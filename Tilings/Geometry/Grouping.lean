  by_cases h : a < b
  · rw [if_pos h]
    constructor
    · exact h
    · linarith [ha.1, hb.2]
  · rw [if_neg h]
    have hba : b < a := lt_of_le_of_ne (le_of_not_gt h) hab.symm
    constructor <;> linarith [ha.2, hb.1]

/-- A simple period-one loop is injective on any half-open interval of length one. -/
private lemma existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_shifted_inj
    {K : Set Pt} {γ : ℝ → Pt} (hγ : IsLoopParam K γ) {a s t : ℝ}
    (hs : s ∈ Ico a (a + 1)) (ht : t ∈ Ico a (a + 1))
    (heq : γ s = γ t) : s = t := by
  obtain ⟨m, hm⟩ := pg_param_eq hγ heq
  have hm_lt : (m : ℝ) < 1 := by
    rw [← hm]
    linarith [hs.2, ht.1]
  have hm_gt : (-1 : ℝ) < m := by
    rw [← hm]
    linarith [hs.1, ht.2]
  have hm_lt' : m < 1 := by exact_mod_cast hm_lt
  have hm_gt' : -1 < m := by exact_mod_cast hm_gt
  have hm0 : m = 0 := by omega
  rw [hm0, Int.cast_zero, sub_eq_zero] at hm
  exact hm

/-- The lifted representatives of the last two points of an ordered triple are
linearly ordered after cutting the circle at the first point. -/
private lemma existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_triple
    {K : Set Pt} {γ : ℝ → Pt} (hγ : IsLoopParam K γ)
    {p q r : Pt} {a b c : ℝ}
    (ha : a ∈ Ico (0 : ℝ) 1) (hb : b ∈ Ico (0 : ℝ) 1)
    (hc : c ∈ Ico (0 : ℝ) 1) (hab : a ≠ b) (hac : a ≠ c)
    (hpa : γ a = p) (hqb : γ b = q) (hrc : γ c = r)
    (hord : PointsInOrder γ (fun i : Fin 3 => ![p, q, r] i)) :
    existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift a b <
      existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift a c := by
  rcases hord with ⟨s, hsmono, hsbound, hsval⟩
  have hs0 : γ (s 0) = p := by simpa using hsval 0
  have hs1 : γ (s 1) = q := by simpa using hsval 1
  have hs2 : γ (s 2) = r := by simpa using hsval 2
  obtain ⟨m, hm⟩ := pg_param_eq hγ (hs0.trans hpa.symm)
  have hs0_eq : s 0 = a + (m : ℝ) := by linarith
  let s1 := s 1 - (m : ℝ)
  let s2 := s 2 - (m : ℝ)
  have hs01 : s 0 < s 1 := hsmono (by decide)
  have hs12 : s 1 < s 2 := hsmono (by decide)
  have hs20 : s 2 < s 0 + 1 := hsbound 0 2
  have hs1_mem : s1 ∈ Ico a (a + 1) := by
    constructor <;> dsimp [s1] <;> linarith
  have hs2_mem : s2 ∈ Ico a (a + 1) := by
    constructor <;> dsimp [s2] <;> linarith
  have hlift_b :=
    existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift_mem ha hb hab
  have hlift_c :=
    existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift_mem ha hc hac
  have hs1_val : γ s1 = q := by
    have hp := pg_periodic_int hγ.2.1 s1 m
    have heq : s1 + (m : ℝ) = s 1 := by dsimp [s1]; ring
    rw [heq] at hp
    exact hp.symm.trans hs1
  have hs2_val : γ s2 = r := by
    have hp := pg_periodic_int hγ.2.1 s2 m
    have heq : s2 + (m : ℝ) = s 2 := by dsimp [s2]; ring
    rw [heq] at hp
    exact hp.symm.trans hs2
  have hlift_b_val :
      γ (existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift a b) = q := by
    unfold existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift
    split_ifs
    · exact hqb
    · exact (hγ.2.1 b).trans hqb
  have hlift_c_val :
      γ (existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift a c) = r := by
    unfold existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift
    split_ifs
    · exact hrc
    · exact (hγ.2.1 c).trans hrc
  have hs1_eq :=
    existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_shifted_inj hγ
      hs1_mem ⟨hlift_b.1.le, hlift_b.2⟩ (hs1_val.trans hlift_b_val.symm)
  have hs2_eq :=
    existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_shifted_inj hγ
      hs2_mem ⟨hlift_c.1.le, hlift_c.2⟩ (hs2_val.trans hlift_c_val.symm)
  rw [← hs1_eq, ← hs2_eq]
  dsimp [s1, s2]
  linarith

/-- Step 2 of the blueprint proof of `existsAnnularSpokes_step5_crosscuts_step3_order_transfer`:
cyclic order is preserved if it is preserved for any 3 points. -/
private lemma existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_reduction
    {k : ℕ} (x : Fin k → Pt) (γ : ℝ → Pt) {K : Set Pt} (hγ : IsLoopParam K γ) (hx_in : ∀ i, x i ∈ K)
    (hx_inj : Function.Injective x)
    (h3 : ∀ f : Fin 3 ↪ Fin k, StrictMono f → PointsInOrder γ (x ∘ f)) :
    PointsInOrder γ x := by
  classical
  by_cases hk0 : k = 0
  · subst k
    exact ⟨fun i => Fin.elim0 i, fun i => Fin.elim0 i,
      fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩
  have hkpos : 0 < k := Nat.pos_of_ne_zero hk0
  let z : Fin k := ⟨0, hkpos⟩
  have hrep : ∀ i : Fin k, ∃ u : ℝ, u ∈ Ico (0 : ℝ) 1 ∧ γ u = x i := by
    intro i
    have hi : x i ∈ γ '' Ico (0 : ℝ) 1 := by
      rw [hγ.2.2.2]
      exact hx_in i
    exact hi
  choose u hu huval using hrep
  have hune : ∀ i j : Fin k, i ≠ j → u i ≠ u j := by
    intro i j hij heq
    apply hij
    apply hx_inj
    rw [← huval i, ← huval j, heq]
  let t : Fin k → ℝ := fun i =>
    if i = z then u z
    else existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift (u z) (u i)
  have ht_mem : ∀ i, t i ∈ Ico (u z) (u z + 1) := by
    intro i
    by_cases hi : i = z
    · simp only [t, hi, if_true, mem_Ico]
      exact ⟨le_rfl, by linarith⟩
    · simp only [t, hi, if_false]
      have hmem := existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift_mem
        (hu z) (hu i) (hune z i fun h => hi h.symm)
      exact ⟨hmem.1.le, hmem.2⟩
  have ht_strict : StrictMono t := by
    intro i j hij
    by_cases hi : i = z
    · have hj : j ≠ z := by
        intro hj
        subst i j
        exact (lt_irrefl z hij).elim
      simp only [t, hi, hj, if_true, if_false]
      exact (existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift_mem
        (hu z) (hu j) (hune z j fun h => hj h.symm)).1
    · have hi_pos : 0 < i.val := by
        by_contra h
        apply hi
        apply Fin.ext
        have hi0 : i.val = 0 := Nat.eq_zero_of_not_pos h
        simpa [z] using hi0
      have hj : j ≠ z := by
        intro hjz
        subst j
        have hv : i.val < z.val := hij
        change i.val < 0 at hv
        exact (Nat.not_lt_zero i.val) hv
      let f : Fin 3 → Fin k := fun a => ![z, i, j] a
      have hf : StrictMono f := by
        rw [Fin.strictMono_iff_lt_succ]
        intro a
        fin_cases a
        · change z < i
          exact hi_pos
        · change i < j
          exact hij
      let fe : Fin 3 ↪ Fin k := ⟨f, hf.injective⟩
      have hord : PointsInOrder γ (fun a : Fin 3 => ![x z, x i, x j] a) := by
        have hord' := h3 fe hf
        change PointsInOrder γ (x ∘ f) at hord'
        have heq : (x ∘ f) = (fun a : Fin 3 => ![x z, x i, x j] a) := by
          funext a
          fin_cases a <;> simp [f]
        rw [heq] at hord'
        exact hord'
      have horder :=
        existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_triple hγ
          (hu z) (hu i) (hu j) (hune z i fun h => hi h.symm)
          (hune z j fun h => hj h.symm)
          (huval z) (huval i) (huval j) hord
      simpa only [t, hi, hj, if_false] using horder
  refine ⟨t, ht_strict, ?_, ?_⟩
  · intro i j
    have hi := ht_mem i
    have hj := ht_mem j
    exact hj.2.trans_le (add_le_add_left hi.1 1)
  · intro i
    by_cases hi : i = z
    · simp only [t, hi, if_true]
      exact huval z
    · simp only [t, hi, if_false]
      unfold existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_lift
      split_ifs
      · exact huval i
      · exact (hγ.2.1 (u i)).trans (huval i)

/-- Step 3 of the blueprint proof of `existsAnnularSpokes_step5_crosscuts_step3_order_transfer`:
cyclic order is trivially preserved for `k < 3` points. -/
private lemma existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step3_small_k
    {k : ℕ} (hk : k < 3) (x : Fin k → Pt) (γ : ℝ → Pt) {K : Set Pt} (hγ : IsLoopParam K γ)
    (hx_in : ∀ i, x i ∈ K) (hx_inj : Function.Injective x) :
    PointsInOrder γ x := by
  dsimp [PointsInOrder]
  rcases hγ with ⟨hγ_cont, hγ_per, hγ_inj, hγ_im⟩
  match k with
  | 0 =>
    use (fun _ => 0)
    refine ⟨?_, ?_, ?_⟩
    · intro i j hij
      exact Fin.elim0 i
    · intro i j
      exact Fin.elim0 i
    · intro i
      exact Fin.elim0 i
  | 1 =>
    have hx0 : x 0 ∈ γ '' Ico 0 1 := by
      rw [hγ_im]
      exact hx_in 0
    rcases hx0 with ⟨t0, ht0_in, ht0_eq⟩
    use (fun _ => t0)
    refine ⟨?_, ?_, ?_⟩
    · intro i j hij
      have hi : i = 0 := Subsingleton.elim i 0
      have hj : j = 0 := Subsingleton.elim j 0
      subst hi hj
      exact (lt_irrefl _ hij).elim
    · intro i j
      linarith
    · intro i
      have hi : i = 0 := Subsingleton.elim i 0
      subst hi
      exact ht0_eq
  | 2 =>
    have hx0 : x 0 ∈ γ '' Ico 0 1 := by rw [hγ_im]; exact hx_in 0
    have hx1 : x 1 ∈ γ '' Ico 0 1 := by rw [hγ_im]; exact hx_in 1
    rcases hx0 with ⟨t0, ht0_in, ht0_eq⟩
    rcases hx1 with ⟨t1, ht1_in, ht1_eq⟩
    have ht0_ne_t1 : t0 ≠ t1 := by
      intro h
      have : x 0 = x 1 := by rw [← ht0_eq, ← ht1_eq, h]
      have : (0 : Fin 2) = 1 := hx_inj this
      revert this
      decide
    by_cases ht : t0 < t1
    · use (fun i => if i = 0 then t0 else t1)
      refine ⟨?_, ?_, ?_⟩
      · intro i j hij
        change (i : ℕ) < j at hij
        have hi0 : (i : ℕ) = 0 := by omega
        have hj1 : (j : ℕ) = 1 := by omega
        have hi_eq : i = 0 := by ext; exact hi0
        have hj_eq : j = 1 := by ext; exact hj1
        subst hi_eq hj_eq
        change t0 < t1
        exact ht
      · intro i j
        fin_cases i <;> fin_cases j
        · change t0 < t0 + 1; linarith
        · change t1 < t0 + 1
          rcases ht1_in with ⟨ht1_ge, ht1_lt⟩
          rcases ht0_in with ⟨ht0_ge, ht0_lt⟩
          linarith
        · change t0 < t1 + 1
          rcases ht1_in with ⟨ht1_ge, ht1_lt⟩
          rcases ht0_in with ⟨ht0_ge, ht0_lt⟩
          linarith
        · change t1 < t1 + 1; linarith
      · intro i
        fin_cases i
        · change γ t0 = x 0; exact ht0_eq
        · change γ t1 = x 1; exact ht1_eq
    · use (fun i => if i = 0 then t0 else t1 + 1)
      have ht_gt : t1 < t0 := lt_of_le_of_ne (not_lt.mp ht) ht0_ne_t1.symm
      refine ⟨?_, ?_, ?_⟩
      · intro i j hij
        change (i : ℕ) < j at hij
        have hi0 : (i : ℕ) = 0 := by omega
        have hj1 : (j : ℕ) = 1 := by omega
        have hi_eq : i = 0 := by ext; exact hi0
        have hj_eq : j = 1 := by ext; exact hj1
        subst hi_eq hj_eq
        change t0 < t1 + 1
        rcases ht1_in with ⟨ht1_ge, ht1_lt⟩
        rcases ht0_in with ⟨ht0_ge, ht0_lt⟩
        linarith
      · intro i j
        fin_cases i <;> fin_cases j
        · change t0 < t0 + 1; linarith
        · change t1 + 1 < t0 + 1
          rcases ht1_in with ⟨ht1_ge, ht1_lt⟩
          rcases ht0_in with ⟨ht0_ge, ht0_lt⟩
          linarith
        · change t0 < t1 + 1 + 1
          rcases ht1_in with ⟨ht1_ge, ht1_lt⟩
          rcases ht0_in with ⟨ht0_ge, ht0_lt⟩
          linarith
        · change t1 + 1 < t1 + 1 + 1; linarith
      · intro i
        fin_cases i
        · change γ t0 = x 0; exact ht0_eq
        · change γ (t1 + 1) = x 1
          have : γ (t1 + 1) = γ t1 := by exact hγ_per t1
          rw [this]
          exact ht1_eq

/-- Step 4 of the blueprint proof of `existsAnnularSpokes_step5_crosscuts_step3_order_transfer`:
a subset of points in cyclic order is in cyclic order. -/
private lemma existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step4_sub_order
    {k : ℕ} (x : Fin k → Pt) (γ : ℝ → Pt) (hord : PointsInOrder γ x)
    {m : ℕ} (f : Fin m ↪ Fin k) (hf : StrictMono f) :
    PointsInOrder γ (x ∘ f) := by
  rcases hord with ⟨t, hmono, hbound, hval⟩
  use t ∘ f
  refine ⟨?_, ?_, ?_⟩
  · exact hmono.comp hf
  · intros i j
    exact hbound (f i) (f j)
  · intro i
    exact hval (f i)

/-- Step 5 of the blueprint proof of `existsAnnularSpokes_step5_crosscuts`: disjoint crosscuts
in an annulus transfer the cyclic order of their outer endpoints to their inner endpoints. -/
private lemma existsAnnularSpokes_step5_crosscuts_step3_order_transfer (A C : PolygonalDisk)
    (hCA : C.carrier ⊆ interior A.carrier) {k : ℕ} (α : Fin k → PolyArc)
    (hin : ∀ j, (α j).carrier ⊆ A.carrier \ interior C.carrier)
    (hC : ∀ j, (α j).carrier ∩ frontier C.carrier = {(α j).start})
    (hA : ∀ j, (α j).carrier ∩ frontier A.carrier = {(α j).stop})
    (hdisj : ∀ i j, i ≠ j → Disjoint (α i).carrier (α j).carrier)
    (hstart : Function.Injective (fun j => (α j).start))
    (hstop : Function.Injective (fun j => (α j).stop))
    {γo γi : ℝ → Pt} (hγo : IsLoopParam (frontier A.carrier) γo)
    (hγi : IsLoopParam (frontier C.carrier) γi)
    (hhom : LoopsHomotopicIn (A.carrier \ interior C.carrier) γo γi)
    (hord : PointsInOrder γo fun j => (α j).stop) :
    PointsInOrder γi fun j => (α j).start := by
  by_cases hk : k < 3
  · apply existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step3_small_k hk _ _ hγi
    · intro i
      have h : (α i).start ∈ (α i).carrier ∩ frontier C.carrier := by
        rw [hC i]
        exact Set.mem_singleton _
      exact h.2
    · exact hstart
  · apply existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step2_reduction _ _ hγi
    · intro i
      have h : (α i).start ∈ (α i).carrier ∩ frontier C.carrier := by
        rw [hC i]
        exact Set.mem_singleton _
      exact h.2
    · exact hstart
    · intro f hf
      have hord_sub := existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step4_sub_order
        _ _ hord f hf
      let α' : Fin 3 → PolyArc := α ∘ f
      have hin' : ∀ j, (α' j).carrier ⊆ A.carrier \ interior C.carrier := fun j => hin (f j)
      have hC' : ∀ j, (α' j).carrier ∩ frontier C.carrier = {(α' j).start} := fun j => hC (f j)
      have hA' : ∀ j, (α' j).carrier ∩ frontier A.carrier = {(α' j).stop} := fun j => hA (f j)
      have hdisj' : ∀ i j, i ≠ j → Disjoint (α' i).carrier (α' j).carrier := by
        intro i j hij
        exact hdisj (f i) (f j) (f.injective.ne hij)
      have hstart' : Function.Injective (fun j => (α' j).start) := hstart.comp f.injective
      have hstop' : Function.Injective (fun j => (α' j).stop) := hstop.comp f.injective
      exact existsAnnularSpokes_step5_crosscuts_step3_order_transfer_step1_k3 A C hCA α' hin'
        hC' hA' hdisj' hstart' hstop' hγo hγi hhom hord_sub

/-- Step 5 of the blueprint proof of `existsAnnularSpokes`: "The separated tubes give disjoint
arcs and distinct endpoints.  Disjoint arcs joining the two boundary components of an annulus
have compatible cyclic endpoint order."  In the polygonal annulus `A \ int C`, if pairwise
disjoint polygonal arcs, each meeting `∂C` only at its start and `∂A` only at its stop, have
their stops in cyclic order along a parametrization `γo` of `∂A`, then their starts are in the
same cyclic order along a parametrization of `∂C` freely homotopic to `γo` in the annulus. -/
private lemma existsAnnularSpokes_step5_crosscuts (A C : PolygonalDisk)
    (hCA : C.carrier ⊆ interior A.carrier) {k : ℕ} (α : Fin k → PolyArc)
    (hin : ∀ j, (α j).carrier ⊆ A.carrier \ interior C.carrier)
    (hC : ∀ j, (α j).carrier ∩ frontier C.carrier = {(α j).start})
    (hA : ∀ j, (α j).carrier ∩ frontier A.carrier = {(α j).stop})
    (hdisj : ∀ i j, i ≠ j → Disjoint (α i).carrier (α j).carrier) {γo : ℝ → Pt}
    (hγo : IsLoopParam (frontier A.carrier) γo)
    (hord : PointsInOrder γo fun j => (α j).stop) :
    MatchingCyclicOrder (A.carrier \ interior C.carrier) (frontier A.carrier)
      (frontier C.carrier) (fun j => (α j).stop) (fun j => (α j).start) := by
  obtain ⟨γi, hγi, hhom⟩ :=
    existsAnnularSpokes_step5_crosscuts_step2_boundary_homotopy A C hCA hγo
  obtain ⟨hstart, hstop⟩ :=
    existsAnnularSpokes_step5_crosscuts_step1_endpoints A C α hC hA hdisj
  have hinner := existsAnnularSpokes_step5_crosscuts_step3_order_transfer A C hCA α hin hC hA
    hdisj hstart hstop hγo hγi hhom hord
  exact ⟨γo, γi, hγo, hγi, hhom, hord, hinner⟩

/-- The open arc of `∂A` strictly between the stops of the cross-cuts `j` and `j + 1`, read along the
loop parametrization `γ` with stop parameters `t` (wrapping around once after the last cross-cut). -/
private def existsAnnularSpokes_step6_cut_step1_regions_step1_cut_gap (γ : ℝ → Pt) {k : ℕ}
    (t : Fin k → ℝ) (j : Fin k) : Set Pt :=
  γ '' Ioo (t j) (if (j : ℕ) + 1 < k then t (finRotate k j) else t (finRotate k j) + 1)

/-- Step 1 of the blueprint proof of `existsAnnularSpokes_step6_cut_step1_regions_step1_cut`: "Cutting a
polygonal annulus along such arcs".  The cut open annulus `int A \ (C ∪ ⋃ αⱼ)` is open, since `C` is compact
and every cross-cut is a finite union of segments. -/
private lemma existsAnnularSpokes_step6_cut_step1_regions_step1_cut_step1_open (A C : PolygonalDisk) {k : ℕ}
    (α : Fin k → PolyArc) : IsOpen (interior A.carrier \ (C.carrier ∪ ⋃ j, (α j).carrier)) := by
  refine isOpen_interior.sdiff (C.compact.isClosed.union (isClosed_iUnion_of_finite fun j => ?_))
  exact isClosed_iUnion_of_finite fun i => (isCompact_segment_pt _ _).isClosed

/-- Step 2 of the blueprint proof of `existsAnnularSpokes_step6_cut_step1_regions_step1_cut`: "a direct polygonal
Jordan argument", approach along a direction: a point is in the closure of a set containing all its small
translates in a fixed direction, and points of an open disk stay in it under small translations. -/
private lemma existsAnnularSpokes_step6_cut_step1_regions_step1_cut_step2_closure_dir {Q : Set Pt} {x v : Pt}
    (h : ∀ᶠ ε in nhdsWithin (0 : ℝ) (Set.Ioi 0), x + ε • v ∈ Q) : x ∈ closure Q := by
  have ht : Filter.Tendsto (fun ε : ℝ => x + ε • v) (nhdsWithin (0 : ℝ) (Set.Ioi 0)) (nhds x) := by
    have : Continuous (fun ε : ℝ => x + ε • v) := by fun_prop
    have h0 := this.tendsto 0
    simp only [zero_smul, add_zero] at h0
    exact h0.mono_left nhdsWithin_le_nhds
  exact mem_closure_of_tendsto ht h

/-- Step 2 of the blueprint proof of `existsAnnularSpokes_step6_cut_step1_regions_step1_cut`: "a direct polygonal
Jordan argument", small translates of a point of an open disk stay in the disk. -/
private lemma existsAnnularSpokes_step6_cut_step1_regions_step1_cut_step2_ball_dir {p x v : Pt} {r : ℝ}
    (hx : x ∈ Metric.ball p r) : ∀ᶠ ε in nhdsWithin (0 : ℝ) (Set.Ioi 0), x + ε • v ∈ Metric.ball p r := by
  have : Continuous (fun ε : ℝ => x + ε • v) := by fun_prop
  have h0 := this.tendsto 0
  simp only [zero_smul, add_zero] at h0
  exact (h0.mono_left nhdsWithin_le_nhds).eventually (Metric.isOpen_ball.mem_nhds hx)

/-- Step 2 of the blueprint proof of `existsAnnularSpokes_step6_cut_step1_regions_step1_cut`: "a direct polygonal
Jordan argument", local picture at a corner turning positively: a small disk minus two rays from its centre is
the union of two connected sectors, each having both rays in its closure. -/
private lemma existsAnnularSpokes_step6_cut_step1_regions_step1_cut_step2_rays_pos (p u w : Pt)
    (hD : 0 < jcr u w) {r : ℝ} (hr : 0 < r) :
