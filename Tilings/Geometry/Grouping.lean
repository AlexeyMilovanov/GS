private lemma existsAnnularSpokes_step6_cut_step1_regions_step1_cut_step2_vertex_local (B : PolygonalDisk)
    (m : Fin B.n) {ε : ℝ} (hε : 0 < ε) :
    ∃ r, 0 < r ∧ r ≤ ε ∧ IsPreconnected (Metric.ball (B.vertex m) r ∩ interior B.carrier) ∧
