    (W : Fin k → Set Pt) (hWo : ∀ j, IsOpen (W j)) (hWd : ∀ i j, i ≠ j → Disjoint (W i) (W j))
    (hWU : ⋃ j, W j = interior A.carrier \ (C.carrier ∪ ⋃ j, (α j).carrier))
