    (hne : ∀ q ∈ Γ, ∀ ρ > 0, (Metric.ball q ρ ∩ U).Nonempty) {x y : Pt} (hy : y ∈ U)
    (hxj : (closure (connectedComponentIn U x) ∩ Γ).Nonempty)
