    rw [hC i]; exact Set.mem_singleton _
  have hsub : ∀ y ∈ Metric.ball (α l).start (min r ε), y ∈ Metric.ball (α l).start r :=
    fun y hy => Metric.ball_subset_ball (min_le_left _ _) hy
