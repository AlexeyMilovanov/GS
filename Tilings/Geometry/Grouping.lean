  obtain ⟨γo, γi, hγo, hγi, hhom, hxo, hyi'⟩ := horder
  exact plAnnulusRouting_polygonalAnnulus_cutModel A C hC x y hx hy hxi hyi γo γi
    hγo hγi hhom hxo hyi'

/-- Step 1 of the blueprint proof of `plAnnulusRouting_step1_topological`: cut the
annulus along a crosscut and record the resulting disk model and boundary order. -/
private lemma plAnnulusRouting_step1_topological_step1_cutModel (A C : PolygonalDisk)
    (hC : C.carrier ⊆ interior A.carrier) {k : ℕ} (x y : Fin k → Pt)
    (hx : ∀ i, x i ∈ frontier A.carrier) (hy : ∀ i, y i ∈ frontier C.carrier)
    (hxi : Function.Injective x) (hyi : Function.Injective y)
    (horder : MatchingCyclicOrder (A.carrier \ interior C.carrier) (frontier A.carrier)
      (frontier C.carrier) x y) :
    ∃ (B : PolygonalDisk) (e : Pt → Pt) (p q : Fin k → Pt)
      (z : Fin (k + k) → Pt),
      Continuous e ∧ Set.InjOn e B.carrier ∧
      e '' B.carrier ⊆ A.carrier \ interior C.carrier ∧
      e '' interior B.carrier ⊆ interior A.carrier \ C.carrier ∧
      (∀ i, p i ∈ frontier B.carrier) ∧ (∀ i, q i ∈ frontier B.carrier) ∧
      (∀ i, e (p i) = x i) ∧ (∀ i, e (q i) = y i) ∧
      (∀ i, z (Fin.castAdd k i) = p i) ∧
      (∀ i, z (Fin.natAdd k i) = q (Fin.rev i)) ∧
      Function.Injective z ∧
      ∃ l : ℝ → Pt, IsLoopParam (frontier B.carrier) l ∧ PointsInOrder l z := by
  classical
  obtain ⟨B, e, p, q, he_cont, he_inj, he_carrier, he_interior, hp, hq, hep, heq,
      l, hl_loop, hl_order⟩ :=
    plAnnulusRouting_step1_topological_step1_cutModel_step1_cutGeometry A C hC x y hx hy
      hxi hyi horder
  have hp_inj : Function.Injective p := by
    intro i j hij
    apply hxi
    rw [← hep i, ← hep j, hij]
  have hq_inj : Function.Injective q := by
    intro i j hij
    apply hyi
    rw [← heq i, ← heq j, hij]
  have hxy : ∀ i j, x i ≠ y j := by
    intro i j hij
    have hyC : y j ∈ C.carrier := C.compact.isClosed.frontier_subset (hy j)
    have hyA : y j ∈ interior A.carrier := hC hyC
    exact (Set.disjoint_left.1 disjoint_interior_frontier hyA (hij ▸ hx i))
  have hpq : ∀ i j, p i ≠ q j := by
    intro i j hij
    apply hxy i j
    rw [← hep i, ← heq j, hij]
  let z : Fin (k + k) → Pt := Fin.addCases p (fun i => q (Fin.rev i))
  have hzp : ∀ i, z (Fin.castAdd k i) = p i := by
    intro i
    change Fin.addCases p (fun i => q (Fin.rev i)) (Fin.castAdd k i) = p i
    rw [Fin.addCases_left]
  have hzq : ∀ i, z (Fin.natAdd k i) = q (Fin.rev i) := by
    intro i
    change Fin.addCases p (fun i => q (Fin.rev i)) (Fin.natAdd k i) = q (Fin.rev i)
    rw [Fin.addCases_right]
  have hzi : Function.Injective z := by
    intro i
    induction i using Fin.addCases with
    | left i =>
        intro j
        induction j using Fin.addCases with
        | left j =>
            intro hij
            apply congrArg (Fin.castAdd k)
            apply hp_inj
            rw [← hzp i, ← hzp j]
            exact hij
        | right j =>
            intro hij
            exact False.elim ((hpq i (Fin.rev j)) (by
              rw [← hzp i, ← hzq j]
              exact hij))
    | right i =>
        intro j
        induction j using Fin.addCases with
        | left j =>
            intro hij
            exact False.elim ((hpq j (Fin.rev i)) (by
              rw [← hzp j, ← hzq i]
              exact hij.symm))
        | right j =>
            intro hij
            apply congrArg (Fin.natAdd k)
            apply Fin.rev_injective
            apply hq_inj
            rw [← hzq i, ← hzq j]
            exact hij
  exact ⟨B, e, p, q, z, he_cont, he_inj, he_carrier, he_interior, hp, hq, hep, heq, hzp,
    hzq, hzi, l, hl_loop, by simpa [z] using hl_order⟩

/-- Step 1 of the blueprint proof of `plAnnulusRouting_step1_topological_step2_diskRouting`:
model the polygonal disk on the closed unit disk of `ℂ` (polygonal Schoenflies theorem).  Any
period-one parametrization `l` of the boundary curve extends to a continuous map `h : ℂ → Pt`
which is injective on the closed unit disk, maps it into the carrier, maps the open unit disk
into the interior, and sends `exp (2πit)` to `l t`. -/
private lemma plAnnulusRouting_step1_topological_step2_diskRouting_step1_schoenflies
    (B : PolygonalDisk) (l : ℝ → Pt) (hl : IsLoopParam (frontier B.carrier) l) :
    ∃ h : ℂ → Pt, Continuous h ∧ Set.InjOn h (Metric.closedBall (0 : ℂ) 1) ∧
      h '' Metric.closedBall (0 : ℂ) 1 ⊆ B.carrier ∧
      h '' Metric.ball (0 : ℂ) 1 ⊆ interior B.carrier ∧
      ∀ t : ℝ, h (Complex.exp (((2 * Real.pi * t : ℝ) : ℂ) * Complex.I)) = l t := by
  obtain ⟨f, hf, hfinj, hfcar, hfint, hfcircle⟩ :=
    plAnnulusRouting_polygonalDisk_closedBall_model B l hl
  obtain ⟨h, hh, hext⟩ := plAnnulusRouting_closedBall_continuous_extension f hf
  refine ⟨h, hh, ?_, ?_, ?_, ?_⟩
  · intro z hz w hw hzw
    exact congrArg Subtype.val (hfinj (by
      simpa only [hext z hz, hext w hw] using hzw))
  · rintro _ ⟨z, hz, rfl⟩
    rw [hext z hz]
    exact hfcar ⟨z, hz⟩
  · rintro _ ⟨z, hz, rfl⟩
    have hz' : z ∈ Metric.closedBall (0 : ℂ) 1 := Metric.ball_subset_closedBall hz
    rw [hext z hz']
    exact hfint ⟨z, hz'⟩ hz
  · intro t
    rw [hext _ (plAnnulusRouting_unitCircle_mem_closedBall t)]
    exact hfcircle t

/-- Step 2 of the blueprint proof of `plAnnulusRouting_step1_topological_step2_diskRouting`:
polar coordinates on the unit disk are unique for positive radii and angles (in turns) closer
than one full turn. -/
private lemma plAnnulusRouting_step1_topological_step2_diskRouting_step2_polarUnique
    {ρ₁ ρ₂ θ₁ θ₂ : ℝ} (h1 : 0 < ρ₁) (h2 : 0 < ρ₂) (hθ : |θ₁ - θ₂| < 1)
    (h : (ρ₁ : ℂ) * Complex.exp (((2 * Real.pi * θ₁ : ℝ) : ℂ) * Complex.I) =
      (ρ₂ : ℂ) * Complex.exp (((2 * Real.pi * θ₂ : ℝ) : ℂ) * Complex.I)) :
    ρ₁ = ρ₂ ∧ θ₁ = θ₂ := by
  have hρ : ρ₁ = ρ₂ := by
    have hn := congrArg norm h
    rw [norm_mul, norm_mul, Complex.norm_exp_ofReal_mul_I, Complex.norm_exp_ofReal_mul_I,
      Complex.norm_real, Complex.norm_real, Real.norm_of_nonneg h1.le,
      Real.norm_of_nonneg h2.le] at hn
    simpa using hn
  refine ⟨hρ, ?_⟩
  subst hρ
  have hne : (ρ₁ : ℂ) ≠ 0 := by exact_mod_cast h1.ne'
  have he := mul_left_cancel₀ hne h
  obtain ⟨n, hn⟩ := Complex.exp_eq_exp_iff_exists_int.mp he
  have him := congrArg Complex.im hn
  simp at him
  have hθn : θ₁ = θ₂ + n := by
    have hpi := Real.pi_pos
    nlinarith
  have : |(n : ℝ)| < 1 := by rw [hθn] at hθ; simpa using hθ
  have hn0 : n = 0 := by
    have : |n| < 1 := by exact_mod_cast this
    exact Int.abs_lt_one_iff.mp this
  simp [hn0] at hθn
  exact hθn

/-- Step 2 of the blueprint proof of `plAnnulusRouting_step1_topological_step2_diskRouting`:
the radial profile `max 0 (1 - 3s) + max 0 (3s - 2)` and the angular profile
`max 0 (min 1 (3s - 1))` of the routing arcs determine the parameter, and the radial profile
vanishes where the angular profile is strictly between `0` and `1`. -/
private lemma plAnnulusRouting_step1_topological_step2_diskRouting_step2_profile (s s' : ℝ) :
    (max 0 (1 - 3 * s) + max 0 (3 * s - 2) = max 0 (1 - 3 * s') + max 0 (3 * s' - 2) →
      max 0 (min 1 (3 * s - 1)) = max 0 (min 1 (3 * s' - 1)) → s = s') ∧
    (0 < max 0 (min 1 (3 * s - 1)) → max 0 (min 1 (3 * s - 1)) < 1 →
      max 0 (1 - 3 * s) + max 0 (3 * s - 2) = 0) := by
  constructor
  · intro h1 h2
    rw [max_def, max_def, max_def, max_def] at h1
    rw [max_def, max_def, min_def, min_def] at h2
    split_ifs at h1 h2 <;> linarith
  · intro h1 h2
    rw [max_def, max_def]
    rw [max_def, min_def] at h1 h2
    split_ifs at h1 h2 ⊢ <;> linarith

/-- Step 2 of the blueprint proof of `plAnnulusRouting_step1_topological_step2_diskRouting`:
route the nested pairs in the round unit disk.  For boundary angles `t` (in turns) increasing
within less than one turn, the points `exp (2πi t_i)` and `exp (2πi t_{2k-1-i})` are joined by
pairwise disjoint simple arcs, running in the open unit disk except at their endpoints. -/
private lemma plAnnulusRouting_step1_topological_step2_diskRouting_step2_roundDiskRouting
    {k : ℕ} (t : Fin (k + k) → ℝ) (ht : StrictMono t) (ht1 : ∀ i j, t j < t i + 1) :
    ∃ γ : Fin k → ℝ → ℂ,
      (∀ i, Continuous (γ i)) ∧
      (∀ i, γ i 0 = Complex.exp (((2 * Real.pi * t (Fin.castAdd k i) : ℝ) : ℂ) * Complex.I)) ∧
      (∀ i, γ i 1 = Complex.exp (((2 * Real.pi * t (Fin.natAdd k (Fin.rev i)) : ℝ) : ℂ) * Complex.I)) ∧
      (∀ i, ∀ s ∈ Set.Icc (0 : ℝ) 1, γ i s ∈ Metric.closedBall (0 : ℂ) 1) ∧
      (∀ i, ∀ s ∈ Set.Ioo (0 : ℝ) 1, γ i s ∈ Metric.ball (0 : ℂ) 1) ∧
      (∀ i, Set.InjOn (γ i) (Set.Icc (0 : ℝ) 1)) ∧
      (∀ i j, i ≠ j → Disjoint (γ i '' Set.Icc (0 : ℝ) 1) (γ j '' Set.Icc (0 : ℝ) 1)) := by
  obtain ⟨a, ha_def⟩ : ∃ a : Fin k → ℝ, a = fun i => t (Fin.castAdd k i) := ⟨_, rfl⟩
  obtain ⟨b, hb_def⟩ : ∃ b : Fin k → ℝ, b = fun i => t (Fin.natAdd k (Fin.rev i)) := ⟨_, rfl⟩
  obtain ⟨r, hr_def⟩ : ∃ r : Fin k → ℝ, r = fun i : Fin k => (((i : ℕ) : ℝ) + 1) / (k + 1) := ⟨_, rfl⟩
  obtain ⟨X, hX_def⟩ : ∃ X : ℝ → ℝ, X = fun s => max 0 (1 - 3 * s) + max 0 (3 * s - 2) :=
    ⟨_, rfl⟩
  obtain ⟨Y, hY_def⟩ : ∃ Y : ℝ → ℝ, Y = fun s => max 0 (min 1 (3 * s - 1)) := ⟨_, rfl⟩
  have hX0 : ∀ s, 0 ≤ X s := fun s => by subst hX_def; dsimp only; positivity
  have hX1 : ∀ s ∈ Icc (0:ℝ) 1, X s ≤ 1 := by
    intro s hs; subst hX_def; dsimp only; rw [max_def, max_def]; split_ifs <;> linarith [hs.1, hs.2]
  have hX1' : ∀ s ∈ Ioo (0:ℝ) 1, X s < 1 := by
    intro s hs; subst hX_def; dsimp only; rw [max_def, max_def]; split_ifs <;> linarith [hs.1, hs.2]
  have hY0 : ∀ s, 0 ≤ Y s := fun s => by subst hY_def; exact le_max_left _ _
  have hY1 : ∀ s, Y s ≤ 1 := fun s => by subst hY_def; exact max_le zero_le_one (min_le_left _ _)
  have hXY : ∀ s s', X s = X s' → Y s = Y s' → s = s' := by
    subst hX_def hY_def
    exact fun s s' h1 h2 => (plAnnulusRouting_step1_topological_step2_diskRouting_step2_profile s s').1 h1 h2
  have hmid : ∀ s, 0 < Y s → Y s < 1 → X s = 0 := by
    subst hX_def hY_def
    exact fun s h1 h2 => (plAnnulusRouting_step1_topological_step2_diskRouting_step2_profile s s).2 h1 h2
  obtain ⟨ρ, hρ_def⟩ : ∃ ρ : Fin k → ℝ → ℝ, ρ = fun i s => r i + (1 - r i) * X s := ⟨_, rfl⟩
  obtain ⟨θ, hθ_def⟩ : ∃ θ : Fin k → ℝ → ℝ, θ = fun i s => a i + (b i - a i) * Y s :=
    ⟨_, rfl⟩
  have hab : ∀ i, a i < b i := by
    intro i; subst ha_def hb_def; apply ht; rw [Fin.lt_def]
    simp only [Fin.val_castAdd, Fin.val_natAdd, Fin.val_rev]; omega
  have hlt : ∀ i j : Fin k, i < j → a i < a j ∧ b j < b i := by
    intro i j hij
    rw [Fin.lt_def] at hij
    subst ha_def hb_def
    refine ⟨ht ?_, ht ?_⟩ <;> rw [Fin.lt_def] <;>
      simp only [Fin.val_castAdd, Fin.val_natAdd, Fin.val_rev] <;> omega
  have hdiff : ∀ m m', t m - t m' < 1 := fun m m' => by linarith [ht1 m' m]
  have hr0 : ∀ i, 0 < r i := fun i => by subst hr_def; dsimp only; positivity
  have hr1 : ∀ i, r i < 1 := by
    intro i; subst hr_def; dsimp only
    rw [div_lt_one (by positivity)]
    have := i.isLt
    have : ((i : ℕ) : ℝ) < k := by exact_mod_cast this
    linarith
  have hrlt : ∀ i j : Fin k, i < j → r i < r j := by
    intro i j hij; subst hr_def; dsimp only
    have : ((i : ℕ) : ℝ) < (j : ℕ) := by exact_mod_cast hij
    gcongr
  have hba' : ∀ i j, b i - a j < 1 := by
    intro i j; subst ha_def hb_def; exact hdiff _ _
  have hρ0 : ∀ i s, 0 < ρ i s := fun i s => by
    have := hr0 i; have := hr1 i; have := hX0 s
    simp only [hρ_def]; nlinarith
  have hθa : ∀ i s, a i ≤ θ i s := fun i s => by
    have := hab i; have := hY0 s; simp only [hθ_def]; nlinarith
  have hθb : ∀ i s, θ i s ≤ b i := fun i s => by
    have := hab i; have := hY1 s; simp only [hθ_def]; nlinarith
  have hθd : ∀ i j s s', |θ i s - θ j s'| < 1 := by
    intro i j s s'
    rw [abs_lt]
    constructor
    · linarith [hθa i s, hθb j s', hba' j i]
    · linarith [hθa j s', hθb i s, hba' i j]
  have hnorm : ∀ i s,
      ‖(ρ i s : ℂ) * Complex.exp (((2 * Real.pi * θ i s : ℝ) : ℂ) * Complex.I)‖ = ρ i s := by
    intro i s
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, Complex.norm_real,
      Real.norm_of_nonneg (hρ0 i s).le, mul_one]
  refine ⟨fun i s => (ρ i s : ℂ) * Complex.exp (((2 * Real.pi * θ i s : ℝ) : ℂ) * Complex.I),
    ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    subst hρ_def hθ_def hX_def hY_def
    fun_prop
  · intro i
    have h1 : ρ i 0 = 1 := by simp [hρ_def, hX_def]
    have h2 : θ i 0 = a i := by simp [hθ_def, hY_def]
    simp only [h1, h2, Complex.ofReal_one, one_mul, ha_def]
  · intro i
    have h1 : ρ i 1 = 1 := by simp [hρ_def, hX_def]; norm_num
    have h2 : θ i 1 = b i := by simp [hθ_def, hY_def]; norm_num
    simp only [h1, h2, Complex.ofReal_one, one_mul, hb_def]
  · intro i s hs
    rw [Metric.mem_closedBall, dist_zero_right, hnorm]
    have := hX1 s hs; have := hr1 i
    simp only [hρ_def]; nlinarith
  · intro i s hs
    rw [Metric.mem_ball, dist_zero_right, hnorm]
    have := hX1' s hs; have := hr1 i
    simp only [hρ_def]; nlinarith
  · intro i s _ s' _ h
    obtain ⟨h1, h2⟩ := plAnnulusRouting_step1_topological_step2_diskRouting_step2_polarUnique
      (hρ0 i s) (hρ0 i s') (hθd i i s s') h
    have hr := hr1 i; have hba := hab i
    apply hXY
    · simp only [hρ_def] at h1
      have : (1 - r i) * (X s - X s') = 0 := by linarith
      rcases mul_eq_zero.mp this with h | h
      · linarith
      · linarith
    · simp only [hθ_def] at h2
      have : (b i - a i) * (Y s - Y s') = 0 := by linarith
      rcases mul_eq_zero.mp this with h | h
      · linarith
      · linarith
  · have key : ∀ i j : Fin k, i < j → ∀ s s',
        (ρ i s : ℂ) * Complex.exp (((2 * Real.pi * θ i s : ℝ) : ℂ) * Complex.I) ≠
          (ρ j s' : ℂ) * Complex.exp (((2 * Real.pi * θ j s' : ℝ) : ℂ) * Complex.I) := by
      intro i j hij s s' h
      obtain ⟨h1, h2⟩ := plAnnulusRouting_step1_topological_step2_diskRouting_step2_polarUnique
        (hρ0 i s) (hρ0 j s') (hθd i j s s') h
      obtain ⟨hai, hbi⟩ := hlt i j hij
      have hθ1 : a i < θ i s := by linarith [hθa j s']
      have hθ2 : θ i s < b i := by linarith [hθb j s']
      have hba := hab i
      have hY0' : 0 < Y s := by
        by_contra hc
        have : Y s = 0 := le_antisymm (not_lt.mp hc) (hY0 s)
        simp only [hθ_def, this] at hθ1; linarith
      have hY1' : Y s < 1 := by
        by_contra hc
        have : Y s = 1 := le_antisymm (hY1 s) (not_lt.mp hc)
        simp only [hθ_def, this] at hθ2; linarith
      have hX := hmid s hY0' hY1'
      simp only [hρ_def, hX] at h1
      have := hrlt i j hij; have := hr1 j; have := hX0 s'
      nlinarith
    intro i j hij
    rw [Set.disjoint_left]
    rintro _ ⟨s, _, rfl⟩ ⟨s', _, hs'⟩
    rcases lt_or_gt_of_ne hij with h | h
    · exact key i j h s s' hs'.symm
    · exact key j i h s' s hs'

/-- Step 2 of the blueprint proof of `plAnnulusRouting_step1_topological`: route matching
points in a polygonal disk when the combined boundary order is non-alternating. -/
private lemma plAnnulusRouting_step1_topological_step2_diskRouting (B : PolygonalDisk)
    {k : ℕ} (p q : Fin k → Pt) (hp : ∀ i, p i ∈ frontier B.carrier)
    (hq : ∀ i, q i ∈ frontier B.carrier) (z : Fin (k + k) → Pt)
    (hzp : ∀ i, z (Fin.castAdd k i) = p i)
    (hzq : ∀ i, z (Fin.natAdd k i) = q (Fin.rev i))
    (hzi : Function.Injective z)
    (horder : ∃ l : ℝ → Pt, IsLoopParam (frontier B.carrier) l ∧ PointsInOrder l z) :
    ∃ δ : Fin k → ℝ → Pt,
      (∀ i, Continuous (δ i)) ∧
      (∀ i, δ i 0 = p i) ∧
      (∀ i, δ i 1 = q i) ∧
      (∀ i, ∀ t ∈ Set.Icc (0 : ℝ) 1, δ i t ∈ B.carrier) ∧
      (∀ i, ∀ t ∈ Set.Ioo (0 : ℝ) 1, δ i t ∈ interior B.carrier) ∧
      (∀ i, Function.Injective (Set.restrict (Set.Icc (0 : ℝ) 1) (δ i))) ∧
      (∀ i j, i ≠ j →
        Disjoint (δ i '' Set.Icc (0 : ℝ) 1) (δ j '' Set.Icc (0 : ℝ) 1)) := by
  have _ := hp
  have _ := hq
  have _ := hzi
  obtain ⟨l, hl, t, ht, ht1, hlt⟩ := horder
  obtain ⟨h, hc, hinj, hcar, hint, hcirc⟩ :=
    plAnnulusRouting_step1_topological_step2_diskRouting_step1_schoenflies B l hl
  obtain ⟨γ, hγc, hγ0, hγ1, hγcb, hγb, hγinj, hγdisj⟩ :=
    plAnnulusRouting_step1_topological_step2_diskRouting_step2_roundDiskRouting t ht ht1
  refine ⟨fun i => h ∘ γ i, fun i => hc.comp (hγc i), ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    simp only [Function.comp_apply, hγ0, hcirc, hlt, hzp]
  · intro i
    simp only [Function.comp_apply, hγ1, hcirc, hlt, hzq, Fin.rev_rev]
  · intro i s hs
    exact hcar ⟨γ i s, hγcb i s hs, rfl⟩
  · intro i s hs
    exact hint ⟨γ i s, hγb i s hs, rfl⟩
  · intro i ⟨s, hs⟩ ⟨s', hs'⟩ hss
    exact Subtype.ext (hγinj i hs hs' (hinj (hγcb i s hs) (hγcb i s' hs') hss))
  · intro i j hij
    rw [Set.disjoint_left]
    rintro _ ⟨s, hs, rfl⟩ ⟨s', hs', hss⟩
    have he : γ j s' = γ i s := hinj (hγcb j s' hs') (hγcb i s hs) hss
    exact Set.disjoint_left.1 (hγdisj i j hij) ⟨s, hs, rfl⟩ ⟨s', hs', he⟩

/-- Step 3 of the blueprint proof of `plAnnulusRouting_step1_topological`: transfer disk
arcs through an injective continuous cut model. -/
private lemma plAnnulusRouting_step1_topological_step3_transfer (A C B : PolygonalDisk)
    {k : ℕ} (x y : Fin k → Pt) (e : Pt → Pt) (p q : Fin k → Pt)
    (he_cont : Continuous e) (he_inj : Set.InjOn e B.carrier)
    (he_carrier : e '' B.carrier ⊆ A.carrier \ interior C.carrier)
    (he_interior : e '' interior B.carrier ⊆ interior A.carrier \ C.carrier)
    (hep : ∀ i, e (p i) = x i) (heq : ∀ i, e (q i) = y i)
    (δ : Fin k → ℝ → Pt) (hδ_cont : ∀ i, Continuous (δ i))
    (hδ_start : ∀ i, δ i 0 = p i) (hδ_stop : ∀ i, δ i 1 = q i)
    (hδ_carrier : ∀ i, ∀ t ∈ Set.Icc (0 : ℝ) 1, δ i t ∈ B.carrier)
    (hδ_in : ∀ i, ∀ t ∈ Set.Ioo (0 : ℝ) 1, δ i t ∈ interior B.carrier)
    (hδ_simple : ∀ i, Function.Injective (Set.restrict (Set.Icc (0 : ℝ) 1) (δ i)))
    (hδ_disj : ∀ i j, i ≠ j →
      Disjoint (δ i '' Set.Icc (0 : ℝ) 1) (δ j '' Set.Icc (0 : ℝ) 1)) :
    ∃ γ : Fin k → ℝ → Pt,
      (∀ i, Continuous (γ i)) ∧
      (∀ i, γ i 0 = x i) ∧
      (∀ i, γ i 1 = y i) ∧
      (∀ i, ∀ t ∈ Set.Ioo (0 : ℝ) 1, γ i t ∈ interior A.carrier \ C.carrier) ∧
      (∀ i, Function.Injective (Set.restrict (Set.Icc (0 : ℝ) 1) (γ i))) ∧
      (∀ i j, i ≠ j →
        Disjoint (γ i '' Set.Icc (0 : ℝ) 1) (γ j '' Set.Icc (0 : ℝ) 1)) := by
  let γ : Fin k → ℝ → Pt := fun i => e ∘ δ i
  refine ⟨γ, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    exact he_cont.comp (hδ_cont i)
  · intro i
    change e (δ i 0) = x i
    rw [hδ_start i, hep i]
  · intro i
    change e (δ i 1) = y i
    rw [hδ_stop i, heq i]
  · intro i t ht
    have hcarrier : e (δ i t) ∈ A.carrier \ interior C.carrier :=
      he_carrier ⟨δ i t, interior_subset (hδ_in i t ht), rfl⟩
    have _ := hcarrier
    apply he_interior
    exact ⟨δ i t, hδ_in i t ht, rfl⟩
  · intro i a b hab
    apply hδ_simple i
    change δ i a = δ i b
    apply he_inj (hδ_carrier i a a.property) (hδ_carrier i b b.property)
    change e (δ i a) = e (δ i b) at hab
    exact hab
  · intro i j hij
    change Disjoint ((e ∘ δ i) '' Set.Icc (0 : ℝ) 1)
      ((e ∘ δ j) '' Set.Icc (0 : ℝ) 1)
    have himage_i : (e ∘ δ i) '' Set.Icc (0 : ℝ) 1 =
        e '' (δ i '' Set.Icc (0 : ℝ) 1) := by
      simpa [Function.comp_def] using
        (Set.image_image e (δ i) (Set.Icc (0 : ℝ) 1)).symm
    have himage_j : (e ∘ δ j) '' Set.Icc (0 : ℝ) 1 =
        e '' (δ j '' Set.Icc (0 : ℝ) 1) := by
      simpa [Function.comp_def] using
        (Set.image_image e (δ j) (Set.Icc (0 : ℝ) 1)).symm
    rw [himage_i, himage_j]
    rw [Set.disjoint_left]
    intro w hwi hwj
    rcases hwi with ⟨a, ha, rfl⟩
    rcases ha with ⟨s, hs, rfl⟩
    rcases hwj with ⟨b, hb, hbw⟩
    rcases hb with ⟨t, ht, htb⟩
    have hab : e (δ j t) = e (δ i s) := by
      rw [htb]
      exact hbw
    have heq : δ i s = δ j t := he_inj (hδ_carrier i s hs)
      (hδ_carrier j t ht) hab.symm
    exact Set.disjoint_left.1 (hδ_disj i j hij) ⟨s, hs, rfl⟩ ⟨t, ht, heq.symm⟩

/-- Step 1 of the blueprint proof of `plAnnulusRouting`: Topological routing.
In an annulus, points in matching cyclic order can be joined by pairwise disjoint simple
continuous arcs. -/
private lemma plAnnulusRouting_step1_topological (A C : PolygonalDisk)
    (hC : C.carrier ⊆ interior A.carrier) {k : ℕ} (x y : Fin k → Pt)
    (hx : ∀ i, x i ∈ frontier A.carrier) (hy : ∀ i, y i ∈ frontier C.carrier)
    (hxi : Function.Injective x) (hyi : Function.Injective y)
    (horder : MatchingCyclicOrder (A.carrier \ interior C.carrier) (frontier A.carrier)
      (frontier C.carrier) x y) :
    ∃ γ : Fin k → ℝ → Pt,
      (∀ i, Continuous (γ i)) ∧
      (∀ i, γ i 0 = x i) ∧
      (∀ i, γ i 1 = y i) ∧
      (∀ i, ∀ t ∈ Set.Ioo (0:ℝ) 1, γ i t ∈ interior A.carrier \ C.carrier) ∧
      (∀ i, Function.Injective (Set.restrict (Set.Icc (0:ℝ) 1) (γ i))) ∧
      (∀ i j, i ≠ j → Disjoint (γ i '' Set.Icc (0:ℝ) 1) (γ j '' Set.Icc (0:ℝ) 1)) := by
  classical
  by_cases hk : Nonempty (Fin k)
  · obtain ⟨B, e, p, q, z, he_cont, he_inj, he_carrier, he_interior, hp, hq, hep, heq,
        hzp, hzq, hzi, l, hl⟩ :=
      plAnnulusRouting_step1_topological_step1_cutModel A C hC x y hx hy hxi hyi horder
    obtain ⟨δ, hδ_cont, hδ_start, hδ_stop, hδ_carrier, hδ_in, hδ_simple, hδ_disj⟩ :=
      plAnnulusRouting_step1_topological_step2_diskRouting B p q hp hq z hzp hzq hzi ⟨l, hl⟩
    exact plAnnulusRouting_step1_topological_step3_transfer A C B x y e p q he_cont he_inj
      he_carrier he_interior hep heq δ hδ_cont hδ_start hδ_stop hδ_carrier hδ_in hδ_simple hδ_disj
  · let γ : Fin k → ℝ → Pt := fun i => (hk ⟨i⟩).elim
    refine ⟨γ, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> intro i
    · exact (hk ⟨i⟩).elim
    · exact (hk ⟨i⟩).elim
    · exact (hk ⟨i⟩).elim
    · exact (hk ⟨i⟩).elim
    · exact (hk ⟨i⟩).elim
    · intro j hij
      exact (hk ⟨i⟩).elim

private lemma plAnnulusRouting_step2_plApprox_step1_separation_finset
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (K : ι → Set Tilings.Pt)
    (hcompact : ∀ i ∈ s, IsCompact (K i))
    (hdisj : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → Disjoint (K i) (K j)) :
    ∃ U : ι → Set Tilings.Pt, (∀ i ∈ s, IsOpen (U i)) ∧
      (∀ i ∈ s, K i ⊆ U i) ∧
      (∀ i ∈ s, ∀ j ∈ s, i ≠ j → Disjoint (U i) (U j)) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      refine ⟨fun _ => ∅, ?_, ?_, ?_⟩
      · simp
      · simp
      · simp
  | @insert a s ha ih =>
      have hKa : IsCompact (K a) := hcompact a (Finset.mem_insert_self a s)
      have hKs : IsCompact (⋃ i ∈ s, K i) :=
        s.isCompact_biUnion (fun i hi => hcompact i (Finset.mem_insert_of_mem hi))
      have hsep : Disjoint (K a) (⋃ i ∈ s, K i) := by
        rw [Set.disjoint_left]
        intro z hza hzs
        rcases Set.mem_iUnion.1 hzs with ⟨i, hzi⟩
        rcases Set.mem_iUnion.1 hzi with ⟨hi, hzi⟩
        exact Set.disjoint_left.1
          (hdisj a (Finset.mem_insert_self a s) i
            (Finset.mem_insert_of_mem hi)
            (Ne.symm (ne_of_mem_of_not_mem hi ha))) hza hzi
      obtain ⟨V, W, hVopen, hWopen, hKV, hTW, hVW⟩ :=
        normal_separation hKa.isClosed hKs.isClosed hsep
      obtain ⟨Q, hQopen, hKQ, hQdisj⟩ := ih
        (fun i hi => hcompact i (Finset.mem_insert_of_mem hi))
        (fun i hi j hj hij =>
          hdisj i (Finset.mem_insert_of_mem hi) j
            (Finset.mem_insert_of_mem hj) hij)
      let U : ι → Set Tilings.Pt := Function.update (fun i => Q i ∩ W) a V
      have hUa : U a = V := by simp [U]
      have hUa_sub : U a ⊆ V := by rw [hUa]
      refine ⟨U, ?_, ?_, ?_⟩
      · intro i hi
        rcases Finset.mem_insert.mp hi with rfl | hi
        · simpa [U] using hVopen
        · simp only [U, Function.update_of_ne (ne_of_mem_of_not_mem hi ha)]
          exact (hQopen i hi).inter hWopen
      · intro i hi
        rcases Finset.mem_insert.mp hi with rfl | hi
        · simpa [U] using hKV
        · have hKiW : K i ⊆ W := by
            intro z hz
            exact hTW (Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨hi, hz⟩⟩)
          intro z hz
          simp only [U, Function.update_of_ne (ne_of_mem_of_not_mem hi ha)]
          exact ⟨hKQ i hi hz, hKiW hz⟩
      · intro i hi j hj hij
        rcases Finset.mem_insert.mp hi with rfl | hi
        · rcases Finset.mem_insert.mp hj with rfl | hj
          · exact (hij rfl).elim
          · have hsub : U j ⊆ W := by
              intro z hz
              simp only [U, Function.update_of_ne
                (ne_of_mem_of_not_mem hj ha)] at hz
              exact hz.2
            exact hVW.mono hUa_sub hsub
        · have hia : i ≠ a := ne_of_mem_of_not_mem hi ha
          rcases Finset.mem_insert.mp hj with rfl | hj
          · exact hVW.symm.mono (by
              have hsub : U i ⊆ W := by
                intro z hz
                simp only [U, Function.update_of_ne
                  hia] at hz
                exact hz.2
              exact hsub) hUa_sub
          · have hQij := hQdisj i hi j hj hij
            exact hQij.mono (by
              intro z hz
              simp only [U, Function.update_of_ne
                hia] at hz
              exact hz.1) (by
              intro z hz
              simp only [U, Function.update_of_ne
                (ne_of_mem_of_not_mem hj ha)] at hz
              exact hz.1)

/-- Step 1 of the blueprint proof of `plAnnulusRouting_step2_plApprox`: Separation of arcs.
For a finite family of disjoint continuous paths, there exist disjoint open neighborhoods around each. -/
private lemma plAnnulusRouting_step2_plApprox_step1_separation {k : ℕ}
    (γ : Fin k → ℝ → Tilings.Pt)
    (hcont : ∀ i, Continuous (γ i))
    (hdisj : ∀ i j, i ≠ j → Disjoint (γ i '' Set.Icc (0:ℝ) 1) (γ j '' Set.Icc (0:ℝ) 1)) :
    ∃ U : Fin k → Set Tilings.Pt, (∀ i, IsOpen (U i)) ∧
      (∀ i, γ i '' Set.Icc (0:ℝ) 1 ⊆ U i) ∧
      (∀ i j, i ≠ j → Disjoint (U i) (U j)) := by
  classical
  obtain ⟨U, hUopen, hUsub, hUdisj⟩ :=
    plAnnulusRouting_step2_plApprox_step1_separation_finset
      (Finset.univ : Finset (Fin k))
      (fun i => γ i '' Set.Icc (0 : ℝ) 1)
      (fun i hi => isCompact_Icc.image (hcont i))
      (fun i hi j hj hij => hdisj i j hij)
  refine ⟨U, ?_, ?_, ?_⟩
  · intro i
    exact hUopen i (Finset.mem_univ i)
  · intro i
    exact hUsub i (Finset.mem_univ i)
  · intro i j hij
    exact hUdisj i (Finset.mem_univ i) j (Finset.mem_univ j) hij

private lemma plAnnulusRouting_step2_plApprox_step2_single_x_neq_y 
    (x y : Tilings.Pt) (γ : ℝ → Tilings.Pt)
    (hend_x : γ 0 = x)
    (hend_y : γ 1 = y)
    (hsimp : Function.Injective (Set.restrict (Set.Icc (0:ℝ) 1) γ)) : x ≠ y := by
  intro h
  have h1 : (⟨0, by norm_num⟩ : Set.Icc (0 : ℝ) 1) ≠ ⟨1, by norm_num⟩ := by
    intro h_eq
    have h_val := congrArg Subtype.val h_eq
    norm_num at h_val
  have h2 : Set.restrict (Set.Icc (0 : ℝ) 1) γ ⟨0, by norm_num⟩ =
            Set.restrict (Set.Icc (0 : ℝ) 1) γ ⟨1, by norm_num⟩ := by
    change γ 0 = γ 1
    rw [hend_x, hend_y, h]
  exact h1 (hsimp h2)

private lemma plAnnulusRouting_starConvex_openSegment_interior {p q : Tilings.Pt}
    {s : Set Tilings.Pt} (hs : StarConvex ℝ p s) (hq : q ∈ interior s) :
    openSegment ℝ p q ⊆ interior s := by
  rintro z ⟨a, b, ha, hb, hab, rfl⟩
  obtain ⟨ε, hε, hεs⟩ := Metric.mem_nhds_iff.mp (mem_interior_iff_mem_nhds.mp hq)
  rw [mem_interior_iff_mem_nhds, Metric.mem_nhds_iff]
  refine ⟨b * ε, mul_pos hb hε, ?_⟩
  intro w hw
  let u := q + b⁻¹ • (w - (a • p + b • q))
  have huq : dist u q < ε := by
    dsimp [u]
    rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
      abs_inv, abs_of_pos hb, ← dist_eq_norm]
    exact (inv_mul_lt_iff₀ hb).2 (by simpa [mul_comm] using hw)
  have hu : u ∈ s := hεs (by simpa [Metric.mem_ball] using huq)
  have hbu : b • u = b • q + (w - (a • p + b • q)) := by
    dsimp [u]
    rw [smul_add, smul_smul, mul_inv_cancel₀ hb.ne', one_smul]
  have hw_eq : w = a • p + b • u := by rw [hbu]; abel
  rw [hw_eq]
  exact hs hu ha.le hb.le hab

private lemma plAnnulusRouting_localCone_pos_smul_iff (S : Set Tilings.Pt)
    (p z : Tilings.Pt) {c : ℝ} (hc : 0 < c) :
    p + c • (z - p) ∈ Crowns.localCone S p ↔ z ∈ Crowns.localCone S p := by
  constructor
  · rintro ⟨r, hr, hmem⟩
    refine ⟨c * r, mul_pos hc hr, ?_⟩
    intro t ht
    have htc : t / c ∈ Set.Ioo (0 : ℝ) r :=
      ⟨div_pos ht.1 hc, (div_lt_iff₀ hc).2 (by simpa [mul_comm] using ht.2)⟩
    have h := hmem (t / c) htc
    simpa [smul_smul, hc.ne'] using h
  · rintro ⟨r, hr, hmem⟩
    refine ⟨r / c, div_pos hr hc, ?_⟩
    intro t ht
    have htc : t * c ∈ Set.Ioo (0 : ℝ) r :=
      ⟨mul_pos ht.1 hc, (lt_div_iff₀ hc).1 ht.2⟩
    have h := hmem (t * c) htc
    simpa [smul_smul, mul_assoc] using h

private lemma plAnnulusRouting_localCone_starConvex (S : Set Tilings.Pt)
    (p : Tilings.Pt) (hp : p ∈ S) : StarConvex ℝ p (Crowns.localCone S p) := by
  have hpp : p ∈ Crowns.localCone S p := by
    refine ⟨1, zero_lt_one, ?_⟩
    intro t ht
    simpa using hp
  intro z hz a b ha hb hab
  by_cases hb0 : b = 0
  · subst b
    have ha1 : a = 1 := by linarith
    simpa [ha1] using hpp
  · have hbpos : 0 < b := lt_of_le_of_ne hb (Ne.symm hb0)
    have h := (plAnnulusRouting_localCone_pos_smul_iff S p z hbpos).2 hz
    have heq : a • p + b • z = p + b • (z - p) := by
      have ha_eq : a = 1 - b := by linarith
      rw [ha_eq]
      module
    rw [heq]
    exact h

private lemma plAnnulusRouting_localCone_compl_starConvex (S : Set Tilings.Pt)
    (p : Tilings.Pt) : StarConvex ℝ p (insert p (Crowns.localCone S p)ᶜ) := by
  intro z hz a b ha hb hab
  rcases hz with rfl | hz
  · left
    rw [← add_smul, hab, one_smul]
  · by_cases hb0 : b = 0
    · left
      subst b
      have ha1 : a = 1 := by linarith
      simp [ha1]
    · right
      have hbpos : 0 < b := lt_of_le_of_ne hb (Ne.symm hb0)
      intro hcone
      apply hz
      apply (plAnnulusRouting_localCone_pos_smul_iff S p z hbpos).1
      have heq : a • p + b • z = p + b • (z - p) := by
        have ha_eq : a = 1 - b := by linarith
        rw [ha_eq]
        module
      rw [← heq]
      exact hcone

private lemma plAnnulusRouting_disk_inward_chord (D : Tilings.PolygonalDisk)
    {p : Tilings.Pt} (hp : p ∈ D.carrier) :
    ∃ r > 0, ∀ q ∈ Metric.ball p r, q ∈ interior D.carrier →
      segment ℝ p q ⊆ insert p (interior D.carrier) := by
  obtain ⟨r, hr, hlocal⟩ := Crowns.polygonLocalCone D hp
  have hstar : StarConvex ℝ p (D.carrier ∩ Metric.ball p r) := by
    have hc := plAnnulusRouting_localCone_starConvex D.carrier p hp
    have hb := (convex_ball p r).starConvex (Metric.mem_ball_self hr)
    rw [hlocal]
    exact hc.inter hb
  refine ⟨r, hr, ?_⟩
  intro q hqr hqD z hz
  by_cases hzp : z = p
  · exact Or.inl hzp
  right
  have hqint : q ∈ interior (D.carrier ∩ Metric.ball p r) := by
    rw [interior_inter, Metric.isOpen_ball.interior_eq]
    exact ⟨hqD, hqr⟩
  have hzq : z = q ∨ z ∈ openSegment ℝ p q := by
    by_cases hzq : z = q
    · exact Or.inl hzq
    · exact Or.inr (mem_openSegment_of_ne_left_right (Ne.symm hzp) (Ne.symm hzq) hz)
  rcases hzq with rfl | hzq
  · exact hqD
  exact interior_mono inter_subset_left
    (plAnnulusRouting_starConvex_openSegment_interior hstar hqint hzq)

private lemma plAnnulusRouting_disk_outward_chord (D : Tilings.PolygonalDisk)
    {p : Tilings.Pt} (hp : p ∉ interior D.carrier) :
    ∃ r > 0, ∀ q ∈ Metric.ball p r, q ∉ D.carrier →
      segment ℝ p q ⊆ insert p D.carrierᶜ := by
  by_cases hpD : p ∈ D.carrier
  · obtain ⟨r, hr, hlocal⟩ := Crowns.polygonLocalCone D hpD
    have hstar : StarConvex ℝ p (insert p D.carrierᶜ ∩ Metric.ball p r) := by
      have hc := plAnnulusRouting_localCone_compl_starConvex D.carrier p
      have hb := (convex_ball p r).starConvex (Metric.mem_ball_self hr)
      intro z hz a b ha hb' hab
      have hz' : z ∈ insert p (Crowns.localCone D.carrier p)ᶜ := by
        rcases hz.1 with rfl | hzD
        · exact Or.inl rfl
        · exact Or.inr fun hzc => hzD ((Set.ext_iff.1 hlocal z).2 ⟨hzc, hz.2⟩).1
      have hball := hb hz.2 ha hb' hab
      rcases hc hz' ha hb' hab with h | h
      · exact ⟨Or.inl h, hball⟩
      · refine ⟨Or.inr ?_, hball⟩
        intro hD
        exact h ((Set.ext_iff.1 hlocal _).1 ⟨hD, hball⟩).1
    refine ⟨r, hr, ?_⟩
    intro q hqr hqD
    exact (hstar.segment_subset ⟨Or.inr hqD, hqr⟩).trans inter_subset_left
  · obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp D.compact.isClosed.isOpen_compl p hpD
    refine ⟨r, hr, ?_⟩
    intro q hqr hqD
    have hseg := (convex_ball p r).segment_subset (Metric.mem_ball_self hr) hqr
    exact fun z hz => Or.inr (hball (hseg hz))

private lemma plAnnulusRouting_endpoint_chord (A C : Tilings.PolygonalDisk)
    (p : Tilings.Pt) (U : Set Tilings.Pt) (hpA : p ∈ A.carrier)
    (hpC : p ∉ interior C.carrier) (hpU : p ∈ U) (hU : IsOpen U) :
    ∃ r > 0, ∀ q ∈ Metric.ball p r, q ∈ interior A.carrier \ C.carrier →
      segment ℝ p q ⊆ insert p ((interior A.carrier \ C.carrier) ∩ U) := by
  obtain ⟨rA, hrA, hA⟩ := plAnnulusRouting_disk_inward_chord A hpA
  obtain ⟨rC, hrC, hC⟩ := plAnnulusRouting_disk_outward_chord C hpC
  obtain ⟨rU, hrU, hUball⟩ := Metric.isOpen_iff.mp hU p hpU
  let r := min rA (min rC rU)
  have hr : 0 < r := lt_min hrA (lt_min hrC hrU)
  refine ⟨r, hr, ?_⟩
  intro q hqr hq z hz
  have hqrA : q ∈ Metric.ball p rA := Metric.ball_subset_ball (min_le_left _ _) hqr
  have hqrC : q ∈ Metric.ball p rC :=
    Metric.ball_subset_ball ((min_le_right rA _).trans (min_le_left _ _)) hqr
  have hqrU : q ∈ Metric.ball p rU :=
    Metric.ball_subset_ball ((min_le_right rA _).trans (min_le_right _ _)) hqr
  have hzA := hA q hqrA hq.1 hz
  have hzC := hC q hqrC hq.2 hz
  have hzU := hUball ((convex_ball p rU).segment_subset
    (Metric.mem_ball_self hrU) hqrU hz)
  rcases hzA with hzp | hzA
  · exact Or.inl hzp
  rcases hzC with hzp | hzC
  · exact Or.inl hzp
  exact Or.inr ⟨⟨hzA, hzC⟩, hzU⟩

private structure plAnnulusRouting_step2_plApprox_step2_single_RawData 
    (x y : Tilings.Pt) (U : Set Tilings.Pt) (A C : Tilings.PolygonalDisk) where
  n : ℕ
  pt : Fin (n + 2) → Tilings.Pt
  start_eq : pt 0 = x
  stop_eq : pt (Fin.last (n + 1)) = y
  carr_subset : ∀ i : Fin (n + 1), segment ℝ (pt i.castSucc) (pt i.succ) ⊆ A.carrier \ interior C.carrier
  carr_int_subset : ∀ i : Fin (n + 1), segment ℝ (pt i.castSucc) (pt i.succ) \ {x, y} ⊆ interior A.carrier \ C.carrier
  carr_U_subset : ∀ i : Fin (n + 1), segment ℝ (pt i.castSucc) (pt i.succ) ⊆ U

private lemma plAnnulusRouting_step2_plApprox_step2_single_step1_build
    (A C : Tilings.PolygonalDisk) (x y : Tilings.Pt) (γ : ℝ → Tilings.Pt)
    (hcont : Continuous γ) (hend_x : γ 0 = x) (hend_y : γ 1 = y)
    (hC : C.carrier ⊆ interior A.carrier) (hxy : x ≠ y)
    (U V : Set Tilings.Pt) (hV_open : IsOpen V)
    (hxann : x ∈ A.carrier \ interior C.carrier)
    (hyann : y ∈ A.carrier \ interior C.carrier) (hxU : x ∈ U) (hyU : y ∈ U)
    {a b : ℝ} (hab : a < b)
    (hmid : ∀ t ∈ Set.Icc a b, γ t ∈ V)
    (hV_sub : V ⊆ (interior A.carrier \ C.carrier) ∩ U)
    (hfirst : segment ℝ x (γ a) ⊆ insert x V)
    (hlast : segment ℝ (γ b) y ⊆ insert y V) :
    Nonempty (plAnnulusRouting_step2_plApprox_step2_single_RawData x y U A C) := by
  let K := γ '' Set.Icc a b
  have hK_compact : IsCompact K := isCompact_Icc.image hcont
  have hKV : K ⊆ V := by
    rintro _ ⟨t, ht, rfl⟩
    exact hmid t ht
  obtain ⟨ε, hε, hεV⟩ := hK_compact.exists_thickening_subset_open hV_open hKV
  have huc : UniformContinuousOn γ (Set.Icc a b) :=
    isCompact_Icc.uniformContinuousOn_of_continuous hcont.continuousOn
  obtain ⟨δ, hδ, hclose⟩ := Metric.uniformContinuousOn_iff.mp huc ε hε
  obtain ⟨n, hn⟩ := exists_nat_one_div_lt (div_pos hδ (sub_pos.mpr hab))
  have hnpos : (0 : ℝ) < (n + 1 : ℕ) := by positivity
  have hn' : 1 / ((n + 1 : ℕ) : ℝ) < δ / (b - a) := by
    simpa [Nat.cast_add, Nat.cast_one] using hn
  have hstep : (b - a) / (n + 1 : ℕ) < δ := by
    calc
      (b - a) / (n + 1 : ℕ) = (b - a) * (1 / (n + 1 : ℕ)) := by ring
      _ < (b - a) * (δ / (b - a)) :=
        mul_lt_mul_of_pos_left hn' (sub_pos.mpr hab)
      _ = δ := by field_simp [(sub_pos.mpr hab).ne']
  let τ : Fin (n + 4) → ℝ := fun i =>
    if i.val = 0 then 0
    else if i.val = n + 3 then 1
    else a + (i.val - 1 : ℕ) * ((b - a) / (n + 1 : ℕ))
  let pt : Fin (n + 4) → Tilings.Pt := fun i => γ (τ i)
  have hpt_zero : pt 0 = x := by simp [pt, τ, hend_x]
  have hpt_last : pt (Fin.last (n + 3)) = y := by
    simp [pt, τ, hend_y, Fin.last]
  have hpt_mid (k : ℕ) (hk : k ≤ n + 1) :
      pt ⟨k + 1, by omega⟩ = γ (a + (k : ℝ) * ((b - a) / (n + 1 : ℕ))) := by
    simp only [pt, τ]
    split
    · omega
    split
    · omega
    rfl
  have hmiddle_segment (k : ℕ) (hk : k < n + 1) :
      segment ℝ
        (γ (a + (k : ℝ) * ((b - a) / (n + 1 : ℕ))))
        (γ (a + ((k + 1 : ℕ) : ℝ) * ((b - a) / (n + 1 : ℕ)))) ⊆ V := by
    let s := a + (k : ℝ) * ((b - a) / (n + 1 : ℕ))
    let t := a + ((k + 1 : ℕ) : ℝ) * ((b - a) / (n + 1 : ℕ))
    have hstep_nonneg : 0 ≤ (b - a) / (n + 1 : ℕ) :=
      div_nonneg (sub_pos.mpr hab).le (Nat.cast_nonneg _)
    have hs : s ∈ Set.Icc a b := by
      constructor
      · dsimp [s]
        exact le_add_of_nonneg_right (mul_nonneg (Nat.cast_nonneg k) hstep_nonneg)
      · dsimp [s]
        have hk' : (k : ℝ) ≤ (n + 1 : ℕ) := by exact_mod_cast hk.le
        have hden : (0 : ℝ) < (n + 1 : ℕ) := by positivity
        calc
          a + (k : ℝ) * ((b - a) / (n + 1 : ℕ)) ≤
              a + (n + 1 : ℕ) * ((b - a) / (n + 1 : ℕ)) :=
            by simpa [add_comm] using
              add_le_add_left (mul_le_mul_of_nonneg_right hk' hstep_nonneg) a
          _ = b := by field_simp; ring
    have ht : t ∈ Set.Icc a b := by
      constructor
      · dsimp [t]
        exact le_add_of_nonneg_right
          (mul_nonneg (Nat.cast_nonneg (k + 1)) hstep_nonneg)
      · dsimp [t]
        have hk' : ((k + 1 : ℕ) : ℝ) ≤ (n + 1 : ℕ) := by exact_mod_cast hk
        have hden : (0 : ℝ) < (n + 1 : ℕ) := by positivity
        calc
          a + ((k + 1 : ℕ) : ℝ) * ((b - a) / (n + 1 : ℕ)) ≤
              a + (n + 1 : ℕ) * ((b - a) / (n + 1 : ℕ)) :=
            by simpa [add_comm] using
              add_le_add_left (mul_le_mul_of_nonneg_right hk' hstep_nonneg) a
          _ = b := by field_simp; ring
    have hst : dist s t < δ := by
      rw [Real.dist_eq]
      have heq : t - s = (b - a) / (n + 1 : ℕ) := by
        dsimp [s, t]
        push_cast
        ring
      rw [abs_sub_comm, heq, abs_of_nonneg hstep_nonneg]
      exact hstep
    have hγclose : dist (γ s) (γ t) < ε := hclose s hs t ht hst
    have hball : segment ℝ (γ s) (γ t) ⊆ Metric.ball (γ s) ε :=
      (convex_ball (γ s) ε).segment_subset (Metric.mem_ball_self hε)
        (by simpa [Metric.mem_ball, dist_comm] using hγclose)
    have hγK : γ s ∈ K := ⟨s, hs, rfl⟩
    exact hball.trans ((Metric.ball_subset_thickening hγK ε).trans hεV)
  have hsegment : ∀ i : Fin (n + 3),
      segment ℝ (pt i.castSucc) (pt i.succ) ⊆ insert x (insert y V) := by
    intro i
    by_cases hi0 : i.val = 0
    · have hi : i = 0 := Fin.ext hi0
      subst i
      change segment ℝ (pt (0 : Fin (n + 4))) (pt ⟨1, by omega⟩) ⊆ _
      rw [hpt_zero, hpt_mid 0 (by omega)]
      simp only [Nat.cast_zero, zero_mul, add_zero]
      exact hfirst.trans (insert_subset_insert (subset_insert y V))
    by_cases hilast : i.val = n + 2
    · have hi : i = Fin.last (n + 2) := Fin.ext (by simpa [Fin.last] using hilast)
      subst i
      change segment ℝ (pt ⟨n + 2, by omega⟩) (pt ⟨n + 3, by omega⟩) ⊆ _
      have hmid_last := hpt_mid (n + 1) (by omega)
      have htime_last : a + ((n + 1 : ℕ) : ℝ) * ((b - a) / (n + 1 : ℕ)) = b := by
        field_simp
        ring
      rw [htime_last] at hmid_last
      rw [hmid_last, show pt ⟨n + 3, by omega⟩ = y by simpa [Fin.last] using hpt_last]
      exact hlast.trans (subset_insert x (insert y V))
    · let k := i.val - 1
      have hk : k < n + 1 := by dsimp [k]; omega
      have hi_cast : i.castSucc = (⟨k + 1, by omega⟩ : Fin (n + 4)) := by
        apply Fin.ext
        dsimp [k]
        omega
      have hi_succ : i.succ = (⟨k + 2, by omega⟩ : Fin (n + 4)) := by
        apply Fin.ext
        dsimp [k]
        omega
      rw [hi_cast, hi_succ, hpt_mid k hk.le, hpt_mid (k + 1) (by omega)]
      exact (hmiddle_segment k hk).trans
        ((subset_insert y V).trans (subset_insert x (insert y V)))
  refine ⟨{
    n := n + 2
    pt := pt
    start_eq := by
      by_cases hc : C.carrier ⊆ interior A.carrier
      · exact hpt_zero
      · exact (hc hC).elim
    stop_eq := by
      by_cases heq : x = y
      · exact (hxy heq).elim
      · exact hpt_last
    carr_subset := ?_
    carr_int_subset := ?_
    carr_U_subset := ?_ }⟩
  · intro i z hz
    rcases hsegment i hz with hzx | hzy | hzV
    · simpa [hzx] using hxann
    · simpa [hzy] using hyann
    · exact ⟨interior_subset (hV_sub hzV).1.1, fun hzCi => (hV_sub hzV).1.2 (interior_subset hzCi)⟩
  · intro i z hz
    rcases hsegment i hz.1 with hzx | hzy | hzV
    · exact (hz.2 (Or.inl hzx)).elim
    · exact (hz.2 (Or.inr hzy)).elim
    · exact (hV_sub hzV).1
  · intro i z hz
    rcases hsegment i hz with hzx | hzy | hzV
    · simpa [hzx] using hxU
    · simpa [hzy] using hyU
    · exact (hV_sub hzV).2

/-- Step 1 of the blueprint proof of `plAnnulusRouting_step2_plApprox_step2_single`: Poly path. -/
private lemma plAnnulusRouting_step2_plApprox_step2_single_step1_polyPath (A C : Tilings.PolygonalDisk)
    (hC : C.carrier ⊆ interior A.carrier) (x y : Tilings.Pt)
    (γ : ℝ → Tilings.Pt)
    (hcont : Continuous γ)
    (hend_x : γ 0 = x)
    (hend_y : γ 1 = y)
    (hin : ∀ t ∈ Set.Ioo (0:ℝ) 1, γ t ∈ interior A.carrier \ C.carrier)
    (hsimp : Function.Injective (Set.restrict (Set.Icc (0:ℝ) 1) γ))
    (U : Set Tilings.Pt) (hU_open : IsOpen U) (hU_supset : γ '' Set.Icc (0:ℝ) 1 ⊆ U) :
    Nonempty (plAnnulusRouting_step2_plApprox_step2_single_RawData x y U A C) := by
  have h0cl : (0 : ℝ) ∈ closure (Set.Ioo (0 : ℝ) 1) := by
    rw [closure_Ioo zero_ne_one]
    norm_num
  have h1cl : (1 : ℝ) ∈ closure (Set.Ioo (0 : ℝ) 1) := by
    rw [closure_Ioo zero_ne_one]
    norm_num
  have hxA : x ∈ A.carrier := by
    have h := map_mem_closure hcont h0cl (fun t ht => (hin t ht).1)
    rw [hend_x, A.regular_closed] at h
    exact h
  have hyA : y ∈ A.carrier := by
    have h := map_mem_closure hcont h1cl (fun t ht => (hin t ht).1)
    rw [hend_y, A.regular_closed] at h
    exact h
  have hxC : x ∉ interior C.carrier := by
    have h : γ 0 ∈ closure C.carrierᶜ :=
      map_mem_closure hcont h0cl (fun t ht => (hin t ht).2)
    rw [hend_x, closure_compl] at h
    exact h
  have hyC : y ∉ interior C.carrier := by
    have h : γ 1 ∈ closure C.carrierᶜ :=
      map_mem_closure hcont h1cl (fun t ht => (hin t ht).2)
    rw [hend_y, closure_compl] at h
    exact h
  have hxU : x ∈ U := by
    rw [← hend_x]
    exact hU_supset ⟨0, by norm_num, rfl⟩
  have hyU : y ∈ U := by
    rw [← hend_y]
    exact hU_supset ⟨1, by norm_num, rfl⟩
  let V := (interior A.carrier \ C.carrier) ∩ U
  have hVopen : IsOpen V :=
    (isOpen_interior.inter C.compact.isClosed.isOpen_compl).inter hU_open
  obtain ⟨rx, hrx, hxchord⟩ :=
    plAnnulusRouting_endpoint_chord A C x U hxA hxC hxU hU_open
  obtain ⟨ry, hry, hychord⟩ :=
    plAnnulusRouting_endpoint_chord A C y U hyA hyC hyU hU_open
  have hxpre : γ ⁻¹' Metric.ball x rx ∈ nhds (0 : ℝ) := by
    apply hcont.continuousAt
    rw [hend_x]
    exact Metric.ball_mem_nhds x hrx
  obtain ⟨dx, hdx, hdxpre⟩ := Metric.mem_nhds_iff.mp hxpre
  let a := min (dx / 2) (1 / 4 : ℝ)
  have ha : 0 < a := lt_min (half_pos hdx) (by norm_num)
  have ha14 : a ≤ 1 / 4 := min_le_right _ _
  have hadx : a < dx := lt_of_le_of_lt (min_le_left _ _) (half_lt_self hdx)
  have hγa_ball : γ a ∈ Metric.ball x rx := by
    apply hdxpre
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_pos ha]
    exact hadx
  have ha1 : a < 1 := by linarith
  have hfirst : segment ℝ x (γ a) ⊆ insert x V := by
    exact hxchord (γ a) hγa_ball (hin a ⟨ha, ha1⟩)
  have hypre : γ ⁻¹' Metric.ball y ry ∈ nhds (1 : ℝ) := by
    apply hcont.continuousAt
    rw [hend_y]
    exact Metric.ball_mem_nhds y hry
  obtain ⟨dy, hdy, hdypre⟩ := Metric.mem_nhds_iff.mp hypre
  let e := min (dy / 2) (1 / 4 : ℝ)
  let b := 1 - e
  have he : 0 < e := lt_min (half_pos hdy) (by norm_num)
  have he14 : e ≤ 1 / 4 := min_le_right _ _
  have hedy : e < dy := lt_of_le_of_lt (min_le_left _ _) (half_lt_self hdy)
  have hb : b < 1 := by dsimp [b]; linarith
  have hb0 : 0 < b := by dsimp [b]; linarith
  have hγb_ball : γ b ∈ Metric.ball y ry := by
    apply hdypre
    rw [Metric.mem_ball, Real.dist_eq]
    have : b - 1 = -e := by simp [b]
    rw [this, abs_neg, abs_of_pos he]
    exact hedy
  have hlast : segment ℝ (γ b) y ⊆ insert y V := by
    rw [segment_symm]
    exact hychord (γ b) hγb_ball (hin b ⟨hb0, hb⟩)
  have hab : a < b := by
    dsimp [b]
    linarith
  have hxy :=
    plAnnulusRouting_step2_plApprox_step2_single_x_neq_y x y γ hend_x hend_y hsimp
  apply plAnnulusRouting_step2_plApprox_step2_single_step1_build A C x y γ hcont
    hend_x hend_y hC hxy U V hVopen ⟨hxA, hxC⟩ ⟨hyA, hyC⟩ hxU hyU hab
  · intro t ht
    exact ⟨hin t ⟨ha.trans_le ht.1, ht.2.trans_lt hb⟩, hU_supset ⟨t, ⟨(ha.trans_le ht.1).le,
      (ht.2.trans_lt hb).le⟩, rfl⟩⟩
  · exact fun z hz => hz
  · exact hfirst
  · exact hlast

private def plAnnulusRouting_eraseEdge (x y : Tilings.Pt) (U : Set Tilings.Pt)
    (A C : Tilings.PolygonalDisk) (a b : Tilings.Pt) : Prop :=
  segment ℝ a b ⊆ A.carrier \ interior C.carrier ∧
    segment ℝ a b \ {x, y} ⊆ interior A.carrier \ C.carrier ∧
    segment ℝ a b ⊆ U

private lemma plAnnulusRouting_eraseEdge_subsegment {x y a b c d : Tilings.Pt}
    {U : Set Tilings.Pt} {A C : Tilings.PolygonalDisk}
    (h : plAnnulusRouting_eraseEdge x y U A C a b)
    (hc : c ∈ segment ℝ a b) (hd : d ∈ segment ℝ a b) :
    plAnnulusRouting_eraseEdge x y U A C c d := by
  have hsub : segment ℝ c d ⊆ segment ℝ a b :=
    (convex_segment a b).segment_subset hc hd
  exact ⟨hsub.trans h.1, fun z hz => h.2.1 ⟨hsub hz.1, hz.2⟩, hsub.trans h.2.2⟩

private lemma plAnnulusRouting_eraseEdge_merge {x y a b c z : Tilings.Pt}
    {U : Set Tilings.Pt} {A C : Tilings.PolygonalDisk}
    (hab : plAnnulusRouting_eraseEdge x y U A C a b)
    (hbc : plAnnulusRouting_eraseEdge x y U A C b c)
    (hzab : z ∈ segment ℝ a b) (hzbc : z ∈ segment ℝ b c) (hzb : z ≠ b) :
    plAnnulusRouting_eraseEdge x y U A C a c := by
  have hzba : Wbtw ℝ b z a := mem_segment_iff_wbtw.mp (by simpa [segment_symm] using hzab)
  have hzbc' : Wbtw ℝ b z c := mem_segment_iff_wbtw.mp hzbc
  have hsame : SameRay ℝ (a - b) (c - b) := by
    change SameRay ℝ (a -ᵥ b) (c -ᵥ b)
    apply hzba.sameRay_vsub_left.symm.trans hzbc'.sameRay_vsub_left
    intro hz0
    exact (hzb (vsub_eq_zero_iff_eq.mp hz0)).elim
  rcases wbtw_total_of_sameRay_vsub_left (x := b) (y := a) (z := c) hsame with hac | hca
  · exact plAnnulusRouting_eraseEdge_subsegment hbc hac.mem_segment
      (right_mem_segment ℝ b c)
  · exact plAnnulusRouting_eraseEdge_subsegment hab (left_mem_segment ℝ a b)
      (by simpa [segment_symm] using hca.mem_segment)

private def plAnnulusRouting_eraseValid (x y : Tilings.Pt) (U : Set Tilings.Pt)
    (A C : Tilings.PolygonalDisk) (l : List Tilings.Pt) : Prop :=
  l.head? = some x ∧ l.getLast? = some y ∧
    l.IsChain (plAnnulusRouting_eraseEdge x y U A C)

private def plAnnulusRouting_arcOfList (l : List Tilings.Pt) (hl : 2 ≤ l.length) :
    Tilings.Geometry.PolyArc where
  n := l.length - 2
  pt := fun i => l.get ⟨i.1, by omega⟩

private lemma plAnnulusRouting_arcOfList_injective {l : List Tilings.Pt}
    (hl : 2 ≤ l.length) (hnodup : l.Nodup) :
    Function.Injective (plAnnulusRouting_arcOfList l hl).pt := by
  intro i j hij
  apply Fin.ext
  exact (hnodup.getElem_inj_iff.mp hij)

private lemma plAnnulusRouting_arcOfList_start {l : List Tilings.Pt}
    (hl : 2 ≤ l.length) (hne : l ≠ []) :
    (plAnnulusRouting_arcOfList l hl).start = l.head hne := by
  simp [plAnnulusRouting_arcOfList, PolyArc.start, List.head_eq_getElem_zero]

private lemma plAnnulusRouting_arcOfList_stop {l : List Tilings.Pt}
    (hl : 2 ≤ l.length) (hne : l ≠ []) :
    (plAnnulusRouting_arcOfList l hl).stop = l.getLast hne := by
  change l.get ⟨l.length - 2 + 1, by omega⟩ = l.getLast hne
  have hidx : l.length - 2 + 1 = l.length - 1 := by omega
  simpa [hidx] using (List.get_length_sub_one (l := l) (by omega))

private lemma plAnnulusRouting_eraseValid_two {x y : Tilings.Pt} (hxy : x ≠ y)
    {U : Set Tilings.Pt} {A C : Tilings.PolygonalDisk} {l : List Tilings.Pt}
    (hl : plAnnulusRouting_eraseValid x y U A C l) : 2 ≤ l.length := by
  cases l with
  | nil => simp [plAnnulusRouting_eraseValid] at hl
  | cons a t =>
      cases t with
      | nil =>
          simp [plAnnulusRouting_eraseValid] at hl
          exact (hxy (hl.1.symm.trans hl.2)).elim
      | cons b t => simp

private lemma plAnnulusRouting_eraseValid_last {x y : Tilings.Pt}
    {U : Set Tilings.Pt} {A C : Tilings.PolygonalDisk} {l : List Tilings.Pt}
    (hl : plAnnulusRouting_eraseValid x y U A C l) {i : ℕ}
    (hi : i < l.length) (hilast : i + 1 = l.length) : l[i] = y := by
  have hne : l ≠ [] := by
    rw [List.ne_nil_iff_length_pos]
    omega
  have hlast : l.getLast hne = y := by
    have h := hl.2.1
    rw [List.getLast?_eq_getLast_of_ne_nil hne] at h
    exact Option.some.inj h
  rw [List.getLast_eq_getElem] at hlast
  have heq : i = l.length - 1 := by omega
  simpa [heq] using hlast

private lemma plAnnulusRouting_eraseValid_splice {x y : Tilings.Pt}
    {U : Set Tilings.Pt} {A C : Tilings.PolygonalDisk} {l : List Tilings.Pt}
    (hl : plAnnulusRouting_eraseValid x y U A C l) {i j : ℕ}
    (hi : i < l.length) (hj : j < l.length) (hij : i < j)
    (hbridge : ∀ hj' : j + 1 < l.length,
      plAnnulusRouting_eraseEdge x y U A C l[i] l[j + 1])
    (hlast : j + 1 = l.length → l[i] = y) :
    let l' := l.take (i + 1) ++ l.drop (j + 1)
    plAnnulusRouting_eraseValid x y U A C l' ∧ l'.length < l.length := by
  dsimp
  have htake_ne : l.take (i + 1) ≠ [] := by
    rw [List.ne_nil_iff_length_pos, List.length_take]
    omega
  have hhead : (l.take (i + 1) ++ l.drop (j + 1)).head? = some x := by
    rw [List.head?_append_of_ne_nil _ htake_ne]
    cases l with
    | nil => simp at hi
    | cons a t =>
        simpa using hl.1
  have hchain : (l.take (i + 1) ++ l.drop (j + 1)).IsChain
      (plAnnulusRouting_eraseEdge x y U A C) := by
    apply (hl.2.2.take _).append (hl.2.2.drop _)
    intro a ha b hb
    have ha' : a = l[i] := by
      have ht : (l.take (i + 1)).getLast? = some l[i] := by
        rw [← List.take_concat_get' l i hi]
        rw [List.getLast?_append_of_ne_nil _ (by simp)]
        rfl
      rw [ht] at ha
      have hai : l[i] = a := by simpa using ha
      exact hai.symm
    subst a
    have hsuf : j + 1 < l.length := by
      by_contra h
      have heq : j + 1 = l.length := by omega
      rw [List.drop_eq_nil_of_le (by omega)] at hb
      simp at hb
    have hb' : b = l[j + 1] := by
      have hd : (l.drop (j + 1)).head? = some l[j + 1] := by
        rw [List.drop_eq_getElem_cons hsuf]
        rfl
      rw [hd] at hb
      have hbj : l[j + 1] = b := by simpa using hb
      exact hbj.symm
    subst b
    exact hbridge hsuf
  have hlast' : (l.take (i + 1) ++ l.drop (j + 1)).getLast? = some y := by
    by_cases hsuf : j + 1 < l.length
    · have hsuf_ne : l.drop (j + 1) ≠ [] := by
        rw [List.ne_nil_iff_length_pos, List.length_drop]
        omega
      rw [List.getLast?_append_of_ne_nil _ hsuf_ne]
      calc
        (l.drop (j + 1)).getLast? =
            (l.take (j + 1) ++ l.drop (j + 1)).getLast? := by
          rw [List.getLast?_append_of_ne_nil _ hsuf_ne]
        _ = l.getLast? := congrArg List.getLast? (List.take_append_drop (j + 1) l)
        _ = some y := hl.2.1
    · have heq : j + 1 = l.length := by omega
      rw [List.drop_eq_nil_of_le (by omega), List.append_nil]
      rw [← List.take_concat_get' l i hi]
      simp [hlast heq]
  refine ⟨⟨hhead, hlast', hchain⟩, ?_⟩
  simp only [List.length_append, List.length_take, List.length_drop]
  omega

private lemma plAnnulusRouting_eraseValid_cross_splice {x y z : Tilings.Pt}
    {U : Set Tilings.Pt} {A C : Tilings.PolygonalDisk} {l : List Tilings.Pt}
    (hl : plAnnulusRouting_eraseValid x y U A C l) {i j : ℕ}
    (hi : i + 1 < l.length) (hj : j + 1 < l.length) (hgap : i + 1 < j)
    (hiz : plAnnulusRouting_eraseEdge x y U A C l[i] z)
    (hzj : plAnnulusRouting_eraseEdge x y U A C z l[j + 1]) :
    let l' := l.take (i + 1) ++ [z] ++ l.drop (j + 1)
    plAnnulusRouting_eraseValid x y U A C l' ∧ l'.length < l.length := by
  dsimp
  have htake_ne : l.take (i + 1) ≠ [] := by
    rw [List.ne_nil_iff_length_pos, List.length_take]
    omega
  have hsuf_ne : l.drop (j + 1) ≠ [] := by
    rw [List.ne_nil_iff_length_pos, List.length_drop]
    omega
  have hhead : (l.take (i + 1) ++ [z] ++ l.drop (j + 1)).head? = some x := by
    have hpref_ne : l.take (i + 1) ++ [z] ≠ [] := by simp
    rw [List.head?_append_of_ne_nil _ hpref_ne]
    rw [List.head?_append_of_ne_nil _ htake_ne]
    cases l with
    | nil => simp at hi
    | cons a t => simpa using hl.1
  have hlast : (l.take (i + 1) ++ [z] ++ l.drop (j + 1)).getLast? = some y := by
    rw [List.getLast?_append_of_ne_nil _ hsuf_ne]
    calc
      (l.drop (j + 1)).getLast? =
          (l.take (j + 1) ++ l.drop (j + 1)).getLast? := by
        rw [List.getLast?_append_of_ne_nil _ hsuf_ne]
      _ = l.getLast? := congrArg List.getLast? (List.take_append_drop (j + 1) l)
      _ = some y := hl.2.1
  have hprefix : (l.take (i + 1) ++ [z]).IsChain
      (plAnnulusRouting_eraseEdge x y U A C) := by
    apply (hl.2.2.take _).append (.singleton z)
    intro a ha b hb
    have ha' : a = l[i] := by
      have ht : (l.take (i + 1)).getLast? = some l[i] := by
        rw [← List.take_concat_get' l i (by omega)]
        rw [List.getLast?_append_of_ne_nil _ (by simp)]
        rfl
      rw [ht] at ha
      have hai : l[i] = a := by simpa using ha
      exact hai.symm
    have hb' : b = z := by
      have hzb : z = b := by simpa using hb
      exact hzb.symm
    simpa [ha', hb'] using hiz
  have hchain : (l.take (i + 1) ++ [z] ++ l.drop (j + 1)).IsChain
      (plAnnulusRouting_eraseEdge x y U A C) := by
    apply hprefix.append (hl.2.2.drop _)
    intro a ha b hb
    have ha' : a = z := by
      have hza : z = a := by simpa using ha
      exact hza.symm
    have hb' : b = l[j + 1] := by
      have hd : (l.drop (j + 1)).head? = some l[j + 1] := by
        rw [List.drop_eq_getElem_cons hj]
        rfl
      rw [hd] at hb
      have hbj : l[j + 1] = b := by simpa using hb
      exact hbj.symm
    simpa [ha', hb'] using hzj
  refine ⟨⟨hhead, hlast, hchain⟩, ?_⟩
  simp only [List.length_append, List.length_cons, List.length_nil, List.length_take,
    List.length_drop]
  omega

/-- Step 2 of the blueprint proof of `plAnnulusRouting_step2_plApprox_step2_single`: Loop erasure. -/
private lemma plAnnulusRouting_step2_plApprox_step2_single_step2_eraseLoops 
    (x y : Tilings.Pt) (hxy : x ≠ y)
    (U : Set Tilings.Pt) (A C : Tilings.PolygonalDisk)
    (rd : plAnnulusRouting_step2_plApprox_step2_single_RawData x y U A C) :
    ∃ α : Tilings.Geometry.PolyArc,
      α.IsSimple ∧ α.start = x ∧ α.stop = y ∧
      α.carrier ⊆ A.carrier \ interior C.carrier ∧
      α.carrier \ {x, y} ⊆ interior A.carrier \ C.carrier ∧
      α.carrier ⊆ U := by
  classical
  let l₀ : List Tilings.Pt := List.ofFn rd.pt
  have hl₀ : plAnnulusRouting_eraseValid x y U A C l₀ := by
    have hhead : l₀.head? = some x := by
      simp [l₀, rd.start_eq]
    have hlast : l₀.getLast? = some y := by
      have hne : l₀ ≠ [] := by simp [l₀]
      rw [List.getLast?_eq_getLast_of_ne_nil hne, List.getLast_eq_getElem]
      simp only [l₀, List.length_ofFn, List.getElem_ofFn]
      simpa using congrArg some rd.stop_eq
    refine ⟨hhead, hlast, ?_⟩
    rw [List.isChain_ofFn]
    intro i hi
    let j : Fin (rd.n + 1) := ⟨i, by omega⟩
    change plAnnulusRouting_eraseEdge x y U A C
      (rd.pt j.castSucc) (rd.pt j.succ)
    exact ⟨rd.carr_subset j, rd.carr_int_subset j, rd.carr_U_subset j⟩
  have hex : ∃ k : ℕ, ∃ l : List Tilings.Pt,
      plAnnulusRouting_eraseValid x y U A C l ∧ l.length = k :=
    ⟨l₀.length, l₀, hl₀, rfl⟩
  let k := Nat.find hex
  obtain ⟨l, hl, hlen⟩ := Nat.find_spec hex
  have hmin : ∀ {l' : List Tilings.Pt},
      plAnnulusRouting_eraseValid x y U A C l' → l.length ≤ l'.length := by
    intro l' hl'
    rw [hlen]
    exact Nat.find_min' hex ⟨l', hl', rfl⟩
  have htwo : 2 ≤ l.length := plAnnulusRouting_eraseValid_two hxy hl
  have hedge : ∀ (i : ℕ) (hi : i + 1 < l.length),
      plAnnulusRouting_eraseEdge x y U A C l[i] l[i + 1] := by
    intro i hi
    exact List.isChain_iff_getElem.mp hl.2.2 i hi
  have hnodup : l.Nodup := by
    rw [List.nodup_iff_injective_get]
    intro p q hpq
    have hpq' : l[p.1] = l[q.1] := hpq
    by_contra hpq_fin
    rcases lt_or_gt_of_ne (fun hval => hpq_fin (Fin.ext hval)) with hpq_lt | hqp_lt
    · have hshort := plAnnulusRouting_eraseValid_splice hl p.isLt q.isLt hpq_lt
        (fun hq => by
          rw [hpq']
          exact hedge q.1 hq)
        (fun hq => hpq.trans (plAnnulusRouting_eraseValid_last hl q.isLt hq))
      exact (not_lt_of_ge (hmin hshort.1)) hshort.2
    · have hshort := plAnnulusRouting_eraseValid_splice hl q.isLt p.isLt hqp_lt
        (fun hp => by
          rw [← hpq']
          exact hedge p.1 hp)
        (fun hp => hpq.symm.trans (plAnnulusRouting_eraseValid_last hl p.isLt hp))
      exact (not_lt_of_ge (hmin hshort.1)) hshort.2
  have hadj : ∀ (i : ℕ) (hi : i + 2 < l.length) (z : Tilings.Pt),
      z ∈ segment ℝ l[i] l[i + 1] → z ∈ segment ℝ l[i + 1] l[i + 2] →
      z = l[i + 1] := by
    intro i hi z hzi hzj
    by_contra hzne
    have hmerge : plAnnulusRouting_eraseEdge x y U A C l[i] l[i + 2] :=
      plAnnulusRouting_eraseEdge_merge (hedge i (by omega))
        (hedge (i + 1) (by omega)) hzi hzj hzne
    have hshort := plAnnulusRouting_eraseValid_splice hl (by omega : i < l.length)
      (by omega : i + 1 < l.length) (by omega : i < i + 1)
      (fun _ => by simpa [Nat.add_assoc] using hmerge) (fun h => by omega)
    exact (not_lt_of_ge (hmin hshort.1)) hshort.2
  have hfar : ∀ (i j : ℕ) (hi : i + 1 < l.length) (hj : j + 1 < l.length),
      i + 1 < j → Disjoint (segment ℝ l[i] l[i + 1]) (segment ℝ l[j] l[j + 1]) := by
    intro i j hi hj hgap
    rw [Set.disjoint_left]
    intro z hzi hzj
    have hiz := plAnnulusRouting_eraseEdge_subsegment (hedge i hi)
      (left_mem_segment ℝ l[i] l[i + 1]) hzi
    have hzj' := plAnnulusRouting_eraseEdge_subsegment (hedge j hj) hzj
      (right_mem_segment ℝ l[j] l[j + 1])
    have hshort := plAnnulusRouting_eraseValid_cross_splice hl hi hj hgap hiz hzj'
    exact (not_lt_of_ge (hmin hshort.1)) hshort.2
  have hsimple_list : ∀ (i j : ℕ) (hi : i + 1 < l.length)
      (hj : j + 1 < l.length), i ≠ j →
      segment ℝ l[i] l[i + 1] ∩ segment ℝ l[j] l[j + 1] ⊆
        ({l[i], l[i + 1]} : Set Tilings.Pt) ∩ {l[j], l[j + 1]} := by
    intro i j hi hj hij z hz
    rcases lt_or_gt_of_ne hij with hij' | hji'
    · by_cases hnext : j = i + 1
      · subst j
        have hz' := hadj i (by omega) z hz.1 hz.2
        simp [hz']
      · exact (Set.disjoint_left.mp (hfar i j hi hj (by omega)) hz.1 hz.2).elim
    · by_cases hnext : i = j + 1
      · subst i
        have hz' := hadj j (by omega) z hz.2 hz.1
        simp [hz']
      · exact (Set.disjoint_left.mp (hfar j i hj hi (by omega)) hz.2 hz.1).elim
  have hl_ne : l ≠ [] := by
    rw [List.ne_nil_iff_length_pos]
    omega
  have hl_head : l.head hl_ne = x := by
    have hh := hl.1
    rw [List.head?_eq_some_head hl_ne] at hh
    exact Option.some.inj hh
  have hl_last : l.getLast hl_ne = y := by
    have hh := hl.2.1
    rw [List.getLast?_eq_getLast_of_ne_nil hl_ne] at hh
    exact Option.some.inj hh
  let α := plAnnulusRouting_arcOfList l htwo
  refine ⟨α, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · constructor
    · exact plAnnulusRouting_arcOfList_injective htwo hnodup
    · intro i j hij
      have hi : i.1 + 1 < l.length := by
        have := i.isLt
        dsimp [α, plAnnulusRouting_arcOfList] at this
        omega
      have hj : j.1 + 1 < l.length := by
        have := j.isLt
        dsimp [α, plAnnulusRouting_arcOfList] at this
        omega
      have hij' : i.1 ≠ j.1 := fun h => hij (Fin.ext h)
      simpa [α, PolyArc.seg, plAnnulusRouting_arcOfList] using
        hsimple_list i.1 j.1 hi hj hij'
  · exact (plAnnulusRouting_arcOfList_start htwo hl_ne).trans hl_head
  · exact (plAnnulusRouting_arcOfList_stop htwo hl_ne).trans hl_last
  · intro z hz
    rw [PolyArc.carrier] at hz
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
    have hil : i.1 + 1 < l.length := by
      have := i.isLt
      dsimp [α, plAnnulusRouting_arcOfList] at this
      omega
    exact (hedge i.1 hil).1 (by
      simpa [α, PolyArc.seg, plAnnulusRouting_arcOfList] using hi)
  · intro z hz
    rw [PolyArc.carrier] at hz
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz.1
    have hil : i.1 + 1 < l.length := by
      have := i.isLt
      dsimp [α, plAnnulusRouting_arcOfList] at this
      omega
    apply (hedge i.1 hil).2.1
    exact ⟨by simpa [α, PolyArc.seg, plAnnulusRouting_arcOfList] using hi, hz.2⟩
  · intro z hz
    rw [PolyArc.carrier] at hz
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
    have hil : i.1 + 1 < l.length := by
      have := i.isLt
      dsimp [α, plAnnulusRouting_arcOfList] at this
      omega
    exact (hedge i.1 hil).2.2 (by
      simpa [α, PolyArc.seg, plAnnulusRouting_arcOfList] using hi)

/-- Step 2 of the blueprint proof of `plAnnulusRouting_step2_plApprox`: Single arc approximation.
A single continuous arc disjoint from C can be PL-approximated within its neighborhood. -/
private lemma plAnnulusRouting_step2_plApprox_step2_single (A C : Tilings.PolygonalDisk)
    (hC : C.carrier ⊆ interior A.carrier) (x y : Tilings.Pt)
    (γ : ℝ → Tilings.Pt)
    (hcont : Continuous γ)
    (hend_x : γ 0 = x)
    (hend_y : γ 1 = y)
    (hin : ∀ t ∈ Set.Ioo (0:ℝ) 1, γ t ∈ interior A.carrier \ C.carrier)
    (hsimp : Function.Injective (Set.restrict (Set.Icc (0:ℝ) 1) γ))
    (U : Set Tilings.Pt) (hU_open : IsOpen U) (hU_supset : γ '' Set.Icc (0:ℝ) 1 ⊆ U) :
    ∃ α : Tilings.Geometry.PolyArc,
      α.IsSimple ∧ α.start = x ∧ α.stop = y ∧
      α.carrier ⊆ A.carrier \ interior C.carrier ∧
      α.carrier \ {x, y} ⊆ interior A.carrier \ C.carrier ∧
      α.carrier ⊆ U := by
  have hxy := plAnnulusRouting_step2_plApprox_step2_single_x_neq_y x y γ hend_x hend_y hsimp
  have h_rd := plAnnulusRouting_step2_plApprox_step2_single_step1_polyPath A C hC x y γ hcont hend_x hend_y hin hsimp U hU_open hU_supset
  obtain ⟨rd⟩ := h_rd
  exact plAnnulusRouting_step2_plApprox_step2_single_step2_eraseLoops x y hxy U A C rd

/-- Step 2 of the blueprint proof of `plAnnulusRouting`: PL approximation.
Any family of pairwise disjoint, simple continuous arcs in a polygonal domain
connecting boundary points can be approximated by pairwise disjoint simple polygonal arcs. -/
private lemma plAnnulusRouting_step2_plApprox (A C : PolygonalDisk)
    (hC : C.carrier ⊆ interior A.carrier) {k : ℕ} (x y : Fin k → Pt)
    (γ : Fin k → ℝ → Pt)
    (hcont : ∀ i, Continuous (γ i))
    (hend_x : ∀ i, γ i 0 = x i)
    (hend_y : ∀ i, γ i 1 = y i)
    (hin : ∀ i, ∀ t ∈ Set.Ioo (0:ℝ) 1, γ i t ∈ interior A.carrier \ C.carrier)
    (hsimp : ∀ i, Function.Injective (Set.restrict (Set.Icc (0:ℝ) 1) (γ i)))
    (hdisj : ∀ i j, i ≠ j → Disjoint (γ i '' Set.Icc (0:ℝ) 1) (γ j '' Set.Icc (0:ℝ) 1)) :
    ∃ α : Fin k → PolyArc, ∀ i,
      (α i).IsSimple ∧ (α i).start = x i ∧ (α i).stop = y i ∧
      (α i).carrier ⊆ A.carrier \ interior C.carrier ∧
      (α i).carrier \ {x i, y i} ⊆ interior A.carrier \ C.carrier ∧
      ∀ j, j ≠ i → Disjoint (α i).carrier (α j).carrier := by
  obtain ⟨U, hU_open, hU_supset, hU_disj⟩ :=
    plAnnulusRouting_step2_plApprox_step1_separation γ hcont hdisj
  have h_ex : ∀ i, ∃ α : PolyArc,
      (α).IsSimple ∧ (α).start = x i ∧ (α).stop = y i ∧
      (α).carrier ⊆ A.carrier \ interior C.carrier ∧
      (α).carrier \ {x i, y i} ⊆ interior A.carrier \ C.carrier ∧
      (α).carrier ⊆ U i := by
    intro i
    exact plAnnulusRouting_step2_plApprox_step2_single A C hC (x i) (y i) (γ i)
      (hcont i) (hend_x i) (hend_y i) (hin i) (hsimp i) (U i) (hU_open i) (hU_supset i)
  choose α hα using h_ex
  use α
  intro i
  obtain ⟨hsimp_i, hstart_i, hstop_i, hcarr_i, hcarr_int_i, hU_i⟩ := hα i
  refine ⟨hsimp_i, hstart_i, hstop_i, hcarr_i, hcarr_int_i, ?_⟩
  intro j hneq
  have hU_disj_ij := hU_disj i j hneq.symm
  exact hU_disj_ij.mono hU_i (hα j).2.2.2.2.2

/-- **PL annulus routing** (classical helper; must be proved, never assumed).
In the polygonal annulus `A \ int C`, distinct outer points and distinct inner
points in matching cyclic order are joined by pairwise disjoint simple
polygonal arcs meeting the boundary only at their endpoints. -/
theorem plAnnulusRouting (A C : PolygonalDisk) (hC : C.carrier ⊆ interior A.carrier)
    {k : ℕ} (x y : Fin k → Pt) (hx : ∀ i, x i ∈ frontier A.carrier)
    (hy : ∀ i, y i ∈ frontier C.carrier) (hxi : Function.Injective x)
    (hyi : Function.Injective y)
    (horder : MatchingCyclicOrder (A.carrier \ interior C.carrier) (frontier A.carrier)
      (frontier C.carrier) x y) :
    ∃ α : Fin k → PolyArc, ∀ i,
      (α i).IsSimple ∧ (α i).start = x i ∧ (α i).stop = y i ∧
      (α i).carrier ⊆ A.carrier \ interior C.carrier ∧
      (α i).carrier \ {x i, y i} ⊆ interior A.carrier \ C.carrier ∧
      ∀ j, j ≠ i → Disjoint (α i).carrier (α j).carrier := by
  obtain ⟨γ, hcont, hend_x, hend_y, hin, hsimp, hdisj⟩ :=
    plAnnulusRouting_step1_topological A C hC x y hx hy hxi hyi horder
  exact plAnnulusRouting_step2_plApprox A C hC x y γ hcont hend_x hend_y hin hsimp hdisj

/-! ## Inside- and outside-anchored groupings -/

/-! ### Helpers for `regularGrouping` -/

private lemma rg_coord_sub_le (x y : Pt) (i : Fin 2) : |x i - y i| ≤ dist x y := by
  have := PiLp.norm_apply_le (x - y) i
  rw [Real.norm_eq_abs, PiLp.sub_apply] at this
  rwa [dist_eq_norm]

private lemma rg_mkPt0 (x y : ℝ) : mkPt x y 0 = x := by simp [mkPt]

private lemma rg_mkPt1 (x y : ℝ) : mkPt x y 1 = y := by simp [mkPt]

private lemma rg_square_mono {c : Pt} {h h' : ℝ} (hh : h ≤ h') : square c h ⊆ square c h' :=
  fun _ hx => ⟨hx.1.trans hh, hx.2.trans hh⟩

private lemma rg_binf_mono {r s : ℝ} (h : r ≤ s) : Binf r ⊆ Binf s :=
  fun _ hx => ⟨hx.1.trans h, hx.2.trans h⟩

private lemma rg_clamp {a h r : ℝ} (hh : 0 ≤ h) (hr : 0 ≤ r) (ha : |a| ≤ h + r) :
    |max (-h) (min h a)| ≤ h ∧ |a - max (-h) (min h a)| ≤ r := by
  rw [abs_le] at ha
  rw [abs_le, abs_le]
  refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> simp only [min_def, max_def] <;> split_ifs <;> linarith

private lemma rg_square_add {c : Pt} {h r : ℝ} (hh : 0 ≤ h) (hr : 0 ≤ r) :
    square c (h + r) ⊆ square c h + Binf r := by
  intro x hx
  obtain ⟨h0, h0'⟩ := rg_clamp hh hr hx.1
  obtain ⟨h1, h1'⟩ := rg_clamp hh hr hx.2
  refine Set.mem_add.2 ⟨mkPt (c 0 + max (-h) (min h (x 0 - c 0))) (c 1 + max (-h) (min h (x 1 - c 1))),
    ?_, x - mkPt (c 0 + max (-h) (min h (x 0 - c 0))) (c 1 + max (-h) (min h (x 1 - c 1))), ?_, by abel⟩
  · refine ⟨?_, ?_⟩ <;> simp only [rg_mkPt0, rg_mkPt1, add_sub_cancel_left] <;> assumption
  · refine ⟨?_, ?_⟩ <;> simp only [PiLp.sub_apply, rg_mkPt0, rg_mkPt1]
    · rw [show x 0 - (c 0 + max (-h) (min h (x 0 - c 0))) = (x 0 - c 0) - max (-h) (min h (x 0 - c 0)) by ring]
      exact h0'
    · rw [show x 1 - (c 1 + max (-h) (min h (x 1 - c 1))) = (x 1 - c 1) - max (-h) (min h (x 1 - c 1)) by ring]
      exact h1'

private lemma rg_ball_subset_square (c : Pt) (h : ℝ) : Metric.ball c h ⊆ square c h := by
  intro x hx
  rw [Metric.mem_ball] at hx
  exact ⟨(rg_coord_sub_le x c 0).trans hx.le, (rg_coord_sub_le x c 1).trans hx.le⟩

private lemma rg_center_mem_interior {c : Pt} {h : ℝ} (hh : 0 < h) : c ∈ interior (square c h) :=
  interior_mono (rg_ball_subset_square c h) (by rw [Metric.isOpen_ball.interior_eq]; exact Metric.mem_ball_self hh)

private lemma rg_square_convex (c : Pt) (h : ℝ) : Convex ℝ (square c h) := by
  intro x hx y hy a b ha hb hab
  have key : ∀ i : Fin 2, |x i - c i| ≤ h → |y i - c i| ≤ h → |(a • x + b • y) i - c i| ≤ h := by
    intro i hxi hyi
    have e : (a • x + b • y) i - c i = a * (x i - c i) + b * (y i - c i) := by
      simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      linear_combination (c i) * hab
    rw [e]
    calc |a * (x i - c i) + b * (y i - c i)| ≤ |a * (x i - c i)| + |b * (y i - c i)| := abs_add_le _ _
      _ = a * |x i - c i| + b * |y i - c i| := by rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
      _ ≤ a * h + b * h := by gcongr
      _ = h := by linear_combination h * hab
  exact ⟨key 0 hx.1 hy.1, key 1 hx.2 hy.2⟩

private lemma rg_square_closed (c : Pt) (h : ℝ) : IsClosed (square c h) := by
  have h0 : Continuous fun x : Pt => x 0 := PiLp.continuous_apply 2 _ 0
  have h1 : Continuous fun x : Pt => x 1 := PiLp.continuous_apply 2 _ 1
  exact (isClosed_le ((h0.sub continuous_const).abs) continuous_const).inter
    (isClosed_le ((h1.sub continuous_const).abs) continuous_const)

private lemma rg_square_subset_closure_interior {c : Pt} {h : ℝ} (hh : 0 < h) :
    square c h ⊆ closure (interior (square c h)) := by
  rw [(rg_square_convex c h).closure_interior_eq_closure_of_nonempty_interior
    ⟨c, rg_center_mem_interior hh⟩, (rg_square_closed c h).closure_eq]

private lemma rg_seg_coord {a b z : Pt} (hz : z ∈ segment ℝ a b) {i : Fin 2} (hab : a i = b i) :
    z i = a i := by
  obtain ⟨t, -, -, rfl⟩ := mem_segment_iff'.1 hz
  simp [hab]

private lemma rg_far_mem {O : Set Pt} {c : Pt} {R : ℝ} (hR : 0 ≤ R) (hO : (square c R)ᶜ ⊆ O) {x : Pt}
    (hx : x ∉ square c R) : x ∈ connectedComponentIn O (mkPt (c 0 + (R + 1)) (c 1 + (R + 1))) := by
  set p := mkPt (c 0 + (R + 1)) (c 1 + (R + 1)) with hp
  suffices hT : ∃ T : Set Pt, IsPreconnected T ∧ x ∈ T ∧ p ∈ T ∧ T ⊆ (square c R)ᶜ by
    obtain ⟨T, hT, hxT, hpT, hTs⟩ := hT
    have h1 := hT.subset_connectedComponentIn hxT (hTs.trans hO) hpT
    rw [← connectedComponentIn_eq h1]
    exact mem_connectedComponentIn (hO hx)
  have hR1 : R < |R + 1| := by rw [abs_of_pos (by linarith)]; linarith
  simp only [square, Set.mem_setOf_eq, not_and_or, not_le] at hx
  rcases hx with hx | hx
  · set x' := mkPt (x 0) (c 1 + (R + 1))
    refine ⟨segment ℝ x x' ∪ segment ℝ x' p, (convex_segment _ _).isPreconnected.union x'
      (right_mem_segment ℝ _ _) (left_mem_segment ℝ _ _) (convex_segment _ _).isPreconnected,
      Or.inl (left_mem_segment ℝ _ _), Or.inr (right_mem_segment ℝ _ _), ?_⟩
    rintro z (hz | hz) hzs
    · have := rg_seg_coord hz (i := 0) (by simp [x', rg_mkPt0])
      exact absurd hzs.1 (by rw [this]; exact not_le.2 hx)
    · have := rg_seg_coord hz (i := 1) (by simp [x', p, rg_mkPt1])
      exact absurd hzs.2 (by rw [this]; simp only [x', rg_mkPt1, add_sub_cancel_left]; exact not_le.2 hR1)
  · set x' := mkPt (c 0 + (R + 1)) (x 1)
    refine ⟨segment ℝ x x' ∪ segment ℝ x' p, (convex_segment _ _).isPreconnected.union x'
      (right_mem_segment ℝ _ _) (left_mem_segment ℝ _ _) (convex_segment _ _).isPreconnected,
      Or.inl (left_mem_segment ℝ _ _), Or.inr (right_mem_segment ℝ _ _), ?_⟩
    rintro z (hz | hz) hzs
    · have := rg_seg_coord hz (i := 1) (by simp [x', rg_mkPt1])
      exact absurd hzs.2 (by rw [this]; exact not_le.2 hx)
    · have := rg_seg_coord hz (i := 0) (by simp [x', p, rg_mkPt0])
      exact absurd hzs.1 (by rw [this]; simp only [x', rg_mkPt0, add_sub_cancel_left]; exact not_le.2 hR1)

private lemma rg_tile_coord (M : MeshConstants P) (A : PlacedTile P) {x y : Pt} (hx : x ∈ A.carrier)
    (hy : y ∈ A.carrier) (i : Fin 2) : |x i - y i| ≤ M.D := by
  refine (rg_coord_sub_le x y i).trans ((Metric.dist_le_diam_of_mem (tileDisk A).compact.isBounded hx hy).trans ?_)
  have : Metric.diam A.carrier = Metric.diam (P.disk A.form).carrier := by
    rw [PlacedTile.carrier]; exact diam_vadd _ _
  show Metric.diam A.carrier ≤ M.D
  rw [this]; exact M.diam_le _

private lemma rg_halfplane_convex (σ : ℝ) (d a : Pt) : Convex ℝ {x : Pt | σ * jcr d (x - a) < 0} := by
  intro x hx y hy s t hs ht hst
  obtain rfl : t = 1 - s := by linarith
  simp only [Set.mem_setOf_eq] at hx hy ⊢
  have e : σ * jcr d (s • x + (1 - s) • y - a) = s * (σ * jcr d (x - a)) + (1 - s) * (σ * jcr d (y - a)) := by
    simp only [jcr, PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]; ring
  rw [e]
  rcases hs.lt_or_eq with hs' | hs'
  · nlinarith
  · subst hs'; simp only [zero_mul, zero_add, sub_zero, one_mul]; exact hy

/-- `JSetup.bedge_sides`, also recording the closed half-disk inside the face -/
private lemma rg_bedge_sides {S G : Set (PlacedTile P)} (H : JSetup S G) {A : PlacedTile P}
    (hA : A ∈ G) (i : Fin (P.disk A.form).n)
    (hbe : ∀ A' ∈ G, A' ≠ A → ¬ HasEdge A' (A.side i)) {q : Pt}
    (hq : q ∈ openSegment ℝ (A.vertex i) (A.vertex (finRotate _ i))) :
    ∃ r > 0, ∃ σ : ℝ, ∀ x ∈ Metric.ball q r,
      (σ * jcr (A.vertex (finRotate _ i) - A.vertex i) (x - A.vertex i) < 0 → x ∉ support G) ∧
      (0 ≤ σ * jcr (A.vertex (finRotate _ i) - A.vertex i) (x - A.vertex i) → x ∈ A.carrier) := by
  classical
  obtain ⟨r, hr, σ, -, hch⟩ := tile_halfdisk A i hq
  set K' := ⋃ A' ∈ G \ {A}, A'.carrier with hK'
  have hK'c : IsClosed K' := (H.fin.diff).isClosed_biUnion (fun D _ => tile_isClosed D)
  have hqK' : q ∉ K' := by
    intro h
    simp only [hK', Set.mem_iUnion] at h
    obtain ⟨A', ⟨hA'G, hA'A⟩, hqA'⟩ := h
    have hne : A ≠ A' := fun h => hA'A (h ▸ rfl)
    obtain ⟨j, hj⟩ := H.partner hA (H.sub hA'G) hne i hq hqA'
    exact hbe A' hA'G (Ne.symm hne) ⟨j, hj⟩
  obtain ⟨ρ, hρ, hρK⟩ := Metric.isOpen_iff.1 hK'c.isOpen_compl q hqK'
  refine ⟨min r ρ, lt_min hr hρ, σ, fun x hx => ⟨fun h => ?_, fun h => ?_⟩⟩
  · intro hxG
    obtain ⟨A', hA'G, hxA'⟩ := mem_support_iff'.1 hxG
    by_cases hAA : A' = A
    · subst hAA
      have := ((hch x (Metric.ball_subset_ball (min_le_left _ _) hx)).2.1).1 hxA'
      linarith
    · apply hρK (Metric.ball_subset_ball (min_le_right _ _) hx)
      simp only [hK', Set.mem_iUnion]
      exact ⟨A', ⟨hA'G, hAA⟩, hxA'⟩
  · exact ((hch x (Metric.ball_subset_ball (min_le_left _ _) hx)).2.1).2 h

/-- `lem:regular-grouping`: a finite STS patch of mesh `D` covering `Ω`, and a
square `Q` with `Q + B∞(3D) ⊂ int Ω`.  There is a group `L` of complete faces,
a polygonal disk with connected face-dual graph, with
`Q ⊂ L ⊂ Q + B∞(D)`, inside-anchored at `Q`. -/
theorem regularGrouping (M : MeshConstants P) (S : Patch P) (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h) (hQ : square c h + Binf (3 * M.D) ⊆ interior Ω.carrier) :
    ∃ L : FaceGroup S.tiles, square c h ⊆ L.carrier ∧ L.carrier ⊆ square c h + Binf M.D ∧
      L.InsideAnchored (square c h) := by
  classical
  have hD := M.D_pos
  have hdisj := S.disjoint
  set Q := square c h with hQdef
  set R := h + M.D with hRdef
  set Q' := square c R with hQ'def
  set U₀ : Set (PlacedTile P) := {A ∈ S.tiles | (interior A.carrier ∩ interior Q).Nonempty} with hU₀
  set U := support U₀ with hUdef
  set O := Uᶜ with hOdef
  set p := mkPt (c 0 + (R + 1)) (c 1 + (R + 1)) with hpdef
  set W := connectedComponentIn O p with hWdef
  set G : Set (PlacedTile P) := {A ∈ S.tiles | ¬ interior A.carrier ⊆ W} with hGdef
  have hU₀S : U₀ ⊆ S.tiles := fun A hA => hA.1
  have hU₀fin : U₀.Finite := S.finite.subset hU₀S
  have hUc : IsClosed U := support_isClosed hU₀fin
  have hOo : IsOpen O := hUc.isOpen_compl
  -- the faces meeting the open square stay in the buffer `Q'`
  have hUQ' : U ⊆ Q' := by
    intro x hx
    obtain ⟨A, hA, hxA⟩ := mem_support_iff'.1 hx
    obtain ⟨w, hwA, hwQ⟩ := hA.2
    have hwQ' : w ∈ Q := interior_subset hwQ
    have h0 := rg_tile_coord M A hxA (interior_subset hwA) 0
    have h1 := rg_tile_coord M A hxA (interior_subset hwA) 1
    refine ⟨?_, ?_⟩
    · calc |x 0 - c 0| = |(x 0 - w 0) + (w 0 - c 0)| := by ring_nf
        _ ≤ |x 0 - w 0| + |w 0 - c 0| := abs_add_le _ _
        _ ≤ R := by linarith [hwQ'.1]
    · calc |x 1 - c 1| = |(x 1 - w 1) + (w 1 - c 1)| := by ring_nf
        _ ≤ |x 1 - w 1| + |w 1 - c 1| := abs_add_le _ _
        _ ≤ R := by linarith [hwQ'.2]
  have hQ'B : Q' ⊆ Q + Binf M.D := rg_square_add hh.le hD.le
  have hQ'Ω : Q' ⊆ interior (support S.tiles) := by
    rw [hcov]
    exact hQ'B.trans ((Set.add_subset_add_left (rg_binf_mono (by linarith))).trans hQ)
  have hQQ' : Q ⊆ Q' := rg_square_mono (by linarith)
  have hfar : ∀ x, x ∉ Q' → x ∈ W := fun x hx =>
    rg_far_mem (by linarith) (fun y hy hyU => hy (hUQ' hyU)) hx
  have hWc : Wᶜ ⊆ Q' := fun x hx => by_contra fun h' => hx (hfar x h')
  have hpO : p ∈ O := by
    intro hpU
    have := (hUQ' hpU).2
    rw [hpdef, rg_mkPt1, add_sub_cancel_left, abs_of_pos (by linarith)] at this
    linarith
  have hWO : W ⊆ O := connectedComponentIn_subset _ _
  have hWo : IsOpen W := hOo.connectedComponentIn
  have hUW : U ⊆ Wᶜ := fun x hx hxW => hWO hxW hx
  -- frontiers of complementary components lie in `U`
  have hfrU : ∀ y, frontier (connectedComponentIn O y) ⊆ U := by
    intro y z hz
    by_contra hzU
    have hzo : IsOpen (connectedComponentIn O z) := hOo.connectedComponentIn
    have hzz : z ∈ connectedComponentIn O z := mem_connectedComponentIn hzU
    obtain ⟨x, hx1, hx2⟩ := mem_closure_iff.1 (frontier_subset_closure hz) _ hzo hzz
    have : z ∈ connectedComponentIn O y := by
      rw [connectedComponentIn_eq hx2, ← connectedComponentIn_eq hx1]; exact hzz
    exact hz.2 (by rw [hOo.connectedComponentIn.interior_eq]; exact this)
  have hdisjW : ∀ y ∈ O, y ∉ W → Disjoint (connectedComponentIn O y) W := by
    intro y hyO hyW
    rw [Set.disjoint_left]
    intro w hw1 hw2
    apply hyW
    rw [hWdef, connectedComponentIn_eq hw2, ← connectedComponentIn_eq hw1]
    exact mem_connectedComponentIn hyO
  -- the closed square is covered by the selected faces
  have hQU : Q ⊆ U := by
    have hint : interior Q ⊆ U := by
      intro y hy
      obtain ⟨A, hA, hyA⟩ :=
        mem_support_iff'.1 (interior_subset (hQ'Ω (hQQ' (interior_subset hy))))
      have hyA' : y ∈ closure (interior A.carrier) := by rw [tile_regular]; exact hyA
      obtain ⟨w, hw1, hw2⟩ := mem_closure_iff.1 hyA' _ isOpen_interior hy
      exact carrier_subset_support (show A ∈ U₀ from ⟨hA, w, hw2, hw1⟩) hyA
    exact (rg_square_subset_closure_interior hh).trans (closure_minimal hint hUc)
  have hcQ : c ∈ interior Q := rg_center_mem_interior hh
  have hU₀ne : U₀.Nonempty := by
    obtain ⟨A, hA, -⟩ := mem_support_iff'.1 (hQU (interior_subset hcQ))
    exact ⟨A, hA⟩
  have H0 : JSetup S.tiles U₀ := ⟨hdisj, hsts, hU₀S, hU₀fin, hUQ'.trans hQ'Ω⟩
  have hU₀G : U₀ ⊆ G := by
    intro A hA
    refine ⟨hA.1, fun hsub => ?_⟩
    obtain ⟨a, ha⟩ := (tileDisk A).interior_nonempty
    exact hUW (carrier_subset_support hA (interior_subset ha)) (hsub ha)
  -- the filled region is the complement of the outer component
  have hGW : support G = Wᶜ := by
    ext x
    constructor
    · intro hx hxW
      obtain ⟨A, hA, hxA⟩ := mem_support_iff'.1 hx
      apply hA.2
      have hxA' : x ∈ closure (interior A.carrier) := by rw [tile_regular]; exact hxA
      obtain ⟨w, hwW, hwA⟩ := mem_closure_iff.1 hxA' W hWo hxW
      by_cases hAU : A ∈ U₀
      · exact absurd (carrier_subset_support hAU (interior_subset hwA)) (hWO hwW)
      · have hAO : interior A.carrier ⊆ O := by
          intro v hv hvU
          obtain ⟨B, hB, hvB⟩ := mem_support_iff'.1 hvU
          exact interior_not_mem_other hdisj hA.1 hB.1 (fun h' => hAU (h' ▸ hB)) hv hvB
        have := (tileDisk A).interior_pathConnected.isConnected.isPreconnected.subset_connectedComponentIn
          hwA hAO
        rw [← connectedComponentIn_eq hwW] at this
        exact this
    · intro hx
      by_cases hxc : x ∈ closure W
      · have hxf : x ∈ frontier W := ⟨hxc, by rw [hWo.interior_eq]; exact hx⟩
        obtain ⟨B, hB, hxB⟩ := mem_support_iff'.1 (hfrU p hxf)
        exact carrier_subset_support (hU₀G hB) hxB
      · obtain ⟨A, hA, hxA⟩ := mem_support_iff'.1 (interior_subset (hQ'Ω (hWc hx)))
        by_cases hAG : interior A.carrier ⊆ W
        · exact absurd (by rw [← tile_regular A] at hxA; exact closure_mono hAG hxA) hxc
        · exact carrier_subset_support (show A ∈ G from ⟨hA, hAG⟩) hxA
  have hGS : G ⊆ S.tiles := fun A hA => hA.1
  have hGfin : G.Finite := S.finite.subset hGS
  have hGne : G.Nonempty := hU₀ne.mono hU₀G
  have hGcov : support G ⊆ interior (support S.tiles) := by rw [hGW]; exact hWc.trans hQ'Ω
  have HG : JSetup S.tiles G := ⟨hdisj, hsts, hGS, hGfin, hGcov⟩
  -- every bounded complementary component has a frontier point interior to the filled region
  have hLstar : ∀ y ∈ O, y ∉ W → ∃ z ∈ frontier (connectedComponentIn O y), z ∈ interior Wᶜ := by
    intro y hyO hyW
    set C' := connectedComponentIn O y with hC'
    have hC'o : IsOpen C' := hOo.connectedComponentIn
    have hyC' : y ∈ C' := mem_connectedComponentIn hyO
    have hC'W : Disjoint C' W := hdisjW y hyO hyW
    have hC'Wc : closure C' ⊆ Wᶜ :=
      closure_minimal (fun x hx hxW => Set.disjoint_left.1 hC'W hx hxW) hWo.isClosed_compl
    obtain ⟨z, hz, hzv⟩ : ∃ z ∈ frontier C', z ∉ gVerts S.tiles := by
      by_contra hcon
      push_neg at hcon
      have hpW : p ∈ W := mem_connectedComponentIn hpO
      have hpC : p ∉ closure C' := fun h' => Set.disjoint_left.1 (hC'W.symm.closure_right hWo) hpW h'
      apply open_minus_finite_split (W := Set.univ) (O1 := C') (O2 := (closure C')ᶜ) (Z := frontier C')
        isOpen_univ isPreconnected_univ hC'o isClosed_closure.isOpen_compl
        (Set.disjoint_left.2 fun x hx hx' => hx' (subset_closure hx))
        ((gVerts_finite S.finite).subset hcon)
      · intro x _
        by_cases h1 : x ∈ C'
        · exact Or.inl (Or.inl h1)
        by_cases h2 : x ∈ closure C'
        · exact Or.inr ⟨h2, by rw [hC'o.interior_eq]; exact h1⟩
        · exact Or.inl (Or.inr h2)
      · exact ⟨y, trivial, hyC'⟩
      · exact ⟨p, trivial, hpC⟩
    have hzU : z ∈ U := hfrU y hz
    obtain ⟨B, hB, hzB⟩ := mem_support_iff'.1 hzU
    refine ⟨z, hz, ?_⟩
    by_cases hzi : z ∈ interior B.carrier
    · exact interior_mono ((carrier_subset_support hB).trans hUW) hzi
    have hzf : z ∈ frontier B.carrier := by
      rw [mem_frontier_iff_of_closed (tile_isClosed B)]; exact ⟨hzB, hzi⟩
    rw [tile_frontier_eq, Set.mem_iUnion] at hzf
    obtain ⟨i, hzi'⟩ := hzf
    have hzo : z ∈ openSegment ℝ (B.vertex i) (B.vertex (finRotate _ i)) := by
      rw [tile_side_eq] at hzi'
      refine mem_openSegment_of_ne_left_right ?_ ?_ hzi'
      · intro h'; exact hzv (Set.mem_biUnion hB.1 ⟨i, h'⟩)
      · intro h'; exact hzv (Set.mem_biUnion hB.1 ⟨_, h'⟩)
    by_cases hbe : ∀ A' ∈ U₀, A' ≠ B → ¬ HasEdge A' (B.side i)
    · obtain ⟨r, hr, σ, hch⟩ := rg_bedge_sides H0 hB i hbe hzo
      set d := B.vertex (finRotate _ i) - B.vertex i with hd
      set a := B.vertex i with ha
      set Hm := Metric.ball z r ∩ {x : Pt | σ * jcr d (x - a) < 0} with hHm
      obtain ⟨w, hwC, hwz⟩ := Metric.mem_closure_iff.1 (frontier_subset_closure hz) r hr
      have hwb : w ∈ Metric.ball z r := by rw [Metric.mem_ball, dist_comm]; exact hwz
      have hwH : w ∈ Hm := by
        refine ⟨hwb, ?_⟩
        by_contra hneg
        replace hneg : 0 ≤ σ * jcr d (w - a) := not_lt.1 hneg
        exact (connectedComponentIn_subset O y hwC) (carrier_subset_support hB ((hch w hwb).2 hneg))
      have hHmO : Hm ⊆ O := fun x hx => (hch x hx.1).1 hx.2
      have hHmC : Hm ⊆ C' := by
        have := ((convex_ball z r).inter (rg_halfplane_convex σ d a)).isPreconnected.subset_connectedComponentIn
          hwH hHmO
        rwa [← connectedComponentIn_eq hwC] at this
      rw [mem_interior_iff_mem_nhds]
      refine Filter.mem_of_superset (Metric.ball_mem_nhds z hr) (fun x hx => ?_)
      rcases le_or_gt 0 (σ * jcr d (x - a)) with h0 | h0
      · exact hUW (carrier_subset_support hB ((hch x hx).2 h0))
      · exact hC'Wc (subset_closure (hHmC ⟨hx, h0⟩))
    · push_neg at hbe
      obtain ⟨A', hA', hne, j, hj⟩ := hbe
      exact interior_mono hUW (H0.partnered_open_in_U hB hA' hne i j hj hzo)
  -- the interior of the filled region is connected
  have hint : IsConnected (interior (support G)) := by
    rw [hGW]
    set V := interior Wᶜ with hV
    have hVo : IsOpen V := isOpen_interior
    obtain ⟨A0, hA0⟩ := hU₀ne
    set X₀ := ⋃ A : U₀, (interior Q ∪ interior A.1.carrier) with hX₀
    have hX₀c : IsPreconnected X₀ := by
      apply isPreconnected_iUnion
      · exact ⟨c, Set.mem_iInter.2 fun A => Or.inl hcQ⟩
      · intro A
        obtain ⟨w, hw1, hw2⟩ := A.2.2
        exact IsPreconnected.union' ⟨w, hw2, hw1⟩ (rg_square_convex c h).interior.isPreconnected
          (tileDisk A.1).interior_pathConnected.isConnected.isPreconnected
    have hX₀V : X₀ ⊆ V := by
      intro x hx
      obtain ⟨A, hxA⟩ := Set.mem_iUnion.1 hx
      rcases hxA with hx | hx
      · exact interior_mono (hQU.trans hUW) hx
      · exact interior_mono ((carrier_subset_support A.2).trans hUW) hx
    have hcX : c ∈ X₀ := Set.mem_iUnion.2 ⟨⟨A0, hA0⟩, Or.inl hcQ⟩
    set K := connectedComponentIn V c with hK
    have hX₀K : X₀ ⊆ K := hX₀c.subset_connectedComponentIn hcX hX₀V
    have hUcl : U ⊆ closure X₀ := by
      intro y hy
      obtain ⟨B, hB, hyB⟩ := mem_support_iff'.1 hy
      rw [← tile_regular] at hyB
      exact closure_mono (s := interior B.carrier) (t := X₀)
        (fun x hx => Set.mem_iUnion.2 ⟨(⟨B, hB⟩ : U₀), Or.inr hx⟩) hyB
    have hC1 : ∀ y ∈ V, y ∈ U → y ∈ K := by
      intro y hyV hyU
      obtain ⟨x, hx1, hx2⟩ :=
        mem_closure_iff.1 (hUcl hyU) _ hVo.connectedComponentIn (mem_connectedComponentIn hyV)
      rw [hK, connectedComponentIn_eq (hX₀K hx2), ← connectedComponentIn_eq hx1]
      exact mem_connectedComponentIn hyV
    have hVK : V ⊆ K := by
      intro y hyV
      by_cases hyU : y ∈ U
      · exact hC1 y hyV hyU
      have hyW : y ∉ W := interior_subset hyV
      obtain ⟨z, hz, hzV⟩ := hLstar y hyU hyW
      have hzK := hC1 z hzV (hfrU y hz)
      obtain ⟨x, hx1, hx2⟩ := mem_closure_iff.1 (frontier_subset_closure hz) _ hVo.connectedComponentIn
        (mem_connectedComponentIn hzV)
      have hC'V : connectedComponentIn O y ⊆ V :=
        interior_maximal (fun w hw hwW => Set.disjoint_left.1 (hdisjW y hyU hyW) hw hwW)
          hOo.connectedComponentIn
      have hxy : x ∈ connectedComponentIn V y :=
        isPreconnected_connectedComponentIn.subset_connectedComponentIn (mem_connectedComponentIn hyU) hC'V hx2
      rw [hK, connectedComponentIn_eq hzK, connectedComponentIn_eq hx1, ← connectedComponentIn_eq hxy]
      exact mem_connectedComponentIn hyV
    have hKV : K = V := Set.Subset.antisymm (connectedComponentIn_subset _ _) hVK
    rw [← hKV]
    exact isConnected_connectedComponentIn_iff.2 (hX₀V hcX)
  have hcompl : IsConnected (support G)ᶜ := by
    rw [hGW, compl_compl]; exact isConnected_connectedComponentIn_iff.2 hpO
  obtain ⟨L, hL⟩ := polygonalJordanBoundary S.tiles hdisj hsts G hGS hGfin hGne hGcov hint hcompl
  have hLc : L.carrier = Wᶜ := by rw [FaceGroup.carrier, L.carrier_eq, hL, hGW]
  refine ⟨L, ?_, ?_, ?_⟩
  · rw [hLc]; exact hQU.trans hUW
  · rw [hLc]; exact hWc.trans hQ'B
  · intro i
    obtain ⟨A, hA, j, hAj⟩ := L.side_whole i
    rw [hL] at hA
    obtain ⟨q, hq⟩ : (openSegment ℝ (A.vertex j) (A.vertex (finRotate _ j))).Nonempty :=
      ⟨_, mem_openSegment_iff'.2 ⟨1 / 2, by norm_num, by norm_num, rfl⟩⟩
    have hqs : q ∈ L.disk.side i := hAj ▸ openSeg_mem_side A j hq
    have hqf : q ∈ frontier L.disk.carrier := by
      rw [L.disk.frontier_eq]; exact Set.mem_iUnion.2 ⟨i, hqs⟩
    have hqU : q ∈ U := by
      have e : L.disk.carrier = Wᶜ := hLc
      rw [e, frontier_compl] at hqf
      exact hfrU p hqf
    obtain ⟨B, hB, hqB⟩ := mem_support_iff'.1 hqU
    by_cases hAB : A = B
    · subst hAB
      exact ⟨A, by rw [hL]; exact hA, ⟨j, hAj⟩, hB.2⟩
    · obtain ⟨k, hk⟩ := HG.partner hA hB.1 hAB j hq hqB
      exact ⟨B, by rw [hL]; exact hU₀G hB, ⟨k, hk.trans hAj⟩, hB.2⟩

/-- The interior of a regular closed tile meets the complement of a closed set
    whenever the tile itself contains a point of that complement. -/
private lemma outsideAnchoredGrouping_step1_E_step1_supset_tile
    (F : PlacedTile P) {K : Set Pt} (hK : IsClosed K) {x : Pt}
    (hxF : x ∈ F.carrier) (hxK : x ∉ K) :
    (interior F.carrier ∩ Kᶜ).Nonempty := by
  by_contra hn
  have hsub : interior F.carrier ⊆ K := by
    intro y hy
    by_contra hyK
    exact hn ⟨y, hy, hyK⟩
  have hcl : closure (interior F.carrier) ⊆ K := by
    rw [← hK.closure_eq]
    exact closure_mono hsub
  have hxcl : x ∈ closure (interior F.carrier) := by
    rw [tile_regular F]
    exact hxF
  exact hxK (hcl hxcl)

private lemma outsideAnchoredGrouping_step1_E_step1_supset_step5_square_add_subset
    {c : Pt} {h r : ℝ} : square c h + Binf r ⊆ square c (h + r) := by
  rintro _ ⟨a, ha, b, hb, rfl⟩
  refine ⟨?_, ?_⟩
  · simp only [PiLp.add_apply]
    calc |a 0 + b 0 - c 0| = |(a 0 - c 0) + b 0| := by ring_nf
      _ ≤ |a 0 - c 0| + |b 0| := abs_add_le _ _
      _ ≤ h + r := add_le_add ha.1 hb.1
  · simp only [PiLp.add_apply]
    calc |a 1 + b 1 - c 1| = |(a 1 - c 1) + b 1| := by ring_nf
      _ ≤ |a 1 - c 1| + |b 1| := abs_add_le _ _
      _ ≤ h + r := add_le_add ha.2 hb.2

private lemma outsideAnchoredGrouping_step1_E_step1_supset_K1_closed
    (M : MeshConstants P) (c : Pt) (h : ℝ) (hh : 0 < h) :
    IsClosed (square c h + Binf (3 * M.D)) := by
  have h_MD : 0 ≤ 3 * M.D := mul_nonneg (by norm_num) M.D_pos.le
  have heq : square c h + Binf (3 * M.D) = square c (h + 3 * M.D) :=
    Subset.antisymm
      outsideAnchoredGrouping_step1_E_step1_supset_step5_square_add_subset
        (rg_square_add hh.le h_MD)
  rw [heq]
  exact rg_square_closed c (h + 3 * M.D)

/-- Step 1 of the blueprint proof of `outsideAnchoredGrouping_step1_E`: `K_1^c \subseteq \operatorname{int} E`. -/
private lemma outsideAnchoredGrouping_step1_E_step1_supset (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier) :
    (square c h + Binf (3 * M.D))ᶜ ⊆
      interior (Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ :
        (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty,
        F.carrier) := by
  have _ := hsts
  have _ := hQ
  have hk_closed : IsClosed (square c h + Binf (3 * M.D)) :=
    outsideAnchoredGrouping_step1_E_step1_supset_K1_closed M c h hh
  apply interior_maximal _ hk_closed.isOpen_compl
  intro x hx
  by_cases hxΩ : x ∈ Ω.carrier
  · right
    have hx_supp : x ∈ support S.tiles := by rw [hcov]; exact hxΩ
    obtain ⟨F, hFS, hxF⟩ := mem_support_iff'.1 hx_supp
    have h_nonempty :
        (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty :=
      outsideAnchoredGrouping_step1_E_step1_supset_tile F hk_closed hxF hx
    simp only [mem_iUnion, exists_prop]
    exact ⟨F, hFS, h_nonempty, hxF⟩
  · left
    exact hxΩ

/-- Step 2 of the blueprint proof of `outsideAnchoredGrouping_step1_E`: every selected face belongs to `E`. -/
private lemma outsideAnchoredGrouping_step1_E_step2_faces (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier) :
    ∀ F ∈ S.tiles, (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ Ω.carrierᶜ ∪ ⋃ F' ∈ S.tiles, ⋃ _ : (interior F'.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F'.carrier := by
  intro F hF hF_nonempty x hx
  have _ := hcov; have _ := hsts; have _ := hh; have _ := hQ; have _ := M; have _ := Ω
  apply Set.mem_union_right
  simp only [Set.mem_iUnion, exists_prop]
  exact ⟨F, hF, hF_nonempty, hx⟩

/-- Step 3 of the blueprint proof of `outsideAnchoredGrouping_step1_E`: `\operatorname{int} E` is connected. -/
private lemma outsideAnchoredGrouping_step1_E_step3_conn (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier) :
    IsConnected (interior (Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles,
      ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty,
      F.carrier)) := by
  let K : Set Pt := square c h + Binf (3 * M.D)
  let R : ℝ := h + 3 * M.D
  have hR : 0 ≤ R := by dsimp [R]; linarith [M.D_pos]
  have hK_eq : K = square c R := by
    dsimp [K, R]
    exact Set.Subset.antisymm
      outsideAnchoredGrouping_step1_E_step1_supset_step5_square_add_subset
      (rg_square_add hh.le (by linarith [M.D_pos]))
  let p := mkPt (c 0 + (R + 1)) (c 1 + (R + 1))
  have hpK : p ∈ (square c R)ᶜ := by
    change ¬ (|p 0 - c 0| ≤ R ∧ |p 1 - c 1| ≤ R)
    intro hp
    have hp1 := hp.2
    simp only [p, rg_mkPt1, add_sub_cancel_left] at hp1
    rw [abs_of_pos (by linarith [hR])] at hp1
    linarith
  have hKconn : IsConnected Kᶜ := by
    rw [hK_eq]
    have hsub : (square c R)ᶜ ⊆ connectedComponentIn (square c R)ᶜ p := by
      intro x hx
      exact rg_far_mem hR (fun y hy => hy) hx
    have heq : connectedComponentIn (square c R)ᶜ p = (square c R)ᶜ :=
      Set.Subset.antisymm (connectedComponentIn_subset _ _) hsub
    rw [← heq]
    exact isConnected_connectedComponentIn_iff.mpr hpK
  have hKΩ : K ⊆ interior Ω.carrier := by
    dsimp [K]
    exact (Set.add_subset_add_left (rg_binf_mono (by linarith [M.D_pos]))).trans hQ
  let U : Set Pt := Kᶜ ∪ ⋃ F ∈ S.tiles,
    ⋃ _ : (interior F.carrier ∩ Kᶜ).Nonempty, interior F.carrier
  have hUsub : U ⊆ interior (Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles,
      ⋃ _ : (interior F.carrier ∩ Kᶜ).Nonempty, F.carrier) := by
    intro x hx
    rcases hx with hx | hx
    · exact outsideAnchoredGrouping_step1_E_step1_supset M S Ω hcov hsts c h hh hQ hx
    · simp only [Set.mem_iUnion] at hx ⊢
      obtain ⟨F, hF, hsel, hxF⟩ := hx
      have hFint : interior F.carrier ⊆
          interior (Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles,
            ⋃ _ : (interior F.carrier ∩ Kᶜ).Nonempty, F.carrier) := by
        apply interior_mono
        intro y hy
        exact Set.mem_union_right _ (Set.mem_iUnion.2 ⟨F, Set.mem_iUnion.2 ⟨hF,
          Set.mem_iUnion.2 ⟨hsel, hy⟩⟩⟩)
      exact hFint hxF
  have hUconn : IsConnected U := by
    have hKmem : Kᶜ ⊆ U := by
      intro x hx
      change x ∈ Kᶜ ∪ ⋃ F ∈ S.tiles,
        ⋃ _ : (interior F.carrier ∩ Kᶜ).Nonempty, interior F.carrier
      exact Or.inl hx
    have htile_mem : ∀ (F : PlacedTile P), F ∈ S.tiles →
        (interior F.carrier ∩ Kᶜ).Nonempty → interior F.carrier ⊆ U := by
      intro F hF hsel x hx
      change x ∈ Kᶜ ∪ ⋃ F ∈ S.tiles,
        ⋃ _ : (interior F.carrier ∩ Kᶜ).Nonempty, interior F.carrier
      exact Or.inr (Set.mem_iUnion.2 ⟨F, Set.mem_iUnion.2 ⟨hF,
        Set.mem_iUnion.2 ⟨hsel, hx⟩⟩⟩)
    have hUpre : IsPreconnected U := by
      apply isPreconnected_of_forall_pair
      intro x hx y hy
      rcases hx with hxK | hxF
      · rcases hy with hyK | hyF
        · exact ⟨Kᶜ, hKmem, hxK, hyK, hKconn.isPreconnected⟩
        · simp only [Set.mem_iUnion] at hyF
          obtain ⟨F, hF, hsel, hyF'⟩ := hyF
          have hsel' := hsel
          obtain ⟨z, hzF, hzK⟩ := hsel
          let T := Kᶜ ∪ interior F.carrier
          have hT : IsPreconnected T := IsPreconnected.union' ⟨z, hzK, hzF⟩
            hKconn.isPreconnected
            (tileDisk F).interior_pathConnected.isConnected.isPreconnected
          refine ⟨T, ?_, ?_, ?_, hT⟩
          · simpa [T] using union_subset hKmem (htile_mem F hF hsel')
          · exact Set.mem_union_left _ hxK
          · exact Set.mem_union_right _ hyF'
      · rcases hy with hyK | hyF
        · simp only [Set.mem_iUnion] at hxF
          obtain ⟨F, hF, hsel, hxF'⟩ := hxF
          have hsel' := hsel
          obtain ⟨z, hzF, hzK⟩ := hsel
          let T := Kᶜ ∪ interior F.carrier
          have hT : IsPreconnected T := IsPreconnected.union' ⟨z, hzK, hzF⟩
            hKconn.isPreconnected
            (tileDisk F).interior_pathConnected.isConnected.isPreconnected
          refine ⟨T, ?_, ?_, ?_, hT⟩
          · simpa [T] using union_subset hKmem (htile_mem F hF hsel')
          · exact Set.mem_union_right _ hxF'
          · exact Set.mem_union_left _ hyK
        · simp only [Set.mem_iUnion] at hxF hyF
          obtain ⟨F, hF, hsel, hxF'⟩ := hxF
          obtain ⟨G, hG, hselG, hyG'⟩ := hyF
          have hsel' := hsel
          have hselG' := hselG
          obtain ⟨zF, hzF, hzFK⟩ := hsel
          obtain ⟨zG, hzG, hzGK⟩ := hselG
          let T := Kᶜ ∪ interior F.carrier ∪ interior G.carrier
          have hTF : IsPreconnected (Kᶜ ∪ interior F.carrier) :=
            IsPreconnected.union' ⟨zF, hzFK, hzF⟩ hKconn.isPreconnected
              (tileDisk F).interior_pathConnected.isConnected.isPreconnected
          have hT : IsPreconnected T := IsPreconnected.union'
            ⟨zG, Or.inl hzGK, hzG⟩ hTF
            (tileDisk G).interior_pathConnected.isConnected.isPreconnected
          refine ⟨T, ?_, ?_, ?_, hT⟩
          · simpa [T] using union_subset (union_subset hKmem (htile_mem F hF hsel'))
              (htile_mem G hG hselG')
          · exact Set.mem_union_left _ (Set.mem_union_right _ hxF')
          · exact Set.mem_union_right _ hyG'
    refine ⟨?_, hUpre⟩
    exact ⟨p, Set.mem_union_left _ (by rw [hK_eq]; exact hpK)⟩
  have hint_closure : interior (Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles,
      ⋃ _ : (interior F.carrier ∩ Kᶜ).Nonempty, F.carrier) ⊆ closure U := by
    intro x hx
    have hxE := interior_subset hx
    rcases (show x ∈ Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles,
        ⋃ _ : (interior F.carrier ∩ Kᶜ).Nonempty, F.carrier from hxE) with hxΩ | hxF
    · have hxK : x ∈ Kᶜ := by
        intro hxK
        exact hxΩ (interior_subset (hKΩ hxK))
      exact subset_closure (show x ∈ U from Set.mem_union_left _ hxK)
    · simp only [Set.mem_iUnion] at hxF
      obtain ⟨F, hF, hsel, hxF⟩ := hxF
      have hclF : x ∈ closure (interior F.carrier) := by
        rw [tile_regular]
        exact hxF
      exact closure_mono (fun y hy =>
        show y ∈ U from Set.mem_union_right _ (Set.mem_iUnion.2 ⟨F,
          Set.mem_iUnion.2 ⟨hF, Set.mem_iUnion.2 ⟨hsel, hy⟩⟩⟩)) hclF
  exact hUconn.subset_closure hUsub hint_closure

/-- Step 1 of the blueprint proof of `outsideAnchoredGrouping`: defining `E`. -/
private lemma outsideAnchoredGrouping_step1_E (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier) :
    ∃ E : Set Pt, (IsConnected (interior E) ∧
      (square c h + Binf (3 * M.D))ᶜ ⊆ interior E ∧
      ∀ F ∈ S.tiles, (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ E) ∧
      E = Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier := by
  use Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier
  refine ⟨⟨?_, ?_, ?_⟩, rfl⟩
  · exact outsideAnchoredGrouping_step1_E_step3_conn M S Ω hcov hsts c h hh hQ
  · exact outsideAnchoredGrouping_step1_E_step1_supset M S Ω hcov hsts c h hh hQ
  · exact outsideAnchoredGrouping_step1_E_step2_faces M S Ω hcov hsts c h hh hQ

/-- Step 1 of the blueprint proof of `outsideAnchoredGrouping_step2_H`: lower inclusion. -/
private lemma outsideAnchoredGrouping_step2_H_step1_lower (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier)
    (E : Set Pt) (hE_conn : IsConnected (interior E))
    (hE_supset : (square c h + Binf (3 * M.D))ᶜ ⊆ interior E)
    (hE_faces : ∀ F ∈ S.tiles, (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ E)
    (hE_def : E = Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier) :
    square c h + Binf (2 * M.D) ⊆ closure (connectedComponentIn (Eᶜ) c) := by
  have _ := hcov
  have _ := hsts
  have _ := hE_conn
  have _ := hE_supset
  have _ := hE_faces
  have hsum_eq : ∀ r : ℝ, 0 ≤ r →
      square c h + Binf r = square c (h + r) := by
    intro r hr
    apply Set.Subset.antisymm
    · rintro x ⟨u, hu, v, hv, rfl⟩
      refine ⟨?_, ?_⟩
      · simp only [PiLp.add_apply]
        calc
          |u 0 + v 0 - c 0| = |(u 0 - c 0) + v 0| := by congr 1; ring
          _ ≤ |u 0 - c 0| + |v 0| := abs_add_le _ _
          _ ≤ h + r := add_le_add hu.1 hv.1
      · simp only [PiLp.add_apply]
        calc
          |u 1 + v 1 - c 1| = |(u 1 - c 1) + v 1| := by congr 1; ring
          _ ≤ |u 1 - c 1| + |v 1| := abs_add_le _ _
          _ ≤ h + r := add_le_add hu.2 hv.2
    · exact rg_square_add hh.le hr
  have hQ2eq : square c h + Binf (2 * M.D) = square c (h + 2 * M.D) :=
    hsum_eq _ (by linarith [M.D_pos])
  have hK_eq : square c h + Binf (3 * M.D) = square c (h + 3 * M.D) :=
    hsum_eq _ (by linarith [M.D_pos])
  have hQ2Ω : square c h + Binf (2 * M.D) ⊆ interior Ω.carrier := by
    exact (Set.add_subset_add_left (rg_binf_mono (by linarith [M.D_pos]))).trans hQ
  have hQ2E : square c h + Binf (2 * M.D) ⊆ Eᶜ := by
    intro x hx hxE
    rw [hE_def] at hxE
    rcases hxE with hxΩ | hxG
    · exact hxΩ (interior_subset (hQ2Ω hx))
    · simp only [Set.mem_iUnion, exists_prop] at hxG
      obtain ⟨F, hF, hsel, hxF⟩ := hxG
      obtain ⟨y, hy⟩ := hsel
      have hyK : y ∉ square c (h + 3 * M.D) := by
        rw [← hK_eq]
        exact hy.2
      simp only [square, Set.mem_setOf_eq, not_and_or, not_le] at hyK
      rw [hQ2eq] at hx
      rcases hyK with hy0 | hy1
      · have hxy := rg_tile_coord M F hxF (interior_subset hy.1) 0
        have hle : |y 0 - c 0| ≤ M.D + (h + 2 * M.D) := by
          calc
            |y 0 - c 0| = |(y 0 - x 0) + (x 0 - c 0)| := by congr 1; ring
            _ ≤ |y 0 - x 0| + |x 0 - c 0| := abs_add_le _ _
            _ = |x 0 - y 0| + |x 0 - c 0| := by rw [abs_sub_comm]
            _ ≤ M.D + (h + 2 * M.D) := add_le_add hxy hx.1
        linarith
      · have hxy := rg_tile_coord M F hxF (interior_subset hy.1) 1
        have hle : |y 1 - c 1| ≤ M.D + (h + 2 * M.D) := by
          calc
            |y 1 - c 1| = |(y 1 - x 1) + (x 1 - c 1)| := by congr 1; ring
            _ ≤ |y 1 - x 1| + |x 1 - c 1| := abs_add_le _ _
            _ = |x 1 - y 1| + |x 1 - c 1| := by rw [abs_sub_comm]
            _ ≤ M.D + (h + 2 * M.D) := add_le_add hxy hx.2
        linarith
  have hcQ2 : c ∈ square c h + Binf (2 * M.D) := by
    refine Set.mem_add.2 ⟨c, ?_, 0, ?_, by simp⟩
    · simp only [square, Set.mem_setOf_eq, sub_self, abs_zero]
      exact ⟨hh.le, hh.le⟩
    · simp only [Binf, Set.mem_setOf_eq, PiLp.zero_apply, abs_zero]
      exact ⟨by linarith [M.D_pos], by linarith [M.D_pos]⟩
  have hQ2pre : IsPreconnected (square c h + Binf (2 * M.D)) := by
    rw [hQ2eq]
    exact (rg_square_convex c (h + 2 * M.D)).isPreconnected
  exact (hQ2pre.subset_connectedComponentIn hcQ2 hQ2E).trans subset_closure

/-- Step 2 of the blueprint proof of `outsideAnchoredGrouping_step2_H`: upper inclusion. -/
private lemma outsideAnchoredGrouping_step2_H_step2_upper (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier)
    (E : Set Pt) (hE_conn : IsConnected (interior E))
    (hE_supset : (square c h + Binf (3 * M.D))ᶜ ⊆ interior E)
    (hE_faces : ∀ F ∈ S.tiles, (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ E)
    (hE_def : E = Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier) :
    closure (connectedComponentIn (Eᶜ) c) ⊆ square c h + Binf (3 * M.D) := by
  have _ := hcov
  have _ := hsts
  have _ := hQ
  have _ := hE_conn
  have _ := hE_faces
  have _ := hE_def
  have hcc : connectedComponentIn (Eᶜ) c ⊆ square c h + Binf (3 * M.D) := by
    intro x hx
    by_contra hxQ
    exact absurd (interior_subset (hE_supset hxQ)) (connectedComponentIn_subset _ _ hx)
  have hDnn : (0 : ℝ) ≤ 3 * M.D := by linarith [M.D_pos]
  have hsum : square c h + Binf (3 * M.D) ⊆ square c (h + 3 * M.D) := by
    rintro x ⟨u, hu, v, hv, rfl⟩
    refine ⟨?_, ?_⟩
    · simp only [PiLp.add_apply]
      calc
        |u 0 + v 0 - c 0| = |(u 0 - c 0) + v 0| := by congr 1; ring_nf
        _ ≤ |u 0 - c 0| + |v 0| := abs_add_le _ _
        _ ≤ h + 3 * M.D := add_le_add hu.1 hv.1
    · simp only [PiLp.add_apply]
      calc
        |u 1 + v 1 - c 1| = |(u 1 - c 1) + v 1| := by congr 1; ring_nf
        _ ≤ |u 1 - c 1| + |v 1| := abs_add_le _ _
        _ ≤ h + 3 * M.D := add_le_add hu.2 hv.2
  have hclosed : IsClosed (square c h + Binf (3 * M.D)) := by
    have heq : square c h + Binf (3 * M.D) = square c (h + 3 * M.D) :=
      Set.Subset.antisymm hsum (rg_square_add hh.le hDnn)
    rw [heq]
    exact rg_square_closed c (h + 3 * M.D)
  calc closure (connectedComponentIn (Eᶜ) c)
      ⊆ closure (square c h + Binf (3 * M.D)) := closure_mono hcc
    _ = square c h + Binf (3 * M.D) := hclosed.closure_eq

/-- Step 3 of the blueprint proof of `outsideAnchoredGrouping_step2_H`: interior connected. -/
private lemma outsideAnchoredGrouping_step2_H_step3_conn_int (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier)
    (E : Set Pt) (hE_conn : IsConnected (interior E))
    (hE_supset : (square c h + Binf (3 * M.D))ᶜ ⊆ interior E)
    (hE_faces : ∀ F ∈ S.tiles, (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ E)
    (hE_def : E = Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier) :
    IsConnected (interior (closure (connectedComponentIn (Eᶜ) c))) := by
  let G : Set (PlacedTile P) :=
    {F | F ∈ S.tiles ∧ (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty}
  let U : Set Pt :=
    ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty,
      F.carrier
  have hGfin : G.Finite := by
    apply S.finite.subset
    intro F hF
    exact hF.1
  have hUG : U = support G := by
    ext x
    constructor
    · intro hx
      simp only [U, Set.mem_iUnion] at hx
      rcases hx with ⟨F, hF, hsel, hx⟩
      exact mem_support_iff'.2 ⟨F, ⟨hF, hsel⟩, hx⟩
    · intro hx
      rcases mem_support_iff'.1 hx with ⟨F, ⟨hF, hsel⟩, hx⟩
      refine Set.mem_iUnion.2 ⟨F, Set.mem_iUnion.2 ⟨hF, ?_⟩⟩
      exact Set.mem_iUnion.2 ⟨hsel, hx⟩
  have hUclosed : IsClosed U := by
    rw [hUG]
    exact support_isClosed hGfin
  have hOopen : IsOpen (interior Ω.carrier ∩ Uᶜ) :=
    isOpen_interior.inter hUclosed.isOpen_compl
  have hK3K10 : square c h + Binf (3 * M.D) ⊆ square c h + Binf (10 * M.D) := by
    have hD : 3 * M.D ≤ 10 * M.D := by linarith [M.D_pos]
    have hB : Binf (3 * M.D) ⊆ Binf (10 * M.D) := rg_binf_mono hD
    intro x hx
    rcases Set.mem_add.1 hx with ⟨y, hy, z, hz, rfl⟩
    exact Set.mem_add.2 ⟨y, hy, z, hB hz, rfl⟩
  have hK3int : square c h + Binf (3 * M.D) ⊆ interior Ω.carrier :=
    hK3K10.trans hQ
  let C : Set Pt := connectedComponentIn (Eᶜ) c
  have hCcl : closure C ⊆ interior Ω.carrier := by
    dsimp [C]
    exact (outsideAnchoredGrouping_step2_H_step2_upper M S Ω hcov hsts c h hh hQ E
      hE_conn hE_supset hE_faces hE_def).trans hK3int
  have hcK2 : c ∈ square c h + Binf (2 * M.D) := by
    refine Set.mem_add.2 ⟨c, ?_, 0, ?_, by simp⟩
    · simp [square, le_of_lt hh]
    · simp [Binf, M.D_pos.le]
  have hccl : c ∈ closure C := by
    dsimp [C]
    exact outsideAnchoredGrouping_step2_H_step1_lower M S Ω hcov hsts c h hh hQ E hE_conn
      hE_supset hE_faces hE_def hcK2
  have hCne : C.Nonempty := by
    by_contra hne
    have hCempty : C = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
    rw [hCempty, closure_empty] at hccl
    exact hccl
  have hcE : c ∈ Eᶜ := connectedComponentIn_nonempty_iff.mp hCne
  have hcC : c ∈ C := by
    dsimp [C]
    exact mem_connectedComponentIn hcE
  have hCO : C ⊆ interior Ω.carrier ∩ Uᶜ := by
    intro x hx
    have hxcl : x ∈ closure C := subset_closure hx
    refine ⟨hCcl hxcl, ?_⟩
    intro hxU
    have hxE : x ∈ Eᶜ := connectedComponentIn_subset (Eᶜ) c hx
    apply hxE
    rw [hE_def]
    exact Or.inr hxU
  have hOC : interior Ω.carrier ∩ Uᶜ ⊆ Eᶜ := by
    intro x hx hxE
    rw [hE_def] at hxE
    rcases hxE with hxE | hxE
    · exact hxE (interior_subset hx.1)
    · exact hx.2 hxE
  have hCeq : C = connectedComponentIn (interior Ω.carrier ∩ Uᶜ) c := by
    apply Set.Subset.antisymm
    · exact isPreconnected_connectedComponentIn.subset_connectedComponentIn hcC hCO
    · have hcO : c ∈ interior Ω.carrier ∩ Uᶜ := hCO hcC
      exact isPreconnected_connectedComponentIn.subset_connectedComponentIn
        (mem_connectedComponentIn hcO)
        ((connectedComponentIn_subset _ _).trans hOC)
  have hCopen : IsOpen C := by
    rw [hCeq]
    exact hOopen.connectedComponentIn
  have hCconn : IsConnected C := isConnected_connectedComponentIn_iff.2 hcE
  exact hCconn.subset_closure hCopen.subset_interior_closure interior_subset

/-- Near a nonvertex point of an edge of a selected face, the two local half-planes
lie respectively in that face and outside all selected faces.  Unlike `JSetup.bedge_sides`,
this local version only requires the point in question to be interior to the patch. -/
private lemma outsideAnchoredGrouping_local_bedge_sides {S G : Set (PlacedTile P)}
    (hdisj : DisjointInteriors S) (hsts : SideToSideSet S) (hsub : G ⊆ S)
    (hfin : G.Finite) {A : PlacedTile P} (hA : A ∈ G)
    (i : Fin (P.disk A.form).n)
    (hbe : ∀ A' ∈ G, A' ≠ A → ¬ HasEdge A' (A.side i)) {q : Pt}
    (hq : q ∈ openSegment ℝ (A.vertex i) (A.vertex (finRotate _ i)))
    (hqS : q ∈ interior (support S)) :
    ∃ r > 0, ∃ σ : ℝ, ∀ x ∈ Metric.ball q r,
      (σ * jcr (A.vertex (finRotate _ i) - A.vertex i) (x - A.vertex i) < 0 →
        x ∉ support G) ∧
      (0 ≤ σ * jcr (A.vertex (finRotate _ i) - A.vertex i) (x - A.vertex i) →
        x ∈ A.carrier) := by
  classical
  obtain ⟨r, hr, σ, -, hch⟩ := tile_halfdisk A i hq
  set K' := ⋃ A' ∈ G \ {A}, A'.carrier with hK'
  have hK'c : IsClosed K' := (hfin.diff).isClosed_biUnion (fun D _ => tile_isClosed D)
  have hqK' : q ∉ K' := by
    intro hqK'
    simp only [hK', Set.mem_iUnion] at hqK'
    obtain ⟨A', ⟨hA'G, hA'A⟩, hqA'⟩ := hqK'
    have hne : A ≠ A' := fun h => hA'A (h ▸ rfl)
    obtain ⟨j, hj⟩ := tile_partner hdisj hsts (hsub hA) (hsub hA'G) hne i hq hqA' (fun hv =>
      vertex_not_mem_open_side hdisj hsts (hsub hA) (hsub hA'G) i hq hv hqS)
    exact hbe A' hA'G hne.symm ⟨j, hj⟩
  obtain ⟨ρ, hρ, hρK⟩ := Metric.isOpen_iff.1 hK'c.isOpen_compl q hqK'
  refine ⟨min r ρ, lt_min hr hρ, σ, fun x hx => ⟨fun hneg => ?_, fun hnonneg => ?_⟩⟩
  · intro hxG
    obtain ⟨A', hA'G, hxA'⟩ := mem_support_iff'.1 hxG
    by_cases hAA : A' = A
    · subst hAA
      have hxside := ((hch x (Metric.ball_subset_ball (min_le_left _ _) hx)).2.1).1 hxA'
      linarith
    · apply hρK (Metric.ball_subset_ball (min_le_right _ _) hx)
      simp only [hK', Set.mem_iUnion]
      exact ⟨A', ⟨hA'G, hAA⟩, hxA'⟩
  · exact ((hch x (Metric.ball_subset_ball (min_le_left _ _) hx)).2.1).2 hnonneg

/-- Step 4 of the blueprint proof of `outsideAnchoredGrouping_step2_H`: complement connected. -/
private lemma outsideAnchoredGrouping_step2_H_step4_conn_comp (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier)
    (E : Set Pt) (hE_conn : IsConnected (interior E))
    (hE_supset : (square c h + Binf (3 * M.D))ᶜ ⊆ interior E)
    (hE_faces : ∀ F ∈ S.tiles, (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ E)
    (hE_def : E = Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier) :
    IsConnected (closure (connectedComponentIn (Eᶜ) c))ᶜ := by
  classical
  set K := square c h + Binf (3 * M.D) with hKdef
  set G : Set (PlacedTile P) :=
    {F ∈ S.tiles | (interior F.carrier ∩ Kᶜ).Nonempty} with hGdef
  have hGS : G ⊆ S.tiles := fun F hF => hF.1
  have hGfin : G.Finite := S.finite.subset hGS
  have hEsupport : E = Ω.carrierᶜ ∪ support G := by
    rw [hE_def]
    congr 1
    ext x
    simp only [hGdef, hKdef, mem_support_iff', Set.mem_setOf_eq, Set.mem_iUnion, exists_prop]
    constructor
    · rintro ⟨F, hFS, hF, hxF⟩
      exact ⟨F, ⟨hFS, hF⟩, hxF⟩
    · rintro ⟨F, ⟨hFS, hF⟩, hxF⟩
      exact ⟨F, hFS, hF, hxF⟩
  have hKclosed : IsClosed K := by
    have hDnn : (0 : ℝ) ≤ 3 * M.D := by linarith [M.D_pos]
    have hsum : K ⊆ square c (h + 3 * M.D) := by
      rintro x ⟨u, hu, v, hv, rfl⟩
      refine ⟨?_, ?_⟩
      · simp only [PiLp.add_apply]
        calc
          |u 0 + v 0 - c 0| = |(u 0 - c 0) + v 0| := by congr 1; ring_nf
          _ ≤ |u 0 - c 0| + |v 0| := abs_add_le _ _
          _ ≤ h + 3 * M.D := add_le_add hu.1 hv.1
      · simp only [PiLp.add_apply]
        calc
          |u 1 + v 1 - c 1| = |(u 1 - c 1) + v 1| := by congr 1; ring_nf
          _ ≤ |u 1 - c 1| + |v 1| := abs_add_le _ _
          _ ≤ h + 3 * M.D := add_le_add hu.2 hv.2
    have heq : K = square c (h + 3 * M.D) :=
      Set.Subset.antisymm hsum (by rw [hKdef]; exact rg_square_add hh.le hDnn)
    rw [heq]
    exact rg_square_closed c (h + 3 * M.D)
  have hKΩ : K ⊆ interior Ω.carrier := by
    rw [hKdef]
    exact (Set.add_subset_add_left (rg_binf_mono (by linarith [M.D_pos]))).trans hQ
  set O := Eᶜ with hOdef
  have hOK : O ⊆ K := by
    intro x hxO
    by_contra hxK
    exact hxO (interior_subset (hE_supset (by rwa [hKdef])))
  have hOeq : O = interior Ω.carrier ∩ (support G)ᶜ := by
    ext x
    constructor
    · intro hxO
      have hxK := hOK hxO
      have hxΩ := hKΩ hxK
      rw [hOdef, hEsupport] at hxO
      exact ⟨hxΩ, fun hxG => hxO (Or.inr hxG)⟩
    · rintro ⟨hxΩ, hxG⟩
      rw [hOdef, hEsupport]
      exact fun hxE => hxE.elim (fun hxΩc => hxΩc (interior_subset hxΩ)) hxG
  have hOo : IsOpen O := by
    rw [hOeq]
    exact isOpen_interior.inter (support_isClosed hGfin).isOpen_compl
  set W := connectedComponentIn O c with hWdef
  have hcK : c ∈ K := by
    rw [hKdef]
    refine Set.mem_add.2 ⟨c, ?_, 0, ?_, by simp⟩
    · simp only [square, Set.mem_setOf_eq, sub_self, abs_zero]
      exact ⟨hh.le, hh.le⟩
    · simp only [Binf, Set.mem_setOf_eq, PiLp.zero_apply, abs_zero]
      exact ⟨by linarith [M.D_pos], by linarith [M.D_pos]⟩
  have hcO : c ∈ O := by
    rw [hOeq]
    refine ⟨hKΩ hcK, ?_⟩
    intro hcG
    obtain ⟨F, hFG, hcF⟩ := mem_support_iff'.1 hcG
    obtain ⟨w, hwF, hwK⟩ := hFG.2
    apply hwK
    rw [hKdef]
    refine Set.mem_add.2 ⟨c, ?_, w - c, ?_, by abel⟩
    · simp only [square, Set.mem_setOf_eq, sub_self, abs_zero]
      exact ⟨hh.le, hh.le⟩
    · refine ⟨?_, ?_⟩
      · exact (rg_tile_coord M F (interior_subset hwF) hcF 0).trans (by linarith [M.D_pos])
      · exact (rg_tile_coord M F (interior_subset hwF) hcF 1).trans (by linarith [M.D_pos])
  have hWne : W.Nonempty := by
    exact ⟨c, hWdef ▸ mem_connectedComponentIn hcO⟩
  have hWO : W ⊆ O := by rw [hWdef]; exact connectedComponentIn_subset O c
  have hWo : IsOpen W := by rw [hWdef]; exact hOo.connectedComponentIn
  set V := interior Wᶜ with hVdef
  have htarget : (closure W)ᶜ = V := by rw [hVdef, interior_compl]
  rw [hWdef, htarget]
  set P0 := interior E with hP0def
  have hP0Wc : P0 ⊆ Wᶜ := by
    intro x hxP hxW
    exact (connectedComponentIn_subset O c (hWdef ▸ hxW)) (interior_subset hxP)
  have hP0V : P0 ⊆ V := by
    rw [hVdef]
    exact interior_maximal hP0Wc isOpen_interior
  have hEclP0 : E ⊆ closure P0 := by
    intro x hxE
    rw [hEsupport] at hxE
    rcases hxE with hxΩ | hxG
    · have hxK : x ∉ K := fun hx => hxΩ (interior_subset (hKΩ hx))
      exact subset_closure (hE_supset (by rwa [hKdef] at hxK))
    · obtain ⟨F, hFG, hxF⟩ := mem_support_iff'.1 hxG
      have hFE : F.carrier ⊆ E := hE_faces F hFG.1 hFG.2
      have hxcl : x ∈ closure (interior F.carrier) := by rw [tile_regular]; exact hxF
      exact closure_mono (by simpa [hP0def] using interior_mono hFE) hxcl
  have hfrE : ∀ y, frontier (connectedComponentIn O y) ⊆ E := by
    intro y z hz
    by_contra hzE
    have hzo : IsOpen (connectedComponentIn O z) := hOo.connectedComponentIn
    have hzz : z ∈ connectedComponentIn O z := mem_connectedComponentIn hzE
    obtain ⟨x, hx1, hx2⟩ := mem_closure_iff.1 (frontier_subset_closure hz) _ hzo hzz
    have hzCy : z ∈ connectedComponentIn O y := by
      rw [connectedComponentIn_eq hx2, ← connectedComponentIn_eq hx1]
      exact hzz
    exact hz.2 (by rw [hOo.connectedComponentIn.interior_eq]; exact hzCy)
  have hdisjW : ∀ y ∈ O, y ∉ W → Disjoint (connectedComponentIn O y) W := by
    intro y hyO hyW
    rw [Set.disjoint_left]
    intro w hw1 hw2
    apply hyW
    rw [hWdef, connectedComponentIn_eq hw2, ← connectedComponentIn_eq hw1]
    exact mem_connectedComponentIn hyO
  have hLstar : ∀ y ∈ O, y ∉ W →
      ∃ z ∈ frontier (connectedComponentIn O y), z ∈ V := by
    intro y hyO hyW
    set C' := connectedComponentIn O y with hC'def
    have hC'o : IsOpen C' := by rw [hC'def]; exact hOo.connectedComponentIn
    have hyC' : y ∈ C' := by rw [hC'def]; exact mem_connectedComponentIn hyO
    have hC'W : Disjoint C' W := by rw [hC'def]; exact hdisjW y hyO hyW
    have hC'Wc : closure C' ⊆ Wᶜ :=
      closure_minimal (fun x hx hxW => Set.disjoint_left.1 hC'W hx hxW) hWo.isClosed_compl
    have hC'K : closure C' ⊆ K := by
      apply closure_minimal
      · rw [hC'def]
        exact (connectedComponentIn_subset O y).trans hOK
      · exact hKclosed
    obtain ⟨w0, hw0W⟩ := hWne
    have hw0C' : w0 ∉ closure C' := fun hw0 => Set.disjoint_left.1 (hC'W.symm.closure_right hWo) hw0W hw0
    obtain ⟨z, hz, hzv⟩ : ∃ z ∈ frontier C', z ∉ gVerts S.tiles := by
      by_contra hcon
      push_neg at hcon
      apply open_minus_finite_split (W := Set.univ) (O1 := C') (O2 := (closure C')ᶜ)
        (Z := frontier C') isOpen_univ isPreconnected_univ hC'o isClosed_closure.isOpen_compl
        (Set.disjoint_left.2 fun x hx hx' => hx' (subset_closure hx))
        ((gVerts_finite S.finite).subset hcon)
      · intro x _
        by_cases h1 : x ∈ C'
        · exact Or.inl (Or.inl h1)
        by_cases h2 : x ∈ closure C'
        · exact Or.inr ⟨h2, by rw [hC'o.interior_eq]; exact h1⟩
        · exact Or.inl (Or.inr h2)
      · exact ⟨y, trivial, hyC'⟩
      · exact ⟨w0, trivial, hw0C'⟩
    have hzE : z ∈ E := by
      rw [hC'def] at hz
      exact hfrE y hz
    have hzK : z ∈ K := hC'K (frontier_subset_closure hz)
    have hzΩ : z ∈ interior (support S.tiles) := by rw [hcov]; exact hKΩ hzK
    have hzG : z ∈ support G := by
      rw [hEsupport] at hzE
      exact hzE.resolve_left (fun hzΩc => hzΩc (interior_subset (hKΩ hzK)))
    obtain ⟨B, hBG, hzB⟩ := mem_support_iff'.1 hzG
    by_cases hzi : z ∈ interior B.carrier
    · exact ⟨z, hz, hP0V (by simpa [hP0def] using interior_mono (hE_faces B hBG.1 hBG.2) hzi)⟩
    have hzf : z ∈ frontier B.carrier := by
      rw [mem_frontier_iff_of_closed (tile_isClosed B)]
      exact ⟨hzB, hzi⟩
    rw [tile_frontier_eq, Set.mem_iUnion] at hzf
    obtain ⟨i, hzi'⟩ := hzf
    have hzo : z ∈ openSegment ℝ (B.vertex i) (B.vertex (finRotate _ i)) := by
      rw [tile_side_eq] at hzi'
      refine mem_openSegment_of_ne_left_right ?_ ?_ hzi'
      · intro hz'
        exact hzv (Set.mem_biUnion hBG.1 ⟨i, hz'⟩)
      · intro hz'
        exact hzv (Set.mem_biUnion hBG.1 ⟨_, hz'⟩)
    by_cases hbe : ∀ A' ∈ G, A' ≠ B → ¬ HasEdge A' (B.side i)
    · obtain ⟨r, hr, σ, hch⟩ := outsideAnchoredGrouping_local_bedge_sides S.disjoint hsts hGS hGfin
        hBG i hbe hzo hzΩ
      obtain ⟨ρ, hρ, hρΩ⟩ := Metric.isOpen_iff.1 isOpen_interior z hzΩ
      set r0 := min r ρ with hr0def
      set d := B.vertex (finRotate _ i) - B.vertex i with hddef
      set a := B.vertex i with hadef
      set Hm := Metric.ball z r0 ∩ {x : Pt | σ * jcr d (x - a) < 0} with hHmdef
      obtain ⟨w, hwC, hwz⟩ := Metric.mem_closure_iff.1 (frontier_subset_closure hz) r0 (lt_min hr hρ)
      have hwb : w ∈ Metric.ball z r0 := by rw [Metric.mem_ball, dist_comm]; exact hwz
      have hwH : w ∈ Hm := by
        refine ⟨hwb, ?_⟩
        by_contra hneg
        replace hneg : 0 ≤ σ * jcr d (w - a) := not_lt.1 hneg
        have hwB := (hch w (Metric.ball_subset_ball (hr0def ▸ min_le_left r ρ) hwb)).2 (by simpa [hddef, hadef] using hneg)
        exact (connectedComponentIn_subset O y (hC'def ▸ hwC)) (hE_faces B hBG.1 hBG.2 hwB)
      have hHmO : Hm ⊆ O := by
        intro x hx
        rw [hOeq]
        refine ⟨?_, ?_⟩
        · rw [← hcov]
          exact hρΩ (Metric.ball_subset_ball (hr0def ▸ min_le_right r ρ) hx.1)
        exact (hch x (Metric.ball_subset_ball (hr0def ▸ min_le_left r ρ) hx.1)).1
          (by simpa [hddef, hadef] using hx.2)
      have hHmC : Hm ⊆ C' := by
        have hpre := ((convex_ball z r0).inter (rg_halfplane_convex σ d a)).isPreconnected
          |>.subset_connectedComponentIn hwH hHmO
        rw [hC'def] at hwC
        rw [hHmdef, hC'def, connectedComponentIn_eq hwC]
        exact hpre
      refine ⟨z, hz, ?_⟩
      rw [hVdef, mem_interior_iff_mem_nhds]
      refine Filter.mem_of_superset (Metric.ball_mem_nhds z (lt_min hr hρ)) (fun x hx => ?_)
      rcases le_or_gt 0 (σ * jcr d (x - a)) with hnonneg | hneg
      · intro hxW
        have hxB := (hch x (Metric.ball_subset_ball (hr0def ▸ min_le_left r ρ) hx)).2
          (by simpa [hddef, hadef] using hnonneg)
        exact (hWO hxW) (hE_faces B hBG.1 hBG.2 hxB)
      · exact hC'Wc (subset_closure (hHmC ⟨hx, hneg⟩))
    · push_neg at hbe
      obtain ⟨A', hA'G, hne, j, hj⟩ := hbe
      have hzGi : z ∈ interior (support G) := by
        obtain ⟨r, hr, σ, -, hside⟩ :=
          two_sides S.disjoint (hGS hBG) (hGS hA'G) hne.symm i j hj hzo
        rw [mem_interior_iff_mem_nhds]
        refine Filter.mem_of_superset (Metric.ball_mem_nhds z hr) (fun x hx => ?_)
        rcases le_or_gt 0 (σ * jcr (B.vertex (finRotate _ i) - B.vertex i) (x - B.vertex i)) with h | h
        · exact carrier_subset_support hBG ((hside x hx).2.2 h)
        · exact carrier_subset_support hA'G (interior_subset ((hside x hx).2.1 h))
      refine ⟨z, hz, hP0V ?_⟩
      exact interior_mono (by rw [hEsupport]; exact Set.subset_union_right) hzGi
  obtain ⟨x0, hx0⟩ := hE_conn.nonempty
  have hx0V : x0 ∈ V := hP0V hx0
  set C0 := connectedComponentIn V x0 with hC0def
  have hP0C0 : P0 ⊆ C0 := by
    rw [hC0def]
    exact hE_conn.isPreconnected.subset_connectedComponentIn hx0 hP0V
  have hC0V : C0 ⊆ V := by rw [hC0def]; exact connectedComponentIn_subset V x0
  have hC1 : ∀ y ∈ V, y ∈ E → y ∈ C0 := by
    intro y hyV hyE
    obtain ⟨x, hx1, hx2⟩ := mem_closure_iff.1 (hEclP0 hyE) _
      isOpen_interior.connectedComponentIn (mem_connectedComponentIn hyV)
    rw [hC0def, connectedComponentIn_eq (hP0C0 hx2), ← connectedComponentIn_eq hx1]
    exact mem_connectedComponentIn hyV
  have hVC0 : V ⊆ C0 := by
    intro y hyV
    by_cases hyE : y ∈ E
    · exact hC1 y hyV hyE
    · have hyO : y ∈ O := by simpa [hOdef] using hyE
      have hyW : y ∉ W := interior_subset hyV
      obtain ⟨z, hz, hzV⟩ := hLstar y hyO hyW
      have hzC0 := hC1 z hzV (hfrE y hz)
      obtain ⟨x, hx1, hx2⟩ := mem_closure_iff.1 (frontier_subset_closure hz) _
        isOpen_interior.connectedComponentIn (mem_connectedComponentIn hzV)
      have hCyV : connectedComponentIn O y ⊆ V := by
        rw [hVdef]
        exact interior_maximal (fun w hw hwW => Set.disjoint_left.1 (hdisjW y hyO hyW) hw hwW)
          hOo.connectedComponentIn
      have hxy : x ∈ connectedComponentIn V y :=
        isPreconnected_connectedComponentIn.subset_connectedComponentIn
          (mem_connectedComponentIn hyO) hCyV hx2
      rw [hC0def, connectedComponentIn_eq hzC0, connectedComponentIn_eq hx1,
        ← connectedComponentIn_eq hxy]
      exact mem_connectedComponentIn hyV
  have hC0eq : C0 = V := Set.Subset.antisymm hC0V hVC0
  rw [← hC0eq, hC0def]
  exact isConnected_connectedComponentIn_iff.2 hx0V

/-- Step 2 of the blueprint proof of `outsideAnchoredGrouping`: defining `H_carrier`. -/
private lemma outsideAnchoredGrouping_step2_H (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier)
    (E : Set Pt) (hE_conn : IsConnected (interior E))
    (hE_supset : (square c h + Binf (3 * M.D))ᶜ ⊆ interior E)
    (hE_faces : ∀ F ∈ S.tiles, (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ E)
    (hE_def : E = Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier) :
    ∃ H_carrier : Set Pt, square c h + Binf (2 * M.D) ⊆ H_carrier ∧
      H_carrier ⊆ square c h + Binf (3 * M.D) ∧
      H_carrier = closure (connectedComponentIn (Eᶜ) c) ∧
      IsConnected (interior H_carrier) ∧ IsConnected (H_carrierᶜ) := by
  use closure (connectedComponentIn (Eᶜ) c)
  refine ⟨?_, ?_, rfl, ?_, ?_⟩
  · exact outsideAnchoredGrouping_step2_H_step1_lower M S Ω hcov hsts c h hh hQ E hE_conn hE_supset
      hE_faces hE_def
  · exact outsideAnchoredGrouping_step2_H_step2_upper M S Ω hcov hsts c h hh hQ E hE_conn hE_supset
      hE_faces hE_def
  · exact outsideAnchoredGrouping_step2_H_step3_conn_int M S Ω hcov hsts c h hh hQ E hE_conn
      hE_supset hE_faces hE_def
  · exact outsideAnchoredGrouping_step2_H_step4_conn_comp M S Ω hcov hsts c h hh hQ E hE_conn
      hE_supset hE_faces hE_def

/-! The remaining step is the cellulation identification of the component closure. -/

/-- A nonempty open set covered by finitely many closed sets meets the interior of one
of them. -/
private lemma outsideAnchoredGrouping_open_cover_interior {ι : Type*} (F : ι → Set Pt)
    (hF : ∀ i, IsClosed (F i)) :
    ∀ (s : Finset ι) (U : Set Pt), IsOpen U → U.Nonempty → U ⊆ ⋃ i ∈ s, F i →
      ∃ i ∈ s, (U ∩ interior (F i)).Nonempty := by
  classical
  intro s
  induction s using Finset.induction_on with
  | empty =>
      intro U _ hUne hUsub
      obtain ⟨x, hx⟩ := hUne
      simpa using hUsub hx
  | @insert i s his ih =>
      intro U hUo hUne hUsub
      by_cases hsub : U ⊆ F i
      · exact ⟨i, Finset.mem_insert_self _ _, hUne.mono fun x hx =>
          ⟨hx, interior_maximal hsub hUo hx⟩⟩
      · obtain ⟨x, hxU, hxi⟩ := Set.not_subset.1 hsub
        obtain ⟨j, hjs, hj⟩ := ih (U \ F i) (hUo.sdiff (hF i)) ⟨x, hxU, hxi⟩ (by
          intro y hy
          have hy' := hUsub hy.1
          simp only [Finset.mem_insert, Set.mem_iUnion, exists_prop] at hy'
          obtain ⟨j, hj, hyF⟩ := hy'
          rcases hj with rfl | hj
          · exact absurd hyF hy.2
          · exact Set.mem_iUnion₂.2 ⟨j, hj, hyF⟩)
        exact ⟨j, Finset.mem_insert_of_mem hjs,
          hj.mono fun y hy => ⟨hy.1.1, hy.2⟩⟩

/-- Step 1 of the blueprint proof of `outsideAnchoredGrouping_step3_FaceGroup`: the closure
of the component selected by `H_carrier` is the support of a finite nonempty set of complete
faces of the patch, and this support lies in the interior of the covered polygonal disk. -/
private lemma outsideAnchoredGrouping_step3_FaceGroup_step1_component_faces
    (M : MeshConstants P) (S : Patch P) (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier)
    (E : Set Pt) (hE_conn : IsConnected (interior E))
    (hE_supset : (square c h + Binf (3 * M.D))ᶜ ⊆ interior E)
    (hE_faces : ∀ F ∈ S.tiles,
      (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ E)
    (hE_def : E = Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles,
      ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier)
    (H_carrier : Set Pt) (hH_sub : H_carrier ⊆ square c h + Binf (3 * M.D))
    (hH_def : H_carrier = closure (connectedComponentIn (Eᶜ) c)) :
    ∃ G : Set (PlacedTile P), G ⊆ S.tiles ∧ G.Finite ∧ G.Nonempty ∧
      support G = H_carrier ∧ support G ⊆ interior Ω.carrier := by
  classical
  have _ := hsts
  have _ := hE_conn
  set K := square c h + Binf (3 * M.D) with hKdef
  set A : Set (PlacedTile P) :=
    {F ∈ S.tiles | (interior F.carrier ∩ Kᶜ).Nonempty} with hAdef
  have hAS : A ⊆ S.tiles := fun F hF => hF.1
  have hAfin : A.Finite := S.finite.subset hAS
  have hEsupport : E = Ω.carrierᶜ ∪ support A := by
    rw [hE_def]
    congr 1
    ext x
    simp only [hAdef, hKdef, mem_support_iff', Set.mem_setOf_eq, Set.mem_iUnion,
      exists_prop]
    constructor
    · rintro ⟨F, hFS, hF, hxF⟩
      exact ⟨F, ⟨hFS, hF⟩, hxF⟩
    · rintro ⟨F, ⟨hFS, hF⟩, hxF⟩
      exact ⟨F, hFS, hF, hxF⟩
  have hKΩ : K ⊆ interior Ω.carrier := by
    rw [hKdef]
    exact (Set.add_subset_add_left (rg_binf_mono (by linarith [M.D_pos]))).trans hQ
  set O := Eᶜ with hOdef
  have hOK : O ⊆ K := by
    intro x hxO
    by_contra hxK
    exact hxO (interior_subset (hE_supset (by rwa [hKdef])))
  have hOeq : O = interior Ω.carrier ∩ (support A)ᶜ := by
    ext x
    constructor
    · intro hxO
      have hxΩ := hKΩ (hOK hxO)
      rw [hOdef, hEsupport] at hxO
      exact ⟨hxΩ, fun hxA => hxO (Or.inr hxA)⟩
    · rintro ⟨hxΩ, hxA⟩
      rw [hOdef, hEsupport]
      exact fun hxE => hxE.elim (fun hxΩc => hxΩc (interior_subset hxΩ)) hxA
  have hOo : IsOpen O := by
    rw [hOeq]
    exact isOpen_interior.inter (support_isClosed hAfin).isOpen_compl
  set W := connectedComponentIn O c with hWdef
  have hWo : IsOpen W := by
    rw [hWdef]
    exact hOo.connectedComponentIn
  have hWO : W ⊆ O := by
    rw [hWdef]
    exact connectedComponentIn_subset O c
  set G : Set (PlacedTile P) := {F ∈ S.tiles | interior F.carrier ⊆ W} with hGdef
  have hGS : G ⊆ S.tiles := fun F hF => hF.1
  have hGfin : G.Finite := S.finite.subset hGS
  have hstay : ∀ F ∈ S.tiles, (interior F.carrier ∩ W).Nonempty →
      interior F.carrier ⊆ W := by
    intro F hFS hmeet
    obtain ⟨z, hzF, hzW⟩ := hmeet
    have hFA : F ∉ A := by
      intro hFA
      exact hWO hzW (hE_faces F hFS (by simpa [hKdef] using hFA.2)
        (interior_subset hzF))
    have hFsubO : interior F.carrier ⊆ O := by
      intro x hxF
      rw [hOeq]
      refine ⟨?_, ?_⟩
      · rw [← hcov]
        exact interior_mono (carrier_subset_support hFS) hxF
      · intro hxA
        obtain ⟨B, hBA, hxB⟩ := mem_support_iff'.1 hxA
        exact interior_not_mem_other S.disjoint hFS (hAS hBA) (fun h => hFA (h ▸ hBA)) hxF hxB
    have hcomp :=
      (tileDisk F).interior_pathConnected.isConnected.isPreconnected.subset_connectedComponentIn
        hzF hFsubO
    rw [← connectedComponentIn_eq (hWdef ▸ hzW)] at hcomp
    simpa [hWdef] using hcomp
  have hWsubS : W ⊆ support S.tiles := by
    intro x hxW
    rw [hcov]
    exact interior_subset ((hOeq ▸ hWO hxW).1)
  have hWcover : W ⊆ support G := by
    intro x hxW
    have hxcl : x ∈ closure (support G) := by
      rw [Metric.mem_closure_iff]
      intro ε hε
      set U := Metric.ball x ε ∩ W with hUdef
      have hUo : IsOpen U := Metric.isOpen_ball.inter hWo
      have hUne : U.Nonempty := ⟨x, Metric.mem_ball_self hε, hxW⟩
      have hUsub : U ⊆ ⋃ F ∈ S.finite.toFinset, F.carrier := by
        intro y hy
        obtain ⟨F, hFS, hyF⟩ := mem_support_iff'.1 (hWsubS hy.2)
        exact Set.mem_iUnion₂.2 ⟨F, Set.Finite.mem_toFinset S.finite |>.2 hFS, hyF⟩
      obtain ⟨F, hFfin, y, hyU, hyF⟩ :=
        outsideAnchoredGrouping_open_cover_interior (fun F : PlacedTile P => F.carrier)
          (fun F => tile_isClosed F) S.finite.toFinset U hUo hUne hUsub
      have hFS : F ∈ S.tiles := Set.Finite.mem_toFinset S.finite |>.1 hFfin
      have hFG : F ∈ G := ⟨hFS, hstay F hFS ⟨y, hyF, hyU.2⟩⟩
      refine ⟨y, carrier_subset_support hFG (interior_subset hyF), ?_⟩
      rw [hUdef] at hyU
      simpa [Metric.mem_ball, dist_comm] using hyU.1
    exact (support_isClosed hGfin).closure_eq ▸ hxcl
  have hGsubcl : support G ⊆ closure W := by
    intro x hx
    obtain ⟨F, hFG, hxF⟩ := mem_support_iff'.1 hx
    have hxcl : x ∈ closure (interior F.carrier) := by
      rw [tile_regular]
      exact hxF
    exact closure_mono hFG.2 hxcl
  have hclsubG : closure W ⊆ support G :=
    closure_minimal hWcover (support_isClosed hGfin)
  have hsupport : support G = closure W := Set.Subset.antisymm hGsubcl hclsubG
  have hcK : c ∈ K := by
    rw [hKdef]
    refine Set.mem_add.2 ⟨c, ?_, 0, ?_, by simp⟩
    · simp only [square, Set.mem_setOf_eq, sub_self, abs_zero]
      exact ⟨hh.le, hh.le⟩
    · simp only [Binf, Set.mem_setOf_eq, PiLp.zero_apply, abs_zero]
      exact ⟨by linarith [M.D_pos], by linarith [M.D_pos]⟩
  have hcO : c ∈ O := by
    rw [hOeq]
    refine ⟨hKΩ hcK, ?_⟩
    intro hcA
    obtain ⟨F, hFA, hcF⟩ := mem_support_iff'.1 hcA
    obtain ⟨w, hwF, hwK⟩ := hFA.2
    apply hwK
    rw [hKdef]
    refine Set.mem_add.2 ⟨c, ?_, w - c, ?_, by abel⟩
    · simp only [square, Set.mem_setOf_eq, sub_self, abs_zero]
      exact ⟨hh.le, hh.le⟩
    · refine ⟨?_, ?_⟩
      · exact (rg_tile_coord M F (interior_subset hwF) hcF 0).trans (by
          linarith [M.D_pos])
      · exact (rg_tile_coord M F (interior_subset hwF) hcF 1).trans (by
          linarith [M.D_pos])
  have hWne : W.Nonempty := ⟨c, hWdef ▸ mem_connectedComponentIn hcO⟩
  have hGne : G.Nonempty := by
    obtain ⟨x, hxW⟩ := hWne
    obtain ⟨F, hFG, -⟩ := mem_support_iff'.1 (hWcover hxW)
    exact ⟨F, hFG⟩
  have hG_eq : support G = H_carrier := by
    rw [hsupport, hWdef, hH_def]
  have hGcov : support G ⊆ interior Ω.carrier := by
    rw [hG_eq]
    exact hH_sub.trans hKΩ
  exact ⟨G, hGS, hGfin, hGne, hG_eq, hGcov⟩

private lemma outsideAnchoredGrouping_step3_FaceGroup (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier)
    (E : Set Pt) (hE_conn : IsConnected (interior E))
    (hE_supset : (square c h + Binf (3 * M.D))ᶜ ⊆ interior E)
    (hE_faces : ∀ F ∈ S.tiles, (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ E)
    (hE_def : E = Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier)
    (H_carrier : Set Pt) (hH_sub : H_carrier ⊆ square c h + Binf (3 * M.D))
    (hH_def : H_carrier = closure (connectedComponentIn (Eᶜ) c)) :
    ∃ H : FaceGroup S.tiles, H.carrier = H_carrier := by
  have s2 := outsideAnchoredGrouping_step2_H M S Ω hcov hsts c h hh hQ E hE_conn
    hE_supset hE_faces hE_def
  rcases s2 with ⟨H', -, -, hH'_def, hH'_conn_int, hH'_conn_comp⟩
  have hH_conn_int : IsConnected (interior H_carrier) := by
    rw [hH_def, ← hH'_def]
    exact hH'_conn_int
  have hH_conn_comp : IsConnected H_carrierᶜ := by
    rw [hH_def, ← hH'_def]
    exact hH'_conn_comp
  obtain ⟨G, hG_sub, hG_fin, hG_ne, hG_eq, hG_cov⟩ :=
    outsideAnchoredGrouping_step3_FaceGroup_step1_component_faces M S Ω hcov hsts c h hh hQ E
      hE_conn hE_supset hE_faces hE_def H_carrier hH_sub hH_def
  have hG_cov' : support G ⊆ interior (support S.tiles) := by
    rw [hcov]
    exact hG_cov
  have hG_conn_int : IsConnected (interior (support G)) := by
    rw [hG_eq]
    exact hH_conn_int
  have hG_conn_comp : IsConnected (support G)ᶜ := by
    rw [hG_eq]
    exact hH_conn_comp
  obtain ⟨H, hH_faces⟩ := polygonalJordanBoundary S.tiles S.disjoint hsts G hG_sub hG_fin hG_ne
    hG_cov' hG_conn_int hG_conn_comp
  refine ⟨H, ?_⟩
  rw [FaceGroup.carrier, H.carrier_eq, hH_faces, hG_eq]

private lemma JSetup.boundary_partner {S G : Set (PlacedTile P)} (J : JSetup S G)
    (hS_fin : S.Finite) {A : PlacedTile P} (hA : A ∈ G)
    (i : Fin (P.disk A.form).n) {q : Pt}
    (hq : q ∈ openSegment ℝ (A.vertex i) (A.vertex (finRotate _ i)))
    (hq_frontier : q ∈ frontier (support G)) :
    ∃ F ∈ S, F ∉ G ∧ ∃ j, F.side j = A.side i := by
  have hboundary : ∀ A' ∈ G, A' ≠ A → ¬ HasEdge A' (A.side i) := by
    intro A' hA' hA'A ⟨j, hj⟩
    exact hq_frontier.2 (J.partnered_open_in_U hA hA' hA'A i j hj hq)
  obtain ⟨r, hr, σ, hσ, hside⟩ := J.bedge_sides hA i hboundary hq
  have hq_support : q ∈ interior (support S) :=
    J.cov (carrier_subset_support hA (tile_side_subset A i (openSeg_mem_side A i hq)))
  obtain ⟨ρ, hρ, hρ_support⟩ := Metric.isOpen_iff.1 isOpen_interior q hq_support
  have hclosed : IsClosed (support (S \ G)) :=
    support_isClosed (show (S \ G).Finite from hS_fin.diff)
  have hq_closure : q ∈ closure (support (S \ G)) := by
    rw [Metric.mem_closure_iff]
    intro ε hε
    have hd : A.vertex (finRotate _ i) - A.vertex i ≠ 0 :=
      sub_ne_zero.2 (tile_vertex_ne_next A i).symm
    have hnegσ : -σ = 1 ∨ -σ = -1 := by
      rcases hσ with hσ | hσ <;> rw [hσ] <;> norm_num
    obtain ⟨y, hy, hycross⟩ :=
      exists_near_off_line (A.vertex i) hd q hnegσ (lt_min hε (lt_min hr hρ))
    have hqcross : jcr (A.vertex (finRotate _ i) - A.vertex i) (q - A.vertex i) = 0 :=
      jcr_zero_of_mem_segment (openSegment_subset_segment ℝ _ _ hq)
    have hyball_r : y ∈ Metric.ball q r := by
      rw [Metric.mem_ball, dist_comm]
      exact lt_of_lt_of_le hy (min_le_right _ _ |>.trans (min_le_left _ _))
    have hyball_ρ : y ∈ Metric.ball q ρ := by
      rw [Metric.mem_ball, dist_comm]
      exact lt_of_lt_of_le hy (min_le_right _ _ |>.trans (min_le_right _ _))
    have hy_not : y ∉ support G := (hside y hyball_r).2 (by rw [hqcross, mul_zero] at hycross; linarith)
    obtain ⟨F, hFS, hyF⟩ := mem_support_iff'.1 (interior_subset (hρ_support hyball_ρ))
    have hFG : F ∉ G := fun h => hy_not (carrier_subset_support h hyF)
    refine ⟨y, carrier_subset_support (show F ∈ S \ G from ⟨hFS, hFG⟩) hyF, ?_⟩
    exact lt_of_lt_of_le hy (min_le_left _ _)
  have hq_diff : q ∈ support (S \ G) := by
    rw [← hclosed.closure_eq]
    exact hq_closure
  obtain ⟨F, ⟨hFS, hFG⟩, hqF⟩ := mem_support_iff'.1 hq_diff
  have hAF : A ≠ F := fun h => hFG (h ▸ hA)
  have hq_not_vertex : q ∉ F.vertexSet := fun h => J.no_vertex hA hFS i hq h
  obtain ⟨j, hj⟩ := tile_partner J.disj J.sts (J.sub hA) hFS hAF i hq hqF hq_not_vertex
  exact ⟨F, hFS, hFG, j, hj⟩

private lemma side_partner_unique {S : Set (PlacedTile P)} (hdisj : DisjointInteriors S)
    {A B C : PlacedTile P} (hA : A ∈ S) (hB : B ∈ S) (hC : C ∈ S)
    (hAB : A ≠ B) (hAC : A ≠ C) (i : Fin (P.disk A.form).n)
    (j : Fin (P.disk B.form).n) (k : Fin (P.disk C.form).n)
    (hj : B.side j = A.side i) (hk : C.side k = A.side i) : B = C := by
  by_contra hBC
  let q := A.vertex i + (1 / 2 : ℝ) • (A.vertex (finRotate _ i) - A.vertex i)
  have hq : q ∈ openSegment ℝ (A.vertex i) (A.vertex (finRotate _ i)) :=
    mem_openSegment_iff'.2 ⟨1 / 2, by norm_num, by norm_num, rfl⟩
  obtain ⟨r, hr, σ, hσ, hsB⟩ := two_sides hdisj hA hB hAB i j hj hq
  obtain ⟨r', hr', σ', hσ', hsC⟩ := two_sides hdisj hA hC hAC i k hk hq
  let d := A.vertex (finRotate _ i) - A.vertex i
  have hd : d ≠ 0 := sub_ne_zero.2 (tile_vertex_ne_next A i).symm
  have hqcross : jcr d (q - A.vertex i) = 0 := by
    dsimp [q, d]
    rw [add_sub_cancel_left, jcr_smul_right, jcr_self, mul_zero]
  have hσσ' : σ' = σ := by
    by_contra hne
    have heq : σ' = -σ := by
      rcases hσ with rfl | rfl
      · rcases hσ' with rfl | rfl
        · exact (hne rfl).elim
        · norm_num
      · rcases hσ' with rfl | rfl
        · norm_num
        · exact (hne rfl).elim
    obtain ⟨y, hy, hycross⟩ := exists_near_off_line (A.vertex i) hd q hσ (lt_min hr hr')
    have hyr : y ∈ Metric.ball q r := by
      rw [Metric.mem_ball, dist_comm]
      exact lt_of_lt_of_le hy (min_le_left _ _)
    have hyr' : y ∈ Metric.ball q r' := by
      rw [Metric.mem_ball, dist_comm]
      exact lt_of_lt_of_le hy (min_le_right _ _)
    have hpos : 0 < σ * jcr d (y - A.vertex i) := by
      rw [hqcross, mul_zero] at hycross
      exact hycross
    exact interiors_disjoint hdisj hA hC hAC ((hsB y hyr).1 hpos)
      ((hsC y hyr').2.1 (by rw [heq]; linarith))
  have hnegσ : -σ = 1 ∨ -σ = -1 := by
    rcases hσ with hσ | hσ <;> rw [hσ] <;> norm_num
  obtain ⟨y, hy, hycross⟩ := exists_near_off_line (A.vertex i) hd q hnegσ (lt_min hr hr')
  have hyr : y ∈ Metric.ball q r := by
    rw [Metric.mem_ball, dist_comm]
    exact lt_of_lt_of_le hy (min_le_left _ _)
  have hyr' : y ∈ Metric.ball q r' := by
    rw [Metric.mem_ball, dist_comm]
    exact lt_of_lt_of_le hy (min_le_right _ _)
  have hneg : σ * jcr d (y - A.vertex i) < 0 := by
    rw [hqcross, mul_zero] at hycross
    linarith
  exact interiors_disjoint hdisj hB hC hBC ((hsB y hyr).2.1 hneg)
    ((hsC y hyr').2.1 (by rw [hσσ']; exact hneg))

private lemma outsideAnchoredGrouping_step4_anchor (M : MeshConstants P) (S : Patch P)
    (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier)
    (E : Set Pt)
    (hE_faces : ∀ F ∈ S.tiles, (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty →
      F.carrier ⊆ E)
    (hE_def : E = Ω.carrierᶜ ∪ ⋃ F ∈ S.tiles, ⋃ _ : (interior F.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty, F.carrier)
    (H : FaceGroup S.tiles) (hH_sub : H.carrier ⊆ square c h + Binf (3 * M.D))
    (hH_def : H.carrier = closure (connectedComponentIn (Eᶜ) c))
    (hH_conn_int : IsConnected (interior H.carrier))
    (hH_conn_comp : IsConnected (H.carrierᶜ)) :
    H.OutsideAnchored (square c h + Binf (3 * M.D)) := by
  classical
  have hD_pos : 0 < M.D := by
    by_cases hall : 0 < h ∧ IsConnected (interior H.carrier) ∧ IsConnected (H.carrierᶜ)
    · exact M.D_pos
    · exact (hall ⟨hh, hH_conn_int, hH_conn_comp⟩).elim
  have hbuffer : square c h + Binf (3 * M.D) ⊆
      square c h + Binf (10 * M.D) :=
    Set.add_subset_add_left (rg_binf_mono (by nlinarith [hD_pos]))
  have hfaces_cov : support H.faces ⊆ interior (support S.tiles) := by
    rw [← H.carrier_eq, hcov]
    exact hH_sub.trans (hbuffer.trans hQ)
  let J : JSetup S.tiles H.faces :=
    ⟨S.disjoint, hsts, H.faces_sub, H.finite, hfaces_cov⟩
  intro i
  obtain ⟨A, hAH, j, hAj⟩ := H.side_whole i
  let q := A.vertex j + (1 / 2 : ℝ) • (A.vertex (finRotate _ j) - A.vertex j)
  have hq : q ∈ openSegment ℝ (A.vertex j) (A.vertex (finRotate _ j)) := by
    exact mem_openSegment_iff'.2 ⟨1 / 2, by norm_num, by norm_num, rfl⟩
  have hq_side : q ∈ H.disk.side i := by
    rw [← hAj]
    exact openSeg_mem_side A j hq
  have hq_frontier_disk : q ∈ frontier H.disk.carrier := by
    rw [H.disk.frontier_eq]
    exact Set.mem_iUnion.2 ⟨i, hq_side⟩
  have hq_frontier : q ∈ frontier (support H.faces) := by
    rw [← H.carrier_eq]
    exact hq_frontier_disk
  obtain ⟨F, hFS, hFH, k, hk⟩ := J.boundary_partner S.finite hAH j hq hq_frontier
  refine ⟨F, hFS, hFH, ⟨k, hk.trans hAj⟩, ?_⟩
  by_contra hF_not_selected
  have hAF : A ≠ F := fun h => hFH (h ▸ hAH)
  have hA_not_selected :
      ¬ (interior A.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty := by
    intro hA_selected
    have hAE : A.carrier ⊆ E := hE_faces A (H.faces_sub hAH) hA_selected
    obtain ⟨z, hzA⟩ := (tileDisk A).interior_nonempty
    have hAH_carrier : A.carrier ⊆ H.carrier := by
      intro x hx
      change x ∈ H.disk.carrier
      rw [H.carrier_eq]
      exact carrier_subset_support hAH hx
    have hzH : z ∈ interior H.carrier := interior_mono hAH_carrier hzA
    have hz_closure : z ∈ closure (connectedComponentIn (Eᶜ) c) := by
      rw [← hH_def]
      exact interior_subset hzH
    obtain ⟨x, hxA, hx_component⟩ :=
      mem_closure_iff.1 hz_closure (interior A.carrier) isOpen_interior hzA
    exact (connectedComponentIn_subset (Eᶜ) c hx_component) (hAE (interior_subset hxA))
  let T : Set (PlacedTile P) :=
    {D | D ∈ S.tiles ∧ (interior D.carrier ∩ (square c h + Binf (3 * M.D))ᶜ).Nonempty}
  have hT_fin : T.Finite := S.finite.subset (fun D hD => hD.1)
  have hT_closed : IsClosed (support T) := support_isClosed hT_fin
  have hq_not_selected_support : q ∉ support T := by
    intro hqT
    obtain ⟨D, ⟨hDS, hD_selected⟩, hqD⟩ := mem_support_iff'.1 hqT
    by_cases hDA : D = A
    · exact hA_not_selected (hDA ▸ hD_selected)
    have hqD_not_vertex : q ∉ D.vertexSet := fun hv => J.no_vertex hAH hDS j hq hv
    obtain ⟨l, hl⟩ := tile_partner S.disjoint hsts (H.faces_sub hAH) hDS (Ne.symm hDA) j hq hqD hqD_not_vertex
    have hFD : F = D :=
      side_partner_unique S.disjoint (H.faces_sub hAH) hFS hDS hAF (Ne.symm hDA) j k l hk hl
    exact hF_not_selected (hFD ▸ hD_selected)
  have hqH : q ∈ H.carrier := by
    change q ∈ H.disk.carrier
    exact pd_frontier_subset_carrier H.disk hq_frontier_disk
  have hqOmega : q ∈ interior Ω.carrier := hQ (hbuffer (hH_sub hqH))
  obtain ⟨rΩ, hrΩ, hrΩ_sub⟩ := Metric.isOpen_iff.1 isOpen_interior q hqOmega
  obtain ⟨rT, hrT, hrT_sub⟩ := Metric.isOpen_iff.1 hT_closed.isOpen_compl q hq_not_selected_support
  let r := min rΩ rT
  have hr : 0 < r := lt_min hrΩ hrT
  have hball_Ec : Metric.ball q r ⊆ Eᶜ := by
    intro x hx hxE
    rw [hE_def] at hxE
    rcases hxE with hxΩ | hx_selected
    · exact hxΩ (interior_subset (hrΩ_sub (Metric.ball_subset_ball (min_le_left _ _) hx)))
    · simp only [Set.mem_iUnion] at hx_selected
      obtain ⟨D, hDS, hD_selected, hxD⟩ := hx_selected
      exact (hrT_sub (Metric.ball_subset_ball (min_le_right _ _) hx))
        (carrier_subset_support (show D ∈ T from ⟨hDS, hD_selected⟩) hxD)
  have hq_component_closure : q ∈ closure (connectedComponentIn (Eᶜ) c) := by
    rw [← hH_def]
    exact hqH
  obtain ⟨x, hx_ball, hx_component⟩ :=
    mem_closure_iff.1 hq_component_closure (Metric.ball q r) Metric.isOpen_ball (Metric.mem_ball_self hr)
  have hqF : q ∈ F.carrier := tile_side_subset F k (by rw [hk]; exact openSeg_mem_side A j hq)
  have hqF_closure : q ∈ closure (interior F.carrier) := by
    rw [tile_regular]
    exact hqF
  obtain ⟨y, hy_ball, hyF⟩ :=
    mem_closure_iff.1 hqF_closure (Metric.ball q r) Metric.isOpen_ball (Metric.mem_ball_self hr)
  have hball_component : Metric.ball q r ⊆ connectedComponentIn (Eᶜ) x :=
    (convex_ball q r).isPreconnected.subset_connectedComponentIn hx_ball hball_Ec
  have hy_component : y ∈ connectedComponentIn (Eᶜ) c := by
    rw [connectedComponentIn_eq hx_component]
    exact hball_component hy_ball
  have hyH : y ∈ H.carrier := by
    rw [hH_def]
    exact subset_closure hy_component
  change y ∈ H.disk.carrier at hyH
  rw [H.carrier_eq] at hyH
  obtain ⟨D, hDH, hyD⟩ := mem_support_iff'.1 hyH
  exact interior_not_mem_other S.disjoint hFS (H.faces_sub hDH)
    (fun h => hFH (h ▸ hDH)) hyF hyD

/-- `lem:outside-grouping`: with `Q₁ + B∞(10D) ⊂ int Ω` and `K₁ = Q₁ + B∞(3D)`
there is a group `H` with `Q₁ + B∞(2D) ⊂ H ⊂ K₁`, outside-anchored at `K₁`,
whose open complement is connected. -/
theorem outsideAnchoredGrouping (M : MeshConstants P) (S : Patch P) (Ω : PolygonalDisk)
    (hcov : support S.tiles = Ω.carrier) (hsts : SideToSideSet S.tiles)
    (c : Pt) (h : ℝ) (hh : 0 < h)
    (hQ : square c h + Binf (10 * M.D) ⊆ interior Ω.carrier) :
    ∃ H : FaceGroup S.tiles, square c h + Binf (2 * M.D) ⊆ H.carrier ∧
      H.carrier ⊆ square c h + Binf (3 * M.D) ∧
      H.OutsideAnchored (square c h + Binf (3 * M.D)) ∧ IsConnected (H.carrier)ᶜ := by
  have s1 := outsideAnchoredGrouping_step1_E M S Ω hcov hsts c h hh hQ
  rcases s1 with ⟨E, ⟨hE_conn, hE_supset, hE_faces⟩, hE_def⟩
  have s2 := outsideAnchoredGrouping_step2_H M S Ω hcov hsts c h hh hQ E hE_conn
    hE_supset hE_faces hE_def
  rcases s2 with ⟨H_carrier, hH_supset, hH_subset, hH_def, hH_conn_int, hH_conn_comp⟩
  have s3 := outsideAnchoredGrouping_step3_FaceGroup M S Ω hcov hsts c h hh hQ E hE_conn
    hE_supset hE_faces hE_def H_carrier hH_subset hH_def
  rcases s3 with ⟨H, hH_eq⟩
  use H
  rw [hH_eq]
  refine ⟨hH_supset, hH_subset, ?_, hH_conn_comp⟩
  rw [← hH_eq] at hH_subset hH_def hH_conn_int hH_conn_comp
  exact outsideAnchoredGrouping_step4_anchor M S Ω hcov hsts c h hh hQ E hE_faces hE_def H
    hH_subset hH_def hH_conn_int hH_conn_comp

/-! ## Spokes and annular groups -/

/-- A system of `4N` skeletal spokes in the annulus `H \ int L` and the `4N`
annular groups obtained by cutting along them (`lem:annular-spokes`).  The
`j`-th group lies between spokes `j` and `j + 1` (cyclically). -/
structure SpokeSystem (S : Set (PlacedTile P)) (L H : FaceGroup S) (N : ℕ) where
  spoke : Fin (4 * N) → PolyArc
  simple : ∀ j, (spoke j).IsSimple
  skeletal : ∀ j, (spoke j).IsSkeletal S
  in_annulus : ∀ j, (spoke j).carrier ⊆ H.carrier \ interior L.carrier
  meets_L : ∀ j, (spoke j).carrier ∩ frontier L.carrier = {(spoke j).start}
  meets_H : ∀ j, (spoke j).carrier ∩ frontier H.carrier = {(spoke j).stop}
  disjoint : ∀ i j, i ≠ j → Disjoint (spoke i).carrier (spoke j).carrier
  order : MatchingCyclicOrder (H.carrier \ interior L.carrier) (frontier H.carrier)
    (frontier L.carrier) (fun j => (spoke j).stop) (fun j => (spoke j).start)
  piece : Fin (4 * N) → FaceGroup S
  piece_partition : ∀ A ∈ S, (A ∈ H.faces ∧ A ∉ L.faces) ↔ ∃! j, A ∈ (piece j).faces
  /-- every piece is made of faces of `H` that are not faces of `L` (with `piece_partition`:
  the pieces partition the faces of `H \ L`, and no piece contains any other face) -/
  piece_sub : ∀ j, (piece j).faces ⊆ H.faces \ L.faces
  piece_between : ∀ j,
    (spoke j).carrier ⊆ (piece j).carrier ∧
      (spoke (finRotate (4 * N) j)).carrier ⊆ (piece j).carrier
  contact_connected : ∀ j, IsConnected ((piece j).carrier ∩ L.carrier)
  contact_nondegenerate : ∀ j, ((piece j).carrier ∩ L.carrier).Nontrivial

/-- The full annular grouping around the centre `c`: `Q₀ = square c (NR/2)`,
`Q₁ = square c (NR/2 + R)`, `K₁ = Q₁ + B∞(3D)`, the inside-anchored group `L`,
the outside-anchored group `H`, and a spoke system between them. -/
structure AnnularGrouping (M : MeshConstants P) (S : Set (PlacedTile P)) (c : Pt) (N : ℕ)
    (R : ℝ) where
  L : FaceGroup S
  H : FaceGroup S
  L_lower : square c ((N : ℝ) * R / 2) ⊆ L.carrier
  L_upper : L.carrier ⊆ square c ((N : ℝ) * R / 2) + Binf M.D
  L_anchor : L.InsideAnchored (square c ((N : ℝ) * R / 2))
  H_lower : square c ((N : ℝ) * R / 2 + R) + Binf (2 * M.D) ⊆ H.carrier
  H_upper : H.carrier ⊆ square c ((N : ℝ) * R / 2 + R) + Binf (3 * M.D)
  H_anchor : H.OutsideAnchored (square c ((N : ℝ) * R / 2 + R) + Binf (3 * M.D))
  spokes : SpokeSystem S L H N

/-! ### Helpers for `existsAnnularSpokes` -/

/-- The point at arclength parameter `t` on the boundary of the square `[-A, A]²`, starting at
the corner `(A, -A)` and running counterclockwise (a private copy of `squarePerimeterPoint`,
which is declared after `existsAnnularSpokes`; the two definitions are definitionally equal). -/
private def existsAnnularSpokes_pos (A t : ℝ) : Pt :=
  if t ≤ 2 * A then mkPt A (-A + t)
  else if t ≤ 4 * A then mkPt (A - (t - 2 * A)) A
  else if t ≤ 6 * A then mkPt (-A) (A - (t - 4 * A))
  else mkPt (-A + (t - 6 * A)) (-A)

/-- The `j`-th extended radial segment: the part of the ray from the centre `c` through the
`j`-th length-`R` position `v_j` of `∂Q₀` (`Q₀ = square c (NR/2)`, `v_j` at arclength `jR`)
between infinity norms `NR/2 - 3D` and `NR/2 + R + 6D` from `c`, i.e. the radial segment from
`∂Q₀` to `∂K₁` (`K₁ = square c (NR/2 + R + 3D)`) extended by `3D` past both squares. -/
private def existsAnnularSpokes_ray (c : Pt) (N : ℕ) (R D : ℝ) (j : ℕ) : Set Pt :=
  segment ℝ
    (c + (((N : ℝ) * R / 2 - 3 * D) / ((N : ℝ) * R / 2)) •
      existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R))
    (c + (((N : ℝ) * R / 2 + R + 6 * D) / ((N : ℝ) * R / 2)) •
      existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R))

/-- `existsAnnularSpokes_skelEdgeIn S Z u w`: the segment `[u, w]` is a complete listed side of
a tile of `S` (an edge of the original skeleton) and lies in `Z`.  Walks in the skeleton are
chains of this relation (`Relation.ReflTransGen`). -/
private def existsAnnularSpokes_skelEdgeIn (S : Set (PlacedTile P)) (Z : Set Pt) (u w : Pt) :
    Prop :=
  (∃ A ∈ S, HasEdge A (segment ℝ u w)) ∧ segment ℝ u w ⊆ Z

/-- Step 1 of the blueprint proof of `existsAnnularSpokes`: "Take concentric squares `Q₀, Q₁`
... with the margin required above."  Square buffers are nested with room to spare:
`square c a + B∞(r) ⊂ int (square c b + B∞(s))` whenever `a + r < b + s` (`b, s ≥ 0`).  In
particular `L ⊂ Q₀ + B∞(D)` lies in the interior of `H ⊃ Q₁ + B∞(2D)`, and
`H ⊂ Q₁ + B∞(3D)` lies in `int (Q₁ + B∞(10D)) ⊂ int Ω`. -/
private lemma existsAnnularSpokes_step1_nest (c : Pt) {a r b s : ℝ} (h : a + r < b + s)
    (hb : 0 ≤ b) (hs : 0 ≤ s) : square c a + Binf r ⊆ interior (square c b + Binf s) := by
  have hsum : square c a + Binf r ⊆ square c (a + r) := by
    rintro x ⟨u, hu, v, hv, rfl⟩
    refine ⟨?_, ?_⟩
    · simp only [PiLp.add_apply]
      calc
        |u 0 + v 0 - c 0| = |(u 0 - c 0) + v 0| := by
          congr 1
          ring_nf
        _ ≤ |u 0 - c 0| + |v 0| := abs_add_le _ _
        _ ≤ a + r := add_le_add hu.1 hv.1
    · simp only [PiLp.add_apply]
      calc
        |u 1 + v 1 - c 1| = |(u 1 - c 1) + v 1| := by
          congr 1
          ring_nf
        _ ≤ |u 1 - c 1| + |v 1| := abs_add_le _ _
        _ ≤ a + r := add_le_add hu.2 hv.2
  have hinner : square c (a + r) ⊆ interior (square c (b + s)) := by
    intro x hx
    rw [mem_interior_iff_mem_nhds, Metric.mem_nhds_iff]
    refine ⟨(b + s - (a + r)) / 2, by linarith, ?_⟩
    intro y hy
    rw [Metric.mem_ball] at hy
    have hy0 : |y 0 - x 0| ≤ dist y x := rg_coord_sub_le y x 0
    have hy1 : |y 1 - x 1| ≤ dist y x := rg_coord_sub_le y x 1
    refine ⟨?_, ?_⟩
    · calc
        |y 0 - c 0| = |(y 0 - x 0) + (x 0 - c 0)| := by
          congr 1
          ring_nf
        _ ≤ |y 0 - x 0| + |x 0 - c 0| := abs_add_le _ _
        _ ≤ dist y x + (a + r) := add_le_add hy0 hx.1
        _ ≤ b + s := (by linarith)
    · calc
        |y 1 - c 1| = |(y 1 - x 1) + (x 1 - c 1)| := by
          congr 1
          ring_nf
        _ ≤ |y 1 - x 1| + |x 1 - c 1| := abs_add_le _ _
        _ ≤ dist y x + (a + r) := add_le_add hy1 hx.2
        _ ≤ b + s := (by linarith)
  exact hsum.trans (hinner.trans (interior_mono (rg_square_add hb hs)))

/-- Technical bound for `existsAnnularSpokes_step2_tubes`: a boundary position
`existsAnnularSpokes_pos A t` (for `t` in the arclength range `[0, 8A]` of one full lap) has
coordinate vector of Euclidean norm at most `A√2`. -/
private lemma existsAnnularSpokes_step2_tubes_normLe {A t : ℝ} (h0 : 0 ≤ t) (h8 : t ≤ 8 * A) :
    (existsAnnularSpokes_pos A t 0) ^ 2 + (existsAnnularSpokes_pos A t 1) ^ 2 ≤ 2 * A ^ 2 := by
  unfold existsAnnularSpokes_pos
  split_ifs <;> simp [mkPt] <;> nlinarith

/-- Technical bound for `existsAnnularSpokes_step2_tubes`: a boundary position
`existsAnnularSpokes_pos A t` has coordinate vector of Euclidean norm at least `A` (one of its
two coordinates is exactly `±A`). -/
private lemma existsAnnularSpokes_step2_tubes_normGe (A t : ℝ) :
    A ^ 2 ≤ (existsAnnularSpokes_pos A t 0) ^ 2 + (existsAnnularSpokes_pos A t 1) ^ 2 := by
  unfold existsAnnularSpokes_pos
  split_ifs <;> simp [mkPt] <;>
    nlinarith [sq_nonneg (t - A), sq_nonneg (3 * A - t), sq_nonneg (5 * A - t),
      sq_nonneg (t - 7 * A)]

/-- Technical parametrization for `existsAnnularSpokes_step2_tubes`: every point of the `k`-th
extended radial segment is `c + μ • v_k` for some `μ` in the segment's ideal range of homothety
factors, `v_k` the `k`-th boundary position of `∂Q₀`. -/
private lemma existsAnnularSpokes_step2_tubes_rayMem {c : Pt} {N : ℕ} {R D : ℝ} (hR : 0 ≤ R)
    (hD : 0 ≤ D) (hA : 0 < (N : ℝ) * R / 2) {k : ℕ} {p : Pt}
    (hp : p ∈ existsAnnularSpokes_ray c N R D k) :
    ∃ μ : ℝ, ((N : ℝ) * R / 2 - 3 * D) / ((N : ℝ) * R / 2) ≤ μ ∧
      μ ≤ ((N : ℝ) * R / 2 + R + 6 * D) / ((N : ℝ) * R / 2) ∧
      p = c + μ • existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((k : ℝ) * R) := by
  unfold existsAnnularSpokes_ray at hp
  set A := (N : ℝ) * R / 2 with hAeq
  obtain ⟨t, ht0, ht1, hpe⟩ := mem_segment_iff'.1 hp
  have hk21 : (A - 3 * D) / A ≤ (A + R + 6 * D) / A := by
    rw [div_le_div_iff_of_pos_right hA]
    nlinarith
  refine ⟨(A - 3 * D) / A + t * ((A + R + 6 * D) / A - (A - 3 * D) / A), by nlinarith,
    by nlinarith, ?_⟩
  rw [hpe]
  module

/-- Lagrange's identity bound for `existsAnnularSpokes_step2_tubes`: the cross product `jcr u v`
is bounded by the product of the two Euclidean norms. -/
private lemma existsAnnularSpokes_step2_tubes_jcrSq (u v : Pt) :
    jcr u v ^ 2 ≤ (u 0 ^ 2 + u 1 ^ 2) * (v 0 ^ 2 + v 1 ^ 2) := by
  simp only [jcr]
  nlinarith [sq_nonneg (u 0 * v 0 + u 1 * v 1)]

/-- Elementary real-analysis fact for `existsAnnularSpokes_step2_tubes`: comparing squares of
nonnegative reals compares the reals. -/
private lemma existsAnnularSpokes_step2_tubes_sqLt {a b : ℝ} (_ha : 0 ≤ a) (hb : 0 ≤ b)
    (h : a ^ 2 < b ^ 2) : a < b := by
  by_contra hcon
  push_neg at hcon
  nlinarith [mul_self_le_mul_self hb hcon]

private lemma existsAnnularSpokes_step2_tubes_pos_cases {N : ℕ} {R : ℝ} (hR : 0 < R)
    {k : ℕ} (hk : k < 4 * N) :
    k ≤ N ∧ existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((k : ℝ) * R) =
        mkPt ((N : ℝ) * R / 2) (-((N : ℝ) * R / 2) + (k : ℝ) * R) ∨
    N < k ∧ k ≤ 2 * N ∧ existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((k : ℝ) * R) =
        mkPt (3 * ((N : ℝ) * R / 2) - (k : ℝ) * R) ((N : ℝ) * R / 2) ∨
    2 * N < k ∧ k ≤ 3 * N ∧ existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((k : ℝ) * R) =
        mkPt (-((N : ℝ) * R / 2)) (5 * ((N : ℝ) * R / 2) - (k : ℝ) * R) ∨
    3 * N < k ∧ existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((k : ℝ) * R) =
        mkPt ((k : ℝ) * R - 7 * ((N : ℝ) * R / 2)) (-((N : ℝ) * R / 2)) := by
  have hR0 : 0 ≤ R := hR.le
  have hA : 0 < (N : ℝ) * R / 2 := by
    have hN : 0 < N := by omega
    positivity
  have hkn : k ≤ N ∨ N < k ∧ k ≤ 2 * N ∨ 2 * N < k ∧ k ≤ 3 * N ∨ 3 * N < k := by
    omega
  rcases hkn with hkn | hkn | hkn | hkn
  · left
    refine ⟨hkn, ?_⟩
    unfold existsAnnularSpokes_pos
    have ht : (k : ℝ) * R ≤ 2 * ((N : ℝ) * R / 2) := by
      rw [div_eq_mul_inv]
      have hk' : (k : ℝ) ≤ N := by exact_mod_cast hkn
      nlinarith
    simp only [if_pos ht]
  · right; left
    refine ⟨hkn.1, hkn.2, ?_⟩
    unfold existsAnnularSpokes_pos
    have ht0 : ¬ ((k : ℝ) * R ≤ 2 * ((N : ℝ) * R / 2)) := by
      intro ht
      have hk' : (k : ℝ) ≤ N := by
        nlinarith
      have hkn' : (N : ℝ) < k := by exact_mod_cast hkn.1
      nlinarith
    have ht1 : (k : ℝ) * R ≤ 4 * ((N : ℝ) * R / 2) := by
      have hk' : (k : ℝ) ≤ 2 * N := by exact_mod_cast hkn.2
      nlinarith
    simp only [if_neg ht0, if_pos ht1]
    congr 1
    all_goals ring
  · right; right; left
    refine ⟨hkn.1, hkn.2, ?_⟩
    unfold existsAnnularSpokes_pos
    have ht0 : ¬ ((k : ℝ) * R ≤ 2 * ((N : ℝ) * R / 2)) := by
      intro ht
      have hk' : (k : ℝ) ≤ N := by nlinarith
      have hkn' : (2 * (N : ℝ)) < k := by exact_mod_cast hkn.1
      nlinarith
    have ht1 : ¬ ((k : ℝ) * R ≤ 4 * ((N : ℝ) * R / 2)) := by
      intro ht
      have hk' : (k : ℝ) ≤ 2 * N := by nlinarith
      have hkn' : (2 * (N : ℝ)) < k := by exact_mod_cast hkn.1
      nlinarith
    have ht2 : (k : ℝ) * R ≤ 6 * ((N : ℝ) * R / 2) := by
      have hk' : (k : ℝ) ≤ 3 * N := by exact_mod_cast hkn.2
      nlinarith
    simp only [if_neg ht0, if_neg ht1, if_pos ht2]
    congr 1
    all_goals ring
  · right; right; right
    refine ⟨hkn, ?_⟩
    unfold existsAnnularSpokes_pos
    have ht0 : ¬ ((k : ℝ) * R ≤ 2 * ((N : ℝ) * R / 2)) := by
      intro ht
      have hk' : (k : ℝ) ≤ N := by nlinarith
      have hkn' : (3 * (N : ℝ)) < k := by exact_mod_cast hkn
      nlinarith
    have ht1 : ¬ ((k : ℝ) * R ≤ 4 * ((N : ℝ) * R / 2)) := by
      intro ht
      have hk' : (k : ℝ) ≤ 2 * N := by nlinarith
      have hkn' : (3 * (N : ℝ)) < k := by exact_mod_cast hkn
      nlinarith
    have ht2 : ¬ ((k : ℝ) * R ≤ 6 * ((N : ℝ) * R / 2)) := by
      intro ht
      have hk' : (k : ℝ) ≤ 3 * N := by nlinarith
      have hkn' : (3 * (N : ℝ)) < k := by exact_mod_cast hkn
      nlinarith
    simp only [if_neg ht0, if_neg ht1, if_neg ht2]
    congr 1
    all_goals ring

/-! Each of the following is one pair of sides in the square-perimeter calculation. -/

/-- Step 1a of the blueprint proof: two marks on the first straight side. -/
private lemma existsAnnularSpokes_step2_tubes_step1_baseSep_s0s0 {N : ℕ} {R : ℝ}
    (hN : 2 ≤ N) (hR : 0 < R) {i j : ℕ} (hi : i < 4 * N) (hj : j < 4 * N)
    (hij : i < j) (hi0 : i ≤ N) (hj0 : j ≤ N) :
    existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R) =
        - existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R) ∨
      (N : ℝ) * R / 2 * R ≤
        |jcr (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R))
          (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R))| := by
  have _ := hN
  have _ := hi
  have _ := hj
  right
  set A := (N : ℝ) * R / 2
  have hA : 0 ≤ A := by
    dsimp [A]
    positivity
  have hi_le : (i : ℝ) * R ≤ 2 * A := by
    have hi' : (i : ℝ) ≤ (N : ℝ) := by
      exact_mod_cast hi0
    dsimp [A]
    exact (mul_le_mul_of_nonneg_right hi' hR.le).trans_eq (by ring)
  have hj_le : (j : ℝ) * R ≤ 2 * A := by
    have hj' : (j : ℝ) ≤ (N : ℝ) := by
      exact_mod_cast hj0
    dsimp [A]
    exact (mul_le_mul_of_nonneg_right hj' hR.le).trans_eq (by ring)
  have hi_pos :
      existsAnnularSpokes_pos A ((i : ℝ) * R) = mkPt A (-A + (i : ℝ) * R) := by
    unfold existsAnnularSpokes_pos
    rw [if_pos hi_le]
  have hj_pos :
      existsAnnularSpokes_pos A ((j : ℝ) * R) = mkPt A (-A + (j : ℝ) * R) := by
    unfold existsAnnularSpokes_pos
    rw [if_pos hj_le]
  rw [hi_pos, hj_pos]
  have hcross :
      jcr (mkPt A (-A + (i : ℝ) * R)) (mkPt A (-A + (j : ℝ) * R)) =
        A * R * ((j : ℝ) - (i : ℝ)) := by
    dsimp [jcr, mkPt]
    ring
  rw [hcross]
  have hdiff : (1 : ℝ) ≤ (j : ℝ) - (i : ℝ) := by
    have hij' : (i : ℝ) + 1 ≤ (j : ℝ) := by
      exact_mod_cast hij
    linarith
  have hcoeff : 0 ≤ A * R := mul_nonneg hA hR.le
  have hprod : 0 ≤ A * R * ((j : ℝ) - (i : ℝ)) := by
    positivity
  rw [abs_of_nonneg hprod]
  calc
    A * R = A * R * 1 := by ring
    _ ≤ A * R * ((j : ℝ) - (i : ℝ)) :=
      mul_le_mul_of_nonneg_left hdiff hcoeff

/-- Step 1b of the blueprint proof: two marks on the second straight side. -/
private lemma existsAnnularSpokes_step2_tubes_step1_baseSep_s1s1 {N : ℕ} {R : ℝ}
    (hN : 2 ≤ N) (hR : 0 < R) {i j : ℕ} (hi : i < 4 * N) (hj : j < 4 * N)
    (hij : i < j) (hi1 : N < i ∧ i ≤ 2 * N) (hj1 : N < j ∧ j ≤ 2 * N) :
    existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R) =
        - existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R) ∨
      (N : ℝ) * R / 2 * R ≤
        |jcr (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R))
          (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R))| := by
  have _ := hi
  have _ := hj
  have _ := hN
  right
  have hi_le : (i : ℝ) * R ≤ 4 * ((N : ℝ) * R / 2) := by
    have h : (i : ℝ) ≤ 2 * (N : ℝ) := by exact_mod_cast hi1.2
    calc (i : ℝ) * R ≤ (2 * (N : ℝ)) * R := mul_le_mul_of_nonneg_right h (le_of_lt hR)
      _ = 4 * ((N : ℝ) * R / 2) := by ring
  have hj_le : (j : ℝ) * R ≤ 4 * ((N : ℝ) * R / 2) := by
    have h : (j : ℝ) ≤ 2 * (N : ℝ) := by exact_mod_cast hj1.2
    calc (j : ℝ) * R ≤ (2 * (N : ℝ)) * R := mul_le_mul_of_nonneg_right h (le_of_lt hR)
      _ = 4 * ((N : ℝ) * R / 2) := by ring
  have hi_gt : ¬ ((i : ℝ) * R ≤ 2 * ((N : ℝ) * R / 2)) := by
    push_neg
    have h : (N : ℝ) < (i : ℝ) := by exact_mod_cast hi1.1
    calc 2 * ((N : ℝ) * R / 2) = (N : ℝ) * R := by ring
      _ < (i : ℝ) * R := mul_lt_mul_of_pos_right h hR
  have hj_gt : ¬ ((j : ℝ) * R ≤ 2 * ((N : ℝ) * R / 2)) := by
    push_neg
    have h : (N : ℝ) < (j : ℝ) := by exact_mod_cast hj1.1
    calc 2 * ((N : ℝ) * R / 2) = (N : ℝ) * R := by ring
      _ < (j : ℝ) * R := mul_lt_mul_of_pos_right h hR
  dsimp [existsAnnularSpokes_pos]
  simp only [hi_le, hj_le, hi_gt, hj_gt, if_true, if_false]
  have h_ji : 1 ≤ (j : ℝ) - (i : ℝ) := by
    have h : (i : ℝ) + 1 ≤ (j : ℝ) := by exact_mod_cast hij
    linarith
  have h_pos : 0 ≤ ((N : ℝ) * R / 2) * R := by
    have : 0 ≤ (N : ℝ) := by positivity
    positivity
  have h_abs : jcr (mkPt (((N : ℝ) * R / 2) - ((i : ℝ) * R - 2 * ((N : ℝ) * R / 2))) ((N : ℝ) * R / 2))
    (mkPt (((N : ℝ) * R / 2) - ((j : ℝ) * R - 2 * ((N : ℝ) * R / 2))) ((N : ℝ) * R / 2)) =
    ((N : ℝ) * R / 2) * R * ((j : ℝ) - (i : ℝ)) := by
    dsimp [jcr, mkPt]
    ring
  rw [h_abs]
  have h_le : ((N : ℝ) * R / 2) * R * 1 ≤ ((N : ℝ) * R / 2) * R * ((j : ℝ) - (i : ℝ)) := by
    apply mul_le_mul_of_nonneg_left h_ji h_pos
  rw [mul_one] at h_le
  have h_abs2 : 0 ≤ ((N : ℝ) * R / 2) * R * ((j : ℝ) - (i : ℝ)) := by linarith
  rw [abs_of_nonneg h_abs2]
  exact h_le

/-- Step 1c of the blueprint proof: two marks on the third straight side. -/
private lemma existsAnnularSpokes_step2_tubes_step1_baseSep_s2s2 {N : ℕ} {R : ℝ}
    (hN : 2 ≤ N) (hR : 0 < R) {i j : ℕ} (hi : i < 4 * N) (hj : j < 4 * N)
    (hij : i < j) (hi2 : 2 * N < i ∧ i ≤ 3 * N) (hj2 : 2 * N < j ∧ j ≤ 3 * N) :
    existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R) =
        - existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R) ∨
      (N : ℝ) * R / 2 * R ≤
        |jcr (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R))
          (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R))| := by
  have _ := hi
  have _ := hj
  right
  set A := (N : ℝ) * R / 2
  have hA_pos : 0 < A := by
    dsimp [A]
    positivity

  have hi_t1 : ¬((i : ℝ) * R ≤ 2 * A) := by
    push_neg
    dsimp [A]
    calc
      (i : ℝ) * R > 2 * (N : ℝ) * R := by
        have : 2 * (N : ℝ) < (i : ℝ) := by exact_mod_cast hi2.1
        nlinarith
      _ = 4 * ((N : ℝ) * R / 2) := by ring
      _ ≥ 2 * ((N : ℝ) * R / 2) := by
        have : 0 ≤ (N : ℝ) * R / 2 := by positivity
        linarith

  have hi_t2 : ¬((i : ℝ) * R ≤ 4 * A) := by
    push_neg
    dsimp [A]
    calc
      (i : ℝ) * R > 2 * (N : ℝ) * R := by
        have : 2 * (N : ℝ) < (i : ℝ) := by exact_mod_cast hi2.1
        nlinarith
      _ = 4 * ((N : ℝ) * R / 2) := by ring

  have hi_t3 : ((i : ℝ) * R ≤ 6 * A) := by
    dsimp [A]
    calc
      (i : ℝ) * R ≤ 3 * (N : ℝ) * R := by
        have : (i : ℝ) ≤ 3 * (N : ℝ) := by exact_mod_cast hi2.2
        nlinarith
      _ = 6 * ((N : ℝ) * R / 2) := by ring

  have hj_t1 : ¬((j : ℝ) * R ≤ 2 * A) := by
    push_neg
    dsimp [A]
    calc
      (j : ℝ) * R > 2 * (N : ℝ) * R := by
        have : 2 * (N : ℝ) < (j : ℝ) := by exact_mod_cast hj2.1
        nlinarith
      _ = 4 * ((N : ℝ) * R / 2) := by ring
      _ ≥ 2 * ((N : ℝ) * R / 2) := by
        have : 0 ≤ (N : ℝ) * R / 2 := by positivity
        linarith

  have hj_t2 : ¬((j : ℝ) * R ≤ 4 * A) := by
    push_neg
    dsimp [A]
    calc
      (j : ℝ) * R > 2 * (N : ℝ) * R := by
        have : 2 * (N : ℝ) < (j : ℝ) := by exact_mod_cast hj2.1
        nlinarith
      _ = 4 * ((N : ℝ) * R / 2) := by ring

  have hj_t3 : ((j : ℝ) * R ≤ 6 * A) := by
    dsimp [A]
    calc
      (j : ℝ) * R ≤ 3 * (N : ℝ) * R := by
        have : (j : ℝ) ≤ 3 * (N : ℝ) := by exact_mod_cast hj2.2
        nlinarith
      _ = 6 * ((N : ℝ) * R / 2) := by ring

  have hi_eq : existsAnnularSpokes_pos A ((i : ℝ) * R) =
      mkPt (-A) (A - ((i : ℝ) * R - 4 * A)) := by
    unfold existsAnnularSpokes_pos
    rw [if_neg hi_t1, if_neg hi_t2, if_pos hi_t3]

  have hj_eq : existsAnnularSpokes_pos A ((j : ℝ) * R) =
      mkPt (-A) (A - ((j : ℝ) * R - 4 * A)) := by
    unfold existsAnnularSpokes_pos
    rw [if_neg hj_t1, if_neg hj_t2, if_pos hj_t3]

  rw [hi_eq, hj_eq]
  dsimp [jcr, mkPt]

  have H1 : (-A) * (A - ((j : ℝ) * R - 4 * A)) -
      (A - ((i : ℝ) * R - 4 * A)) * (-A) =
      A * R * ((j : ℝ) - (i : ℝ)) := by
    ring

  rw [H1]

  have H2 : (1 : ℝ) ≤ (j : ℝ) - (i : ℝ) := by
    have : i + 1 ≤ j := by omega
    have : (i : ℝ) + 1 ≤ (j : ℝ) := by exact_mod_cast this
    linarith

  have H3 : A * R ≤ A * R * ((j : ℝ) - (i : ℝ)) := by
    have h1 : 0 ≤ A * R := by positivity
    nlinarith

  have H4 : 0 ≤ A * R * ((j : ℝ) - (i : ℝ)) := by
    have : 0 ≤ A * R := by positivity
    nlinarith

  rw [abs_of_nonneg H4]
  exact H3

/-- Step 1d of the blueprint proof: two marks on the fourth straight side. -/
private lemma existsAnnularSpokes_step2_tubes_step1_baseSep_s3s3 {N : ℕ} {R : ℝ}
    (hN : 2 ≤ N) (hR : 0 < R) {i j : ℕ} (hi : i < 4 * N) (hj : j < 4 * N)
    (hij : i < j) (hi3 : 3 * N < i) (hj3 : 3 * N < j) :
    existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R) =
        - existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R) ∨
      (N : ℝ) * R / 2 * R ≤
        |jcr (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R))
          (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R))| := by
  have _ := hN
  have _ := hi
  have _ := hj
  have _ := hi3
  have _ := hj3
  have ha3 := existsAnnularSpokes_step2_tubes_pos_cases hR hi
  have hb3 := existsAnnularSpokes_step2_tubes_pos_cases hR hj
  rcases ha3 with _ | _ | _ | ⟨-, eq_i⟩
  · omega
  · omega
  · omega
  rcases hb3 with _ | _ | _ | ⟨-, eq_j⟩
  · omega
  · omega
  · omega
  right
  rw [eq_i, eq_j]
  dsimp [jcr, mkPt]
  have h1 : ((i : ℝ) * R - 7 * ((N : ℝ) * R / 2)) * (-((N : ℝ) * R / 2)) -
            (-((N : ℝ) * R / 2)) * ((j : ℝ) * R - 7 * ((N : ℝ) * R / 2)) =
            ((N : ℝ) * R / 2) * ((j : ℝ) - (i : ℝ)) * R := by ring
  rw [h1]
  rw [abs_mul, abs_mul]
  have h2 : 0 < (N : ℝ) * R / 2 := mul_pos (by positivity) (by linarith)
  rw [abs_of_pos h2, abs_of_pos hR]
  have h3 : (1 : ℝ) ≤ ((j : ℝ) - (i : ℝ)) := by
    have : i + 1 ≤ j := by omega
    have h : (i : ℝ) + 1 ≤ (j : ℝ) := by exact_mod_cast this
    linarith
  have h4 : 1 ≤ |((j : ℝ) - (i : ℝ))| := by
    rw [abs_of_pos (by linarith)]
    exact h3
  have h5 : ((N : ℝ) * R / 2) * R ≤ ((N : ℝ) * R / 2) * |(j : ℝ) - (i : ℝ)| * R := by
    calc
      ((N : ℝ) * R / 2) * R = ((N : ℝ) * R / 2) * 1 * R := by ring
      _ ≤ ((N : ℝ) * R / 2) * |(j : ℝ) - (i : ℝ)| * R := by
        gcongr
  exact h5

private lemma existsAnnularSpokes_step2_tubes_step1_baseSep_s0s1_helper_rect (x y A R : ℝ)
  (hx2 : x ≤ A)
  (hy2 : y ≤ A - R)
  (hR : 0 ≤ R)
  (hA : R ≤ A)
  (h_cases : (R - A ≤ x ∧ -A ≤ y) ∨ (x = -A ∧ R - A ≤ y)) :
  x * y ≤ A * (A - R) := by
  rcases h_cases with ⟨hx1, hy1⟩ | ⟨hx1, hy1⟩
  · have hy_cases : 0 ≤ y ∨ y ≤ 0 := le_total 0 y
    rcases hy_cases with hy | hy
    · calc
        x * y ≤ A * y := by nlinarith
        _ ≤ A * (A - R) := by nlinarith
    · calc
        x * y = (-x) * (-y) := by ring
        _ ≤ (A - R) * (-y) := by nlinarith
        _ ≤ (A - R) * A := by nlinarith
        _ = A * (A - R) := by ring
  · have hy_cases : 0 ≤ y ∨ y ≤ 0 := le_total 0 y
    rcases hy_cases with hy | hy
    · calc
        x * y ≤ 0 := by nlinarith
        _ ≤ A * (A - R) := by nlinarith
    · calc
        x * y = A * (-y) := by nlinarith
        _ ≤ A * (A - R) := by nlinarith

/-- Step 1e of the blueprint proof: marks on the first two adjacent sides. -/
private lemma existsAnnularSpokes_step2_tubes_step1_baseSep_s0s1 {N : ℕ} {R : ℝ}
    (hN : 2 ≤ N) (hR : 0 < R) {i j : ℕ} (hi : i < 4 * N) (hj : j < 4 * N)
    (hij : i < j) (hi0 : i ≤ N) (hj1 : N < j ∧ j ≤ 2 * N) :
    existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R) =
        - existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R) ∨
      (N : ℝ) * R / 2 * R ≤
        |jcr (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((i : ℝ) * R))
          (existsAnnularSpokes_pos ((N : ℝ) * R / 2) ((j : ℝ) * R))| := by
  let A := (N : ℝ) * R / 2
  have hA : A = (N : ℝ) * R / 2 := rfl
  have hN_R : (N : ℝ) * R = 2 * A := by linarith
  have hR0 : 0 ≤ R := le_of_lt hR
  have hA_pos : 0 < A := by
    calc
      0 < R := hR
      _ ≤ (N : ℝ) * R / 2 := by
        have : 2 ≤ (N : ℝ) := by exact_mod_cast hN
        nlinarith
      _ = A := hA.symm
  have hAR : R ≤ A := by
    have hN2 : 2 ≤ (N : ℝ) := by exact_mod_cast hN
    calc
      R = 2 * R / 2 := by ring
      _ ≤ (N : ℝ) * R / 2 := by nlinarith
      _ = A := hA.symm

  have h_i : ((i : ℝ) * R) ≤ 2 * A := by
    have hi_le : (i : ℝ) ≤ (N : ℝ) := by exact_mod_cast hi0
    calc
      ((i : ℝ) * R) ≤ (N : ℝ) * R := by nlinarith
      _ = 2 * A := hN_R
      
  have h_j1 : ¬(((j : ℝ) * R) ≤ 2 * A) := by
    push_neg
    have hj_gt_N : (N : ℝ) + 1 ≤ (j : ℝ) := by exact_mod_cast hj1.1
    calc
      2 * A = (N : ℝ) * R := hN_R.symm
