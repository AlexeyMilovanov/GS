        · rw [add_sub_cancel_left, ht, jcr_smul_right, jcr_smul_right, jcr_self, mul_zero, mul_zero]
      rintro (⟨hx, h1⟩ | ⟨hx, h1⟩) <;> refine ⟨hx, fun h => ?_⟩ <;> linarith [key x h]
