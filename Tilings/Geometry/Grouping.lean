  · have hp : p = q₀ := by simp [p, hdir]
    have hq : q = p₀ := by simp [q, hdir]
    rw [hp] at hminpre
    rw [hq] at hminsuf
    simpa [p₀, q₀, s, B] using And.intro hminsuf hminpre

private lemma existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_parent_min
    (τ : Substitution P) (M : MeshConstants P) (Rs : RoutingSetup τ M) :
    ∃ d : ℝ, 0 < d ∧ ∀ α (a : Fin (Rs.GS.G.P'.disk α).n),
      d ≤ dist ((Rs.GS.G.P'.disk α).vertex a)
        ((Rs.GS.G.P'.disk α).vertex (finRotate _ a)) := by
  let I := Σ α : Rs.GS.G.P'.Form, Fin (Rs.GS.G.P'.disk α).n
  let q : I → ℝ := fun i => dist ((Rs.GS.G.P'.disk i.1).vertex i.2)
    ((Rs.GS.G.P'.disk i.1).vertex (finRotate _ i.2))
  let S := insert 1 (Finset.univ.image q)
  have hS : S.Nonempty := Finset.insert_nonempty _ _
  let d := S.min' hS
  refine ⟨d, ?_, ?_⟩
  · rw [Finset.lt_min'_iff]
    intro y hy
    rw [Finset.mem_insert, Finset.mem_image] at hy
    rcases hy with rfl | ⟨⟨α, a⟩, -, rfl⟩
    · exact zero_lt_one
    · exact dist_pos.mpr (pd_vertex_ne_next (Rs.GS.G.P'.disk α) a)
  · intro α a
    exact Finset.min'_le S (q ⟨α, a⟩)
      (Finset.mem_insert_of_mem (Finset.mem_image.mpr ⟨⟨α, a⟩, Finset.mem_univ _, rfl⟩))

private lemma existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_other_vertex
    (τ : Substitution P) (M : MeshConstants P) (Rs : RoutingSetup τ M) :
    ∃ d : ℝ, 0 < d ∧ ∀ α (a i : Fin (Rs.GS.G.P'.disk α).n),
      i ≠ a → i ≠ finRotate _ a → ∀ x ∈ (Rs.GS.G.P'.disk α).side a,
        d ≤ dist x ((Rs.GS.G.P'.disk α).vertex i) := by
  have hpair : ∀ (α : Rs.GS.G.P'.Form) (a i : Fin (Rs.GS.G.P'.disk α).n),
      i ≠ a → i ≠ finRotate _ a →
      ∃ d : ℝ, 0 < d ∧ ∀ x ∈ (Rs.GS.G.P'.disk α).side a,
        d ≤ dist x ((Rs.GS.G.P'.disk α).vertex i) := by
    intro α a i hia hinext
    let B := Rs.GS.G.P'.disk α
    have hcompact : IsCompact (B.side a) := by
      rw [PolygonalDisk.side, segment_eq_image']
      exact isCompact_Icc.image (by fun_prop)
    have hclosed : IsClosed ({B.vertex i} : Set Pt) := isClosed_singleton
    have hdisj : Disjoint (B.side a) ({B.vertex i} : Set Pt) := by
      rw [Set.disjoint_singleton_right]
      intro hi
      apply pd_vertex_not_mem_openSegment B i a
      rw [PolygonalDisk.side] at hi
      exact mem_openSegment_of_ne_left_right
        (fun h => hia (B.vertex_injective h.symm))
        (fun h => hinext (B.vertex_injective h.symm)) hi
    obtain ⟨r, hr, hsep⟩ := Metric.exists_pos_forall_lt_edist hcompact hclosed hdisj
    have hrne : (r : ENNReal) ≠ 0 := ENNReal.coe_ne_zero.mpr hr.ne'
    refine ⟨(r : ℝ), ENNReal.toReal_pos hrne ENNReal.coe_ne_top, ?_⟩
    intro x hx
    have hlt := hsep x hx (B.vertex i) (Set.mem_singleton _)
    have hlt' : (r : ENNReal) < ENNReal.ofReal (dist x (B.vertex i)) := by
      rw [← edist_dist]
      exact hlt
    rw [← ENNReal.ofReal_coe_nnreal] at hlt'
    exact (ENNReal.ofReal_lt_ofReal_iff_of_nonneg (by positivity)).mp hlt' |>.le
  let I := Σ α : Rs.GS.G.P'.Form,
    Fin (Rs.GS.G.P'.disk α).n × Fin (Rs.GS.G.P'.disk α).n
  let q : I → ℝ := fun z => if h₁ : z.2.2 = z.2.1 then 1
    else if h₂ : z.2.2 = finRotate _ z.2.1 then 1
    else Classical.choose (hpair z.1 z.2.1 z.2.2 h₁ h₂)
  let S := insert 1 (Finset.univ.image q)
  have hS : S.Nonempty := Finset.insert_nonempty _ _
  let d := S.min' hS
  refine ⟨d, ?_, ?_⟩
  · rw [Finset.lt_min'_iff]
    intro y hy
    rw [Finset.mem_insert, Finset.mem_image] at hy
    rcases hy with rfl | ⟨⟨α, a, i⟩, -, rfl⟩
    · exact zero_lt_one
    · dsimp only [q]
      split_ifs with h₁ h₂
      · exact zero_lt_one
      · exact zero_lt_one
      · exact (Classical.choose_spec (hpair α a i h₁ h₂)).1
  · intro α a i hia hinext x hx
    have hle := Finset.min'_le S (q ⟨α, a, i⟩)
      (Finset.mem_insert_of_mem
        (Finset.mem_image.mpr ⟨⟨α, a, i⟩, Finset.mem_univ _, rfl⟩))
    dsimp only [q] at hle
    by_cases h₁ : i = a
    · exact (hia h₁).elim
    · simp only [h₁, ↓reduceDIte] at hle
      by_cases h₂ : i = finRotate _ a
      · exact (hinext h₂).elim
      · simp only [h₂, ↓reduceDIte] at hle
        exact hle.trans ((Classical.choose_spec (hpair α a i h₁ h₂)).2 x hx)

private lemma existsRoutingAfterPower_step2_ports_step1_intra_step1_side_interval
    {Q : Protoset} {p q : Pt} (X : PlacedTile Q)
    (i : Fin (Q.disk X.form).n) (hsub : X.side i ⊆ segment ℝ p q) :
    ∃ a b : ℝ, a < b ∧
      X.side i = segment ℝ (AffineMap.lineMap p q a) (AffineMap.lineMap p q b) := by
  have hleft := hsub (vertex_mem_side X i)
  have hright := hsub (by rw [tile_side_eq]; exact right_mem_segment ℝ _ _)
  obtain ⟨a, -, -, ha⟩ := mem_segment_iff'.mp hleft
  obtain ⟨b, -, -, hb⟩ := mem_segment_iff'.mp hright
  have ha' : X.vertex i = AffineMap.lineMap p q a := by
    rw [ha]
    simp only [AffineMap.lineMap_apply_module']
    module
  have hb' : X.vertex (finRotate _ i) = AffineMap.lineMap p q b := by
    rw [hb]
    simp only [AffineMap.lineMap_apply_module']
    module
  have hab : a ≠ b := by
    intro h
    apply tile_vertex_ne_next X i
    rw [ha', hb', h]
  rcases lt_or_gt_of_ne hab with hab | hba
  · exact ⟨a, b, hab, by rw [tile_side_eq, ha', hb']⟩
  · exact ⟨b, a, hba, by rw [tile_side_eq, ha', hb', segment_symm]⟩

private lemma existsRoutingAfterPower_step2_ports_step1_intra_step1_point_param
    {p q : Pt} {a b : ℝ} (hab : a ≤ b) {e : Set Pt}
    (he : e = segment ℝ (AffineMap.lineMap p q a) (AffineMap.lineMap p q b))
    {x : Pt} (hx : x ∈ e) :
    ∃ t ∈ Icc a b, x = AffineMap.lineMap p q t := by
  rw [he, ← image_segment] at hx
  obtain ⟨t, ht, rfl⟩ := hx
  refine ⟨t, ?_, rfl⟩
  simpa only [segment_eq_uIcc, uIcc_of_le hab] using ht

private lemma existsRoutingAfterPower_step2_ports_step1_intra_step1_overlap
    {p q : Pt} {a b c d : ℝ} (hpq : p ≠ q) (hab : a < b) (hcd : c < d)
    (hac : a ≤ c) (hcb : c < b) {e f : Set Pt}
    (he : e = segment ℝ (AffineMap.lineMap p q a) (AffineMap.lineMap p q b))
    (hf : f = segment ℝ (AffineMap.lineMap p q c) (AffineMap.lineMap p q d)) :
    OverlapPos e f := by
  let u := min b d
  have hcu : c < u := lt_min hcb hcd
  refine ⟨AffineMap.lineMap p q c, AffineMap.lineMap p q u, ?_, ?_⟩
  · exact (AffineMap.lineMap_injective ℝ hpq).ne (ne_of_lt hcu)
  · intro z hz
    rw [← image_segment] at hz
    obtain ⟨t, ht, rfl⟩ := hz
    have ht' : t ∈ Icc c u := by
      simpa only [segment_eq_uIcc, uIcc_of_le hcu.le] using ht
    constructor
    · rw [he, ← image_segment]
      refine ⟨t, ?_, rfl⟩
      rw [segment_eq_uIcc, uIcc_of_le hab.le]
      exact ⟨hac.trans ht'.1, ht'.2.trans (min_le_left _ _)⟩
    · rw [hf, ← image_segment]
      refine ⟨t, ?_, rfl⟩
      rw [segment_eq_uIcc, uIcc_of_le hcd.le]
      exact ⟨ht'.1, ht'.2.trans (min_le_right _ _)⟩

private lemma existsRoutingAfterPower_step2_ports_step1_intra_step1_before
    {p q : Pt} (hpq : p ≠ q) (hlex : LexPositive (q - p))
    {a b c d : ℝ} (hab : a < b) (hcd : c < d) (hac : a ≤ c)
    {e f : Set Pt}
    (he : e = segment ℝ (AffineMap.lineMap p q a) (AffineMap.lineMap p q b))
    (hf : f = segment ℝ (AffineMap.lineMap p q c) (AffineMap.lineMap p q d))
    (hno : ¬ OverlapPos e f) :
    ∀ x ∈ e, ∀ y ∈ f, x = y ∨ LexPositive (y - x) := by
  have hbc : b ≤ c := by
    by_contra h
    exact hno (existsRoutingAfterPower_step2_ports_step1_intra_step1_overlap
      hpq hab hcd hac (lt_of_not_ge h) he hf)
  intro x hx y hy
  obtain ⟨s, hs, rfl⟩ :=
    existsRoutingAfterPower_step2_ports_step1_intra_step1_point_param hab.le he hx
  obtain ⟨t, ht, rfl⟩ :=
    existsRoutingAfterPower_step2_ports_step1_intra_step1_point_param hcd.le hf hy
  have hst : s ≤ t := hs.2.trans (hbc.trans ht.1)
  rcases hst.eq_or_lt with hst | hst
  · left
    rw [hst]
  · right
    have heq : AffineMap.lineMap p q t - AffineMap.lineMap p q s =
        (t - s) • (q - p) := by
      simp only [AffineMap.lineMap_apply_module']
      module
    rw [heq]
    exact existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_lex_smul_pos
      hlex (sub_pos.mpr hst)

private lemma existsRoutingAfterPower_step2_ports_step1_intra_step1_ordered_list
    {Q : Protoset} (T : Template Q) {p q : Pt} (hpq : p ≠ q)
    (hlex : LexPositive (q - p)) :
    ∃ L : List (Set Pt),
      (∀ e, e ∈ L ↔ T.IsOuter e ∧ e ⊆ segment ℝ p q) ∧ L.Nodup ∧
      L.Pairwise (fun e e' => ∀ x ∈ e, ∀ y ∈ e', x = y ∨ LexPositive (y - x)) := by
  classical
  let E : Set (Set Pt) := {e | T.IsOuter e ∧ e ⊆ segment ℝ p q}
  have hE : E.Finite := by
    refine (T.children.finite.biUnion (fun X _ => Set.finite_range X.side)).subset ?_
    intro e he
    obtain ⟨⟨X, hX, i, hi⟩, -⟩ := he.1
    exact Set.mem_biUnion hX ⟨i, hi⟩
  letI : Fintype {e // e ∈ E} := hE.fintype
  have hspan (e : {e // e ∈ E}) :
      ∃ a b : ℝ, a < b ∧
        e.1 = segment ℝ (AffineMap.lineMap p q a) (AffineMap.lineMap p q b) := by
    obtain ⟨⟨X, hX, i, hi⟩, -⟩ := e.2.1
    obtain ⟨a, b, hab, hside⟩ :=
      existsRoutingAfterPower_step2_ports_step1_intra_step1_side_interval X i
        (by rw [hi]; exact e.2.2)
    exact ⟨a, b, hab, hi.symm.trans hside⟩
  let lo : {e // e ∈ E} → ℝ := fun e => Classical.choose (hspan e)
  let hi : {e // e ∈ E} → ℝ := fun e =>
    Classical.choose (Classical.choose_spec (hspan e))
  have hspan_spec (e : {e // e ∈ E}) : lo e < hi e ∧
      e.1 = segment ℝ (AffineMap.lineMap p q (lo e))
        (AffineMap.lineMap p q (hi e)) :=
    Classical.choose_spec (Classical.choose_spec (hspan e))
  let r : {e // e ∈ E} → {e // e ∈ E} → Prop := fun e f => lo e ≤ lo f
  letI : IsTrans {e // e ∈ E} r := ⟨fun _ _ _ h₁ h₂ => h₁.trans h₂⟩
  letI : Std.Total r := ⟨fun e f => le_total (lo e) (lo f)⟩
  let K := List.mergeSort (Finset.univ.toList : List {e // e ∈ E}) (r · ·)
  have hKpair : K.Pairwise r := List.pairwise_mergeSort' r _
  have hKperm : K.Perm (Finset.univ.toList : List {e // e ∈ E}) :=
    List.mergeSort_perm _ _
  have hKn : K.Nodup := hKperm.nodup_iff.mpr (Finset.nodup_toList _)
  let L := K.map Subtype.val
  refine ⟨L, ?_, hKn.map Subtype.val_injective, ?_⟩
  · intro e
    constructor
    · intro he
      obtain ⟨z, hz, rfl⟩ := List.mem_map.mp he
      exact z.2
    · intro he
      let z : {e // e ∈ E} := ⟨e, he⟩
      apply List.mem_map.mpr
      refine ⟨z, ?_, rfl⟩
      exact hKperm.mem_iff.mpr (by simp)
  · rw [List.pairwise_map]
    refine (List.pairwise_and_iff.mpr ⟨hKpair, hKn⟩).imp (fun {e f} hef => ?_)
    have hno : ¬ OverlapPos e.1 f.1 := by
      intro hov
      obtain ⟨⟨X, hX, i, hXi⟩, -⟩ := e.2.1
      obtain ⟨⟨Y, hY, j, hYj⟩, -⟩ := f.2.1
      apply hef.2
      apply Subtype.ext
      have hov' : OverlapPos (X.side i) (Y.side j) := by
        rwa [hXi, hYj]
      exact hXi.symm.trans (((T.sts X hX Y hY i j) hov').trans hYj)
    exact existsRoutingAfterPower_step2_ports_step1_intra_step1_before hpq hlex
      (hspan_spec e).1 (hspan_spec f).1 hef.1 (hspan_spec e).2 (hspan_spec f).2 hno

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step2_ports_step1_intra`:
A scaled parent declared side contains an ordered list of whole fine sides of large enough
cardinality to choose five distinct ports by the sixth-quantiles. -/
private lemma existsRoutingAfterPower_step2_ports_step1_intra_step1_ports (τ : Substitution P)
    (hτ : τ.STS) (M : MeshConstants P) (Rs : RoutingSetup τ M) :
    ∃ _nPorts : ℕ, ∀ _l ≥ _nPorts, 0 < _l → ∀ _α _a,
    ∃ (L : List (Set Pt)) (_port : Fin 5 → Set Pt),
      (∀ e, e ∈ L ↔ (Rs.retained _l _α).IsOuter e ∧ e ⊆ (τ.θ ^ (Rs.GS.k * _l)) • (Rs.GS.G.P'.disk _α).side _a) ∧
      L.Nodup ∧ L.Pairwise (fun e e' => ∀ x ∈ e, ∀ y ∈ e', x = y ∨ LexPositive (y - x)) ∧
      (∀ r, L[MacroData.portRank L.length r - 1]? = some (_port r)) ∧
      (∀ _r, (Rs.retained _l _α).IsOuter (_port _r) ∧ _port _r ⊆ (τ.θ ^ (Rs.GS.k * _l)) • (Rs.GS.G.P'.disk _α).side _a) ∧
      Function.Injective _port := by
  classical
  have _ := hτ
  obtain ⟨d, hd, hdside⟩ :=
    existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_parent_min τ M Rs
  obtain ⟨nPorts, hnPorts⟩ := pow_unbounded_of_one_lt (6 * M.D / d) τ.one_lt
  refine ⟨nPorts, ?_⟩
  intro l hln hl α a
  let s := τ.θ ^ (Rs.GS.k * l)
  let B := Rs.GS.G.P'.disk α
  let p₀ := s • B.vertex a
  let q₀ := s • B.vertex (finRotate _ a)
  have hs : 0 < s := pow_pos (by linarith [τ.one_lt]) _
  have hpq₀ : p₀ ≠ q₀ := by
    intro h
    have := smul_right_injective Pt hs.ne' h
    exact (pd_vertex_ne_next B a) this
  let p := if LexPositive (q₀ - p₀) then p₀ else q₀
  let q := if LexPositive (q₀ - p₀) then q₀ else p₀
  have hpq : p ≠ q := by
    simp only [p, q]
    split_ifs
    · exact hpq₀
    · exact hpq₀.symm
  have hlex : LexPositive (q - p) := by
    simp only [p, q]
    split_ifs with h
    · exact h
    · rcases existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_lex_neg
        (sub_ne_zero.mpr hpq₀.symm) with h' | h'
      · exact (h h').elim
      · simpa only [neg_sub] using h'
  have hpqseg : segment ℝ p q = s • B.side a := by
    dsimp only [p, q]
    split_ifs
    · simp only [p₀, q₀]
      rw [existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_segment_smul]
      rfl
    · simp only [p₀, q₀]
      rw [segment_symm,
        existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_segment_smul]
      rfl
  obtain ⟨L, hL, hLn, hLpair⟩ :=
    existsRoutingAfterPower_step2_ports_step1_intra_step1_ordered_list
      (Rs.retained l α) hpq hlex
  have hLscaled : ∀ e, e ∈ L ↔ (Rs.retained l α).IsOuter e ∧
      e ⊆ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side a := by
    intro e
    rw [← hpqseg]
    exact hL e
  have hnkl : nPorts ≤ Rs.GS.k * l := by
    have hkl : l ≤ Rs.GS.k * l := by
      nlinarith [Rs.GS.k_pos]
    exact hln.trans hkl
  have hpow : τ.θ ^ nPorts ≤ s :=
    pow_le_pow_right₀ τ.one_lt.le hnkl
  have hslarge : 6 * M.D < s * d := by
    have hn' : 6 * M.D < (τ.θ ^ nPorts) * d := by
      rw [div_lt_iff₀ hd] at hnPorts
      exact hnPorts
    exact hn'.trans_le (mul_le_mul_of_nonneg_right hpow hd.le)
  have hlength :=
    existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_length_bound
      τ M Rs l hl α a L hLscaled hLn
  have hNd : s * d ≤ (L.length : ℝ) * M.D + 2 * M.D := by
    exact (mul_le_mul_of_nonneg_left (hdside α a) hs.le).trans
      (by simpa [s] using hlength)
  have hN : 5 ≤ L.length := by
    have hcast : (4 : ℝ) < (L.length : ℝ) := by
      nlinarith [M.D_pos]
    exact_mod_cast hcast
  let idx : Fin 5 → ℕ := fun r => MacroData.portRank L.length r - 1
  have hidx : ∀ r, idx r < L.length := by
    intro r
    fin_cases r <;> simp only [idx, MacroData.portRank] <;> omega
  let port : Fin 5 → Set Pt := fun r => L[idx r]'(by simpa using hidx r)
  have hport : ∀ r, L[MacroData.portRank L.length r - 1]? = some (port r) := by
    intro r
    rw [List.getElem?_eq_getElem (hidx r)]
  have hport_outer : ∀ r, (Rs.retained l α).IsOuter (port r) ∧
      port r ⊆ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side a := by
    intro r
    apply (hLscaled (port r)).mp
    exact L.get_mem ⟨idx r, hidx r⟩
  have hport_inj : Function.Injective port := by
    intro r t hrt
    have hi : idx r = idx t := (List.Nodup.getElem_inj_iff hLn).mp hrt
    fin_cases r <;> fin_cases t <;>
      simp only [idx, MacroData.portRank] at hi ⊢ <;> omega
  exact ⟨L, port, hLscaled, hLn, hLpair, hport, hport_outer, hport_inj⟩

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step2_ports_step1_intra`:
Their separation from one another and from the ends is bounded below by a positive
normalized lower bound `cp` uniformly over all forms and large enough powers. -/
private lemma existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance (τ : Substitution P)
    (hτ : τ.STS) (M : MeshConstants P) (Rs : RoutingSetup τ M) :
    ∃ _cp : ℝ, 0 < _cp ∧ ∃ _nPorts : ℕ, ∀ _l ≥ _nPorts, 0 < _l → ∀ _α _a,
      ∀ L : List (Set Pt), (∀ e, e ∈ L ↔ (Rs.retained _l _α).IsOuter e ∧ e ⊆ (τ.θ ^ (Rs.GS.k * _l)) • (Rs.GS.G.P'.disk _α).side _a) →
      L.Nodup → L.Pairwise (fun e e' => ∀ x ∈ e, ∀ y ∈ e', x = y ∨ LexPositive (y - x)) →
      ∀ _port : Fin 5 → Set Pt, (∀ r, L[MacroData.portRank L.length r - 1]? = some (_port r)) →
      (∀ _r _s, _r ≠ _s → ∀ _x ∈ _port _r, ∀ _y ∈ _port _s, _cp * τ.θ ^ (Rs.GS.k * _l) ≤ dist _x _y) ∧
      (∀ _r (_i : Fin (Rs.GS.G.P'.disk _α).n), ∀ _x ∈ _port _r,
        _cp * τ.θ ^ (Rs.GS.k * _l) ≤ dist _x ((τ.θ ^ (Rs.GS.k * _l)) • (Rs.GS.G.P'.disk _α).vertex _i)) := by
  have _ := hτ
  obtain ⟨d, hd, hdside⟩ :=
    existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_parent_min τ M Rs
  obtain ⟨dv, hdv, hdvertex⟩ :=
    existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_other_vertex τ M Rs
  let cp₁ := d * M.γ / (12 * M.D)
  let cp := min cp₁ dv
  have hcp₁ : 0 < cp₁ := by
    dsimp only [cp₁]
    exact div_pos (mul_pos hd M.γ_pos) (mul_pos (by norm_num) M.D_pos)
  have hcp : 0 < cp := lt_min hcp₁ hdv
  obtain ⟨nPorts, hnPorts⟩ := pow_unbounded_of_one_lt (48 * M.D / d) τ.one_lt
  refine ⟨cp, hcp, nPorts, ?_⟩
  intro l hln hl α a L hL hLn hLpair port hport
  let s := τ.θ ^ (Rs.GS.k * l)
  have hs : 0 < s := pow_pos (by linarith [τ.one_lt]) _
  have hnkl : nPorts ≤ Rs.GS.k * l := by
    have hkl : l ≤ Rs.GS.k * l := by
      nlinarith [Rs.GS.k_pos]
    exact hln.trans hkl
  have hpow : τ.θ ^ nPorts ≤ s :=
    pow_le_pow_right₀ τ.one_lt.le hnkl
  have hslarge : 48 * M.D < s * d := by
    have hn' : 48 * M.D < (τ.θ ^ nPorts) * d := by
      rw [div_lt_iff₀ hd] at hnPorts
      exact hnPorts
    exact hn'.trans_le (mul_le_mul_of_nonneg_right hpow hd.le)
  have hlength :=
    existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_length_bound
      τ M Rs l hl α a L hL hLn
  have hNd : s * d ≤ (L.length : ℝ) * M.D + 2 * M.D := by
    exact (mul_le_mul_of_nonneg_left (hdside α a) hs.le).trans (by simpa [s] using hlength)
  have hN : 47 ≤ L.length := by
    have hcast : (46 : ℝ) < (L.length : ℝ) := by
      nlinarith [M.D_pos]
    exact_mod_cast hcast
  have hlong : ∀ e ∈ L, ∃ x ∈ e, ∃ y ∈ e, M.γ ≤ dist x y := by
    intro e he
    exact existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_outer_long
      τ M Rs l hl α ((hL e).mp he).1
  have hsub : ∀ e ∈ L,
      e ⊆ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side a :=
    fun e he => ((hL e).mp he).2
  have hquant : ∀ r t : Fin 5, r < t →
      let ir := MacroData.portRank L.length r - 1
      let it := MacroData.portRank L.length t - 1
      ir < it ∧ L.length ≤ 6 * (it - ir - 1) + 13 := by
    intro r t hrt
    fin_cases r <;> fin_cases t <;>
      simp only [Fin.mk_lt_mk] at hrt ⊢ <;>
      simp only [MacroData.portRank] <;> omega
  have hscale_of_count : ∀ g : ℕ, L.length ≤ 6 * g + 13 →
      cp₁ * s ≤ (g : ℝ) * M.γ := by
    intro g hg
    have hg' : (L.length : ℝ) ≤ 6 * (g : ℝ) + 13 := by exact_mod_cast hg
    have hbase : d * s / (12 * M.D) ≤ (g : ℝ) := by
      rw [div_le_iff₀ (mul_pos (by norm_num) M.D_pos)]
      nlinarith [M.D_pos]
    have hmul := mul_le_mul_of_nonneg_right hbase M.γ_pos.le
    calc
      cp₁ * s = (d * s / (12 * M.D)) * M.γ := by dsimp only [cp₁]; ring
      _ ≤ (g : ℝ) * M.γ := hmul
  constructor
  · intro r t hrt x hx y hy
    have hcpcp₁ : cp ≤ cp₁ := min_le_left _ _
    rcases lt_or_gt_of_ne hrt with hrt' | htr'
    · let ir := MacroData.portRank L.length r - 1
      let it := MacroData.portRank L.length t - 1
      obtain ⟨hrit, hgap⟩ := hquant r t hrt'
      have hdist := existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_list_distance
        τ M Rs l α a L hsub hlong hLpair hrit (hport r) (hport t) hx hy
      exact (mul_le_mul_of_nonneg_right hcpcp₁ hs.le).trans
        ((hscale_of_count (it - ir - 1) hgap).trans hdist)
    · let ir := MacroData.portRank L.length r - 1
      let it := MacroData.portRank L.length t - 1
      obtain ⟨htir, hgap⟩ := hquant t r htr'
      have hdist := existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_list_distance
        τ M Rs l α a L hsub hlong hLpair htir (hport t) (hport r) hy hx
      rw [dist_comm] at hdist
      exact (mul_le_mul_of_nonneg_right hcpcp₁ hs.le).trans
        ((hscale_of_count (ir - it - 1) hgap).trans hdist)
  · intro r i x hx
    let ir := MacroData.portRank L.length r - 1
    let g := min ir (L.length - ir - 1)
    have hir : ir < L.length := by
      by_contra h
      have hpr := hport r
      rw [List.getElem?_eq_none (Nat.le_of_not_gt h)] at hpr
      contradiction
    have hgap : L.length ≤ 6 * g + 13 := by
      fin_cases r <;>
        simp only [ir, g, MacroData.portRank] <;> omega
    have hcpbase : cp * s ≤ (g : ℝ) * M.γ :=
      (mul_le_mul_of_nonneg_right (min_le_left cp₁ dv) hs.le).trans
        (hscale_of_count g hgap)
    by_cases hia : i = a
    · subst i
      have hends := existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_list_ends
        τ M Rs l α a L hsub hlong hLpair (hport r) hx
      exact hcpbase.trans (by simpa [ir, g, s] using hends.1)
    · by_cases hinext : i = finRotate _ a
      · subst i
        have hends := existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance_list_ends
          τ M Rs l α a L hsub hlong hLpair (hport r) hx
        exact hcpbase.trans (by simpa [ir, g, s] using hends.2)
      · have hportmem : port r ∈ L := by
          rw [List.mem_iff_getElem?]
          exact ⟨ir, hport r⟩
        have hxscaled := ((hL (port r)).mp hportmem).2 hx
        obtain ⟨z, hz, hzx⟩ := Set.mem_smul_set.mp hxscaled
        rw [← hzx]
        have hsep := hdvertex α a i hia hinext z hz
        have hscaled : dv * s ≤ dist (s • z) (s • (Rs.GS.G.P'.disk α).vertex i) := by
          rw [dist_smul₀, Real.norm_eq_abs, abs_of_pos hs]
          nlinarith
        exact (mul_le_mul_of_nonneg_right (min_le_right cp₁ dv) hs.le).trans hscaled

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step2_ports`: intra-side quantiles. -/
private lemma existsRoutingAfterPower_step2_ports_step1_intra (τ : Substitution P) (hτ : τ.STS)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) :
    ∃ _cp : ℝ, 0 < _cp ∧ ∃ _nPorts : ℕ, ∀ _l ≥ _nPorts, 0 < _l → ∀ _α _a,
      ∃ _port : Fin 5 → Set Pt,
        (∀ _r, (Rs.retained _l _α).IsOuter (_port _r) ∧ _port _r ⊆ (τ.θ ^ (Rs.GS.k * _l)) • (Rs.GS.G.P'.disk _α).side _a) ∧
        Function.Injective _port ∧
        (∀ _r _s, _r ≠ _s → ∀ _x ∈ _port _r, ∀ _y ∈ _port _s, _cp * τ.θ ^ (Rs.GS.k * _l) ≤ dist _x _y) ∧
        (∀ _r (_i : Fin (Rs.GS.G.P'.disk _α).n), ∀ _x ∈ _port _r,
          _cp * τ.θ ^ (Rs.GS.k * _l) ≤
            dist _x ((τ.θ ^ (Rs.GS.k * _l)) • (Rs.GS.G.P'.disk _α).vertex _i)) ∧
        (∃ L : List (Set Pt), (∀ e, e ∈ L ↔ (Rs.retained _l _α).IsOuter e ∧ e ⊆ (τ.θ ^ (Rs.GS.k * _l)) • (Rs.GS.G.P'.disk _α).side _a) ∧
          L.Nodup ∧ L.Pairwise (fun e e' => ∀ x ∈ e, ∀ y ∈ e', x = y ∨ LexPositive (y - x)) ∧
          ∀ r, L[MacroData.portRank L.length r - 1]? = some (_port r)) := by
  obtain ⟨n1, hn1⟩ := existsRoutingAfterPower_step2_ports_step1_intra_step1_ports τ hτ M Rs
  obtain ⟨cp, hcp, n2, hn2⟩ := existsRoutingAfterPower_step2_ports_step1_intra_step2_clearance τ hτ M Rs
  refine ⟨cp, hcp, max n1 n2, ?_⟩
  intro l hl hlpos α a
  have hl1 : l ≥ n1 := le_trans (Nat.le_max_left _ _) hl
  have hl2 : l ≥ n2 := le_trans (Nat.le_max_right _ _) hl
  obtain ⟨L, port, hL1, hL2, hL3, hL4, hport1, hport2⟩ := hn1 l hl1 hlpos α a
  have h_clearance := hn2 l hl2 hlpos α a L hL1 hL2 hL3 port hL4
  refine ⟨port, hport1, hport2, h_clearance.1, h_clearance.2, L, hL1, hL2, hL3, hL4⟩

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step2_ports_step2_inter`: uniqueness of the quantile port list. -/
private lemma existsRoutingAfterPower_step2_ports_step2_inter_step1_unique (τ : Substitution P) (hτ : τ.STS)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ) (α : Rs.GS.G.P'.Form) (a : Fin (Rs.GS.G.P'.disk α).n)
    (p1 p2 : Fin 5 → Set Pt) :
    (∃ L : List (Set Pt), (∀ e, e ∈ L ↔ (Rs.retained l α).IsOuter e ∧ e ⊆ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side a) ∧
          L.Nodup ∧ L.Pairwise (fun e e' => ∀ x ∈ e, ∀ y ∈ e', x = y ∨ LexPositive (y - x)) ∧
          ∀ r, L[MacroData.portRank L.length r - 1]? = some (p1 r)) →
    (∃ L : List (Set Pt), (∀ e, e ∈ L ↔ (Rs.retained l α).IsOuter e ∧ e ⊆ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side a) ∧
          L.Nodup ∧ L.Pairwise (fun e e' => ∀ x ∈ e, ∀ y ∈ e', x = y ∨ LexPositive (y - x)) ∧
          ∀ r, L[MacroData.portRank L.length r - 1]? = some (p2 r)) →
    p1 = p2 := by
  have _ := hτ
  rintro ⟨L1, h1, n1, q1, r1⟩ ⟨L2, h2, n2, q2, r2⟩
  have hne : ∀ e, e ∈ L1 → e.Nonempty := by
    intro e he
    obtain ⟨⟨A, -, i, rfl⟩, -⟩ := ((h1 e).1 he).1
    exact ⟨_, Set.vadd_mem_vadd_set (left_mem_segment ℝ _ _)⟩
  have hperm : L1.Perm L2 := (List.perm_ext_iff_of_nodup n1 n2).2 (fun e => (h1 e).trans (h2 e).symm)
  have hL : L1 = L2 := by
    refine hperm.eq_of_pairwise ?_ q1 q2
    intro a b ha hb hab hba
    have key : ∀ x ∈ a, ∀ y ∈ b, x = y := by
      intro x hx y hy
      rcases hab x hx y hy with h | h
      · exact h
      rcases hba y hy x hx with h' | h'
      · exact h'.symm
      exfalso
      simp only [LexPositive, PiLp.sub_apply] at h h'
      rcases h with h | ⟨h0, h⟩ <;> rcases h' with h' | ⟨h0', h'⟩ <;> linarith
    obtain ⟨x, hx⟩ := hne a ha
    obtain ⟨y, hy⟩ := hne b (hperm.symm.subset hb)
    ext z
    constructor
    · intro hz
      rw [key z hz y hy]; exact hy
    · intro hz
      rw [← key x hx z hz]; exact hx
  subst hL
  funext r
  have := (r1 r).symm.trans (r2 r)
  exact Option.some_injective _ this

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step2_ports_step2_inter`:
positive mutual Euclidean separation of closed portions of different sides. -/
private lemma existsRoutingAfterPower_step2_ports_step2_inter_step2_unscaled (τ : Substitution P) (hτ : τ.STS)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (δ : ℝ) (hδ : 0 < δ) :
    ∃ c : ℝ, 0 < c ∧ ∀ α a b, a ≠ b →
      ∀ x ∈ (Rs.GS.G.P'.disk α).side a, ∀ y ∈ (Rs.GS.G.P'.disk α).side b,
        (∀ i, δ ≤ dist x ((Rs.GS.G.P'.disk α).vertex i)) →
        (∀ i, δ ≤ dist y ((Rs.GS.G.P'.disk α).vertex i)) →
        c ≤ dist x y := by
  have _ := hτ
  have hpair : ∀ (α : Rs.GS.G.P'.Form)
      (a b : Fin ((Rs.GS.G.P'.disk α).n)), a ≠ b →
      ∃ d : ℝ, 0 < d ∧ ∀ x ∈ (Rs.GS.G.P'.disk α).side a,
        ∀ y ∈ (Rs.GS.G.P'.disk α).side b,
        (∀ i, δ ≤ dist x ((Rs.GS.G.P'.disk α).vertex i)) →
        (∀ i, δ ≤ dist y ((Rs.GS.G.P'.disk α).vertex i)) → d ≤ dist x y := by
    intro α a b hab
    let D := Rs.GS.G.P'.disk α
    let Ka := D.side a ∩ {x | ∀ j, δ ≤ dist x (D.vertex j)}
    let Kb := D.side b ∩ {y | ∀ j, δ ≤ dist y (D.vertex j)}
    have hKa : IsCompact Ka := by
      have hc : IsCompact (D.side a) := by
        rw [PolygonalDisk.side, segment_eq_image']
        exact isCompact_Icc.image (by fun_prop)
      have hcl : IsClosed {x | ∀ j, δ ≤ dist x (D.vertex j)} := by
        have heq : {x | ∀ (j : Fin D.n), δ ≤ dist x (D.vertex j)} = ⋂ j : Fin D.n, {x | δ ≤ dist x (D.vertex j)} := by
          ext x; simp
        rw [heq]
        apply isClosed_iInter
        intro j
        exact isClosed_le continuous_const (continuous_id.dist continuous_const)
      exact hc.inter_right hcl
    have hKb_cl : IsClosed Kb := by
      have hc : IsCompact (D.side b) := by
        rw [PolygonalDisk.side, segment_eq_image']
        exact isCompact_Icc.image (by fun_prop)
      have hcl : IsClosed {y | ∀ j, δ ≤ dist y (D.vertex j)} := by
        have heq : {y | ∀ (j : Fin D.n), δ ≤ dist y (D.vertex j)} = ⋂ j : Fin D.n, {y | δ ≤ dist y (D.vertex j)} := by
          ext x; simp
        rw [heq]
        apply isClosed_iInter
        intro j
        exact isClosed_le continuous_const (continuous_id.dist continuous_const)
      exact hc.isClosed.inter hcl
    have hdisj : Disjoint Ka Kb := by
      rw [disjoint_iff_inter_eq_empty, eq_empty_iff_forall_notMem]
      intro x hx
      have hx_in_inter : x ∈ D.side a ∩ D.side b := ⟨hx.1.1, hx.2.1⟩
      have hx_simple := D.simple a b hab hx_in_inter
      have hx_end := hx_simple.1
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx_end
      rcases hx_end with rfl | rfl
      · have hdist := hx.1.2 a
        simp only [dist_self] at hdist
        linarith
      · have hdist := hx.1.2 (finRotate D.n a)
        simp only [dist_self] at hdist
        linarith
    obtain ⟨r, hr_pos, hr_lt⟩ := Metric.exists_pos_forall_lt_edist hKa hKb_cl hdisj
    have h_r_ne : (r : ENNReal) ≠ 0 := ENNReal.coe_ne_zero.2 hr_pos.ne'
    refine ⟨(r : ℝ), ENNReal.toReal_pos h_r_ne ENNReal.coe_ne_top, ?_⟩
    intro x hx_a y hx_b hx_dist hy_dist
    have hx : x ∈ Ka := ⟨hx_a, hx_dist⟩
    have hy : y ∈ Kb := ⟨hx_b, hy_dist⟩
    have hlt := hr_lt x hx y hy
    have hlt' : ↑r < ENNReal.ofReal (dist x y) := by
      rw [← edist_dist]
      exact hlt
    rw [← ENNReal.ofReal_coe_nnreal] at hlt'
    have hdist : (r : ℝ) < dist x y :=
      (ENNReal.ofReal_lt_ofReal_iff_of_nonneg (by positivity)).1 hlt'
    exact hdist.le
  let I := Σ α : Rs.GS.G.P'.Form, Fin ((Rs.GS.G.P'.disk α).n) × Fin ((Rs.GS.G.P'.disk α).n)
  let q : I → ℝ := fun i => if h : i.2.1 = i.2.2 then 1 else Classical.choose (hpair i.1 i.2.1 i.2.2 h)
  let S := insert 1 (Finset.univ.image q)
  have S_nonempty : S.Nonempty := Finset.insert_nonempty _ _
  let c := S.min' S_nonempty
  refine ⟨c, ?_, ?_⟩
  · rw [Finset.lt_min'_iff]
    intro y hy
    rw [Finset.mem_insert, Finset.mem_image] at hy
    rcases hy with rfl | ⟨⟨α, a, b⟩, _, h_q⟩
    · exact zero_lt_one
    · dsimp [q] at h_q
      split_ifs at h_q with h
      · rw [← h_q]
        exact zero_lt_one
      · rw [← h_q]
        exact (Classical.choose_spec (hpair α a b h)).1
  · intro α a b hab x hx y hy hx_dist hy_dist
    have h_le := Finset.min'_le S (q ⟨α, a, b⟩) (Finset.mem_insert_of_mem (Finset.mem_image.2 ⟨⟨α, a, b⟩, Finset.mem_univ _, rfl⟩))
    dsimp [q] at h_le
    split_ifs at h_le with h
    · exact (hab h).elim
    · exact h_le.trans ((Classical.choose_spec (hpair α a b h)).2 x hx y hy hx_dist hy_dist)

/-- Step 3 of the blueprint proof of `existsRoutingAfterPower_step2_ports_step2_inter`: scaling the separation to the retained template. -/
private lemma existsRoutingAfterPower_step2_ports_step2_inter_step3_scaled (τ : Substitution P) (hτ : τ.STS)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (δ : ℝ) (hδ : 0 < δ) (c : ℝ) (hc : 0 < c)
    (H_unscaled : ∀ α a b, a ≠ b →
      ∀ x ∈ (Rs.GS.G.P'.disk α).side a, ∀ y ∈ (Rs.GS.G.P'.disk α).side b,
        (∀ i, δ ≤ dist x ((Rs.GS.G.P'.disk α).vertex i)) →
        (∀ i, δ ≤ dist y ((Rs.GS.G.P'.disk α).vertex i)) →
        c ≤ dist x y) :
    ∀ l, 0 < l → ∀ α a b, a ≠ b →
      ∀ x ∈ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side a,
      ∀ y ∈ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side b,
        (∀ i, δ * τ.θ ^ (Rs.GS.k * l) ≤ dist x ((τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).vertex i)) →
        (∀ i, δ * τ.θ ^ (Rs.GS.k * l) ≤ dist y ((τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).vertex i)) →
        c * τ.θ ^ (Rs.GS.k * l) ≤ dist x y := by
  have _ := hτ
  have _ := hδ
  have _ := hc
  intro l hl α a b hab x hx y hy hx_dist hy_dist
  have _ := hl
  have hs : 0 < τ.θ ^ (Rs.GS.k * l) :=
    pow_pos (by linarith [τ.one_lt]) _
  obtain ⟨x', hx', rfl⟩ := Set.mem_smul_set.mp hx
  obtain ⟨y', hy', rfl⟩ := Set.mem_smul_set.mp hy
  have hx_dist' : ∀ i, δ ≤ dist x' ((Rs.GS.G.P'.disk α).vertex i) := by
    intro i
    have h := hx_dist i
    rw [dist_smul₀, Real.norm_eq_abs, abs_of_pos hs] at h
    apply le_of_mul_le_mul_left ?_ hs
    calc
      τ.θ ^ (Rs.GS.k * l) * δ = δ * τ.θ ^ (Rs.GS.k * l) := mul_comm _ _
      _ ≤ τ.θ ^ (Rs.GS.k * l) * dist x' ((Rs.GS.G.P'.disk α).vertex i) := by
        simpa using h
  have hy_dist' : ∀ i, δ ≤ dist y' ((Rs.GS.G.P'.disk α).vertex i) := by
    intro i
    have h := hy_dist i
    rw [dist_smul₀, Real.norm_eq_abs, abs_of_pos hs] at h
    apply le_of_mul_le_mul_left ?_ hs
    calc
      τ.θ ^ (Rs.GS.k * l) * δ = δ * τ.θ ^ (Rs.GS.k * l) := mul_comm _ _
      _ ≤ τ.θ ^ (Rs.GS.k * l) * dist y' ((Rs.GS.G.P'.disk α).vertex i) := by
        simpa using h
  have h := H_unscaled α a b hab x' hx' y' hy' hx_dist' hy_dist'
  calc
    c * τ.θ ^ (Rs.GS.k * l) = τ.θ ^ (Rs.GS.k * l) * c := mul_comm _ _
    _ ≤ τ.θ ^ (Rs.GS.k * l) * dist x' y' :=
      mul_le_mul_of_nonneg_left h hs.le
    _ = dist (τ.θ ^ (Rs.GS.k * l) • x') (τ.θ ^ (Rs.GS.k * l) • y') := by
      rw [dist_smul₀, Real.norm_eq_abs, abs_of_pos hs]

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step2_ports`: inter-side separation. -/
private lemma existsRoutingAfterPower_step2_ports_step2_inter (τ : Substitution P) (hτ : τ.STS)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) :
    ∃ _cp : ℝ, 0 < _cp ∧ ∃ _nPorts : ℕ, ∀ _l ≥ _nPorts, 0 < _l → ∀ _α _a _b, _a ≠ _b →
      ∀ _port_a _port_b : Fin 5 → Set Pt,
        (∃ L : List (Set Pt), (∀ e, e ∈ L ↔ (Rs.retained _l _α).IsOuter e ∧ e ⊆ (τ.θ ^ (Rs.GS.k * _l)) • (Rs.GS.G.P'.disk _α).side _a) ∧
          L.Nodup ∧ L.Pairwise (fun e e' => ∀ x ∈ e, ∀ y ∈ e', x = y ∨ LexPositive (y - x)) ∧
          ∀ r, L[MacroData.portRank L.length r - 1]? = some (_port_a r)) →
        (∃ L : List (Set Pt), (∀ e, e ∈ L ↔ (Rs.retained _l _α).IsOuter e ∧ e ⊆ (τ.θ ^ (Rs.GS.k * _l)) • (Rs.GS.G.P'.disk _α).side _b) ∧
          L.Nodup ∧ L.Pairwise (fun e e' => ∀ x ∈ e, ∀ y ∈ e', x = y ∨ LexPositive (y - x)) ∧
          ∀ r, L[MacroData.portRank L.length r - 1]? = some (_port_b r)) →
        ∀ _r _s, ∀ _x ∈ _port_a _r, ∀ _y ∈ _port_b _s,
          _cp * τ.θ ^ (Rs.GS.k * _l) ≤ dist _x _y := by
  obtain ⟨cp1, hcp1, n1, hn1⟩ := existsRoutingAfterPower_step2_ports_step1_intra τ hτ M Rs
  obtain ⟨c, hc, H_unscaled⟩ := existsRoutingAfterPower_step2_ports_step2_inter_step2_unscaled τ hτ M Rs cp1 hcp1
  refine ⟨c, hc, n1, ?_⟩
  intro l hl hlpos α a b hab port_a port_b H_L_a H_L_b r s x hx y hy
  have h_intra := hn1 l hl hlpos α
  have ⟨port_a_ex, h_a_ex⟩ := h_intra a
  have ⟨port_b_ex, h_b_ex⟩ := h_intra b
  have H_eq_a : port_a = port_a_ex := existsRoutingAfterPower_step2_ports_step2_inter_step1_unique τ hτ M Rs l α a port_a port_a_ex H_L_a h_a_ex.2.2.2.2
  have H_eq_b : port_b = port_b_ex := existsRoutingAfterPower_step2_ports_step2_inter_step1_unique τ hτ M Rs l α b port_b port_b_ex H_L_b h_b_ex.2.2.2.2
  subst H_eq_a H_eq_b
  have h_x_vert := h_a_ex.2.2.2.1 r
  have h_y_vert := h_b_ex.2.2.2.1 s
  have h_x_side : x ∈ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side a := h_a_ex.1 r |>.right hx
  have h_y_side : y ∈ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side b := h_b_ex.1 s |>.right hy
  exact existsRoutingAfterPower_step2_ports_step2_inter_step3_scaled τ hτ M Rs cp1 hcp1 c hc
    H_unscaled l hlpos α a b hab x h_x_side y h_y_side
    (fun i => h_x_vert i x hx) (fun i => h_y_vert i y hy)

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower`: "Outside the retained central
annulus every child is an original tile, so the mesh remains `D` ... A scaled parent declared side
of length `sℓ` contains an ordered list of whole fine sides of cardinality `L ≥ sℓ/D - 2` ...
Choose five ports by the sixth-quantiles `⌈iL/6⌉` ... Their separation from one another and from
the ends is bounded below by `γ(⌊L/6⌋ - 1) - D`.  After normalization this gives a positive lower
bound depending only on the finite parent catalogue.  Closed portions of different sides away from
their endpoints also have positive mutual Euclidean separation."  One normalized constant `cp > 0`
and one threshold serve every form and every larger power. -/
private lemma existsRoutingAfterPower_step2_ports (τ : Substitution P) (hτ : τ.STS)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) :
    ∃ _cp : ℝ, 0 < _cp ∧ ∃ _nPorts : ℕ, ∀ _l ≥ _nPorts, 0 < _l → ∀ _α,
      Nonempty (existsRoutingAfterPower_PortData τ M Rs _l _α _cp) := by
  obtain ⟨cp1, hcp1, n1, hn1⟩ := existsRoutingAfterPower_step2_ports_step1_intra τ hτ M Rs
  obtain ⟨cp2, hcp2, n2, hn2⟩ := existsRoutingAfterPower_step2_ports_step2_inter τ hτ M Rs
  refine ⟨min cp1 cp2, lt_min hcp1 hcp2, max n1 n2, ?_⟩
  intro l hl hlpos α
  have hl1 : l ≥ n1 := le_trans (Nat.le_max_left _ _) hl
  have hl2 : l ≥ n2 := le_trans (Nat.le_max_right _ _) hl
  have h_intra := hn1 l hl1 hlpos α
  have h_inter := hn2 l hl2 hlpos α
  
  have port_ex (a : Fin (Rs.GS.G.P'.disk α).n) := h_intra a
  let port_fn := fun a => Classical.choose (port_ex a)
  have port_spec (a : Fin (Rs.GS.G.P'.disk α).n) := Classical.choose_spec (port_ex a)
  
  have outer_cond : ∀ a r, (Rs.retained l α).IsOuter (port_fn a r) ∧ port_fn a r ⊆ (τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).side a := by
    intro a r
    exact (port_spec a).1 r
    
  have inj_cond : ∀ a, Function.Injective (port_fn a) := by
    intro a
    exact (port_spec a).2.1
    
  have pos_theta : 0 ≤ τ.θ ^ (Rs.GS.k * l) := by
    exact pow_nonneg (le_of_lt (lt_trans zero_lt_one τ.one_lt)) _

  have sep_cond : ∀ a r b s, (a, r) ≠ (b, s) → ∀ x ∈ port_fn a r, ∀ y ∈ port_fn b s, (min cp1 cp2) * τ.θ ^ (Rs.GS.k * l) ≤ dist x y := by
    intro a r b s hneq x hx y hy
    by_cases hab : a = b
    · subst hab
      have hrs : r ≠ s := fun hrs => hneq (Prod.ext rfl hrs)
      have H := (port_spec a).2.2.1 r s hrs x hx y hy
      have H_min : (min cp1 cp2) * τ.θ ^ (Rs.GS.k * l) ≤ cp1 * τ.θ ^ (Rs.GS.k * l) := by
        gcongr
        exact min_le_left cp1 cp2
      exact le_trans H_min H
    · have H := h_inter a b hab (port_fn a) (port_fn b) (port_spec a).2.2.2.2 (port_spec b).2.2.2.2 r s x hx y hy
      have H_min : (min cp1 cp2) * τ.θ ^ (Rs.GS.k * l) ≤ cp2 * τ.θ ^ (Rs.GS.k * l) := by
        gcongr
        exact min_le_right cp1 cp2
      exact le_trans H_min H

  have corner_cond : ∀ a r (i : Fin (Rs.GS.G.P'.disk α).n), ∀ x ∈ port_fn a r,
      (min cp1 cp2) * τ.θ ^ (Rs.GS.k * l) ≤
        dist x ((τ.θ ^ (Rs.GS.k * l)) • (Rs.GS.G.P'.disk α).vertex i) := by
    intro a r i x hx
    have H := (port_spec a).2.2.2.1 r i x hx
    have H_min : (min cp1 cp2) * τ.θ ^ (Rs.GS.k * l) ≤ cp1 * τ.θ ^ (Rs.GS.k * l) := by
      gcongr
      exact min_le_left cp1 cp2
    exact le_trans H_min H

  have quant_cond : QuantilePorts (Rs.retained l α) (Rs.GS.G.P'.disk α) (τ.θ ^ (Rs.GS.k * l)) port_fn := by
    intro a
    exact (port_spec a).2.2.2.2

  exact ⟨⟨port_fn, outer_cond, inj_cond, sep_cond, corner_cond, quant_cond⟩⟩

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step1_grouped_step1_annular_member`:
the scattered original tiles of a mixed tile cover it, so the central child lies in `L`. -/
private lemma existsRoutingAfterPower_step3_entries_step1_grouped_step1_annular_member_step1_cover
    (G : GroupedFamily P) (C : PlacedTile G.mixed) : C.carrier ⊆ support (G.mixedScatterTile C) := by
  rcases C with ⟨f, a⟩
  rcases f with β | q
  · intro x hx
    simp only [PlacedTile.carrier] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    change y ∈ (G.P'.disk β).carrier at hy
    rw [← G.support_eq β] at hy
    obtain ⟨T, hT, hyT⟩ := mem_support_iff'.1 hy
    refine mem_support_iff'.2 ⟨T.translate a, ?_, ?_⟩
    · simp only [GroupedFamily.mixedScatterTile, Sum.elim_inl, translateSet]
      exact ⟨T, hT, rfl⟩
    · simp only [PlacedTile.carrier, PlacedTile.translate] at hyT ⊢
      obtain ⟨w, hw, rfl⟩ := hyT
      exact ⟨w, hw, by simp [vadd_eq_add, add_assoc]⟩
  · intro x hx
    refine mem_support_iff'.2 ⟨⟨q, a⟩, ?_, hx⟩
    simp [GroupedFamily.mixedScatterTile]

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step1_grouped_step1_annular_member`:
every scattered original tile lies inside the mixed tile that produced it. -/
private lemma existsRoutingAfterPower_step3_entries_step1_grouped_step1_annular_member_step2_carrier
    (G : GroupedFamily P) (C : PlacedTile G.mixed) {A : PlacedTile P}
    (hA : A ∈ G.mixedScatterTile C) : A.carrier ⊆ C.carrier := by
  rcases C with ⟨f, a⟩
  rcases f with β | q
  · simp only [GroupedFamily.mixedScatterTile, Sum.elim_inl, translateSet,
      Set.mem_image] at hA
    obtain ⟨T, hT, rfl⟩ := hA
    have hsub : T.carrier ⊆ (G.P'.disk β).carrier := by
      rw [← G.support_eq β]
      exact carrier_subset_support hT
    intro x hx
    simp only [PlacedTile.carrier, PlacedTile.translate] at hx ⊢
    obtain ⟨y, hy, rfl⟩ := hx
    refine ⟨T.anchor +ᵥ y, hsub ⟨y, hy, rfl⟩, ?_⟩
    simp [vadd_eq_add, add_assoc]
  · simp only [GroupedFamily.mixedScatterTile, Sum.elim_inr,
      Set.mem_singleton_iff] at hA
    subst hA
    intro x hx
    exact hx

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step1_grouped`:
an original child sharing a central side lies in `H \ L`, hence in one annular piece. -/
private lemma existsRoutingAfterPower_step3_entries_step1_grouped_step1_annular_member
    (τ : Substitution P) (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ)
    (hl : 0 < l) (α : Rs.GS.G.P'.Form) {p : P.Form}
    {X : PlacedTile Rs.GS.G.mixed}
    (hX : X ∈ (Rs.retained l α).children.tiles)
    (hXc : X ≠ Rs.central l α) {k : Fin (Rs.GS.G.mixed.disk (Rs.central l α).form).n}
    (hk : HasEdge X ((Rs.central l α).side k))
    (hXp : X.form = Sum.inr p) :
    ∃ j : Fin (4 * Rs.N α),
      (⟨p, X.anchor⟩ : PlacedTile P) ∈ ((Rs.annulus l α hl).spokes.piece j).faces := by
  set A : PlacedTile P := ⟨p, X.anchor⟩
  have hdisj := (Rs.retained l α).children.disjoint
  have hAX : A.carrier = X.carrier := by simp [A, PlacedTile.carrier, hXp]
  have hscX : Rs.GS.G.mixedScatterTile X = {A} := by simp [GroupedFamily.mixedScatterTile, hXp, A]
  have hAS : A ∈ Rs.GS.G.mixedScatter (Rs.retained l α).children.tiles :=
    Set.mem_biUnion hX (by rw [hscX]; rfl)
  obtain ⟨z, hz⟩ : (interior X.carrier).Nonempty := by
    rw [PlacedTile.carrier, interior_vadd]
    exact (Rs.GS.G.mixed.disk X.form).interior_nonempty.vadd_set
  -- the original child is not a face of `L`
  have hAL : A ∉ (Rs.annulus l α hl).L.faces := by
    intro h
    rw [← Rs.central_scatter l α hl] at h
    have hsub :=
      existsRoutingAfterPower_step3_entries_step1_grouped_step1_annular_member_step2_carrier Rs.GS.G _ h
    rw [hAX] at hsub
    exact interior_not_mem_other hdisj hX (Rs.central_mem l α) hXc hz (hsub (interior_subset hz))
  -- the original child lies in `H`
  have hR : 0 ≤ Rs.R α := by
    have h1 := Rs.R_large α
    have h2 := M.D_pos
    have h3 : 0 ≤ 10000 * ((M.K0 : ℝ) + 3) * M.D := by positivity
    linarith
  have hXH : X.carrier ⊆ (Rs.annulus l α hl).H.carrier := by
    obtain ⟨i, hi⟩ := hk
    set y := (Rs.central l α).vertex k
    have hyside : y ∈ (Rs.central l α).side k := by
      rw [tile_side_eq]; exact left_mem_segment ℝ _ _
    have hyX : y ∈ X.carrier := tile_side_subset X i (hi ▸ hyside)
    have hyL : y ∈ (Rs.annulus l α hl).L.carrier := by
      have h1 := existsRoutingAfterPower_step3_entries_step1_grouped_step1_annular_member_step1_cover Rs.GS.G
        (Rs.central l α) (tile_side_subset _ k hyside)
      rw [Rs.central_scatter l α hl, ← (Rs.annulus l α hl).L.carrier_eq] at h1
      exact h1
    obtain ⟨u, hu, v, hv, huv⟩ := (Rs.annulus l α hl).L_upper hyL
    intro x hx
    apply (Rs.annulus l α hl).H_lower
    have hcoord : ∀ i : Fin 2, |x i - y i| ≤ M.D := fun i =>
      rg_tile_coord M A (hAX ▸ hx) (hAX ▸ hyX) i
    refine ⟨u, ⟨?_, ?_⟩, x - u, ⟨?_, ?_⟩, add_sub_cancel u x⟩
    · exact hu.1.trans (by linarith)
    · exact hu.2.trans (by linarith)
    · have h := hcoord 0
      have hv0 := hv.1
      rw [← huv] at h
      simp only [PiLp.sub_apply, PiLp.add_apply] at h ⊢
      calc |x 0 - u 0| = |(x 0 - (u 0 + v 0)) + v 0| := by ring_nf
        _ ≤ |x 0 - (u 0 + v 0)| + |v 0| := abs_add_le _ _
        _ ≤ 2 * M.D := by linarith
    · have h := hcoord 1
      have hv1 := hv.2
      rw [← huv] at h
      simp only [PiLp.sub_apply, PiLp.add_apply] at h ⊢
      calc |x 1 - u 1| = |(x 1 - (u 1 + v 1)) + v 1| := by ring_nf
        _ ≤ |x 1 - (u 1 + v 1)| + |v 1| := abs_add_le _ _
        _ ≤ 2 * M.D := by linarith
  -- hence it is a face of `H`
  have hAH : A ∈ (Rs.annulus l α hl).H.faces := by
    have hzH : z ∈ (Rs.annulus l α hl).H.carrier := hXH (interior_subset hz)
    change z ∈ (Rs.annulus l α hl).H.disk.carrier at hzH
    rw [(Rs.annulus l α hl).H.carrier_eq] at hzH
    obtain ⟨F, hF, hzF⟩ := mem_support_iff'.1 hzH
    have hFS := (Rs.annulus l α hl).H.faces_sub hF
    simp only [GroupedFamily.mixedScatter, Set.mem_iUnion] at hFS
    obtain ⟨Y, hY, hFY⟩ := hFS
    have hFYc :=
      existsRoutingAfterPower_step3_entries_step1_grouped_step1_annular_member_step2_carrier Rs.GS.G Y hFY
    by_cases hYX : Y = X
    · subst hYX
      rw [hscX] at hFY
      rw [Set.mem_singleton_iff] at hFY
      exact hFY ▸ hF
    · exact absurd (hFYc hzF) (interior_not_mem_other hdisj hX hY (Ne.symm hYX) hz)
  obtain ⟨j, hj, -⟩ := ((Rs.annulus l α hl).spokes.piece_partition A hAS).1 ⟨hAH, hAL⟩
  exact ⟨j, hj⟩

/- The carrier of a scattered original tile is contained in the mixed tile that
   produced it.  This is local to the collision step because the general
   scattering helper is declared later in this file. -/
private lemma existsRoutingAfterPower_step3_entries_step1_grouped_step2_collision_aux_carrier
    (G : GroupedFamily P) (C : PlacedTile G.mixed) {A : PlacedTile P}
    (hA : A ∈ G.mixedScatterTile C) : A.carrier ⊆ C.carrier := by
  rcases C with ⟨f, a⟩
  rcases f with β | p
  · simp only [GroupedFamily.mixedScatterTile, Sum.elim_inl, translateSet,
      Set.mem_image] at hA
    obtain ⟨T, hT, rfl⟩ := hA
    have hsub : T.carrier ⊆ (G.P'.disk β).carrier := by
      rw [← G.support_eq β]
      exact carrier_subset_support hT
    intro x hx
    simp only [PlacedTile.carrier, PlacedTile.translate] at hx ⊢
    obtain ⟨y, hy, rfl⟩ := hx
    refine ⟨T.anchor +ᵥ y, hsub ⟨y, hy, rfl⟩, ?_⟩
    simp [vadd_eq_add, add_assoc]
  · simp only [GroupedFamily.mixedScatterTile, Sum.elim_inr,
      Set.mem_singleton_iff] at hA
    subst hA
    intro x hx
    exact hx

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step1_grouped`:
the retained child representing an annular piece cannot pass through an original child in that
piece; the only possible overlap is the same retained child. -/
private lemma existsRoutingAfterPower_step3_entries_step1_grouped_step2_collision
    (τ : Substitution P) (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ)
    (hl : 0 < l) (α : Rs.GS.G.P'.Form) {p : P.Form}
    {X Y : PlacedTile Rs.GS.G.mixed} {j : Fin (4 * Rs.N α)}
    (hX : X ∈ (Rs.retained l α).children.tiles)
    (hXc : X ≠ Rs.central l α) (hXp : X.form = Sum.inr p)
    (hY : Y ∈ (Rs.retained l α).children.tiles)
    (hYc : Y ≠ Rs.central l α)
    (hYj : Rs.GS.G.mixedScatterTile Y = ((Rs.annulus l α hl).spokes.piece j).faces)
    (hXj : (⟨p, X.anchor⟩ : PlacedTile P) ∈
      ((Rs.annulus l α hl).spokes.piece j).faces) : Y = X := by
  have _ := hXc
  have _ := hYc
  have hmem : (⟨p, X.anchor⟩ : PlacedTile P) ∈ Rs.GS.G.mixedScatterTile Y := by
    rw [hYj]
    exact hXj
  have hsub : (⟨p, X.anchor⟩ : PlacedTile P).carrier ⊆ Y.carrier :=
    existsRoutingAfterPower_step3_entries_step1_grouped_step2_collision_aux_carrier
      Rs.GS.G Y hmem
  have hXsub : X.carrier ⊆ Y.carrier := by
    intro x hx
    apply hsub
    simpa [PlacedTile.carrier, hXp] using hx
  by_contra hYX
  have hXY : X ≠ Y := fun h => hYX h.symm
  have hdisj := (Rs.retained l α).children.disjoint hX hY hXY
  have hnonempty : (interior X.carrier).Nonempty := by
    rw [PlacedTile.carrier, interior_vadd]
    exact (Rs.GS.G.mixed.disk X.form).interior_nonempty.vadd_set
  obtain ⟨x, hx⟩ := hnonempty
  exact Set.disjoint_left.1 hdisj hx (interior_mono hXsub hx)

/-- Step 3 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step1_grouped`:
the four separated windows force every annular piece to contain two distinct original faces. -/
private lemma existsRoutingAfterPower_step3_entries_step1_grouped_step3_piece_two_faces
    (τ : Substitution P) (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ)
    (hl : 0 < l) (α : Rs.GS.G.P'.Form) :
    ∀ j : Fin (4 * Rs.N α), ∃ A B : PlacedTile P,
      A ∈ ((Rs.annulus l α hl).spokes.piece j).faces ∧
      B ∈ ((Rs.annulus l α hl).spokes.piece j).faces ∧ A ≠ B := by
  intro j
  obtain ⟨e, he, hsep⟩ := Rs.windows l α hl
  obtain ⟨⟨A, hA, i, hAi⟩, -⟩ := he j 0
  obtain ⟨⟨B, hB, k, hBk⟩, -⟩ := he j 1
  refine ⟨A, B, hA, hB, ?_⟩
  rintro rfl
  have hxs : A.vertex i ∈ A.side i := ⟨(P.disk A.form).vertex i, left_mem_segment ℝ _ _, rfl⟩
  have hys : A.vertex k ∈ A.side k := ⟨(P.disk A.form).vertex k, left_mem_segment ℝ _ _, rfl⟩
  have hx : A.vertex i ∈ e j 0 := hAi ▸ hxs
  have hy : A.vertex k ∈ e j 1 := hBk ▸ hys
  have h1 := hsep j 0 j 1 (by simp) _ hx _ hy
  have h2 := step5_tile_dist_le M A (tile_side_subset A i hxs) (tile_side_subset A k hys)
  have h3 := Rs.R_large α
  have hD := M.D_pos
  have hK : (0 : ℝ) ≤ M.K0 := Nat.cast_nonneg _
  nlinarith

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step3_entries`: the print neighbour
is a retained annular group.  A child sharing a side with the central child (which scatters to the
inside-anchored group `L`) lies within `D` of `L`, hence in `H \ L`, hence in one annular piece; the
child representing that piece (`RoutingSetup.piece_child`) has more than one face, because its four
windows are more than `D` apart (`RoutingSetup.windows`, `R_large`); a single original child cannot
overlap it, so the given child is that grouped child. -/
private lemma existsRoutingAfterPower_step3_entries_step1_grouped (τ : Substitution P)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ) (hl : 0 < l) (α : Rs.GS.G.P'.Form)
    {X : PlacedTile Rs.GS.G.mixed} (hX : X ∈ (Rs.retained l α).children.tiles)
    (hXc : X ≠ Rs.central l α) {k : Fin (Rs.GS.G.mixed.disk (Rs.central l α).form).n}
    (hk : HasEdge X ((Rs.central l α).side k)) : ∃ β, X.form = Sum.inl β := by
  cases hform : X.form with
  | inl β => exact ⟨β, rfl⟩
  | inr p =>
    exfalso
    obtain ⟨j, hXj⟩ :=
      existsRoutingAfterPower_step3_entries_step1_grouped_step1_annular_member
        τ M Rs l hl α hX hXc hk hform
    obtain ⟨Y, hY, hYc, hYj⟩ := Rs.piece_child l α hl j
    have hYX :=
      existsRoutingAfterPower_step3_entries_step1_grouped_step2_collision
        τ M Rs l hl α hX hXc hform hY hYc hYj hXj
    rw [hYX] at hYj
    have hscatter : Rs.GS.G.mixedScatterTile X =
        ({⟨p, X.anchor⟩} : Set (PlacedTile P)) := by
      simp [GroupedFamily.mixedScatterTile, hform]
    rw [hscatter] at hYj
    obtain ⟨A, B, hA, hB, hAB⟩ :=
      existsRoutingAfterPower_step3_entries_step1_grouped_step3_piece_two_faces
        τ M Rs l hl α j
    have hA' : A ∈ ({⟨p, X.anchor⟩} : Set (PlacedTile P)) := hYj.symm ▸ hA
    have hB' : B ∈ ({⟨p, X.anchor⟩} : Set (PlacedTile P)) := hYj.symm ▸ hB
    have hAe : A = ⟨p, X.anchor⟩ := by simpa using hA'
    have hBe : B = ⟨p, X.anchor⟩ := by simpa using hB'
    exact hAB (hAe.trans hBe.symm)

/-- Step 1 of the blueprint proof of
`existsRoutingAfterPower_step3_entries_step2_outside`: identify the original retained child
on the outside of the annulus across a private edge.  The scattered face is explicitly tied to
the retained child and to the outside of the annular group.
-/
private lemma existsRoutingAfterPower_step3_entries_step2_outside_step1_original
    (τ : Substitution P) (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ)
    (hl : 0 < l) (α : Rs.GS.G.P'.Form) {j : Fin (4 * Rs.N α)} {e : Set Pt}
    (he : e ∈ privateOuterEdges (Rs.annulus l α hl) j) :
    ∃ (F : PlacedTile Rs.GS.G.mixed) (p : P.Form),
      F ∈ (Rs.retained l α).children.tiles ∧ F.form = Sum.inr p ∧
      (⟨p, F.anchor⟩ : PlacedTile P) ∈
        Rs.GS.G.mixedScatter (Rs.retained l α).children.tiles ∧
      (⟨p, F.anchor⟩ : PlacedTile P) ∉ (Rs.annulus l α hl).H.faces ∧
      HasEdge F e ∧ e ⊆ frontier (Rs.annulus l α hl).H.carrier := by
  have hsub_front := he.2.1
  obtain ⟨F_P, hFP_in_S, hFP_not_in_H, hFP_edge, hFP_disj⟩ := he.2.2
  simp only [GroupedFamily.mixedScatter, Set.mem_iUnion, exists_prop] at hFP_in_S
  obtain ⟨F, hF_child, hFP_in_scatterF⟩ := hFP_in_S
  have h_inr : ∃ p, F.form = Sum.inr p := by
    by_contra h_not_inr
    have h_inl : ∃ β, F.form = Sum.inl β := by
      cases hform : F.form with
      | inl β => exact ⟨β, rfl⟩
      | inr p => exact False.elim (h_not_inr ⟨p, hform⟩)
    by_cases h_cent : F = Rs.central l α
    · subst h_cent
      have h_scat := Rs.central_scatter l α hl
      rw [h_scat] at hFP_in_scatterF
      have hFP_L : F_P.carrier ⊆ (Rs.annulus l α hl).L.carrier := by
        intro x hx
        show x ∈ (Rs.annulus l α hl).L.disk.carrier
        rw [(Rs.annulus l α hl).L.carrier_eq]
        exact Set.subset_biUnion_of_mem (u := fun (Z : PlacedTile P) => Z.carrier) hFP_in_scatterF hx
      obtain ⟨i, hi⟩ := hFP_edge
      have h_e_sub : e ⊆ F_P.carrier := by
        intro x hx
        have hy : x ∈ F_P.side i := hi ▸ hx
        dsimp [PlacedTile.side, PlacedTile.carrier] at hy ⊢
        obtain ⟨y, hy1, rfl⟩ := Set.mem_vadd_set.1 hy
        apply Set.vadd_mem_vadd_set
        have hfront : y ∈ frontier (P.disk F_P.form).carrier := by
          rw [(P.disk F_P.form).frontier_eq]
          exact Set.subset_iUnion (fun j => segment ℝ _ _) i hy1
        exact (P.disk F_P.form).compact.isClosed.closure_eq ▸ frontier_subset_closure hfront
      have he_nonempty : e.Nonempty := by
        rw [← hi, PlacedTile.side]
        exact ⟨_, Set.vadd_mem_vadd_set (a := F_P.anchor) (left_mem_segment ℝ _ _)⟩
      have he_L : e ⊆ (Rs.annulus l α hl).L.carrier := h_e_sub.trans hFP_L
      have hD := M.D_pos
      have hR0 : 0 < Rs.R α := by have h1 : 0 ≤ (M.K0 : ℝ) := Nat.cast_nonneg M.K0; have h3 := Rs.R_large α; nlinarith
      have hb : 0 ≤ (Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α := by positivity
      have hnest1 : square (Rs.centre l α) ((Rs.N α : ℝ) * Rs.R α / 2) + Binf M.D ⊆
          interior (square (Rs.centre l α) ((Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α) + Binf (2 * M.D)) :=
        existsAnnularSpokes_step1_nest (Rs.centre l α) (by linarith) hb (by linarith)
      have hLH : (Rs.annulus l α hl).L.carrier ⊆ interior (Rs.annulus l α hl).H.carrier :=
        (Rs.annulus l α hl).L_upper.trans (hnest1.trans (interior_mono (Rs.annulus l α hl).H_lower))
      have he_intH : e ⊆ interior (Rs.annulus l α hl).H.carrier := he_L.trans hLH
      have he_empty : e ⊆ ∅ := fun x hx =>
        Set.disjoint_left.1 disjoint_interior_frontier (he_intH hx) (hsub_front hx)
      exact he_nonempty.ne_empty (Set.subset_empty_iff.1 he_empty)
    · obtain ⟨k, hk⟩ := Rs.small_scatter l α hl F hF_child h_cent h_inl
      rw [hk] at hFP_in_scatterF
      have h_kj : k = j := by
        by_contra h_k_ne_j
        have h_disj := hFP_disj k h_k_ne_j
        have hFP_sub : F_P.carrier ⊆ ((Rs.annulus l α hl).spokes.piece k).carrier := by
          intro x hx
          show x ∈ ((Rs.annulus l α hl).spokes.piece k).disk.carrier
          rw [((Rs.annulus l α hl).spokes.piece k).carrier_eq]
          exact Set.subset_biUnion_of_mem (u := fun (Z : PlacedTile P) => Z.carrier) hFP_in_scatterF hx
        obtain ⟨i, hi⟩ := hFP_edge
        have h_e_sub : e ⊆ F_P.carrier := by
          intro x hx
          have hy : x ∈ F_P.side i := hi ▸ hx
          dsimp [PlacedTile.side, PlacedTile.carrier] at hy ⊢
          obtain ⟨y, hy1, rfl⟩ := Set.mem_vadd_set.1 hy
          apply Set.vadd_mem_vadd_set
          have hfront : y ∈ frontier (P.disk F_P.form).carrier := by
            rw [(P.disk F_P.form).frontier_eq]
            exact Set.subset_iUnion (fun j => segment ℝ _ _) i hy1
          exact (P.disk F_P.form).compact.isClosed.closure_eq ▸ frontier_subset_closure hfront
        have h_e_nonempty : e.Nonempty := by
          rw [← hi, PlacedTile.side]
          exact ⟨_, Set.vadd_mem_vadd_set (a := F_P.anchor) (left_mem_segment ℝ _ _)⟩
        obtain ⟨x, hx⟩ := h_e_nonempty
        exact Set.disjoint_left.1 h_disj (h_e_sub hx) (hFP_sub (h_e_sub hx))
      rw [h_kj] at hFP_in_scatterF
      have hFP_in_H : F_P ∈ (Rs.annulus l α hl).H.faces :=
        ((Rs.annulus l α hl).spokes.piece_sub j hFP_in_scatterF).1
      exact hFP_not_in_H hFP_in_H
  obtain ⟨p, hp⟩ := h_inr
  use F, p
  have hF_scat : Rs.GS.G.mixedScatterTile F = {⟨p, F.anchor⟩} := by
    dsimp [GroupedFamily.mixedScatterTile]
    rw [hp]
    rfl
  have h_in_scatter : (⟨p, F.anchor⟩ : PlacedTile P) ∈ Rs.GS.G.mixedScatter (Rs.retained l α).children.tiles := by
    dsimp [GroupedFamily.mixedScatter]
    rw [Set.mem_iUnion]
    use F
    rw [Set.mem_iUnion]
    use hF_child
    rw [hF_scat]
    exact Set.mem_singleton _
  rw [hF_scat] at hFP_in_scatterF
  have hF_eq : F_P = ⟨p, F.anchor⟩ := hFP_in_scatterF
  subst hF_eq
  have hFeq : F = (⟨Sum.inr p, F.anchor⟩ : PlacedTile Rs.GS.G.mixed) := by
    apply PlacedTile.ext
    · exact hp
    · rfl
  have hEdge : HasEdge F e := by
    rw [hFeq]
    simpa [HasEdge, PlacedTile.side] using hFP_edge
  exact ⟨hF_child, hp, h_in_scatter, hFP_not_in_H, hEdge, hsub_front⟩

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior`:
"the face cannot be an unrelated placed tile" -- every original tile of the scattering of a mixed
tile lies in the carrier of that mixed tile. -/
private lemma existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior_step1_carrier
    (G : GroupedFamily P) (C : PlacedTile G.mixed) {X : PlacedTile P}
    (hX : X ∈ G.mixedScatterTile C) : X.carrier ⊆ C.carrier := by
  rcases C with ⟨f, a⟩
  rcases f with β | p
  · simp only [GroupedFamily.mixedScatterTile, Sum.elim_inl, translateSet, Set.mem_image] at hX
    obtain ⟨T0, hT0, rfl⟩ := hX
    have hsub : T0.carrier ⊆ (G.P'.disk β).carrier := by
      rw [← G.support_eq β]; exact carrier_subset_support hT0
    intro x hx
    simp only [PlacedTile.carrier, PlacedTile.translate] at hx ⊢
    obtain ⟨y, hy, rfl⟩ := hx
    refine ⟨T0.anchor +ᵥ y, hsub ⟨y, hy, rfl⟩, ?_⟩
    simp [vadd_eq_add, add_assoc]
  · simp only [GroupedFamily.mixedScatterTile, Sum.elim_inr, Set.mem_singleton_iff] at hX
    subst hX
    intro x hx
    exact hx

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior`:
"Membership in both the retained children and the scattered tiling is retained explicitly" --
the scattering of a patch of mixed tiles has pairwise disjoint interiors. -/
private lemma existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior_step1_disjoint
    (G : GroupedFamily P) (T : Patch G.mixed) : DisjointInteriors (G.mixedScatter T.tiles) := by
  intro X hX Y hY hXY
  simp only [GroupedFamily.mixedScatter, Set.mem_iUnion] at hX hY
  obtain ⟨C1, hC1, hX1⟩ := hX
  obtain ⟨C2, hC2, hY2⟩ := hY
  by_cases hC : C1 = C2
  · subst hC
    rcases C1 with ⟨f, a⟩
    rcases f with β | p
    · simp only [GroupedFamily.mixedScatterTile, Sum.elim_inl, translateSet, Set.mem_image] at hX1 hY2
      obtain ⟨X0, hX0, rfl⟩ := hX1
      obtain ⟨Y0, hY0, rfl⟩ := hY2
      have hne : X0 ≠ Y0 := fun h => hXY (h ▸ rfl)
      have hd := (G.dissect β).disjoint hX0 hY0 hne
      have hcar : ∀ Z : PlacedTile P, (Z.translate a).carrier = a +ᵥ Z.carrier := by
        intro Z
        simp only [PlacedTile.carrier, PlacedTile.translate, vadd_vadd]
        rfl
      change Disjoint (interior (X0.translate a).carrier) (interior (Y0.translate a).carrier)
      rw [hcar, hcar, interior_vadd, interior_vadd]
      exact Set.disjoint_vadd_set.2 hd
    · simp only [GroupedFamily.mixedScatterTile, Sum.elim_inr, Set.mem_singleton_iff] at hX1 hY2
      exact absurd (hX1.trans hY2.symm) hXY
  · have hd := T.disjoint hC1 hC2 hC
    exact Disjoint.mono
      (interior_mono
        (existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior_step1_carrier G C1 hX1))
      (interior_mono
        (existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior_step1_carrier G C2 hY2))
      hd

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior`:
"Its outside-anchored original face contains a point outside `K₁`" -- a face of a tiling with
disjoint interiors, not in the outside-anchored group `H`, having a listed side on the boundary of
`H`, is the outside face of a listed side of `H`, hence its interior meets the exterior of `K`. -/
private lemma existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior_step2_anchor
    {S : Set (PlacedTile P)} (hdisj : DisjointInteriors S) (H : FaceGroup S) {K : Set Pt}
    (hanc : H.OutsideAnchored K) {A : PlacedTile P} (hA : A ∈ S) (hAH : A ∉ H.faces)
    (i : Fin (P.disk A.form).n) (hi : A.side i ⊆ frontier H.carrier) :
    (interior A.carrier ∩ Kᶜ).Nonempty := by
  classical
  set a := A.vertex i
  set b := A.vertex (finRotate _ i)
  have hab : a ≠ b := tile_vertex_ne_next A i
  -- a relative interior point of the side, not a vertex of `H`
  have hinf : (openSegment ℝ a b).Infinite := by
    rw [openSegment_eq_image']
    refine (Set.Ioo_infinite (by norm_num : (0 : ℝ) < 1)).image ?_
    intro s _ t _ hst
    have hd : b - a ≠ 0 := sub_ne_zero.2 hab.symm
    exact smul_cancel_pt hd (add_left_cancel hst)
  have hVfin : H.disk.vertexSet.Finite := Set.finite_range _
  obtain ⟨q, hqo, hqV⟩ := (hinf.diff hVfin).nonempty
  have hqA : q ∈ A.side i := openSeg_mem_side A i hqo
  have hqH : q ∈ frontier H.disk.carrier := hi hqA
  rw [H.disk.frontier_eq] at hqH
  obtain ⟨m, hm⟩ := Set.mem_iUnion.1 hqH
  have hqm : q ∈ openSegment ℝ (H.disk.vertex m) (H.disk.vertex (finRotate _ m)) := by
    refine mem_openSegment_of_ne_left_right ?_ ?_ hm
    · intro h; exact hqV ⟨m, h⟩
    · intro h; exact hqV ⟨_, h⟩
  obtain ⟨F', hF'S, hF'H, ⟨k, hk⟩, hF'K⟩ := hanc m
  obtain ⟨B, hBH, ⟨j, hj⟩⟩ := H.side_whole m
  have hBS : B ∈ S := H.faces_sub hBH
  have hBF : B ≠ F' := fun h => hF'H (h ▸ hBH)
  have hAB : A ≠ B := fun h => hAH (h ▸ hBH)
  have hqB : q ∈ openSegment ℝ (B.vertex j) (B.vertex (finRotate _ j)) := by
    refine openSegment_transfer (pd_vertex_ne_next H.disk m) ?_ hqm
    rw [← tile_side_eq, hj]; rfl
  have hkj : F'.side k = B.side j := hk.trans hj.symm
  obtain ⟨r, hr, σ, hσ, hch⟩ := two_sides hdisj hBS hF'S hBF j k hkj hqB
  -- a point of the interior of `A` near `q`
  have hqAc : q ∈ closure (interior A.carrier) := by
    rw [tile_regular]; exact tile_side_subset A i hqA
  obtain ⟨y, hyA, hqy⟩ := Metric.mem_closure_iff.1 hqAc (r / 2) (by linarith)
  obtain ⟨ε, hε, hεA⟩ := Metric.isOpen_iff.1 isOpen_interior y hyA
  set d := B.vertex (finRotate _ j) - B.vertex j
  have hd : d ≠ 0 := sub_ne_zero.2 (tile_vertex_ne_next B j).symm
  have hnegσ : -σ = 1 ∨ -σ = -1 := by
    rcases hσ with hσ | hσ <;> rw [hσ] <;> norm_num
  obtain ⟨z, hyz, hz⟩ := exists_near_off_line (B.vertex j) hd y hnegσ (lt_min hε (half_pos hr))
  have hyball : y ∈ Metric.ball q r := by
    rw [Metric.mem_ball, dist_comm]; linarith
  have hzball : z ∈ Metric.ball q r := by
    rw [Metric.mem_ball]
    have h1 := dist_triangle z y q
    have h2 : dist y z < r / 2 := lt_of_lt_of_le hyz (min_le_right _ _)
    rw [dist_comm z y, dist_comm y q] at h1
    linarith
  have hzA : z ∈ interior A.carrier := hεA (by
    rw [Metric.mem_ball, dist_comm]; exact lt_of_lt_of_le hyz (min_le_left _ _))
  by_cases hpos : 0 < σ * jcr d (y - B.vertex j)
  · exact (interiors_disjoint hdisj hA hBS hAB hyA ((hch y hyball).1 hpos)).elim
  · have hzneg : σ * jcr d (z - B.vertex j) < 0 := by
      push_neg at hpos; linarith
    have hzF : z ∈ interior F'.carrier := (hch z hzball).2.1 hzneg
    by_cases hAF : A = F'
    · rw [hAF]; exact hF'K
    · exact (interiors_disjoint hdisj hA hF'S hAF hzA hzF).elim

/-- Step 2 of the blueprint proof of
`existsRoutingAfterPower_step3_entries_step2_outside`: an original scattered face attached to a
boundary edge of an outside-anchored group has an interior point in the exterior.  Membership in
both the retained children and the scattered tiling is retained explicitly, so the face cannot be
an unrelated placed tile.
-/
private lemma existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior
    (τ : Substitution P) (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ)
    (hl : 0 < l) (α : Rs.GS.G.P'.Form) {j : Fin (4 * Rs.N α)} {e : Set Pt}
    (F : PlacedTile Rs.GS.G.mixed) (p : P.Form)
    (hF : F ∈ (Rs.retained l α).children.tiles) (hform : F.form = Sum.inr p)
    (hscatter : (⟨p, F.anchor⟩ : PlacedTile P) ∈
      Rs.GS.G.mixedScatter (Rs.retained l α).children.tiles)
    (houtside : (⟨p, F.anchor⟩ : PlacedTile P) ∉ (Rs.annulus l α hl).H.faces)
    (heF : HasEdge F e) (he_boundary : e ⊆ frontier (Rs.annulus l α hl).H.carrier) :
    ∃ q, q ∈ interior F.carrier ∧
      q ∉ square (Rs.centre l α) ((Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α) + Binf (3 * M.D) := by
  have _ := j
  rcases F with ⟨f, a⟩
  dsimp only at hform
  subst hform
  obtain ⟨i, hi⟩ := heF
  have hside : (⟨p, a⟩ : PlacedTile P).side i ⊆ frontier (Rs.annulus l α hl).H.carrier := by
    rw [← hi] at he_boundary; exact he_boundary
  exact existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior_step2_anchor
    (existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior_step1_disjoint Rs.GS.G
      (Rs.retained l α).children)
    (Rs.annulus l α hl).H (Rs.annulus l α hl).H_anchor hscatter houtside i hside

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step3_entries`: "Its
outside-anchored original face contains a point `q_i` outside `K₁`".  The outside face of a private
outer edge (`H.OutsideAnchored`, the edge being a listed side of `H`) is an original child of the
retained template, and its interior meets the exterior of `K₁ = Q₁ + B∞(3D)`. -/
private lemma existsRoutingAfterPower_step3_entries_step2_outside (τ : Substitution P)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ) (hl : 0 < l) (α : Rs.GS.G.P'.Form)
    {j : Fin (4 * Rs.N α)} {e : Set Pt} (he : e ∈ privateOuterEdges (Rs.annulus l α hl) j) :
    ∃ (F : PlacedTile Rs.GS.G.mixed) (q : Pt), F ∈ (Rs.retained l α).children.tiles ∧
      (∃ p, F.form = Sum.inr p) ∧ HasEdge F e ∧ q ∈ interior F.carrier ∧
      q ∉ square (Rs.centre l α) ((Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α) + Binf (3 * M.D) := by
  obtain ⟨F, p, hF, hform, hscatter, houtside, hEdge, hboundary⟩ :=
    existsRoutingAfterPower_step3_entries_step2_outside_step1_original τ M Rs l hl α he
  obtain ⟨q, hqint, hqout⟩ :=
    existsRoutingAfterPower_step3_entries_step2_outside_step2_exterior τ M Rs l hl α (j := j) F p
      hF hform hscatter houtside hEdge hboundary
  exact ⟨F, q, hF, ⟨p, hform⟩, hEdge, hqint, hqout⟩

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed`:
An element `e` of `privateOuterEdges` has a face `A` in the piece which has it as an edge. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step1_mem (τ : Substitution P)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ) (hl : 0 < l) (α : Rs.GS.G.P'.Form)
    {j : Fin (4 * Rs.N α)} {X : PlacedTile Rs.GS.G.mixed}
    (hX : X ∈ (Rs.retained l α).children.tiles)
    (hXj : Rs.GS.G.mixedScatterTile X = ((Rs.annulus l α hl).spokes.piece j).faces)
    {e : Set Pt} (he : e ∈ privateOuterEdges (Rs.annulus l α hl) j) :
    ∃ A ∈ ((Rs.annulus l α hl).spokes.piece j).faces, HasEdge A e := by
  have _ := hX
  have _ := hXj
  exact he.1

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary`:
the support of a translated set of placed tiles is the translate of the support. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary_step1_translate
    (v : Pt) (S : Set (PlacedTile P)) :
    support (translateSet v S) = v +ᵥ support S := by
  have hcarrier : ∀ B : PlacedTile P, (B.translate v).carrier = v +ᵥ B.carrier := by
    intro B
    ext y
    simp [PlacedTile.carrier, PlacedTile.translate, vadd_eq_add, add_vadd]
  ext x
  simp only [support, translateSet, mem_iUnion, Set.mem_vadd_set, Set.mem_image]
  constructor
  · rintro ⟨A, ⟨B, hB, rfl⟩, hx⟩
    rw [hcarrier] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    exact ⟨y, ⟨B, hB, hy⟩, rfl⟩
  · rintro ⟨_, ⟨A, hA, hx⟩, rfl⟩
    exact ⟨A.translate v, ⟨A, hA, rfl⟩, by rw [hcarrier]; exact ⟨_, hx, rfl⟩⟩

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary`:
the carrier of a placed mixed tile is the union of the carriers of its scattered original faces. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary_step2_carrier
    (G : GroupedFamily P) (X : PlacedTile G.mixed) :
    X.carrier = support (G.mixedScatterTile X) := by
  obtain ⟨f, a⟩ := X
  cases f with
  | inl β =>
    show a +ᵥ (G.P'.disk β).carrier = support (translateSet a (G.dissect β).tiles)
    rw [existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary_step1_translate,
      G.support_eq β]
  | inr p =>
    show a +ᵥ (P.disk p).carrier = support ({⟨p, a⟩} : Set (PlacedTile P))
    simp [support, PlacedTile.carrier]

/-- Step 3 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary`:
a listed side of a placed tile is contained in its carrier. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary_step3_side
    {A : PlacedTile P} {e : Set Pt} (h : HasEdge A e) : e ⊆ A.carrier := by
  obtain ⟨i, rfl⟩ := h
  apply Set.vadd_set_mono
  intro y hy
  have hfr : y ∈ frontier (P.disk A.form).carrier := by
    rw [(P.disk A.form).frontier_eq]
    exact Set.mem_iUnion.2 ⟨i, hy⟩
  have := frontier_subset_closure hfr
  rwa [(P.disk A.form).compact.isClosed.closure_eq] at this

/-- Step 4 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary`:
a point of a face group `K` contained in a face group `H` (faces of `K` among faces of `H`) which
lies on the frontier of `H` lies on the frontier of `K`. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary_step4_frontier
    {S : Set (PlacedTile P)} (K H : FaceGroup S) (hKH : K.faces ⊆ H.faces) {x : Pt}
    (hxK : x ∈ K.carrier) (hxH : x ∈ frontier H.carrier) : x ∈ frontier K.carrier := by
  have hsub : K.carrier ⊆ H.carrier := by
    show K.disk.carrier ⊆ H.disk.carrier
    rw [K.carrier_eq, H.carrier_eq]
    exact Set.biUnion_subset_biUnion_left hKH
  exact ⟨subset_closure hxK, fun hint => hxH.2 (interior_mono hsub hint)⟩

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed`:
An element `e` of `privateOuterEdges` of the annulus lies on the boundary of the retained child `X`. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary (τ : Substitution P)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ) (hl : 0 < l) (α : Rs.GS.G.P'.Form)
    {j : Fin (4 * Rs.N α)} {X : PlacedTile Rs.GS.G.mixed}
    (hX : X ∈ (Rs.retained l α).children.tiles)
    (hXj : Rs.GS.G.mixedScatterTile X = ((Rs.annulus l α hl).spokes.piece j).faces)
    {e : Set Pt} (he : e ∈ privateOuterEdges (Rs.annulus l α hl) j) :
    e ⊆ frontier X.carrier := by
  have _ := hX
  intro x hx
  have hcarX :=
    existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary_step2_carrier Rs.GS.G X
  rw [hXj, ← ((Rs.annulus l α hl).spokes.piece j).carrier_eq] at hcarX
  rw [hcarX]
  obtain ⟨⟨A, hA, hAe⟩, hH, -⟩ := he
  have hxK : x ∈ ((Rs.annulus l α hl).spokes.piece j).carrier := by
    show x ∈ ((Rs.annulus l α hl).spokes.piece j).disk.carrier
    rw [((Rs.annulus l α hl).spokes.piece j).carrier_eq]
    exact Set.mem_biUnion hA
      (existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary_step3_side hAe hx)
  exact existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary_step4_frontier _ _
    (fun B hB => ((Rs.annulus l α hl).spokes.piece_sub j hB).1) hxK (hH hx)

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge`:
an infinite convex set covered by finitely many convex sets (the listed sides of the group) overlaps
one of them with positive length. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge_step1_overlap {e : Set Pt}
    (hec : Convex ℝ e) (hei : e.Infinite) {n : ℕ} (s : Fin n → Set Pt) (hs : ∀ k, Convex ℝ (s k))
    (hcov : e ⊆ ⋃ k, s k) : ∃ k, OverlapPos e (s k) := by
  by_contra hcon
  push_neg at hcon
  have hsub : ∀ k, (e ∩ s k).Subsingleton := by
    intro k x hx y hy
    by_contra hxy
    exact hcon k ⟨x, y, hxy, (hec.inter (hs k)).segment_subset hx hy⟩
  apply hei
  have : e = ⋃ k, e ∩ s k := by
    rw [← inter_iUnion]; exact (inter_eq_left.mpr hcov).symm
  rw [this]
  exact finite_iUnion fun k => (hsub k).finite

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge`:
a listed side of a polygonal disk is a nondegenerate segment, hence an infinite set. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge_step2_sideInfinite
    (D : PolygonalDisk) (i : Fin D.n) : (D.side i).Infinite := by
  have hrot : ∀ i : Fin D.n, finRotate D.n i ≠ i := by
    obtain ⟨m, hm⟩ : ∃ m, D.n = m + 1 := ⟨D.n - 1, by have := D.three_le; omega⟩
    have h3 := D.three_le
    rw [hm] at h3 ⊢
    intro i hc
    rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
    · rw [finRotate_succ_apply] at hc
      have := congrArg Fin.val hc
      simp at this
    · rw [finRotate_last] at hc
      have := congrArg Fin.val hc
      simp at this
      omega
  have hne : D.vertex i ≠ D.vertex (finRotate D.n i) := fun h => hrot i (D.vertex_injective h).symm
  unfold PolygonalDisk.side
  rw [segment_eq_image_lineMap]
  exact (Icc_infinite zero_lt_one).image (AffineMap.lineMap_injective ℝ hne).injOn

/-- Step 3 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge`:
the listed sides of a group are complete original sides (`side_whole`) and the group is
side-to-side (`sts`), so an original side of a constituent lying on the group boundary is a listed
side of the group. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge_step3_groupSide
    (G : GroupedFamily P) (β : G.P'.Form) {A₀ : PlacedTile P} (hA₀ : A₀ ∈ (G.dissect β).tiles)
    (i : Fin (P.disk A₀.form).n) (hfr : A₀.side i ⊆ frontier (G.P'.disk β).carrier) :
    ∃ k, (G.P'.disk β).side k = A₀.side i := by
  rw [(G.P'.disk β).frontier_eq] at hfr
  have hinf : (A₀.side i).Infinite := by
    unfold PlacedTile.side
    rw [← Set.image_vadd]
    exact (existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge_step2_sideInfinite _ i).image
      (add_right_injective A₀.anchor).injOn
  obtain ⟨k, x, y, hxy, hseg⟩ :=
    existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge_step1_overlap
      ((convex_segment _ _).vadd A₀.anchor) hinf
      (fun k => (G.P'.disk β).side k) (fun k => convex_segment _ _) hfr
  obtain ⟨B, hB, j, hBj⟩ := G.side_whole β k
  have := G.sts β A₀ hA₀ B hB i j ⟨x, y, hxy, by rw [hBj]; exact hseg⟩
  exact ⟨k, hBj.symm.trans this.symm⟩

/-- Step 3 of the blueprint proof of `existsRoutingAfterPower_step3_entries_step3_listed`:
The listed boundary sides of `X` are its complete boundary original sides, so `e` is an edge of `X`. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge (τ : Substitution P)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ) (hl : 0 < l) (α : Rs.GS.G.P'.Form)
    {j : Fin (4 * Rs.N α)} {X : PlacedTile Rs.GS.G.mixed}
    (hX : X ∈ (Rs.retained l α).children.tiles)
    (hXj : Rs.GS.G.mixedScatterTile X = ((Rs.annulus l α hl).spokes.piece j).faces)
    {e : Set Pt} (he : e ∈ privateOuterEdges (Rs.annulus l α hl) j)
    (hA : ∃ A ∈ ((Rs.annulus l α hl).spokes.piece j).faces, HasEdge A e)
    (hBoundary : e ⊆ frontier X.carrier) :
    HasEdge X e := by
  have _ := hX
  have _ := he
  obtain ⟨A, hA, i, hAi⟩ := hA
  obtain ⟨form, v⟩ := X
  rcases form with β | p
  · change translateSet v (Rs.GS.G.dissect β).tiles = _ at hXj
    change e ⊆ frontier (v +ᵥ (Rs.GS.G.P'.disk β).carrier) at hBoundary
    rw [← hXj] at hA
    obtain ⟨A₀, hA₀, rfl⟩ := hA
    have hside : (A₀.translate v).side i = v +ᵥ A₀.side i := by
      simp only [PlacedTile.side, PlacedTile.translate, vadd_vadd, vadd_eq_add]
    subst hAi
    rw [hside] at hBoundary
    have hfr : frontier (v +ᵥ (Rs.GS.G.P'.disk β).carrier) = v +ᵥ frontier (Rs.GS.G.P'.disk β).carrier := by
      have h := (Homeomorph.addLeft v).image_frontier (Rs.GS.G.P'.disk β).carrier
      rw [← Set.image_vadd, ← Set.image_vadd]
      exact h.symm
    rw [hfr, vadd_set_subset_vadd_set_iff] at hBoundary
    obtain ⟨k, hk⟩ :=
      existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge_step3_groupSide Rs.GS.G β hA₀ i hBoundary
    refine ⟨k, ?_⟩
    rw [hside]
    change v +ᵥ (Rs.GS.G.P'.disk β).side k = _
    rw [hk]
  · change ({⟨p, v⟩} : Set (PlacedTile P)) = _ at hXj
    rw [← hXj, mem_singleton_iff] at hA
    subst hA
    exact ⟨i, hAi⟩

/-- Step 3 of the blueprint proof of `existsRoutingAfterPower_step3_entries`: "The entry and
print belong to the same small group".  A private outer edge of an annular piece lies on the
boundary of the retained child that scatters to that piece, and the listed sides of a group are
its complete boundary original sides (`GroupedFamily.side_whole`, `vertex_retained`), so the edge
is a listed side of that child. -/
private lemma existsRoutingAfterPower_step3_entries_step3_listed (τ : Substitution P)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ) (hl : 0 < l) (α : Rs.GS.G.P'.Form)
    {j : Fin (4 * Rs.N α)} {X : PlacedTile Rs.GS.G.mixed}
    (hX : X ∈ (Rs.retained l α).children.tiles)
    (hXj : Rs.GS.G.mixedScatterTile X = ((Rs.annulus l α hl).spokes.piece j).faces)
    {e : Set Pt} (he : e ∈ privateOuterEdges (Rs.annulus l α hl) j) : HasEdge X e := by
  have h1 := existsRoutingAfterPower_step3_entries_step3_listed_step1_mem τ M Rs l hl α hX hXj he
  have h2 := existsRoutingAfterPower_step3_entries_step3_listed_step2_boundary τ M Rs l hl α hX hXj he
  exact existsRoutingAfterPower_step3_entries_step3_listed_step3_hasEdge τ M Rs l hl α hX hXj he h1 h2

private lemma existsRoutingAfterPower_step3_entries_step4_scatterInj_support (v : Pt) (S : Set (PlacedTile P)) :
    support (translateSet v S) = v +ᵥ support S := by
  ext x
  simp only [support, translateSet, mem_iUnion, Set.mem_vadd_set, Set.mem_image]
  constructor
  · rintro ⟨A, ⟨B, hB, rfl⟩, hx⟩
    have hcarrier_translate : (B.translate v).carrier = v +ᵥ B.carrier := by
      ext y
      simp [PlacedTile.carrier, PlacedTile.translate, vadd_eq_add, add_vadd]
    rw [hcarrier_translate] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    exact ⟨y, ⟨B, hB, hy⟩, rfl⟩
  · rintro ⟨_, ⟨A, hA, hx⟩, rfl⟩
    have hcarrier_translate : (A.translate v).carrier = v +ᵥ A.carrier := by
      ext y
      simp [PlacedTile.carrier, PlacedTile.translate, vadd_eq_add, add_vadd]
    exact ⟨A.translate v, ⟨A, hA, rfl⟩, by rw [hcarrier_translate]; exact ⟨_, hx, rfl⟩⟩

/-- Step 4 of the blueprint proof of `existsRoutingAfterPower_step3_entries`: "The windows are
separated by a fixed multiple of `R`, so the four faces are distinct" -- the bookkeeping fact that
distinct children of the retained template have distinct scatterings (the scattering of a child
covers exactly its carrier, and the children have disjoint interiors), so distinct print
neighbours lie in distinct annular pieces. -/
private lemma existsRoutingAfterPower_step3_entries_step4_scatterInj (τ : Substitution P)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ) (α : Rs.GS.G.P'.Form)
    {X Y : PlacedTile Rs.GS.G.mixed} (hX : X ∈ (Rs.retained l α).children.tiles)
    (hY : Y ∈ (Rs.retained l α).children.tiles)
    (hXY : Rs.GS.G.mixedScatterTile X = Rs.GS.G.mixedScatterTile Y) : X = Y := by
  have hsX : support (Rs.GS.G.mixedScatterTile X) = X.carrier := by
    unfold GroupedFamily.mixedScatterTile
    rcases X with ⟨f, a⟩
    rcases f with f_G | f_P
    · simp [PlacedTile.carrier]
      rw [existsRoutingAfterPower_step3_entries_step4_scatterInj_support]
      rw [Rs.GS.G.support_eq f_G]
    · simp [support, PlacedTile.carrier]
  have hsY : support (Rs.GS.G.mixedScatterTile Y) = Y.carrier := by
    unfold GroupedFamily.mixedScatterTile
    rcases Y with ⟨f, a⟩
    rcases f with f_G | f_P
    · simp [PlacedTile.carrier]
      rw [existsRoutingAfterPower_step3_entries_step4_scatterInj_support]
      rw [Rs.GS.G.support_eq f_G]
    · simp [support, PlacedTile.carrier]
  have h_carr_eq : X.carrier = Y.carrier := by
    rw [← hsX, ← hsY, hXY]
  by_contra h_neq
  have h_disj : DisjointInteriors (Rs.retained l α).children.tiles := (Rs.retained l α).children.disjoint
  have h_disjoint := h_disj hX hY h_neq
  have hint_eq : interior X.carrier = interior Y.carrier := by
    rw [h_carr_eq]
  have h_int_nonempty : (interior X.carrier).Nonempty := by
    have h_int := (Rs.GS.G.mixed.disk X.form).interior_nonempty
    rw [PlacedTile.carrier, interior_vadd]
    exact Set.Nonempty.vadd_set h_int
  have h_disjoint2 : Disjoint (interior X.carrier) (interior Y.carrier) := h_disjoint
  rw [hint_eq] at h_disjoint2
  have h_empty : interior Y.carrier = ∅ := Disjoint.eq_bot_of_self h_disjoint2
  rw [hint_eq] at h_int_nonempty
  rw [h_empty] at h_int_nonempty
  exact Set.not_nonempty_empty h_int_nonempty

/-- Step 3 of the blueprint proof of `existsRoutingAfterPower`: "In each selected small group's
middle outer interval, choose four separated windows ... choose a private fine edge in each window.
... Its outside-anchored original face contains a point `q_i` outside `K₁`".  The print slots and
neighbours come from `RoutingSetup.print_slots`, the pieces from `small_scatter`, the windows from
`RoutingSetup.windows`. -/
private lemma existsRoutingAfterPower_step3_entries (τ : Substitution P) (M : MeshConstants P)
    (Rs : RoutingSetup τ M) (l : ℕ) (hl : 0 < l) (α : Rs.GS.G.P'.Form) :
    Nonempty (existsRoutingAfterPower_EntryData τ M Rs l α hl) := by
  classical
  obtain ⟨f, g, hf, hg, hcyc, hord, hid, hfg⟩ := Rs.print_slots l α hl
  have hgr : ∀ a ∈ Rs.markedSides α, ∃ β, (g a).form = Sum.inl β := fun a ha =>
    existsRoutingAfterPower_step3_entries_step1_grouped τ M Rs l hl α (hfg a ha).1
      (hfg a ha).2.1 (hfg a ha).2.2
  have hN : 0 < 4 * Rs.N α := by
    have := Rs.N_two α
    omega
  have hpc : ∀ a, ∃ j : Fin (4 * Rs.N α), a ∈ Rs.markedSides α →
      Rs.GS.G.mixedScatterTile (g a) = ((Rs.annulus l α hl).spokes.piece j).faces := by
    intro a
    by_cases ha : a ∈ Rs.markedSides α
    · obtain ⟨j, hj⟩ := Rs.small_scatter l α hl (g a) (hfg a ha).1 (hfg a ha).2.1 (hgr a ha)
      exact ⟨j, fun _ => hj⟩
    · exact ⟨⟨0, hN⟩, fun h => absurd h ha⟩
  choose pc hpc using hpc
  obtain ⟨E, hEpriv, hEsep⟩ := Rs.windows l α hl
  have hout := fun j i =>
    existsRoutingAfterPower_step3_entries_step2_outside τ M Rs l hl α (hEpriv j i)
  choose F q hF using hout
  exact ⟨{
    printIdx := f
    neighbour := g
    piece := pc
    entry := fun a i => E (pc a) i
    face := fun a i => F (pc a) i
    point := fun a i => q (pc a) i
    print_injOn := hf
    print_cyclic := hcyc
    print_order := hord
    print_id := hid
    neighbour_mem := fun a ha => ⟨(hfg a ha).1, (hfg a ha).2.1⟩
    neighbour_injOn := hg
    neighbour_grouped := hgr
    print_edge := fun a ha => (hfg a ha).2.2
    piece_eq := fun a ha => hpc a ha
    entry_private := fun a _ i => hEpriv (pc a) i
    entry_side := fun a ha i => existsRoutingAfterPower_step3_entries_step3_listed τ M Rs l hl α
      (hfg a ha).1 (hpc a ha) (hEpriv (pc a) i)
    face_mem := fun a _ i => ⟨(hF (pc a) i).1, (hF (pc a) i).2.1⟩
    face_edge := fun a _ i => (hF (pc a) i).2.2.1
    point_mem := fun a _ i => (hF (pc a) i).2.2.2.1
    point_out := fun a _ i => (hF (pc a) i).2.2.2.2
    separated := by
      intro a ha b hb i j hij x hx y hy
      refine hEsep (pc a) i (pc b) j ?_ x hx y hy
      intro h
      obtain ⟨h1, h2⟩ := Prod.mk.inj h
      apply hij
      have hab : g a = g b := existsRoutingAfterPower_step3_entries_step4_scatterInj τ M Rs l α
        (hfg a ha).1 (hfg b hb).1 (by rw [hpc a ha, hpc b hb, h1])
      rw [hg ha hb hab, h2] }⟩

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step4_routes`: "Each fixed radial
direction meets its boundary at a point `b_i(z)`": the point of the circle of radius `r` about the
centre `c` on the ray from `c` through `q`. -/
private def existsRoutingAfterPower_step4_routes_step1_radialEnd (c q : Pt) (r : ℝ) : Pt :=
  c + (r / ‖q - c‖) • (q - c)

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step4_routes`: "Join each inner radial
ray at its intermediate-square endpoint to the outer PL route": the polygonal arc `γ` followed by
the segment from its endpoint to `q`. -/
private def existsRoutingAfterPower_step4_routes_step1_join (γ : PolyArc) (q : Pt) : PolyArc :=
  ⟨γ.n + 1, Fin.snoc (α := fun _ => Pt) γ.pt q⟩

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step4_routes`: "Join each inner radial
ray at its intermediate-square endpoint to the outer PL route ... The two portions meet only at
that endpoint": the joined arc starts where `γ` starts, stops at `q`, and its carrier is the
carrier of `γ` together with the joining segment. -/
private lemma existsRoutingAfterPower_step4_routes_step1_join_spec (γ : PolyArc) (q : Pt) :
    (existsRoutingAfterPower_step4_routes_step1_join γ q).start = γ.start ∧
      (existsRoutingAfterPower_step4_routes_step1_join γ q).stop = q ∧
      (existsRoutingAfterPower_step4_routes_step1_join γ q).carrier =
        γ.carrier ∪ segment ℝ γ.stop q := by
  refine ⟨?_, ?_, ?_⟩
  · exact Fin.snoc_castSucc (α := fun _ => Pt) (p := γ.pt) (x := q) (i := 0)
  · exact Fin.snoc_last (α := fun _ => Pt) (p := γ.pt) (x := q)
  · ext x
    simp only [PolyArc.carrier, PolyArc.seg, Set.mem_iUnion, Set.mem_union]
    rw [Fin.exists_fin_succ']
    apply or_congr
    · apply exists_congr
      intro i
      change x ∈ segment ℝ (Fin.snoc (α := fun _ => Pt) γ.pt q i.castSucc.castSucc)
          (Fin.snoc (α := fun _ => Pt) γ.pt q i.castSucc.succ) ↔ _
      rw [Fin.succ_castSucc, Fin.snoc_castSucc, Fin.snoc_castSucc]
    · change x ∈ segment ℝ (Fin.snoc (α := fun _ => Pt) γ.pt q (Fin.last (γ.n + 1)).castSucc)
          (Fin.snoc (α := fun _ => Pt) γ.pt q (Fin.last (γ.n + 1)).succ) ↔ _
      rw [Fin.succ_last, Fin.snoc_castSucc, Fin.snoc_last]
      rfl

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step4_routes`: "Its outside-anchored
original face contains a point `q_i` outside `K₁`; join `p_i` to `q_i` through that face.  This
collar has diameter at most `D`": every entrance point lies within `D` of its entrance edge, and
hence in the square `Q₁ + B∞(4D)`. -/
private lemma existsRoutingAfterPower_step4_routes_step2_entryNear (τ : Substitution P)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) {l : ℕ} {hl : 0 < l} {α : Rs.GS.G.P'.Form}
    (entries : existsRoutingAfterPower_EntryData τ M Rs l α hl) {a : Fin (Rs.GS.G.P'.disk α).n}
    (ha : a ∈ Rs.markedSides α) (i : Fin 4) :
    (∃ y ∈ entries.entry a i, dist (entries.point a i) y ≤ M.D) ∧
      entries.point a i ∈ square (Rs.centre l α)
        ((Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α + 4 * M.D) := by
  obtain ⟨j, hj⟩ := entries.face_edge a ha i
  obtain ⟨-, p, hp⟩ := entries.face_mem a ha i
  have hdist : ∀ {u v : Pt}, u ∈ (entries.face a i).carrier → v ∈ (entries.face a i).carrier →
      dist u v ≤ M.D := by
    intro u v hu hv
    obtain ⟨u', hu', rfl⟩ := hu
    obtain ⟨v', hv', rfl⟩ := hv
    rw [dist_vadd_cancel_left]
    rw [hp] at hu' hv'
    exact (Metric.dist_le_diam_of_mem (P.disk p).compact.isBounded hu' hv').trans (M.diam_le p)
  have hy : (entries.face a i).anchor +ᵥ (Rs.GS.G.mixed.disk (entries.face a i).form).vertex j ∈
      entries.entry a i := by
    rw [← hj]
    exact Set.vadd_mem_vadd_set (left_mem_segment ℝ _ _)
  set y := (entries.face a i).anchor +ᵥ (Rs.GS.G.mixed.disk (entries.face a i).form).vertex j
  have hqy : dist (entries.point a i) y ≤ M.D :=
    hdist (interior_subset (entries.point_mem a ha i)) (tile_side_subset _ j (hj ▸ hy))
  refine ⟨⟨y, hy, hqy⟩, ?_⟩
  have hyS : y ∈ square (Rs.centre l α) ((Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α + 3 * M.D) :=
    closure_minimal ((Rs.annulus l α hl).H_upper.trans step5_square_add_subset)
      (rg_square_closed _ _) (frontier_subset_closure ((entries.entry_private a ha i).2.1 hy))
  have hc : ∀ k : Fin 2, |entries.point a i k - Rs.centre l α k| ≤
      (Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α + 4 * M.D := by
    intro k
    have h1 := (rg_coord_sub_le (entries.point a i) y k).trans hqy
    have h2 : |y k - Rs.centre l α k| ≤ (Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α + 3 * M.D := by
      fin_cases k
      · exact hyS.1
      · exact hyS.2
    have h3 := abs_sub_le (entries.point a i k) (y k) (Rs.centre l α k)
    linarith
  exact ⟨hc 0, hc 1⟩

/-- Step 3 of the blueprint proof of `existsRoutingAfterPower_step4_routes`: "The rays remain
outside `H`": the radial segment from a point `q` outside a square about `c` out to the circle of
radius `r ≥ ‖q - c‖` about `c` does not meet that square. -/
private lemma existsRoutingAfterPower_step4_routes_step3_rayOutside {c q : Pt} {h r : ℝ}
    (hq : q ∉ square c h) (hr : ‖q - c‖ ≤ r) :
    Disjoint (segment ℝ q (existsRoutingAfterPower_step4_routes_step1_radialEnd c q r))
      (square c h) := by
  rw [Set.disjoint_left]
  intro x hx hxs
  apply hq
  unfold existsRoutingAfterPower_step4_routes_step1_radialEnd at hx
  by_cases hqc : q = c
  · subst hqc
    simp only [sub_self, smul_zero, add_zero, segment_same, Set.mem_singleton_iff] at hx
    rw [hx] at hxs
    exact hxs
  obtain ⟨a, b, ha, hb, hab, rfl⟩ := hx
  set lam := r / ‖q - c‖ with hlam_def
  have hlam : 1 ≤ lam := by
    rw [hlam_def, le_div_iff₀ (norm_pos_iff.2 (sub_ne_zero.2 hqc))]; linarith
  have hμ : 1 ≤ a + b * lam := by nlinarith
  have key : ∀ j : Fin 2, (a • q + b • (c + lam • (q - c))) j - c j =
      (a + b * lam) * (q j - c j) := by
    intro j
    simp only [PiLp.add_apply, PiLp.smul_apply, PiLp.sub_apply, smul_eq_mul]
    linear_combination (c j) * hab
  have hj : ∀ j : Fin 2, |(a • q + b • (c + lam • (q - c))) j - c j| ≤ h → |q j - c j| ≤ h := by
    intro j hj
    rw [key, abs_mul, abs_of_pos (by linarith)] at hj
    nlinarith [abs_nonneg (q j - c j)]
  exact ⟨hj 0 hxs.1, hj 1 hxs.2⟩

/-- Step 4 of the blueprint proof of `existsRoutingAfterPower_step4_routes`: "Taking
`R ≥ 10000(K₀+3)D` makes all these collars and radial rays from `q_i` to infinity separated by
more than `10D` outside `K₁`": two entrance points in the frame `(Q₁ + B∞(4D)) \ (Q₁ + B∞(3D))`
at distance at least `R/10 - 2D` have radial segments (out to a common radius) at distance at
least `5D`. -/
private lemma existsRoutingAfterPower_step4_routes_step4_raysSeparated {c q₁ q₂ : Pt} {h D R r : ℝ}
    (hh : 0 ≤ h) (hD : 0 < D) (hR : 1000 * D ≤ R) (hq₁ : q₁ ∈ square c (h + 4 * D))
    (hq₂ : q₂ ∈ square c (h + 4 * D)) (hq₁' : q₁ ∉ square c (h + 3 * D))
    (hq₂' : q₂ ∉ square c (h + 3 * D)) (hsep : R / 10 - 2 * D ≤ dist q₁ q₂)
    (hr₁ : ‖q₁ - c‖ ≤ r) (hr₂ : ‖q₂ - c‖ ≤ r) :
    ∀ x ∈ segment ℝ q₁ (existsRoutingAfterPower_step4_routes_step1_radialEnd c q₁ r),
      ∀ y ∈ segment ℝ q₂ (existsRoutingAfterPower_step4_routes_step1_radialEnd c q₂ r),
        5 * D ≤ dist x y := by
  have hray : ∀ q : Pt, q ≠ c → ‖q - c‖ ≤ r →
      ∀ x ∈ segment ℝ q (existsRoutingAfterPower_step4_routes_step1_radialEnd c q r),
        ∃ μ : ℝ, 1 ≤ μ ∧ x - c = μ • (q - c) := by
    intro q hqc hr x hx
    obtain ⟨a, b, ha, hb, hab, rfl⟩ := hx
    have hlam : 1 ≤ r / ‖q - c‖ := by
      rw [le_div_iff₀ (norm_pos_iff.2 (sub_ne_zero.2 hqc))]; linarith
    refine ⟨a + b * (r / ‖q - c‖), by nlinarith, ?_⟩
    obtain rfl : a = 1 - b := by linarith
    unfold existsRoutingAfterPower_step4_routes_step1_radialEnd
    module
  have hnorm : ∀ x : Pt, ‖x‖ ≤ |x 0| + |x 1| := by
    intro x
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_two, Real.sqrt_le_iff]
    refine ⟨by positivity, ?_⟩
    simp only [Real.norm_eq_abs, sq_abs]
    nlinarith [abs_nonneg (x 0), abs_nonneg (x 1), sq_abs (x 0), sq_abs (x 1)]
  have core : ∀ (u v : Pt) (μ ν : ℝ), 1 ≤ μ → μ ≤ ν → (∀ j, |u j| ≤ h + 4 * D) →
      (∃ j, h + 3 * D < |v j|) → (∀ j, |v j| ≤ h + 4 * D) → 98 * D ≤ ‖u - v‖ →
      ‖μ • u - ν • v‖ < 5 * D → False := by
    intro u v μ ν hμ hμν hu hv hv' huv hd
    obtain ⟨j, hj⟩ := hv
    have hcoord : |μ * u j - ν * v j| ≤ ‖μ • u - ν • v‖ := by
      have := rg_coord_sub_le (μ • u) (ν • v) j
      rwa [dist_eq_norm, PiLp.smul_apply, PiLp.smul_apply, smul_eq_mul, smul_eq_mul] at this
    have e1 : ν * |v j| ≤ μ * |u j| + ‖μ • u - ν • v‖ := by
      have h1 := abs_sub_abs_le_abs_sub (ν * v j) (μ * u j)
      rw [abs_sub_comm] at h1
      rw [abs_mul, abs_mul, abs_of_pos (by linarith : (0 : ℝ) < ν),
        abs_of_pos (by linarith : (0 : ℝ) < μ)] at h1
      linarith
    have e2 : μ * ‖u - v‖ ≤ ‖μ • u - ν • v‖ + (ν - μ) * ‖v‖ := by
      have : μ • (u - v) = (μ • u - ν • v) + (ν - μ) • v := by module
      have h2 := norm_add_le (μ • u - ν • v) ((ν - μ) • v)
      rw [← this, norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
        abs_of_pos (by linarith : (0 : ℝ) < μ), abs_of_nonneg (by linarith : (0 : ℝ) ≤ ν - μ)] at h2
      exact h2
    have hvn : ‖v‖ ≤ 2 * (h + 4 * D) := by linarith [hnorm v, hv' 0, hv' 1]
    have p1 : ν * (h + 3 * D) < ν * |v j| := mul_lt_mul_of_pos_left hj (by linarith)
    have p2 : μ * |u j| ≤ μ * (h + 4 * D) := mul_le_mul_of_nonneg_left (hu j) (by linarith)
    have p3 : (ν - μ) * ‖v‖ ≤ (ν - μ) * (2 * (h + 4 * D)) :=
      mul_le_mul_of_nonneg_left hvn (by linarith)
    have p4 : 0 ≤ (ν - μ) * h := mul_nonneg (by linarith) hh
    have p5 : μ * (98 * D) ≤ μ * ‖u - v‖ := mul_le_mul_of_nonneg_left huv (by linarith)
    have p6 : 0 ≤ μ * D := by nlinarith
    nlinarith
  intro x hx y hy
  have hc3 : c ∈ square c (h + 3 * D) := ⟨by simp; linarith, by simp; linarith⟩
  have hq₁c : q₁ ≠ c := fun e => hq₁' (e ▸ hc3)
  have hq₂c : q₂ ≠ c := fun e => hq₂' (e ▸ hc3)
  obtain ⟨μ, hμ, hxμ⟩ := hray q₁ hq₁c hr₁ x hx
  obtain ⟨ν, hν, hyν⟩ := hray q₂ hq₂c hr₂ y hy
  by_contra hlt
  push_neg at hlt
  have hxy : dist x y = ‖μ • (q₁ - c) - ν • (q₂ - c)‖ := by
    rw [dist_eq_norm, ← hxμ, ← hyν]; congr 1; abel
  have hup : ∀ q : Pt, q ∈ square c (h + 4 * D) → ∀ j, |(q - c) j| ≤ h + 4 * D := by
    intro q hq j
    rw [PiLp.sub_apply]
    fin_cases j
    · exact hq.1
    · exact hq.2
  have hlow : ∀ q : Pt, q ∉ square c (h + 3 * D) → ∃ j, h + 3 * D < |(q - c) j| := by
    intro q hq
    by_contra hne
    push_neg at hne
    apply hq
    have h0 := hne 0
    have h1 := hne 1
    rw [PiLp.sub_apply] at h0 h1
    exact ⟨h0, h1⟩
  have huv : 98 * D ≤ ‖(q₁ - c) - (q₂ - c)‖ := by
    rw [sub_sub_sub_cancel_right, ← dist_eq_norm]; linarith
  rcases le_total μ ν with hle | hle
  · exact core _ _ μ ν hμ hle (hup q₁ hq₁) (hlow q₂ hq₂') (hup q₂ hq₂) huv (hxy ▸ hlt)
  · refine core _ _ ν μ hν hle (hup q₂ hq₂) (hlow q₁ hq₁') (hup q₁ hq₁) ?_ ?_
    · rwa [norm_sub_rev]
    · rw [norm_sub_rev, ← hxy]; exact hlt

/-- Step 5 of the blueprint proof of `existsRoutingAfterPower_step4_routes`: "Choose `l` larger
... so that `c₀s > 100D` and the physical intermediate square contains the fixed central annulus":
finitely many bounds are eventually below the expansion `θ^(kl)`. -/
private lemma existsRoutingAfterPower_step4_routes_step5_scale {ι : Type*} [Finite ι] {θ : ℝ}
    (hθ : 1 < θ) {k : ℕ} (hk : 0 < k) (B : ι → ℝ) :
    ∃ n : ℕ, ∀ l ≥ n, ∀ i, B i ≤ θ ^ (k * l) := by
  obtain ⟨M₀, hM₀⟩ := (Set.finite_range B).bddAbove
  obtain ⟨n, hn⟩ := exists_nat_gt (M₀ / (θ - 1))
  refine ⟨n, fun l hl i => ?_⟩
  have h1 : B i ≤ M₀ := hM₀ ⟨i, rfl⟩
  have h2 : M₀ < n * (θ - 1) := by rwa [div_lt_iff₀ (by linarith)] at hn
  have h3 : (n : ℝ) * (θ - 1) ≤ l * (θ - 1) :=
    mul_le_mul_of_nonneg_right (by exact_mod_cast hl) (by linarith)
  have h4 : 1 + (l : ℝ) * (θ - 1) ≤ (1 + (θ - 1)) ^ l := one_add_mul_le_pow (by linarith) l
  have h5 : θ ^ l ≤ θ ^ (k * l) := pow_le_pow_right₀ hθ.le (Nat.le_mul_of_pos_left l hk)
  rw [add_sub_cancel] at h4
  linarith

/-- Step 6 of the blueprint proof of `existsRoutingAfterPower_step4_routes`: the routing in
normalized coordinates with uniform clearance.  "For a normalized centre `z ∈ K_A`, take the
intermediate square `C_z` ... Its ordered outer port points and inner points `b_i(z)` have disjoint
simple polygonal arcs ... We now prove local stability of these bounds ... The subcover therefore
gives a uniform `c₀ > 0` for mutual and off-collar boundary clearance in normalized coordinates."
Here the intermediate region is the disk of radius `κ s` (`s = θ^(kl)`) about the centre, which lies
in the open region; once it contains the central frame, the ports are joined (after relabelling the
entrances of each marked side by `perm`) to the points where the radial rays through the entrance
points leave the disk, by arcs outside the open disk, at distance at least `c₀ s` from each other,
from the other radial segments and from the other ports.  This consumes `ports.quantile` and
`ports.separated`, the planar cyclic compatibility `entries.print_order` (not only the index clause
`entries.print_cyclic`), and the uniform centre clearance in `Rs.clearance`.  It is precisely the
annular-routing, prescribed-collar, PL-stability, and compactness step; the later lemmas prove the
scale threshold, radial separation from `entries.separated` and `Rs.R_large`, and the final tube
packaging. -/
private lemma existsRoutingAfterPower_step4_routes_step6_outerRouting (τ : Substitution P)
    (hτ : τ.STS) (M : MeshConstants P) (Rs : RoutingSetup τ M) {cp : ℝ} (hcp : 0 < cp) :
    ∃ κ > (0 : ℝ), ∃ c₀ > (0 : ℝ), ∀ (l : ℕ) (hl : 0 < l) (α : Rs.GS.G.P'.Form),
      4 * ((Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α + 4 * M.D) ≤ κ * τ.θ ^ (Rs.GS.k * l) →
      ∀ (ports : existsRoutingAfterPower_PortData τ M Rs l α cp)
        (entries : existsRoutingAfterPower_EntryData τ M Rs l α hl),
      ∃ (perm : Fin (Rs.GS.G.P'.disk α).n → Equiv.Perm (Fin 4))
        (γ : Fin (Rs.GS.G.P'.disk α).n → Fin 4 → PolyArc),
        Metric.closedBall (Rs.centre l α) (κ * τ.θ ^ (Rs.GS.k * l)) ⊆
            interior (Rs.retained l α).region ∧
          (∀ b r, ∀ x ∈ Metric.closedBall (Rs.centre l α) (κ * τ.θ ^ (Rs.GS.k * l)),
            ∀ y ∈ ports.port b r, c₀ * τ.θ ^ (Rs.GS.k * l) ≤ dist x y) ∧
          ∀ a ∈ Rs.markedSides α, ∀ i,
            (γ a i).start ∈ ports.port a i.castSucc ∧
            (γ a i).stop = existsRoutingAfterPower_step4_routes_step1_radialEnd (Rs.centre l α)
              (entries.point a (perm a i)) (κ * τ.θ ^ (Rs.GS.k * l)) ∧
            (γ a i).carrier \ {(γ a i).start} ⊆ interior (Rs.retained l α).region ∧
            Disjoint (γ a i).carrier (Metric.ball (Rs.centre l α) (κ * τ.θ ^ (Rs.GS.k * l))) ∧
            (∀ b ∈ Rs.markedSides α, ∀ j, (a, i) ≠ (b, j) → ∀ x ∈ (γ a i).carrier,
              (∀ y ∈ (γ b j).carrier, c₀ * τ.θ ^ (Rs.GS.k * l) ≤ dist x y) ∧
              ∀ y ∈ segment ℝ (entries.point b (perm b j))
                (existsRoutingAfterPower_step4_routes_step1_radialEnd (Rs.centre l α)
                  (entries.point b (perm b j)) (κ * τ.θ ^ (Rs.GS.k * l))),
                c₀ * τ.θ ^ (Rs.GS.k * l) ≤ dist x y) ∧
            ∀ b r, (b, r) ≠ (a, i.castSucc) → ∀ x ∈ (γ a i).carrier, ∀ y ∈ ports.port b r,
              c₀ * τ.θ ^ (Rs.GS.k * l) ≤ dist x y := by
  sorry

/-- Step 7 of the blueprint proof of `existsRoutingAfterPower_step4_routes`: "Different routes
cannot cross the same original face: their `D` tubes are disjoint": sets at distance at least
`5D` have disjoint closed `2D`-thickenings. -/
private lemma existsRoutingAfterPower_step4_routes_step7_tubes {A B : Set Pt} {D : ℝ} (hD : 0 < D)
    (h : ∀ x ∈ A, ∀ y ∈ B, 5 * D ≤ dist x y) :
    Disjoint (Metric.cthickening (2 * D) A) (Metric.cthickening (2 * D) B) := by
  rw [Set.disjoint_left]
  intro z hzA hzB
  have hsub := fun E : Set Pt => Metric.cthickening_subset_thickening' (E := E)
    (by linarith : (0 : ℝ) < 5 * D / 2) (by linarith : 2 * D < 5 * D / 2)
  obtain ⟨x, hx, hzx⟩ := Metric.mem_thickening_iff.1 (hsub A hzA)
  obtain ⟨y, hy, hzy⟩ := Metric.mem_thickening_iff.1 (hsub B hzB)
  have := h x hx y hy
  have := dist_triangle_left x y z
  linarith

/-- Step 4 of the blueprint proof of `existsRoutingAfterPower`: the wide routing.  "For a
normalized centre `z ∈ K_A`, take the intermediate square `C_z = z + [-ρ/4, ρ/4]²` ... Its ordered
outer port points and inner points `b_i(z)` admit disjoint simple polygonal arcs" (cut the annulus
along a crosscut, `plAnnulusRouting`, prescribed inward-normal outer collars and outward-radial
inner collars); "We now prove local stability of these bounds" (PL slides of the ports, the bump
`H(x) = x + φ(x)(z' - z)` for the centre); "The centre and port parameter space is compact ...
The subcover therefore gives a uniform `c₀ > 0` ... Choose `l` larger ... so that `c₀s > 100D` and
the physical intermediate square contains the fixed central annulus.  Join each inner radial ray at
its intermediate-square endpoint to the outer PL route" and continue along the radial ray and the
collar through the outside-anchored face to the entrance point (`R ≥ 10000(K₀+3)D` separates
the rays and collars by more than `10D` outside `K₁`).  The entrances of each marked side are
relabelled to match the port order; the groups of different marked sides are in matching cyclic
order because the prints are in planar matching order with the marked sides (`print_order`;
audit of 14 October 2026: the index clause `print_cyclic` alone does not fix the planar order) and
each print lies on the contact arc of its piece.  Only the cyclic order matters: annular routing
needs no localization of the piece of `a` near the side `a`. -/
private lemma existsRoutingAfterPower_step4_routes (τ : Substitution P) (hτ : τ.STS)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) {cp : ℝ} (hcp : 0 < cp) :
    ∃ _nRoutes : ℕ, ∀ _l ≥ _nRoutes, ∀ _hl : 0 < _l, ∀ _α,
      ∀ _ports : existsRoutingAfterPower_PortData τ M Rs _l _α cp,
      ∀ _entries : existsRoutingAfterPower_EntryData τ M Rs _l _α _hl,
      Nonempty (existsRoutingAfterPower_ArcData τ M Rs _l _hl _α _ports _entries) := by
  classical
  obtain ⟨κ, hκ, c₀, hc₀, H6⟩ :=
    existsRoutingAfterPower_step4_routes_step6_outerRouting τ hτ M Rs hcp
  have hD := M.D_pos
  obtain ⟨n, hn⟩ := existsRoutingAfterPower_step4_routes_step5_scale τ.one_lt Rs.GS.k_pos
    (fun α : Rs.GS.G.P'.Form =>
      max (4 * ((Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α + 4 * M.D) / κ) (5 * M.D / c₀))
  refine ⟨n, fun l hln hl α ports entries => ?_⟩
  have hB := hn l hln α
  have hbig : 4 * ((Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α + 4 * M.D) ≤ κ * τ.θ ^ (Rs.GS.k * l) := by
    have := (le_max_left _ _).trans hB
    rw [div_le_iff₀ hκ] at this; linarith
  have hc5 : 5 * M.D ≤ c₀ * τ.θ ^ (Rs.GS.k * l) := by
    have := (le_max_right _ _).trans hB
    rw [div_le_iff₀ hc₀] at this; linarith
  obtain ⟨perm, γ, hball, hballP, hγ⟩ := H6 l hl α hbig ports entries
  set s := τ.θ ^ (Rs.GS.k * l) with hs
  have hs0 : 0 < s := pow_pos (lt_trans zero_lt_one τ.one_lt) _
  set c := Rs.centre l α with hc
  set h := (Rs.N α : ℝ) * Rs.R α / 2 + Rs.R α with hh_def
  set q := entries.point with hq_def
  set bend := fun a i =>
    existsRoutingAfterPower_step4_routes_step1_radialEnd c (q a (perm a i)) (κ * s) with hbend
  have hRl := Rs.R_large α
  have hK0 : (0 : ℝ) ≤ M.K0 := Nat.cast_nonneg _
  have hR : 1000 * M.D ≤ Rs.R α := by nlinarith
  have hh : 0 ≤ h := by
    have : (0 : ℝ) ≤ Rs.N α := Nat.cast_nonneg _
    rw [hh_def]; nlinarith
  have hnorm : ∀ x : Pt, ‖x‖ ≤ |x 0| + |x 1| := by
    intro x
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_two, Real.sqrt_le_iff]
    refine ⟨by positivity, ?_⟩
    simp only [Real.norm_eq_abs, sq_abs]
    nlinarith [abs_nonneg (x 0), abs_nonneg (x 1), sq_abs (x 0), sq_abs (x 1)]
  have hsq : ∀ {t : ℝ} {x : Pt}, x ∈ square c t → ‖x - c‖ ≤ 2 * t := by
    intro t x hx
    refine (hnorm _).trans ?_
    simp only [PiLp.sub_apply]
    linarith [hx.1, hx.2]
  have hq : ∀ a ∈ Rs.markedSides α, ∀ i, q a i ∈ square c (h + 4 * M.D) ∧
      q a i ∉ square c (h + 3 * M.D) ∧ ‖q a i - c‖ ≤ κ * s := by
    intro a ha i
    have h1 := (existsRoutingAfterPower_step4_routes_step2_entryNear τ M Rs entries ha i).2
    refine ⟨h1, fun h2 => entries.point_out a ha i (rg_square_add hh (by linarith) h2), ?_⟩
    linarith [hsq h1]
  have hrad : ∀ a ∈ Rs.markedSides α, ∀ i,
      segment ℝ (q a (perm a i)) (bend a i) ⊆ Metric.closedBall c (κ * s) := by
    intro a ha i
    obtain ⟨hq1, hq2, hq3⟩ := hq a ha (perm a i)
    have hne : q a (perm a i) - c ≠ 0 := by
      intro h0
      apply hq2
      rw [sub_eq_zero.1 h0]
      exact ⟨by simp; positivity, by simp; positivity⟩
    refine (convex_closedBall c (κ * s)).segment_subset (Metric.mem_closedBall.2 ?_)
      (Metric.mem_closedBall.2 ?_)
    · rw [dist_eq_norm]; exact hq3
    · rw [dist_eq_norm, hbend]
      simp only [existsRoutingAfterPower_step4_routes_step1_radialEnd, add_sub_cancel_left]
      rw [norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (div_nonneg (mul_pos hκ hs0).le (norm_nonneg _)),
        div_mul_cancel₀ _ (norm_ne_zero_iff.2 hne)]
  have hcar : ∀ a ∈ Rs.markedSides α, ∀ i,
      (existsRoutingAfterPower_step4_routes_step1_join (γ a i) (q a (perm a i))).carrier =
        (γ a i).carrier ∪ segment ℝ (q a (perm a i)) (bend a i) := by
    intro a ha i
    rw [(existsRoutingAfterPower_step4_routes_step1_join_spec _ _).2.2, (hγ a ha i).2.1,
      segment_symm]
  have hHsq : (Rs.annulus l α hl).H.carrier ⊆ square c (h + 3 * M.D) :=
    (Rs.annulus l α hl).H_upper.trans step5_square_add_subset
  have hsqball : square c (h + 3 * M.D) ⊆ Metric.ball c (κ * s) := by
    intro x hx
    rw [Metric.mem_ball, dist_eq_norm]
    linarith [hsq hx]
  have hsep : ∀ a ∈ Rs.markedSides α, ∀ b ∈ Rs.markedSides α, ∀ i j, (a, i) ≠ (b, j) →
      ∀ x ∈ (γ a i).carrier ∪ segment ℝ (q a (perm a i)) (bend a i),
      ∀ y ∈ (γ b j).carrier ∪ segment ℝ (q b (perm b j)) (bend b j), 5 * M.D ≤ dist x y := by
    intro a ha b hb i j hij x hx y hy
    rcases hx with hx | hx <;> rcases hy with hy | hy
    · exact hc5.trans (((hγ a ha i).2.2.2.2.1 b hb j hij x hx).1 y hy)
    · exact hc5.trans (((hγ a ha i).2.2.2.2.1 b hb j hij x hx).2 y hy)
    · rw [dist_comm]
      exact hc5.trans (((hγ b hb j).2.2.2.2.1 a ha i (Ne.symm hij) y hy).2 x hx)
    · have hne : (a, perm a i) ≠ (b, perm b j) := by
        intro he
        obtain ⟨rfl, h2⟩ := Prod.mk.inj he
        exact hij (by rw [(perm a).injective h2])
      obtain ⟨y₁, hy₁, hd₁⟩ := (existsRoutingAfterPower_step4_routes_step2_entryNear τ M Rs entries
        ha (perm a i)).1
      obtain ⟨y₂, hy₂, hd₂⟩ := (existsRoutingAfterPower_step4_routes_step2_entryNear τ M Rs entries
        hb (perm b j)).1
      have h12 := entries.separated a ha b hb (perm a i) (perm b j) hne y₁ hy₁ y₂ hy₂
      have hqq : Rs.R α / 10 - 2 * M.D ≤ dist (q a (perm a i)) (q b (perm b j)) := by
        have t1 := dist_triangle y₁ (q a (perm a i)) y₂
        have t2 := dist_triangle (q a (perm a i)) (q b (perm b j)) y₂
        rw [dist_comm] at hd₁
        linarith
      obtain ⟨ha1, ha2, ha3⟩ := hq a ha (perm a i)
      obtain ⟨hb1, hb2, hb3⟩ := hq b hb (perm b j)
      exact existsRoutingAfterPower_step4_routes_step4_raysSeparated hh hD hR ha1 hb1 ha2 hb2 hqq
        ha3 hb3 x hx y hy
  refine ⟨{
    perm := perm
    arc := fun a i => existsRoutingAfterPower_step4_routes_step1_join (γ a i) (q a (perm a i))
    start_mem := ?_
    stop_eq := ?_
    inside := ?_
    avoid_H := ?_
    tube_disjoint := ?_
    tube_ports := ?_ }⟩
  · intro a ha i
    rw [(existsRoutingAfterPower_step4_routes_step1_join_spec _ _).1]
    exact (hγ a ha i).1
  · intro a _ i
    exact (existsRoutingAfterPower_step4_routes_step1_join_spec _ _).2.1
  · intro a ha i x hx
    simp only [(existsRoutingAfterPower_step4_routes_step1_join_spec _ _).1] at hx
    rw [hcar a ha i] at hx
    rcases hx with ⟨hx | hx, hxs⟩
    · exact (hγ a ha i).2.2.1 ⟨hx, hxs⟩
    · exact hball (hrad a ha i hx)
  · intro a ha i
    rw [hcar a ha i, Set.disjoint_union_left]
    refine ⟨((hγ a ha i).2.2.2.1.mono_right (hHsq.trans hsqball)), ?_⟩
    exact (existsRoutingAfterPower_step4_routes_step3_rayOutside (hq a ha (perm a i)).2.1
      (hq a ha (perm a i)).2.2).mono_right hHsq
  · intro a ha b hb i j hij
    rw [hcar a ha i, hcar b hb j]
    exact existsRoutingAfterPower_step4_routes_step7_tubes hD (hsep a ha b hb i j hij)
  · intro a ha i b r hbr
    rw [hcar a ha i]
    refine (existsRoutingAfterPower_step4_routes_step7_tubes hD ?_).mono_right
      (Metric.self_subset_cthickening _)
    intro x hx y hy
    rcases hx with hx | hx
    · exact hc5.trans ((hγ a ha i).2.2.2.2.2 b r hbr x hx y hy)
    · exact hc5.trans (hballP b r x (hrad a ha i hx) y hy)

private structure existsRoutingAfterPower_step5_discretize_step1_route_RawData (τ : Substitution P)
    (M : MeshConstants P) (Rs : RoutingSetup τ M) (l : ℕ) (hl : 0 < l) (α : Rs.GS.G.P'.Form)
    (p : Set Pt) (F : PlacedTile Rs.GS.G.mixed) (γ : PolyArc) where
  sides : List (Set Pt)
  tiles : List (PlacedTile Rs.GS.G.mixed)
  head : sides.head? = some p
  length_eq : tiles.length = sides.length
  last_tile : tiles.getLast? = some F
  step : ∀ (_k : ℕ) (_X : PlacedTile Rs.GS.G.mixed) (_e : Set Pt), tiles[_k]? = some _X →
    sides[_k]? = some _e → _X ∈ (Rs.retained l α).children.tiles ∧ HasEdge _X _e
  step_next : ∀ (_k : ℕ) (_X : PlacedTile Rs.GS.G.mixed) (_e : Set Pt), tiles[_k]? = some _X →
    sides[_k + 1]? = some _e → HasEdge _X _e
  cross : ∀ (_k : ℕ) (_X _Y : PlacedTile Rs.GS.G.mixed), tiles[_k]? = some _X →
    tiles[_k + 1]? = some _Y → _X ≠ _Y
  inner : ∀ _e ∈ sides.tail, (Rs.retained l α).IsInner _e
  near : ∀ _e ∈ sides.tail, _e ⊆ Metric.cthickening (2 * M.D) γ.carrier ∧
    (_e \ (Rs.annulus l α hl).H.carrier).Nonempty

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb`: "perturb
the routes away from the finite original vertices" — the elementary convexity of an open half-plane. -/
private lemma existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplane
    (c : ℝ) (d a : Pt) : Convex ℝ {x : Pt | 0 < c * jcr d (x - a)} := by
  intro x hx y hy s t hs ht hst
  obtain rfl : t = 1 - s := by linarith
  simp only [Set.mem_setOf_eq] at hx hy ⊢
  have e : c * jcr d (s • x + (1 - s) • y - a) = s * (c * jcr d (x - a)) + (1 - s) * (c * jcr d (y - a)) := by
    simp only [jcr, PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]; ring
  rw [e]
  rcases hs.lt_or_eq with hs' | hs'
  · nlinarith
  · subst hs'; simp only [zero_mul, zero_add, sub_zero, one_mul]; exact hy

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb`: "perturb
the routes away from the finite original vertices" — the half-plane on the other side of a line. -/
private lemma existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplaneNeg
    (c : ℝ) (d a : Pt) : Convex ℝ {x : Pt | c * jcr d (x - a) < 0} := by
  have h := existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplane (-c) d a
  have e : {x : Pt | c * jcr d (x - a) < 0} = {x : Pt | 0 < -c * jcr d (x - a)} := by
    ext x; simp only [Set.mem_setOf_eq, neg_mul]; constructor <;> intro h <;> linarith
  rw [e]; exact h

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb`: "perturb
the routes away from the finite original vertices" — near a boundary point `z` of a closed set `K`, if the points
off the frontier are covered by two preconnected pieces avoiding the frontier, then the interior of `K` is
preconnected near `z`. -/
private lemma existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_clopen
    {K U P1 P2 : Set Pt} (hK : IsClosed K) (hU : IsOpen U) {z : Pt} (hzU : z ∈ U)
    (hz : z ∈ frontier K) (h1 : IsPreconnected P1) (h2 : IsPreconnected P2) (h1U : P1 ⊆ U) (h2U : P2 ⊆ U)
    (hcov : U \ frontier K ⊆ P1 ∪ P2) (hd1 : Disjoint P1 (frontier K)) (hd2 : Disjoint P2 (frontier K)) :
    IsPreconnected (U ∩ interior K) := by
  have hsplit : ∀ {Pi : Set Pt}, IsPreconnected Pi → Disjoint Pi (frontier K) →
      Pi ⊆ interior K ∨ Pi ⊆ Kᶜ := by
    intro Pi hPi hdi
    apply hPi.subset_or_subset isOpen_interior hK.isOpen_compl
    · exact Set.disjoint_left.2 fun x hx hx' => hx' (interior_subset hx)
    · intro x hx
      by_cases hxK : x ∈ K
      · left
        by_contra hni
        exact Set.disjoint_left.1 hdi hx ⟨subset_closure hxK, hni⟩
      · exact Or.inr hxK
  have hint : ∀ x ∈ U ∩ interior K, x ∈ P1 ∪ P2 := fun x hx =>
    hcov ⟨hx.1, fun hf => hf.2 hx.2⟩
  rcases hsplit h1 hd1 with g1 | b1 <;> rcases hsplit h2 hd2 with g2 | b2
  · exfalso
    have hUK : U ⊆ K := by
      intro x hx
      by_cases hf : x ∈ frontier K
      · exact hK.frontier_subset hf
      · rcases hcov ⟨hx, hf⟩ with h | h
        · exact interior_subset (g1 h)
        · exact interior_subset (g2 h)
    exact hz.2 (interior_maximal hUK hU hzU)
  · convert h1 using 1
    ext x; constructor
    · intro hx
      rcases hint x hx with h | h
      · exact h
      · exact absurd (interior_subset hx.2) (b2 h)
    · intro hx; exact ⟨h1U hx, g1 hx⟩
  · convert h2 using 1
    ext x; constructor
    · intro hx
      rcases hint x hx with h | h
      · exact absurd (interior_subset hx.2) (b1 h)
      · exact h
    · intro hx; exact ⟨h2U hx, g2 hx⟩
  · convert isPreconnected_empty using 1
    ext x
    simp only [Set.mem_empty_iff_false, iff_false]
    intro hx
    rcases hint x hx with h | h
    · exact b1 h (interior_subset hx.2)
    · exact b2 h (interior_subset hx.2)

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb`: segment
parameters, a point of `[a, b]` is `a + t (b - a)` with `0 ≤ t`. -/
private lemma existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segParam
    {a b x : Pt} (hx : x ∈ segment ℝ a b) : ∃ t : ℝ, 0 ≤ t ∧ x - a = t • (b - a) := by
  obtain ⟨t, h0, -, rfl⟩ := mem_segment_iff'.1 hx
  exact ⟨t, h0, by abel⟩

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb`: a short
nonnegative multiple of `b - a` based at `a` lies on `[a, b]`. -/
private lemma existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segMem {a b x : Pt} {t : ℝ} (ht : 0 ≤ t) (hxa : x - a = t • (b - a))
    (hn : ‖x - a‖ < ‖b - a‖) : x ∈ segment ℝ a b := by
  have hba : b - a ≠ 0 := by
    intro h; rw [h, norm_zero] at hn; exact absurd hn (not_lt.2 (norm_nonneg _))
  have ht1 : t ≤ 1 := by
    rw [hxa, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht] at hn
    have hp : 0 < ‖b - a‖ := norm_pos_iff.2 hba
    by_contra h; push_neg at h; nlinarith
  exact mem_segment_iff'.2 ⟨t, ht, ht1, by rw [← hxa]; abel⟩

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb`: "perturb
the routes away from the finite original vertices" — near a vertex of a polygonal disk its interior is locally
preconnected (the disk is locally a sector, bounded by the two incident sides). -/
private lemma existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_vertex (B : PolygonalDisk) (k : Fin B.n) :
    ∃ r0 > 0, ∀ r, 0 < r → r ≤ r0 → IsPreconnected (Metric.ball (B.vertex k) r ∩ interior B.carrier) := by
  classical
  have hn3 := B.three_le
  set kp := (finRotate B.n).symm k with hkp
  have hkpn : finRotate B.n kp = k := by simp [hkp]
  set a := B.vertex k with ha
  set b := B.vertex (finRotate B.n k) with hb
  set c := B.vertex kp with hc
  have hkkp : k ≠ kp := by
    intro h
    apply finRotate_ne_self (n := B.n) (by omega) k
    conv_lhs => rw [h]
    exact hkpn
  have hab : a ≠ b := pd_vertex_ne_next B k
  have hca : c ≠ a := by have := pd_vertex_ne_next B kp; rwa [hkpn] at this
  set d1 := b - a with hd1
  set d2 := c - a with hd2
  have hd1n : d1 ≠ 0 := sub_ne_zero.2 hab.symm
  have hd2n : d2 ≠ 0 := sub_ne_zero.2 hca
  have hfr := B.frontier_eq
  have hsk : segment ℝ a b ⊆ frontier B.carrier := by
    rw [hfr]; exact Set.subset_iUnion_of_subset k le_rfl
  have hskp : segment ℝ a c ⊆ frontier B.carrier := by
    rw [hfr, segment_symm]; refine Set.subset_iUnion_of_subset kp ?_; rw [hkpn]
  set Ko := ⋃ j ∈ ({k, kp}ᶜ : Set (Fin B.n)), segment ℝ (B.vertex j) (B.vertex (finRotate B.n j)) with hKo
  have hKoc : IsClosed Ko :=
    (Set.toFinite _).isClosed_biUnion (fun j _ => (isCompact_segment_pt _ _).isClosed)
  have haKo : a ∉ Ko := by
    simp only [hKo, Set.mem_iUnion, Set.mem_compl_iff, Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    rintro ⟨j, ⟨hjk, hjkp⟩, haj⟩
    have h := B.simple j k hjk ⟨haj, left_mem_segment ℝ _ _⟩
    rcases h.1 with h | h
    · exact hjk (B.vertex_injective h.symm)
    · apply hjkp
      have : finRotate B.n j = k := B.vertex_injective h.symm
      rw [hkp, ← this]; simp
  obtain ⟨r1, hr1, hball1⟩ := Metric.isOpen_iff.1 hKoc.isOpen_compl a haKo
  have hn1 : 0 < ‖d1‖ := norm_pos_iff.2 hd1n
  have hn2 : 0 < ‖d2‖ := norm_pos_iff.2 hd2n
  refine ⟨min r1 (min ‖d1‖ ‖d2‖), by positivity, fun r hr hrr => ?_⟩
  have hrr1 : r ≤ r1 := hrr.trans (min_le_left _ _)
  have hrd1 : r ≤ ‖d1‖ := hrr.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hrd2 : r ≤ ‖d2‖ := hrr.trans ((min_le_right _ _).trans (min_le_right _ _))
  set U := Metric.ball a r with hU
  have hxU : ∀ x ∈ U, ‖x - a‖ < r := fun x hx => by rwa [hU, Metric.mem_ball, dist_eq_norm] at hx
  have hfrU : ∀ x ∈ U, x ∈ frontier B.carrier → x ∈ segment ℝ a b ∨ x ∈ segment ℝ a c := by
    intro x hx hxf
    rw [hfr, Set.mem_iUnion] at hxf
    obtain ⟨j, hj⟩ := hxf
    by_cases hjk : j = k
    · subst hjk; exact Or.inl hj
    by_cases hjkp : j = kp
    · subst hjkp; rw [hkpn, segment_symm] at hj; exact Or.inr hj
    · exfalso
      apply hball1 (Metric.ball_subset_ball hrr1 hx)
      simp only [hKo, Set.mem_iUnion, Set.mem_compl_iff, Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
      exact ⟨j, ⟨hjk, hjkp⟩, hj⟩
  have hfr_a : a ∈ frontier B.carrier := hsk (left_mem_segment ℝ _ _)
  have hUo : IsOpen U := Metric.isOpen_ball
  have haU : a ∈ U := Metric.mem_ball_self hr
  by_cases hs : jcr d1 d2 = 0
  · obtain ⟨μ, hμ⟩ := exists_smul_of_jcr_eq_zero hd1n hs
    have hμ0 : μ ≠ 0 := by rintro rfl; rw [zero_smul] at hμ; exact hd2n hμ
    rcases lt_or_gt_of_ne hμ0 with hμn | hμp
    · set P1 := U ∩ {x : Pt | 0 < 1 * jcr d1 (x - a)}
      set P2 := U ∩ {x : Pt | 1 * jcr d1 (x - a) < 0}
      have hon1 : ∀ x ∈ segment ℝ a b, jcr d1 (x - a) = 0 := by
        intro x hx
        obtain ⟨t, -, ht⟩ := existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segParam hx
        rw [ht, jcr_smul_right, jcr_self, mul_zero]
      have hon2 : ∀ x ∈ segment ℝ a c, jcr d1 (x - a) = 0 := by
        intro x hx
        obtain ⟨t, -, ht⟩ := existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segParam hx
        rw [ht, ← hd2, hμ, smul_smul, jcr_smul_right, jcr_self, mul_zero]
      apply existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_clopen B.compact.isClosed hUo haU hfr_a
        ((convex_ball a r).inter (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplane 1 d1 a)).isPreconnected
        ((convex_ball a r).inter (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplaneNeg 1 d1 a)).isPreconnected
        Set.inter_subset_left Set.inter_subset_left
      · rintro x ⟨hx, hxf⟩
        by_contra hn
        simp only [Set.mem_union, Set.mem_inter_iff, Set.mem_setOf_eq, one_mul, not_or,
          not_and, not_lt] at hn
        have h0 : jcr d1 (x - a) = 0 := le_antisymm (hn.1 hx) (hn.2 hx)
        obtain ⟨t, ht⟩ := exists_smul_of_jcr_eq_zero hd1n h0
        apply hxf
        rcases le_or_gt 0 t with ht0 | ht0
        · exact hsk (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segMem ht0 ht ((hxU x hx).trans_le hrd1))
        · refine hskp (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segMem (t := t / μ) (div_nonneg_of_nonpos ht0.le hμn.le) ?_
            ((hxU x hx).trans_le hrd2))
          rw [ht, ← hd2, hμ, smul_smul, div_mul_cancel₀ _ hμ0]
      · rw [Set.disjoint_left]
        rintro x ⟨hx, hxp⟩ hxf
        simp only [Set.mem_setOf_eq, one_mul] at hxp
        rcases hfrU x hx hxf with h | h
        · rw [hon1 x h] at hxp; exact lt_irrefl _ hxp
        · rw [hon2 x h] at hxp; exact lt_irrefl _ hxp
      · rw [Set.disjoint_left]
        rintro x ⟨hx, hxp⟩ hxf
        simp only [Set.mem_setOf_eq, one_mul] at hxp
        rcases hfrU x hx hxf with h | h
        · rw [hon1 x h] at hxp; exact lt_irrefl _ hxp
        · rw [hon2 x h] at hxp; exact lt_irrefl _ hxp
    · exfalso
      set m := min 1 μ / 2 with hm
      have hm0 : 0 < m := by positivity
      have hm1 : m ≤ 1 / 2 := by have := min_le_left 1 μ; linarith
      have hmμ : m ≤ μ / 2 := by have := min_le_right 1 μ; linarith
      set x := a + m • d1 with hx
      have hx1 : x ∈ segment ℝ a b := mem_segment_iff'.2 ⟨m, hm0.le, by linarith, rfl⟩
      have hx2 : x ∈ segment ℝ c a := by
        rw [segment_symm]
        refine mem_segment_iff'.2 ⟨m / μ, by positivity, ?_, ?_⟩
        · rw [div_le_one hμp]; linarith
        · rw [hx, ← hd2, hμ, smul_smul, div_mul_cancel₀ _ hμ0]
      have h := B.simple k kp hkkp ⟨hx1, by rw [hkpn]; exact hx2⟩
      rcases h.1 with h | h
      · have : m • d1 = 0 := by
          have h' : x - a = 0 := by rw [h]; exact sub_self _
          rw [hx] at h'; simpa using h'
        rcases smul_eq_zero.1 this with h0 | h0
        · linarith
        · exact hd1n h0
      · have : (m - 1) • d1 = 0 := by
          have e : (m - 1) • d1 = x - b := by rw [hx, hd1]; module
          rw [e, h, sub_self]
        rcases smul_eq_zero.1 this with h0 | h0
        · linarith
        · exact hd1n h0
  · generalize hs0 : jcr d1 d2 = s0 at hs
    have hs2 : 0 < s0 * s0 := mul_self_pos.2 hs
    have hP1 : IsPreconnected (U ∩ ({x : Pt | 0 < s0 * jcr d1 (x - a)} ∩ {x : Pt | 0 < (-s0) * jcr d2 (x - a)})) :=
      ((convex_ball a r).inter ((existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplane s0 d1 a).inter
        (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplane (-s0) d2 a))).isPreconnected
    have hP2 : IsPreconnected (U ∩ {x : Pt | s0 * jcr d1 (x - a) < 0} ∪
        U ∩ {x : Pt | (-s0) * jcr d2 (x - a) < 0}) := by
      obtain ⟨t, ht⟩ : ∃ t : ℝ, t = r / (2 * (‖d1 + d2‖ + 1)) := ⟨_, rfl⟩
      have htp : 0 < t := by rw [ht]; positivity
      obtain ⟨y0, hy0a⟩ : ∃ y0 : Pt, y0 - a = (-t) • (d1 + d2) := ⟨a + (-t) • (d1 + d2), by abel⟩
      have hy0U : y0 ∈ U := by
        rw [hU, Metric.mem_ball, dist_eq_norm, hy0a, norm_smul, Real.norm_eq_abs, abs_neg,
          abs_of_pos htp, ht]
        have h1 : 0 ≤ ‖d1 + d2‖ := norm_nonneg _
        rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
        nlinarith
      have hy1 : s0 * jcr d1 (y0 - a) < 0 := by
        rw [hy0a, jcr_smul_right, jcr_add_right, jcr_self, zero_add, hs0]
        nlinarith
      have hy2 : (-s0) * jcr d2 (y0 - a) < 0 := by
        rw [hy0a, jcr_smul_right, jcr_add_right, jcr_self, add_zero, jcr_anti, hs0]
        nlinarith
      exact ((convex_ball a r).inter (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplaneNeg s0 d1 a)).isPreconnected.union y0
        ⟨hy0U, hy1⟩ ⟨hy0U, hy2⟩
        ((convex_ball a r).inter (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplaneNeg (-s0) d2 a)).isPreconnected
    have hon1 : ∀ x ∈ segment ℝ a b, jcr d1 (x - a) = 0 ∧ 0 ≤ (-s0) * jcr d2 (x - a) := by
      intro x hx
      obtain ⟨t, ht0, ht⟩ := existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segParam hx
      have ht' : x - a = t • d1 := ht
      have e1 : jcr d1 (x - a) = 0 := by rw [ht', jcr_smul_right, jcr_self, mul_zero]
      have e2 : (-s0) * jcr d2 (x - a) = t * (s0 * s0) := by
        rw [ht', jcr_smul_right, jcr_anti, hs0]; ring
      exact ⟨e1, by rw [e2]; exact mul_nonneg ht0 (mul_self_nonneg s0)⟩
    have hon2 : ∀ x ∈ segment ℝ a c, jcr d2 (x - a) = 0 ∧ 0 ≤ s0 * jcr d1 (x - a) := by
      intro x hx
      obtain ⟨t, ht0, ht⟩ := existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segParam hx
      have ht' : x - a = t • d2 := ht
      have e1 : jcr d2 (x - a) = 0 := by rw [ht', jcr_smul_right, jcr_self, mul_zero]
      have e2 : s0 * jcr d1 (x - a) = t * (s0 * s0) := by
        rw [ht', jcr_smul_right, hs0]; ring
      exact ⟨e1, by rw [e2]; exact mul_nonneg ht0 (mul_self_nonneg s0)⟩
    apply existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_clopen B.compact.isClosed hUo haU hfr_a hP1 hP2 Set.inter_subset_left
      (Set.union_subset Set.inter_subset_left Set.inter_subset_left)
    · rintro x ⟨hx, hxf⟩
      by_contra hn
      simp only [Set.mem_union, Set.mem_inter_iff, Set.mem_setOf_eq, not_or, not_and, not_lt] at hn
      obtain ⟨hn1', hn2', hn3'⟩ := hn
      have hA := hn2' hx
      have hB := hn3' hx
      apply hxf
      by_cases hA0 : s0 * jcr d1 (x - a) = 0
      · have h0 : jcr d1 (x - a) = 0 := by
          rcases mul_eq_zero.1 hA0 with h | h
          · exact absurd h hs
          · exact h
        obtain ⟨t, ht⟩ := exists_smul_of_jcr_eq_zero hd1n h0
        have ht0 : 0 ≤ t := by
          have e : (-s0) * jcr d2 (x - a) = t * (s0 * s0) := by
            rw [ht, jcr_smul_right, jcr_anti, hs0]; ring
          rw [e] at hB
          by_contra hneg; push_neg at hneg
          exact absurd hB (not_le.2 (mul_neg_of_neg_of_pos hneg hs2))
        exact hsk (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segMem ht0 ht ((hxU x hx).trans_le hrd1))
      · have hA' : 0 < s0 * jcr d1 (x - a) := lt_of_le_of_ne hA (Ne.symm hA0)
        have hB0 : (-s0) * jcr d2 (x - a) = 0 := le_antisymm (hn1' hx hA') hB
        have h0 : jcr d2 (x - a) = 0 := by
          rcases mul_eq_zero.1 hB0 with h | h
          · exact absurd (neg_eq_zero.1 h) hs
          · exact h
        obtain ⟨t, ht⟩ := exists_smul_of_jcr_eq_zero hd2n h0
        have ht0 : 0 ≤ t := by
          have e : s0 * jcr d1 (x - a) = t * (s0 * s0) := by
            rw [ht, jcr_smul_right, hs0]; ring
          rw [e] at hA
          by_contra hneg; push_neg at hneg
          exact absurd hA (not_le.2 (mul_neg_of_neg_of_pos hneg hs2))
        exact hskp (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_segMem ht0 ht ((hxU x hx).trans_le hrd2))
    · rw [Set.disjoint_left]
      rintro x ⟨hx, hx1, hx2⟩ hxf
      simp only [Set.mem_setOf_eq] at hx1 hx2
      rcases hfrU x hx hxf with h | h
      · rw [(hon1 x h).1, mul_zero] at hx1; exact lt_irrefl _ hx1
      · rw [(hon2 x h).1, mul_zero] at hx2; exact lt_irrefl _ hx2
    · rw [Set.disjoint_left]
      rintro x hxP hxf
      rcases hxP with ⟨hx, hxn⟩ | ⟨hx, hxn⟩ <;> simp only [Set.mem_setOf_eq] at hxn <;>
        rcases hfrU x hx hxf with h | h
      · rw [(hon1 x h).1, mul_zero] at hxn; exact lt_irrefl _ hxn
      · linarith [(hon2 x h).2]
      · linarith [(hon1 x h).2]
      · rw [(hon2 x h).1, mul_zero] at hxn; exact lt_irrefl _ hxn

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb`: "perturb
the routes away from the finite original vertices" — the interior of a polygonal disk is locally preconnected at
every boundary point (a half disk at an inner point of a side, a sector at a vertex). -/
private lemma existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_localConn (B : PolygonalDisk) {z : Pt} (hz : z ∈ frontier B.carrier) :
    ∃ r0 > 0, ∀ r, 0 < r → r ≤ r0 → IsPreconnected (Metric.ball z r ∩ interior B.carrier) := by
  have hz' := hz
  rw [B.frontier_eq, Set.mem_iUnion] at hz'
  obtain ⟨i, hi⟩ := hz'
  by_cases h1 : z = B.vertex i
  · subst h1; exact existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_vertex B i
  by_cases h2 : z = B.vertex (finRotate B.n i)
  · subst h2; exact existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_vertex B _
  have hzo := mem_openSegment_of_ne_left_right (Ne.symm h1) (Ne.symm h2) hi
  obtain ⟨r, hr, σ, -, hch⟩ := pd_halfdisk B i hzo
  refine ⟨r, hr, fun r' hr' hrr => ?_⟩
  have e : Metric.ball z r' ∩ interior B.carrier = Metric.ball z r' ∩
      {x : Pt | 0 < σ * jcr (B.vertex (finRotate B.n i) - B.vertex i) (x - B.vertex i)} := by
    ext x
    constructor
    · rintro ⟨hx, hxi⟩
      exact ⟨hx, ((hch x (Metric.ball_subset_ball hrr hx)).2.2).1 hxi⟩
    · rintro ⟨hx, hxi⟩
      exact ⟨hx, ((hch x (Metric.ball_subset_ball hrr hx)).2.2).2 hxi⟩
  rw [e]
  exact ((convex_ball z r').inter (existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_halfplane _ _ _)).isPreconnected

/-- Step 1 of the blueprint proof of `existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb`: "perturb
the routes away from the finite original vertices" — local preconnectedness of the interior at a boundary point of a
scaled polygonal disk (such as the scaled parent region of a template). -/
private lemma existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_localConnScaled (B : PolygonalDisk) {s : ℝ} (hs : 0 < s) {z : Pt}
    (hz : z ∈ frontier (s • B.carrier)) :
    ∃ r0 > 0, ∀ r, 0 < r → r ≤ r0 → IsPreconnected (Metric.ball z r ∩ interior (s • B.carrier)) := by
  have hz2 : z ∈ frontier (⇑(Homeomorph.smulOfNeZero s hs.ne') '' B.carrier) := hz
  rw [← (Homeomorph.smulOfNeZero s hs.ne').image_frontier] at hz2
  obtain ⟨z', hz', rfl⟩ := hz2
  change ∃ r0 > 0, ∀ r, 0 < r → r ≤ r0 → IsPreconnected (Metric.ball (s • z') r ∩ interior (s • B.carrier))
  obtain ⟨r0, hr0, h⟩ := existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step1_localConn B hz'
  refine ⟨s * r0, by positivity, fun r hr hrr => ?_⟩
  have hball : Metric.ball (s • z') r = s • Metric.ball z' (r / s) := by
    rw [smul_ball hs.ne', Real.norm_eq_abs, abs_of_pos hs, mul_div_cancel₀ _ hs.ne']
  rw [hball, interior_smul₀ hs.ne', ← Set.smul_set_inter₀ hs.ne']
  have := h (r / s) (by positivity) (by rw [div_le_iff₀ hs]; linarith)
  rw [← Set.image_smul]
  exact this.image _ (continuous_const_smul s).continuousOn

/-- Step 2 of the blueprint proof of `existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb`: "list
their crossed faces" — every point has a neighbourhood meeting only faces of a finite family that contain it. -/
private lemma existsRoutingAfterPower_step5_discretize_step1_route_step1_perturb_step2_localNbhd
    {Q : Protoset} {S : Set (PlacedTile Q)} (hfin : S.Finite) (x : Pt) :
    ∃ ρ > 0, ∀ y ∈ Metric.ball x ρ, ∀ X ∈ S, y ∈ X.carrier → x ∈ X.carrier := by
  have hC : IsClosed (⋃ X ∈ {X ∈ S | x ∉ X.carrier}, X.carrier) :=
    (hfin.subset (fun X hX => hX.1)).isClosed_biUnion (fun X _ => tile_isClosed X)
  have hxC : x ∉ ⋃ X ∈ {X ∈ S | x ∉ X.carrier}, X.carrier := by
    intro hx
    obtain ⟨X, hX, hxX⟩ := Set.mem_iUnion₂.1 hx
    exact hX.2 hxX
  obtain ⟨ρ, hρ, hball⟩ := Metric.isOpen_iff.1 hC.isOpen_compl x hxC
  refine ⟨ρ, hρ, fun y hy X hX hyX => ?_⟩
  by_contra hxX
